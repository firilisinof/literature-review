}
@article{Xue2025,
  title         = {Advances in Integration of Co-Packaged High-Density Optical Interconnection Chips (Invited); [共 封 装 高 密 度 光 互 连 芯 片 集 成 研 究 进 展（特 邀）]},
  author        = {Xue, Jintao and Bao, Shenlei and Cheng, Chao and Bu, Xianglin and Liu, Qian and Wei, Liqun and Yang, Yihao and Zhang, Wenfu and Wang, Binhao},
  year          = 2025,
  journal       = {Guangxue Xuebao/Acta Optica Sinica},
  volume        = 45,
  number        = 17,
  doi           = {10.3788/aos251285},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105014946313&doi=10.3788%2FAOS251285&partnerID=40&md5=dd844c6d74d1aa9d5ff6a2f0fa529c50},
  note          = {Cited by: 0},
  abstract      = {Significance The exponential growth of artificial intelligence (AI) large models, such as ChatGPT and DeepSeek, has catalyzed unprecedented demand for high-performance computing infrastructure. Projections indicate China's intelligent computing power will reach 1037.3\texttimes{}10<sup>18</sup> by 2025, with global private investments in AI infrastructure surpassing 2 trillion RMB in 2024. Traditional electrical interconnections, however, encounter fundamental limitations in power consumption and transmission distance (typically below several meters), proving inadequate for large-scale AI cluster expansion involving millions of accelerator processing units (XPUs). Optical interconnections present advantages in latency, transmission distance, and bandwidth density, positioning them as essential enablers for next-generation AI computing capabilities. Co-packaged optics (CPO) technology, which integrates high-density optical engines with switching chips or XPUs on a shared high-speed substrate, significantly reduces electrical signal paths and power consumption. Silicon photonic technology, compatible with complementary metal-oxide-semiconductor (CMOS) processes, enables monolithic integration of photonic and electronic devices, making silicon-based micro-ring optical engines central to CPO development due to their compact footprint, energy efficiency, and wavelength selectivity for wavelength division multiplexing (WDM). Progress Multi-wavelength lasers: These are essential for WDM-enabled high-density interconnects. Key solutions include distributed feedback (DFB) laser arrays, comb lasers, and mode-locked lasers. Ayar Labs'2024 16-channel SuperNova laser [Fig. 2(a)] complies with the CW-WDM MSA standard, delivering 200 GHz-spaced wavelengths with 2 dBm power at 55 ℃ . Intel achieves 16 wavelengths with only 4 lasers via multi-period gratings [Fig. 2(b)], while Innolume's quantum dot Fabry‒Perot comb laser [Fig. 2(e)] supports 24 channels at 100 GHz spacing. The quantum dot mode-locked laser by Institute of Physics, Chinese Academy of Sciences [Fig. 2(f)] demonstrates 4-channel 100 Gbit/s transmission at 80 ℃. Micro-ring modulators (MRMs): Compared to Mach‒Zehnder modulators (MZMs), MRMs offer micron-scale size and low power consumption, ideal for CPO. Innovations in junction designs (lateral, L-shaped, vertical) have significantly improved performance. The lateral-junction MRM by Xi'an Institute of Optics and Precision Mechanics, Chinese Academy of Sciences [Fig. 3(d)] achieves >67 GHz bandwidth and 256 Gbit/s PAM4 transmission rate. TSMC's 65 nm silicon photonics process enables MRMs with 76 GHz bandwidth and 0.35 V\cdot{}cm efficiency (Table 2). Thermal tuning systems (Fig. 4) using resistive heaters and closed-loop feedback address wavelength drift from fabrication errors and temperature fluctuations, with ETH Zurich's demonstration achieving 10 pm tuning precision [Fig. 4(d)]. Photodetectors: Germanium (Ge) -on-silicon detectors overcome silicon's transparency to infrared light. Huazhong University of Science and Technology's U-shaped electrode vertical PIN detector [Fig. 5(b)] reaches 103 GHz bandwidth with 1.3 nA dark current. Germany's IHP develops a fin-shaped lateral PIN detector [Fig. 5(c)] achieving 265 GHz bandwidth by optimizing carrier transport (Table 4). WDM and polarization handling: Micro-ring filters enable compact WDM demultiplexing. The University of British Columbia demonstrates that second-order dual-ring filters surpass single rings in crosstalk (-15 dB) and channel count (31\texttimes{}50 GHz). Polarization-insensitive receivers [Fig. 6(a)] and polarization diversity structures [Fig. 6(b)] address random polarization in fiber links. Analog electronic chips: CMOS-driven MRMs reduce power consumption. Intel's 28 nm driver with nonlinear equalization [Fig. 7(b)] supports 112 Gbit/s PAM4 with 5.8 pJ/bit efficiency. AMD's 7 nm transimpedance amplifier (TIA) [Fig. 8(d)] achieves 0.96 pJ/bit (Table 6). Packaging technologies: 2.5D integration [Fig. 9(a)] employs interposers for high-density interconnects, while fan-out wafer-level packaging (FOWLP) [Fig. 9(b)] provides flexibility for CPO. 3D integration with through-silicon vias (TSVs) [Fig. 9(c)], as demonstrated by TSMC's CoWoS process, targets 6.4 Tbit/s engines by 2026. Optical coupling technologies include IBM's reflow-compatible polymer waveguide [Fig. 11(a)] and Intel's pluggable glass waveguide connector [Fig. 11(b)], achieving <3 dB insertion loss. Conclusions and Prospects Silicon-based micro-ring optical engines have demonstrated substantial progress, with components achieving performance requirements of 100 ‒ 200 Gbit/s per channel. Several critical challenges persist: enhancing thermal tuning stability for multi-channel WDM, improving packaging yield in the presence of photonic process variations, and maintaining optical connector reliability under thermal stress. Future development trajectories include advancing single-channel speeds to 200 Gbit/s and optimizing compatibility with Universal Chiplet Interconnect Express (UCIe) interfaces. The standardization initiatives led by OIF and COBO remain essential for addressing protocol fragmentation. Given the continued advancement in integration density, power efficiency, and manufacturing scalability, micro-ring-based CPO demonstrates significant potential to enhance next-generation artificial intelligence and high-performance computing infrastructure. \textcopyright{} 2025 Chinese Optical Society. All rights reserved.},
  author_keywords = {co-packaged optics; micro-ring modulators; multi-wavelength lasers; optical interconnection; photodetectors; silicon photonics},
  keywords      = {Adaptive optics; Distributed feedback lasers; Electric power system interconnection; Electric power utilization; Engines; Feedback; Integrated circuit interconnects; Light modulators; Light transmission; Mode-locked fiber lasers; Optical fibers; Optical interconnects; Optical waveguides; Photonic devices; Photonic integration technology; Quantum dot lasers; Co-packaged optic; Micro-ring modulator; Microrings; Multi-wavelength lasers; Optical engine; Optical-; Power; Ring modulators; Silicon photonics; Wavelength division; Photodetectors; Silicon photonics},
  type          = {Review},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Yadav2025,
  title         = {Knowledge mapping of quantum computing for climate change research and sustainable innovation},
  author        = {Yadav, Mamta and Rawat, Keshav Singh},
  year          = 2025,
  journal       = {Quality and Quantity},
  doi           = {10.1007/s11135-025-02413-2},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105017918577&doi=10.1007%2Fs11135-025-02413-2&partnerID=40&md5=c5cd506c7e2ea5b8dc3000b35d92fe1e},
  note          = {Cited by: 5},
  abstract      = {The advent of quantum computing as a transformative computational paradigm in engineering drives substantial improvements in computational efficiency, predictive accuracy, and sustainability in technological development. Its integration into climate modeling revolutionizes the field by enabling high-precision climate simulations and optimizing climate-resilient strategies. The present research explores the evolving landscape, advancements, and challenges of climate science driven by quantum computing. This study presents a comprehensive scientometric and systematic review of quantum computing in climate, publications indexed in the Scopus database from 1992 to 2025. We conducted this study to comprehend the field's developmental trajectory, research distribution, and emerging frontiers. A PRISMA-guided selection protocol ensures transparency and replicability while investigating publication patterns, international research collaborations, and keyword co-occurrence networks to identify interdisciplinary connections and key research trends using CiteSpace. Thematic cluster analysis identifies research hotspots across quantum simulation, climate-energy systems, hydrologic modeling, and high-performance computing. Citation burst detection and centrality metrics reveal the rapid emergence of topics such as quantum-enhanced forecasting, environmental optimization, and sustainable computing. Furthermore, the study synthesizes domain-level insights and outlines a quantum-specific research agenda spanning carbon capture, extreme event prediction, and hybrid quantum-classical climate models. The findings highlight the efficacy of quantum computing in high-precision climate simulations, advanced data processing, and the optimization of climate-resilient strategies. This research provides valuable insights into emerging directions, fosters global collaboration, and aims to guide well-informed decision-making while driving technological innovations that support environmental sustainability. This research offers a multidimensional view of the evolving quantum-climate research landscape and proposes future directions for sustainable, high-resolution environmental modeling. \textcopyright{} The Author(s), under exclusive licence to Springer Nature B.V. 2025.},
  author_keywords = {Artificial intelligence; Climate modeling; Environmental sustainability; Quantum computing; Sustainable development},
  type          = {Article},
  publication_stage = {Article in press},
  source        = {Scopus}
}
@article{Yadav2025_2,
  title         = {Building Automated Computational Models for Predicting Energy Consumption in High-Performance Concrete Production},
  author        = {Yadav, Anupam and Dasarathy, A.K. and Thakur, Rishabh and Abdulla, Mohammed Rauf and Al-hedrewy, Marwea and Padmapriya, R. and Kedia, Navin and Das, Priyadarshi and Singh, Kamred Udham},
  year          = 2025,
  journal       = {Computational Economics},
  doi           = {10.1007/s10614-025-10984-3},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105005102301&doi=10.1007%2Fs10614-025-10984-3&partnerID=40&md5=fe7ede2f379016c5739327eee5cc14cb},
  note          = {Cited by: 0},
  abstract      = {This contribution provides a new energy consumption predictive model for producing high-performance concrete (HPC) using state-of-the-art machine learning techniques. Three of the most popular state-of-the-art regression models, Light Gradient Boosting Regression (LGBR), Extreme Gradient Boosting Regression (XGBR), and CatBoost Regression (CATR), are used in modeling energy demand. A novel hyperparameter optimization method called the Drawer Algorithm (DA) is introduced and used for improved model accuracy and generality in the training process. Beyond prediction, complete sensitivity analysis is performed to uncover and quantify the influence of the most vital features on energy consumption during different HPC production phases. The combination of robust ML models, an efficient optimization method, and complete and dense data on all of the main production phases of HPC enables the introduced framework to have robust accuracy, with the XGBR model optimized using DA (XGDA) yielding an R<sup>2</sup> of 0.9875 and an RMSE of 53.6594. This study combines sophisticated machine learning and optimization strategies with exhaustive data from every phase of high-performance concrete production to produce a strong model for forecasting and optimizing energy consumption, minimizing costs, and encouraging building sustainability. \textcopyright{} The Author(s), under exclusive licence to Springer Science+Business Media, LLC, part of Springer Nature 2025.},
  author_keywords = {Boosting models; Energy consumption; High-performance concrete; Optimization; Predictive modeling; Sustainability},
  type          = {Article},
  publication_stage = {Article in press},
  source        = {Scopus}
}
@article{Yagmur2024,
  title         = {Hybrid process improvement framework to reduce the eutrophication potential of in-situ leaching for uranium extraction: A qualitative study},
  author        = {Yagmur, Kirim and Okorie, Okechukwu},
  year          = 2024,
  journal       = {Journal of Cleaner Production},
  volume        = 483,
  doi           = {10.1016/j.jclepro.2024.144213},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85210025519&doi=10.1016%2Fj.jclepro.2024.144213&partnerID=40&md5=e7fe04fafb6def8c4d3e074a778de770},
  note          = {Cited by: 0; All Open Access; Green Open Access; Hybrid Gold Open Access},
  abstract      = {The UK government has embarked on a comprehensive revaluation of its investment in Nuclear Power (NP) in response to a confluence of factors, including rising oil and gas prices, the shift towards independent energy extraction, and mounting concerns about climate change. Central to this revaluation is the Hinkley Point C (HPC) Project, a new nuclear power station, which aligns with the UK's decarbonisation and NetZero ambition but requires improvements highlighted by the \'{E}lectricit\'{e} de France's (EDF) life cycle analysis, particularly in its Eutrophication Potential (EP). Eutrophication, a form of environmental damage stemming from excessive organism activity due to elevated nutrient loading remains is a key concern. Eutrophication is particularly relevant to nuclear power due to the nutrient emissions associated with uranium mining and milling processes. These processes contribute significantly to eutrophication, accounting for 58\% of the EP per kilowatt-hour delivered. This study undertakes the development of a Hybrid Process Improvement Framework (HPIF) aimed at mitigating EP associated with uranium extraction in nuclear power plants and identifies diesel combustion in support of in-situ leaching (ISL) techniques for Uranium Extraction as the predominant contributor to EP impact. Consequently, the research underscores the necessity for a novel HPIF design aimed at reducing diesel combustion and, by extension, the overall EP value. By promoting sustainable practices, the research supports a broader move towards resource-efficient and low-impact industrial processes, crucial for the UK's overall Net Zero strategy. Further, the study adopts the DMADV methodology for the design of the HPIF process, thus ensuring a well-structured and data-driven approach in managing the HPIF configuration process. For validation, we employ semi-structured open-ended qualitative interviews with a unique set of subject experts (n = 21) comprising nuclear industry practitioners, academic researchers, and policymakers. Insights from the analysed data from 21 subject experts indicate that the HPIF is a novel tool that can address the larger objective of responding to critical environmental concerns within the nuclear power industry. We conclude that the HPIF can mitigate EP reduction challenges associated with uranium extraction for nuclear power plants. The HPIF integrates and synthesises the methodologies of three established studies focused on reducing diesel fuel consumption in diesel generators. It systematically addresses key parameters, including load profiles, optimal generator type, number of generators, and scheduling strategies, tailored to specific load demands. By employing the advanced calculations derived from these three studies, HPIF effectively targets the fundamental issue contributing to EP value--namely, the diesel combustions of diesel generators. This framework specifically addresses the challenge of reducing EP values associated with diesel fuel usage. \textcopyright{} 2024 The Authors},
  author_keywords = {Diesel combustions; Eutrophication potential; In-situ leaching; NVivo; Six Sigma DMADV; Uranium extraction},
  keywords      = {Conversion efficiency; Costs; Diesel power plants; Elastin; Glucose; Hydrometallurgy; Lipoproteins; Liquid sugar; Loss prevention; Mine power plants; Nuclear fuel accounting; Nuclear fuel reprocessing; Nuclear industry; Nuclear power plants; Proteomics; Saturated fatty acids; Volatile fatty acids; Waste treatment; Xylose; Zein; Diesel combustion; Eutrophication potentials; Hybrid process; In-situ leaching; Nvivo; Power; Process improvement frameworks; Six sigma DMADV; Six-Sigma; Uranium extraction; In situ combustion},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Yamabe2018541,
  title         = {Sequential process of chiral imprinting and composite formation allows to produce electrooptically active poly(bis-EDOT)/hydroxypropyl cellulose},
  author        = {Yamabe, Kohei and Goto, Hiromasa},
  year          = 2018,
  journal       = {Advanced Composites and Hybrid Materials},
  volume        = 1,
  number        = 3,
  pages         = {541--547},
  doi           = {10.1007/s42114-018-0037-2},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85059447656&doi=10.1007%2Fs42114-018-0037-2&partnerID=40&md5=8c2e77bec1603a44ca726f409fc8df63},
  note          = {Cited by: 6},
  abstract      = {Poly(3,4-ethylenedioxythiophene) (PEDOT) is one of the promising conjugated polymeric materials for organic devices such as organic solar cell or organic electroluminescence display. Hydroxypropyl cellulose (HPC) is a product of chemical-modified cellulose. HPC shows liquid crystal at appropriate condition in solvents. HPC has been used for a binder of medicines and can be applied for green sustainable chemistry in materials science. In this study, poly(bis-(3,4-ethylenedioxythiophene)), abbreviated as poly(bis-EDOT), film is prepared in cholesteric liquid crystals with electrochemical polymerization. We employ a dimer of EDOT (bis-EDOT) as a monomer because bis-EDOT shows good affinity with liquid crystals and the linear shape of bis-EDOT allows pre-orientation in liquid crystal prior to polymerization. The polymer film thus prepared in cholesteric liquid crystals (CLC) shows characteristic circular dichroism (CD) derived from 3-D asymmetric super structure. This study demonstrates that polymerization of the linear-shaped bis-EDOT can effectively imprint 3-D asymmetric structure from HPC as a polymer CLC matrix and form conductive polymer/non-conductive polymer composite. [Figure not available: see fulltext.] \textcopyright{} 2018, Springer International Publishing AG, part of Springer Nature.},
  author_keywords = {Conjugated polymer; EDOT; Electropolymerization; Hydroxypropyl cellulose; Polymer composites},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Yamagiwa2016133,
  title         = {Stream-based lossless data compression hardware using adaptive frequency table management},
  author        = {Yamagiwa, Shinichi and Marumo, Koichi and Sakamoto, Hiroshi},
  year          = 2016,
  journal       = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
  volume        = 9495,
  pages         = {133--146},
  doi           = {10.1007/978-3-319-29006-5_11},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84958062578&doi=10.1007%2F978-3-319-29006-5_11&partnerID=40&md5=dfe223a33d41e4cb7e1066ef19f476b7},
  note          = {Cited by: 1},
  abstract      = {In order to treat BigData efficiently, the communication speed of the inter or the intra data path equipped on high performance computing systems that needs to treat BigData management has been reaching to very high speed. In spite of fast increasing of the BigData, the implementation of the data communication path has become complex due to the electrical difficulties such as noises, crosstalks and reflections of the high speed data connection via a single cupper-based physical wire. This paper proposes a novel hardware solution to implement it by applying a stream-based data compression algorithm called the LCADLT. The compression algorithm is able to treat continuous data stream without exchanging the symbol lookup table among the compressor and the decompressor. The algorithm includes a dynamic frequency management of data patterns. The management is implemented by a dynamic histogram creation optimized for hardware implementation. When the dedicated communication protocol is combined with the LCA-DLT, it supports remote data migration among the computing systems. This paper describes the algorithm design and its hardware implementation of the LCA-DLT, and also shows the compression performance including the required hardware resources. \textcopyright{} Springer International Publishing Switzerland 2016.},
  author_keywords = {Communication protocol; Dynamic histogram creation; Lossless data compression},
  keywords      = {Algorithms; Benchmarking; Big data; Computer hardware description languages; Graphic methods; Hardware; Information management; Life cycle; Network protocols; Optimization; Reconfigurable hardware; Table lookup; Communication speed; Compression algorithms; Compression performance; Data compression algorithms; Dynamic histograms; Hardware implementations; High performance computing systems; Lossless data compression; Data compression},
  type          = {Conference paper},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Yamamoto201380,
  title         = {Numerical simulation of long-term fate of CO2 stored in deep reservoir rocks on massively parallel vector supercomputer},
  author        = {Yamamoto, Hajime and Nanai, Shinichi and Zhang, Keni and Audigane, Pascal and Chiaberge, Christophe and Ogata, Ryusei and Nishikawa, Noriaki and Hirokawa, Yuichi and Shingu, Satoru and Nakajima, Kengo},
  year          = 2013,
  journal       = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
  volume        = {7851 Lncs},
  pages         = {80--92},
  doi           = {10.1007/978-3-642-38718-0_11},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84883295970&doi=10.1007%2F978-3-642-38718-0_11&partnerID=40&md5=7dc222ec998b52cd5107da07139c9042},
  note          = {Cited by: 8},
  abstract      = {As one of the promising approaches for reducing greenhouse-gas content in the atmosphere, CCS (carbon dioxide capture and storage) has been recognized worldwide. CO<sub>2</sub> is captured from large emission sources and injected and stored in deep reservoir rocks, including saline aquifers, depleted oil and gas field. Under typical pressure and temperature conditions at deep reservoirs (depths > 800m), CO<sub>2</sub> will be stored in supercritical state, subsequently dissolving in groundwater, and eventually forming carbonate minerals through geochemical reactions in a long-term (e.g., thousands of years). To ensure the safety and permanence of the storage, numerical simulation is considered as the most powerful approach for predicting the long-term fate of CO<sub>2</sub> in reservoirs. A parallelized general-purpose hydrodynamics code TOUGH2-MP has been used on scalar architectures where it exhibits excellent performance and scalability. However, on the Earth Simulator (ES2), which is a massively parallel vector computer, extensive tune-ups were required for increasing the vector operation ratio. In this paper, the performance of the modified TOUGH2-MP code on ES2 is presented with some illustrative numerical simulations of long-term fate of CO<sub>2</sub> stored in reservoirs. \textcopyright{} 2013 Springer-Verlag.},
  author_keywords = {CCS; Hydrodynamics; The Earth Simulator; Vector processors},
  keywords      = {Aquifers; Carbon capture; Computer simulation; Groundwater resources; Hydrodynamics; Hydrogeology; Numerical models; Oil fields; Petroleum reservoirs; Rocks; Supercomputers; Vectors; Carbon dioxide capture and storage; CCS; Earth simulators; Geochemical reaction; Performance and scalabilities; Pressure and temperature; Supercritical state; Vector processors; Carbon dioxide},
  type          = {Conference paper},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Yan201861,
  title         = {Superlinear speedup phenomenon in parallel 3D Discrete Element Method (DEM) simulations of complex-shaped particles},
  author        = {Yan, Beichuan and Regueiro, Richard A.},
  year          = 2018,
  journal       = {Parallel Computing},
  volume        = 75,
  pages         = {61--87},
  doi           = {10.1016/j.parco.2018.03.007},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85044716610&doi=10.1016%2Fj.parco.2018.03.007&partnerID=40&md5=159d24676dac8408c1563efd4ca91d86},
  note          = {Cited by: 18},
  abstract      = {Strong superlinear speedup has been discovered in large scale simulations of parallel 3D DEM for complex-shaped particles, which is based on an algorithm of spatial domain decomposition, and exhibits the ``high-CPU-low-memory'' characteristics. The interpretation of this phenomenon requires a careful examination of the speedup theory and practice in the field of parallel computing. The superlinear speedup is investigated from three perspectives: (i) memory footprint per process, (ii) cache miss rates of L1, L2 and L3 level caches, and (iii) uniprocessor performance, using a wide range of problem size (across five orders of magnitude of simulation scale regarding number of particles) and number of compute nodes (1–2048 nodes) on DoD supercomputers. The Performance-API (PAPI) is employed in the source code to measure cache miss rate and FLOPS. The strong scaling measurements show that cache miss rate is sensitive to the memory consumption shrinkage per processor, and the last level cache (LLC) contributes most significantly to the strong superlinear speedup among all of the three cache levels, and this is also revealed in the weak scaling measurements. The findings are associated with the inherently perfect scalability of 3D DEM: its memory scalability function is a nonlinearly decreasing function of the number of processors. In addition, a constant (non-increasing) uniprocessor FLOPS performance w.r.t problem size can also contribute to the superlinear speedup. The superlinear speedup is a common phenomenon for large scale 3D DEM simulations of complex-shaped particles, and the larger the scale, the stronger is the superlinear speedup. DEM researchers should take advantage of this effect to speedup their parallel simulations. \textcopyright{} 2018 Elsevier B.V.},
  author_keywords = {Cache miss rate; Complex-shaped; FLOPS; Granular materials; Parallel Discrete Element Method; Superlinear speedup},
  keywords      = {Computation theory; Domain decomposition methods; Finite difference method; Granular materials; Parallel processing systems; Scalability; Supercomputers; Cache miss rates; Complex-shaped; Complex-shaped particles; FLOPS; Large scale simulations; Lastlevel caches (LLC); Spatial domain decompositions; Superlinear speedups; Cache memory},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Yan2022,
  title         = {Optimized border irrigation improved soil water content, increased winter wheat grain yield and water productivity},
  author        = {Yan, Feilong and Yu, Zhenwen and Shi, Yu},
  year          = 2022,
  journal       = {Scientific Reports},
  volume        = 12,
  number        = 1,
  doi           = {10.1038/s41598-022-25137-x},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85142934961&doi=10.1038%2Fs41598-022-25137-x&partnerID=40&md5=4a36881f80d9cb9329b77ef384c0412c},
  note          = {Cited by: 2; All Open Access; Gold Open Access; Green Open Access},
  abstract      = {Border irrigation is still the main irrigation method in the Huang-Huai-Hai Plain of China (HPC), we aimed to find a suitable border length to reduce the quantity of irrigation water through a traditional border irrigation system to alleviate groundwater depletion. A 2-year experiment (2017–2019) was conducted with four border lengths: 20~m (L20), 30~m (L30), 40~m (L40) and 50~m (L50); supplementary irrigation was implemented during jointing and anthesis. The results showed that compared with the L20 and L30 treatments, the L40 treatment did not significantly increase the total water consumption. Compared with the L50 treatment, the L40 treatment significantly reduced the water consumption of ineffective tillers from jointing to anthesis. There was no significant difference in flag leaf net photosynthetic rate (Pn) between L40 treatment and L50 treatment at 14–28~days after anthesis, which was 12.36\% and 21.31\% higher than L30 and L20 treatments respectively, and significantly increased dry matter accumulation after anthesis. Grain yield were the higher in the L40 and L50 treatments, while the water productivity (WP) was highest in the L40 treatment, which was 3.98\%, 4.54\% and 7.94\% higher than L50, L30, and L20 treatments, respectively. Hence, the irrigation field treatments with a border length of 40~m were considered the most efficient, which provides a theoretical basis for optimizing the traditional irrigation border length in HPC. \textcopyright{} 2022, The Author(s).},
  keywords      = {Edible Grain; Plant Leaves; Soil; Triticum; Water; water; food grain; plant leaf; soil; wheat},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Yan2025,
  title         = {Architecting hierarchically porous biomass carbons via halogen-induced defect modulation for advanced supercapacitive applications},
  author        = {Yan, Wang and Hanbo, Wang and Sheng, Wan and Ziming, Wang and Yahui, Xu and Dongyu, Zhu and Yumei, Tian and Haiyan, Lu},
  year          = 2025,
  journal       = {Journal of Energy Storage},
  volume        = 133,
  doi           = {10.1016/j.est.2025.118042},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105012608026&doi=10.1016%2Fj.est.2025.118042&partnerID=40&md5=14c2259b3479fad892d234746299ef0d},
  note          = {Cited by: 4},
  abstract      = {Amidst the rise of energy and environmental issues, the focus shifted to sustainable and cost-effective resources for energy storage. Natural biomass and its derivatives emerged as promising materials for supercapacitor electrodes. However, the lower energy density of carbon materials compared to batteries restricted their use in high-energy-density applications. To tackle this challenge, researchers had concentrated on innovating materials, optimizing structural designs, introducing heteroatom doping, and conducting interface engineering to boost the comprehensive performance of supercapacitors. Among them, heteroatom doping garnered significant attention. This was attributed to its relatively straightforward doping process, which not only enabled precise control over the doping concentration but also enhanced the overall efficiency of the production process. This study introduced a sustainable and cost-effective approach to enhance the preparation of supercapacitor electrode materials derived from natural biomass through halogen doping. By adjusting the doping amount of halogen elements, Cl, F-HPC-0.5 had high specific surface area (4501 m<sup>2</sup> g<sup>-1</sup>), substantial specific capacitance (469.1 F g<sup>-1</sup> at 1 A g<sup>-1</sup>) and remarkable stability (96.40 \% capacitance retention after 5000 cycles at 5 A g<sup>-1</sup>). As expected, the symmetrical supercapacitor delivered an enhanced energy density of 32.4 Wh kg<sup>-1</sup> within operating voltage range of 0–1.8 V. More impressively, it maintained a retention rate of 93.93 \% after 10,000 cycles at a high current density. The voltages of the positive and negative electrode materials were monitored in real time using a floating ground test. Even under conditions of high current density, the system was able to maintain a relatively stable state. This advancement in material design ensured that the supercapacitors had high performance, while maintaining their performance in long cycles, it met the strict requirements of modern supercapacitors applications. \textcopyright{} 2025 Elsevier Ltd},
  author_keywords = {Biomass carbon; Defect modulation; Energy storage; Halogen doped; Porous structure},
  keywords      = {Biomass; Carbon; Cost effectiveness; Defects; Electrodes; Halogen elements; Interfaces (materials); Structural design; Structural optimization; Supercapacitor; Biomass carbon; Defect modulation; Energy; Energy density; Halogen doped; Heteroatoms; High current densities; Natural biomass; Porous structures; Supercapacitor electrodes; Capacitance; Energy storage},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Yan2026,
  title         = {Retrieval of Aerosol Size Characteristics from Satellite Observations: Progress, Challenges, and Prospects (Invited); [大气气溶胶尺度信息的卫星遥感反演：进展、挑战与展望（特邀）]},
  author        = {Yan, Xing and Chen, Jiayi and Wang, Qiao and Chen, Ziyue and Zhao, Chuanfeng},
  year          = 2026,
  journal       = {Guangxue Xuebao/Acta Optica Sinica},
  volume        = 46,
  number        = 6,
  doi           = {10.3788/aos251947},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105033218418&doi=10.3788%2FAOS251947&partnerID=40&md5=61eda19ed592e7d12db60c554c5ae97d},
  note          = {Cited by: 0},
  abstract      = {Significance Aerosols play a crucial role in the Earth's climate system, air quality, and human health through their interactions with radiation, clouds, and atmospheric chemistry. Beyond total aerosol optical depth (AOD), size-resolved aerosol properties--such as fine-mode and coarse-mode aerosol optical depth (fAOD/cAOD) and the fine-mode fraction (FMF)--provide essential information for understanding aerosol sources, composition, transport, and environmental effects. Satellite remote sensing offers the only feasible means for long-term, global-scale monitoring of aerosol size information. However, retrieving aerosol size-segregated properties from spaceborne observations remains challenging due to the inherent ill-posedness of radiative transfer, surface-atmosphere coupling, and limited observational information content. These challenges motivate the need for retrieval frameworks that move beyond purely empirical approaches and incorporate physical constraints into data-driven methods. A systematic review of the progress, methodological evolution, and remaining challenges in satellite-based aerosol size-resolved retrievals is therefore of great significance for advancing aerosol remote sensing and related applications. Progress This review provides a comprehensive overview of satellite remote sensing techniques for aerosol size-segregated retrievals, with a primary focus on passive optical observations. From the perspective of observation capabilities, single-angle radiometers such as MODIS and VIIRS have enabled long-term and large-scale monitoring of aerosol optical properties, forming the backbone of global aerosol datasets. Multi-angle instruments, represented by MISR, significantly enhance sensitivity to aerosol particle size and type by exploiting angular scattering information. Polarimetric sensors, such as POLDER and the forthcoming 3MI, further improve retrieval performance under bright surface and strongly absorbing aerosol conditions by providing additional constraints on aerosol microphysical properties. From the methodological perspective, aerosol size-separation techniques have evolved from physically based radiative transfer models and lookup-table approaches to empirical statistical methods and machine learning algorithms. Early physical methods relied on predefined aerosol models and spectral assumptions, offering physical interpretability but limited flexibility. Data-driven machine learning approaches have demonstrated improved accuracy and spatial completeness by learning nonlinear relationships between satellite observations, auxiliary data, and ground-based measurements. More recently, physics-informed and physics-constrained machine learning frameworks have emerged, aiming to integrate radiative transfer principles and aerosol physical priors into datadriven models to improve robustness and generalizability. Based on these developments, multiple long-term fAOD, cAOD, and FMF datasets have been generated and applied in climate model evaluation, transboundary pollution analysis, and health exposure assessment. At the same time, increasing attention has been paid to uncertainty characterization, cross-sensor consistency, and the limitations of using correlation-based metrics alone to assess retrieval performance. Conclusions and Prospects Despite substantial progress, several challenges remain in satellite-based aerosol size-resolved retrievals. Surface reflectance variability, absorbing aerosol effects, and non-Lambertian surface properties continue to complicate spectral separation of aerosol modes. Differences in spectral response functions, viewing geometries, and calibration among satellite sensors lead to systematic discrepancies across aerosol products, limiting their comparability. Moreover, while machine learning methods show strong performance, insufficient physical constraints and limited interpretability may reduce their reliability under complex aerosol conditions. Future research is expected to advance toward physically constrained machine learning, in order to address the limited interpretability and potential physical inconsistency of conventional machine-learning approaches in aerosol size separation. In this review, we propose a three-stage physics-constraint strategy that introduces physical knowledge at the input, training, and observation stages: 1) input stage--embed physically meaningful priors such as viewing geometry, radiative-transfer variables, and sensor spectral response information to construct an input space with clear physical interpretation; 2) training stage--use differentiable radiative transfer to formulate physics-consistent loss functions incorporating energy-conservation and spectral-smoothness constraints, thereby ensuring that model optimization follows fundamental radiation-scattering laws; 3) observation stage--integrate polarimetric measurements and introduce joint angular-spectral constraints to maintain physical closure of the scattering field and polarization consistency. Together, these developments enable a methodological transition from `` data-driven'' to `` physicsconstrained''retrieval paradigms, offering a promising new avenue for more robust and transferable separation of coarseand finemode aerosol optical depth. With the continued deployment of next-generation satellite sensors and advances in artificial intelligence and high-performance computing, hybrid approaches that integrate physical understanding with data-driven techniques are expected to deliver more consistent and reliable global estimates of aerosol size-resolved optical properties, supporting refined assessments of aerosol-climate interactions and environmental impacts. \textcopyright{} 2026, Chinese Optical Society. All rights reserved.},
  author_keywords = {aerosol optical depth; coarse-mode; fine-mode; machine learning; multiple-angle satellite; polarimetric satellite},
  keywords      = {Air quality; Atmospheric aerosols; Atmospheric chemistry; Atmospheric movements; Couplings; Large datasets; Learning algorithms; Learning systems; Machine learning; Optical depth; Radiative transfer; Remote sensing; Satellites; Size separation; Space optics; Table lookup; Aerosol optical depths; Aerosol size; Coarse mode; Fine-mode; Interpretability; Machine-learning; Multiple-angle satellite; Polarimetric satellite; Property; Satellite observations; Particle size; Polarimeters},
  type          = {Review},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Yang2012273,
  title         = {An analysis on the energy efficiency of air-cooled chillers with water mist system},
  author        = {Yang, Jia and Chan, K.T. and Wu, Xiangsheng and Yu, F.W. and Yang, Xiaofeng},
  year          = 2012,
  journal       = {Energy and Buildings},
  volume        = 55,
  pages         = {273--284},
  doi           = {10.1016/j.enbuild.2012.09.018},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84870582109&doi=10.1016%2Fj.enbuild.2012.09.018&partnerID=40&md5=7db0d6d4e9ae7252c8a5da8fdd4bb7b3},
  note          = {Cited by: 37},
  abstract      = {This paper presents the effect of operating water mist system to enhance the energy efficiency of air-cooled chillers under various operating conditions. A thermodynamic model for an air-cooled chiller with twin refrigeration circuits coupled with a water mist system was developed and validated by measured operating data. The validated model was used to investigate how the thermal properties of the entering condenser air and the performance of the air-cooled chiller varied under different operating schemes with water mist pre-cooling. Under the conventional head pressure control (HPC) with a designed water mist generation rate, the coefficient of performance (COP) increased by up to 21.3\%. The chiller performance could be improved further under variable condensing temperature control (CTC). Under CTC, chiller COP was increased up to 51.5\% with optimal water mist generation rate. The potential energy savings of these chillers serving a representative office building in subtropical climate was evaluated, and CTC coupling with optimal water mist generation rate would reduce the annual total electricity consumption for cooling by 14.1\%. The water consumption of the water mist system was comparatively small, comparing with the total water losses for an open-loop cooling tower system with equivalent heat rejection capacity. \textcopyright{} 2012 Elsevier B.V. All rights reserved.},
  author_keywords = {Air-cooled chiller; Coefficient of performance; Energy saving; Water mist},
