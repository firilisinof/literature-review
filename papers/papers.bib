@conference{Regly202510,
  title         = {Shell form-finding for a reading pavilion in the city of Campinas, S\~{a}o Paulo},
  author        = {Regly, Carolina J. T. P. and J.vianna, Nicolas and Mistro, Samira F. and Zaccarias, Vanessa O. V. and Melachos, Felipe C. and Buttignol, Thomaz E. T.},
  year          = 2025,
  journal       = {fib Symposium},
  pages         = {10--21},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105016459919&partnerID=40&md5=c677a92fd3d410e1f16a9a7fb3b8c24b},
  note          = {Cited by: 0},
  abstract      = {Parametric modeling has been increasingly present in the architectural and engineering conceptual design stage. Moreover, structural optimization modeling to improve sustainability and performance levels requires a solid interaction between architects and engineers. Thus, this paper describes the development of an algorithm in the Grasshopper 3D and Karamba3d plugins to explore the form-finding concept of a self-supporting double-curved shell structure, which was inspired by the Flagship Dolce Gusto Neo (2023), designed by Est\'{u}dio Guto Requena (S\~{a}o Paulo, SP, Brazil). The analysis is divided into four main parts that include an introduction to the conceptual design of shells; the methodology adopted for the shell form-finding, the algorithm for the parametric modeling, and the structural analysis. The major challenges were the parameterization in the number of shell petals and the equilibrium of the self-supporting structure, requiring the use of a central column. The thickness of the shell proved to be critical to the stability of the structure. Excessive thin sections (approximately 3 cm) tended to present large deformations. In contrast, thickness values ranging between 7 and 9 cm reached a plateau, with very small displacements. The use of high-performance concrete (HPC) is preferred, as classes C50 to C90 exhibited a maximum displacement of approximately 0.19 to 0.15 cm. \textcopyright{} f\'{e}d\'{e}ration internationale du b\'{e}ton (fib).},
  author_keywords = {Form-finding; High-performance concrete; Parametric modeling; Self-supporting structure; Structural stability},
  keywords      = {Conceptual design; High performance concrete; Stability; Structural analysis; Structural optimization; Conceptual design stages; Form-finding; High-performance concrete; Optimization models; Parametric models; Performance:level; Sao Paulo; Self-supporting structures; Structural optimisations; Structural stabilities; Shells (structures)},
  type          = {Conference paper},
  publication_stage = {Final},
  source        = {Scopus}
}
