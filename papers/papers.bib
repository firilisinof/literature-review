}
@article{Tong2026,
  title         = {Intelligent Hybrid Caching for Sustainable Big Data Processing: Leveraging NVM to Enable Green Digital Transformation},
  author        = {Tong, Lei and Shen, Qing and Xie, Zhenqiang},
  year          = 2026,
  journal       = {Sustainability (Switzerland)},
  volume        = 18,
  number        = 5,
  doi           = {10.3390/su18052601},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105032671584&doi=10.3390%2Fsu18052601&partnerID=40&md5=732327d0219ee7253dbd1a7e5142fa0c},
  note          = {Cited by: 0; All Open Access; Gold Open Access},
  abstract      = {Apache Spark has gained widespread adoption for large-scale data processing. However, conventional caching methods inadequately address the dual challenges of performance bottlenecks and escalating energy consumption in data-intensive workloads. This paper introduces a sustainable computing framework that integrates Directed Acyclic Graph (DAG) dependency analysis with garbage collection (GC) behavior monitoring to optimize data placement between DRAM and non-volatile memory (NVM). The proposed Intelligent Hybrid Caching Management Framework (IHCMF) dynamically predicts data access patterns and migrates cache blocks based on cost–benefit analysis, achieving a 37.5\% execution time reduction over default Spark configurations in SparkBench evaluations. By improving throughput-per-watt and projecting potential benefits from NVM's near-zero idle power and extended hardware lifespan, IHCMF provides a scalable, cost-effective caching solution for resource-constrained edge computing environments. This work demonstrates that high-performance computing can be reconciled with environmental sustainability through intelligent memory management. \textcopyright{} 2026 by the authors.},
  author_keywords = {Apache Spark optimization; energy-efficient big data systems; hybrid memory (DRAM-NVM); sustainable digital infrastructure},
  keywords      = {data processing; energy efficiency; environmental management; infrastructure planning; monitoring system; optimization; sustainability},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Tong2026_2,
  title         = {Sample augmentation-based adversarial training method to counter evasive spectre attacks},
  author        = {Tong, Zhongkai and Gao, Jian and Yuan, Deyu and Liu, Gang},
  year          = 2026,
  journal       = {Engineering Applications of Artificial Intelligence},
  volume        = 166,
  doi           = {10.1016/j.engappai.2025.113634},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105026123914&doi=10.1016%2Fj.engappai.2025.113634&partnerID=40&md5=31e1bf4ceb332ee36d012fbed5ab464e},
  note          = {Cited by: 0},
  abstract      = {Microarchitectural attacks exploit subtle processor-level vulnerabilities to extract sensitive data, posing persistent challenges to modern hardware security. Although artificial intelligence (AI)–assisted detection using hardware performance counters (HPCs) provides a low-overhead defense, its reliability remains limited when facing evasive variants that deliberately mask their microarchitectural footprints. In this work, we present Evasive Spectre. This novel Spectre variant incorporates controlled delay operations to bypass state-of-the-art HPC-based AI detectors, thereby exposing inherent weaknesses in existing detection systems. To mitigate these limitations, we propose a sample-augmentation-based adversarial training framework that improves model robustness by periodically injecting adversarial samples and leveraging combined HPC feature representations. Experiments on Intel Corporation (Intel) i7-7700 and Advanced Micro Devices (AMD) Ryzen 7-4800H platforms demonstrate over 99\% detection accuracy against both Spectre and the proposed Evasive Spectre, with a maximum runtime overhead of only 1.7\%. These results underscore a lightweight, scalable, and robust defense paradigm that advances the application of adversarial learning to intelligent hardware security in the AI-driven era. \textcopyright{} 2025 Elsevier Ltd.},
  author_keywords = {Adversarial training; Attack detection; Automated machine learning; Evasive Spectre; Hardware security; Sample augmentation},
  keywords      = {Adversarial machine learning; Artificial intelligence; Learning systems; Network security; Sampling; Attack detection; Automated machine learning; Automated machines; Delay-operations; Evasive specter; Hardware performance counters; Low overhead; Machine-learning; Sample augmentation; Training methods; Hardware security},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Topcu2025533,
  title         = {Demystifying Power and Performance Variations in GPU Systems through Microarchitectural Analysis},
