  title         = {Tunable luminescence properties and energy transfer in Ba 3Lu(PO4)3:Ce3+,Tb3+ phosphors},
  author        = {Jin, Cheng and Ma, Hengxin and Liu, Yufeng and Liu, Qingbo and Dong, Guoyi and Yu, Quanmao},
