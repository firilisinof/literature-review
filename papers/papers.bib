  source        = {Scopus}
}
@article{Spagnuolo2023,
  title         = {Precast high-performance concrete (HPC) sheet piles prestressed with glass fiber reinforced polymer (GFRP) bars},
  author        = {Spagnuolo, S. and Giorgi, C. and Rinaldi, Z. and Pedrocco, L.},
  year          = 2023,
  journal       = {Composite Structures},
  volume        = 304,
  doi           = {10.1016/j.compstruct.2022.116324},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85140300796&doi=10.1016%2Fj.compstruct.2022.116324&partnerID=40&md5=52c725bf17987b3e8671619092260ab7},
  note          = {Cited by: 14},
  abstract      = {Since decades, the prestressed reinforced concrete technique, with steel strands, has been widely used in structural and infrastructural fields. The paper deals with the possibility to replace the traditional steel strands with new composite Glass Fiber Reinforced Polymer (GFRP) bars for the prestressing of precast High Performance Concrete (HPC) sheet piles. The use of prestressing combined with composite reinforcing bars could be a good solution in all those cases where the attention of the design is focus on durability, structural lightness, speed of execution, sustainability, economic savings due to the reduction of the structure maintenance. In order to evaluate the potentiality and feasibility of the proposed technique, full-scale experimental tests on sheet piles are carried out at the Laboratory of the University of Rome Tor Vergata. A suitable design and check procedure is also applied and discussed. \textcopyright{} 2022 Elsevier Ltd},
