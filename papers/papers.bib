  keywords      = {Application programs; Computer aided engineering; Computer architecture; Computer hardware; Control systems; Energy efficiency; Memory architecture; Power management; Supercomputers; Wave interference; Memory management; Minimax techniques; Power engineering computing; Power system management; Registers; Cache memory},
  type          = {Conference paper},
  publication_stage = {Final},
