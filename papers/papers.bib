@conference{Meddah200917,
  title         = {Shrinkage reducing effect of a combination of internal curing and shrinkage compensating agents on high-performance concrete},
  author        = {Meddah, Mohammed Seddik and Suzuki, M. and Sato, R.},
  year          = 2009,
  journal       = {American Concrete Institute, ACI Special Publication},
  number        = {261 Sp},
  pages         = {17--31},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-72849123964&partnerID=40&md5=189fc5e77c0cb812101384e83286975f},
  note          = {Cited by: 2},
  abstract      = {Water entraining agent using porous aggregate known as internal curing (IC) has become an important component of high-performance concrete (HPC). This paper presents part of the experimental results of an on-going research project regarding the effectiveness of porous ceramic waste aggregates called 'PorCera' (PC) as IC agent for high-performance structural concrete elements. Previous studies have proven the effectiveness of both the presoaked recycled porous ceramic coarse aggregate (PCCA) as an IC and shrinkage compensating agents in reducing autogenous shrinkage of HPC. The main purpose of this study is to investigate the synergistic effect of a combination of shrinkage compensating agents and the PorCera on silica fume HPC behavior. This hybrid curing technique includes a combination of shrinkage reducing agent (SRA), expansive additive (EA), and internal curing provided by the recycled PC. Its effect on compressive and split tensile strengths, autogenous shrinkage, and internal self-stress were investigated. Results indicate that HPC mixtures made with this hybrid curing system drastically reduce the amount of autogenous shrinkage, and consequently the induced internal stress and perform much betterthan the single incorporation of shrinkage compensating agents.},
  author_keywords = {Autogenous shrinkage; Expansive additive; Induced stress; Internal curing; Porous ceramic aggregate; Shrinkage compensating agent; Silica fume high-performance concrete},
  keywords      = {Ceramic materials; Cochannel interference; Concrete aggregates; Curing; Oxides; Recycling; Shrinkage; Silica; Silica fume; Sustainable development; Tensile strength; Autogenous shrinkage; High-performance concrete; Induced stress; Internal curing; Porous ceramic aggregate; Porous ceramics; Expansive concrete},
  type          = {Conference paper},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Meddah20233425,
  title         = {Design of a non-shrinking silica fume high-performance concrete with recycled ceramic tile aggregate},
  author        = {Meddah, Mohammed Seddik},
  year          = 2023,
  journal       = {Structural Concrete},
  volume        = 24,
  number        = 3,
  pages         = {3425--3442},
  doi           = {10.1002/suco.202200741},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85143497279&doi=10.1002%2Fsuco.202200741&partnerID=40&md5=fe85ff50c66bade5342ee9b6e10f2d3e},
  note          = {Cited by: 4},
  abstract      = {Internal curing (IC) process introduced via a water-entraining agent using lightweight and porous aggregate has become an essential component in designing high and ultra-high-performance concrete (HPC/UHPC). This paper presents experimental results demonstrating the effectiveness of using recycled ceramic tile aggregates (RCTA) derived from waste ceramic tiles as an IC agent for high-performance structural elements. Previous studies by the author have confirmed the efficiency of both the pre-saturated recycled porous ceramic coarse aggregate (RPCA) as an IC and shrinkage compensating agents in mitigating autogenous shrinkage and the induced internal self-stress in HPC mixtures. The main objective of this study is to investigate the effect of two different curing systems (internal curing using the waste ceramic aggregate combined with shrinkage compensating agents) on silica fume (SF) HPC behavior. The shrinkage compensating agents include a combination of shrinkage-reducing agent (R) and expansive additive (E). The influence of this combined ternary curing system on the mechanical properties, including compressive, flexural, and splitting tensile strengths, modulus of elasticity, autogenous shrinkage, and internal self-induced tensile stress, were investigated. The obtained results indicate a substantial reduction in the autogenous shrinkage strains magnitude and, consequently, the internal self-induced tensile stress in the HPC mixtures designed with these two curing systems. It was also found that this combination of the two curing systems resulting in a hybrid curing system, performs much better than the single incorporation of shrinkage-compensating agents. Besides, a long-term strengths improvement was recorded for mixtures designed with the RPCA. Incorporating recycled aggregate in the design and production of HPC could further promote concrete sustainability by reducing the amount of virgin extracted non-renewable minerals, reducing the energy required to extract and process natural aggregates and the CO<sub>2</sub> generated, and also reducing solid waste materials disposal. \textcopyright{} 2022 International Federation for Structural Concrete.},
  author_keywords = {autogenous shrinkage; expansive agent; induced self-stress; internal water curing; porous ceramic waste tile aggregate; shrinkage compensating agent; silica fume HPC},
  keywords      = {Concrete aggregates; Concrete mixtures; Curing; High performance concrete; Integrated circuits; Mixtures; Recycling; Silica fume; Tensile strength; Tensile stress; Waste disposal; Autogenous shrinkage; Ceramic waste; Expansive agents; Induced self-stress; Internal water curing; Porous ceramic waste tile aggregate; Porous ceramics; Self-stresses; Shrinkage compensating agent; Silicum fume HPC; Shrinkage},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Meech200372,
  title         = {CERM3 and its contribution to providing sustainable research for the mining industry},
  author        = {Meech, John A. and Scoble, Malcolm and Wilson, Ward and Pakalnis, Rimas and Klein, Bern and Veiga, Marcello and Hall, Robert and Ghomshei, Mory and Baldwin, Susan and Lavkulich, Leslie and Suttle, Curtis and Mortensen, James and Weis, Dominique and Smith, Leslie and Hall, Kenneth and Dixon, David and Tromans, Desmond and Dreisinger, David and Dunbar, Scott and Pawlik, Marek and Morin, Mario and Cullen, William and Teschke, Kay and Gibson, Ginger and Ulansky, Ryan and Hinton, Jennifer and Wickland, Benjamin and Bissiri, Yassiah and Lang, Brennan},
  year          = 2003,
  journal       = {CIM Bulletin},
  volume        = 96,
  number        = 1067,
  pages         = {72--81},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-0242515841&partnerID=40&md5=124006788fb160fcc18dcebb0dd0c759},
  note          = {Cited by: 4},
  abstract      = {On July 26, 2000, the Canada Foundation for Innovation announced an award of .3 M) and the UBC Stewart Blusson Fund (\$0.7 M). Annual industrial grants and contracts are providing support funding for the on-going research projects. Corporate membership in CERM3 entitles each participant to a seat on the technical advisory committee (TAC) as well as access to the five laboratory facilities currently under construction. Both the federal and provincial governments will also participate in the TAC through NRCan-CANMET and the BC Ministry of Energy and Mines, respectively. CERM3's mission is: \textbullet{} to develop innovative methods to deal with environmental problems created by mining activity; \textbullet{} to promote sustainable development as a hallmark of management decision-making; to produce mining and processing engineers with the required environmental skills; and \textbullet{} to enhance the image of mining in society as a vibrant and necessary component of a modern economy and society which disturbs the environment for the benefit of mankind. CERM3 brings together a multi-disciplinary team of researchers from over 12 departments at The University of British Columbia (UBC) to work on mining-related environmental problems. These include: chemistry; soil sciences; chemical and biological engineering; earth and ocean sciences; microbiology; civil engineering; electrical engineering; metals and materials engineering; mechanical engineering; mining and mineral processing, the Westwater Research Centre; the Institute for Resources and the Environment; and the School of Occupational and Environmental Hygiene. The centre intends to interact with scientists from industry, governments and other universities across Canada and around the world. CERM3 aims to become Canada's leading environmental research facility for the mining industry. This paper describes the evolution of CERM3 and its coordinated multi-disciplinary approach to mining and the environment. Some of CERM3's research projects include: \textbullet{} developing new protocols for environmental analyses to provide consistent and reliable assays; \textbullet{} isolating a natural virus for Thiobacillus ferrooxidans and other bacteria responsible for acid rock drainage (ARD); \textbullet{} designing bio-remediation and adsorption techniques for mine effluents; \textbullet{} promoting and enhancing the use of hydrometallurgy to reduce environmental pollution; \textbullet{} examining new approaches to comminution to decrease energy consumption; \textbullet{} developing a magnetically levitated hoisting system to reduce the footprint of a mine operation; \textbullet{} building a state-of-the-art supercomputer network laboratory for mine/mill simulations; and \textbullet{} designing intelligent bulkheads to seal tunnels following mine closure to survive for 1000 years. This latter project involves the establishment of a research station at the Britannia mine site, 45 km north of Vancouver, which will provide a full-scale facility to design the "Millennium Plug" and contribute directly to the solution to one of North America's worst ARD-contaminated sites.},
  author_keywords = {Environmental research; Materials; Metals; Minerals; Mining; Sustainable development},
