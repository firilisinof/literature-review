@article{Varrette2020144,
  title         = {Automatic Software Tuning of Parallel Programs for Energy-Aware Executions},
  author        = {Varrette, S\'{e}bastien and Pinel, Fr\'{e}d\'{e}ric and Kieffer, Emmanuel and Danoy, Gr\'{e}goire and Bouvry, Pascal},
  year          = 2020,
  journal       = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
  volume        = {12044 Lncs},
  pages         = {144--155},
  doi           = {10.1007/978-3-030-43222-5_13},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85084000441&doi=10.1007%2F978-3-030-43222-5_13&partnerID=40&md5=e3b61ab6f626e7e7443bcafaee311912},
  note          = {Cited by: 3},
  abstract      = {For large scale systems, such as data centers, energy efficiency has proven to be key for reducing capital, operational expenses and environmental impact. Power drainage of a system is closely related to the type and characteristics of workload that the device is running. For this reason, this paper presents an automatic software tuning method for parallel program generation able to adapt and exploit the hardware features available on a target computing system such as an HPC facility or a cloud system in a better way than traditional compiler infrastructures. We propose a search based approach combining both exact methods and approximated heuristics evolving programs in order to find optimized configurations relying on an ever-increasing number of tunable knobs i.e., code transformation and execution options (such as the number of OpenMP threads and/or the CPU frequency settings). The main objective is to outperform the configurations generated by traditional compiling infrastructures for selected KPIs i.e., performance, energy and power usage (for both for the CPU and DRAM), as well as the runtime. First experimental results tied to the local optimization phase of the proposed framework are encouraging, demonstrating between 8\% and 41\% improvement for all considered metrics on a reference benchmarking application (i.e., Linpack). This brings novel perspectives for the global optimization step currently under investigation within the presented framework, with the ambition to pave the way toward automatic tuning of energy-aware applications beyond the performance of the current state-of-the-art compiler infrastructures. \textcopyright{} 2020, Springer Nature Switzerland AG.},
  author_keywords = {Automatic tuning; Compiler infrastructure; Energy efficiency; HPC; Hyper-parameter optimization; MOEA; Performance evaluation},
  keywords      = {Application programming interfaces (API); Automatic programming; Benchmarking; Cosine transforms; Energy efficiency; Environmental impact; Global optimization; Green computing; Heuristic methods; Large scale systems; Power management; Automatic tuning; Code transformation; Energy-aware applications; Frequency setting; Hardware features; Local optimizations; Operational expense; Optimized configuration; Program compilers},
  type          = {Conference paper},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Varshney2025,
  title         = {A walrus optimization algorithm for sustainable internet of robotic things based on Q-Learning},
  author        = {Varshney, Hirdesh and Singh, Avtar},
  year          = 2025,
  journal       = {Journal of Supercomputing},
  volume        = 81,
  number        = 15,
  doi           = {10.1007/s11227-025-07933-0},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105018808090&doi=10.1007%2Fs11227-025-07933-0&partnerID=40&md5=cd49c7fbf390d40e0da24276394bac6f},
  note          = {Cited by: 0},
  abstract      = {The Internet of Robotic Things (IoRT) integrates cloud robotics, artificial intelligence, and the Internet of Things to work collaboratively and is popularly employed in various autonomous systems. However, these devices often struggle to meet real-time applicability due to limited battery, low computational capability, and high latency, which necessitate high-performance computing and distributed architectures. Therefore, the present work develops an efficient task offloading mechanism by considering a multi-objective optimization approach to reduce energy consumption based on sampling rate, transmission interval, and data processing while achieving the deadline constraints and load balancing. The methodology is executed via fog computing to lower the communication overhead among edge devices and the cloud. Further, the Q-learning approach is integrated with the walrus optimization algorithm to develop QWaOA. This integration helps improve the balance between exploration–exploitation by incorporating the intelligence of reinforcement learning. The effectiveness of the proposed work is confirmed by simulations, which show that the proposed strategy reduces the energy requirements by at least 27.14\% compared to existing methods. The experimental findings validate the proposed schema compared to other existing approaches in enhancing the performance of IoRT devices. \textcopyright{} The Author(s), under exclusive licence to Springer Science+Business Media, LLC, part of Springer Nature 2025.},
  author_keywords = {Cloud robotics; Energy optimization; Internet of robotic things; Load balancing; Multi-objective optimization; Task offloading},
  keywords      = {Computer architecture; Edge computing; Energy utilization; Green computing; Intelligent robots; Internet of things; Learning algorithms; Multiobjective optimization; Reinforcement learning; Cloud robotics; Computational capability; Energy optimization; Internet of robotic thing; Load-Balancing; Multi-objectives optimization; Optimization algorithms; Q-learning; Real- time; Task offloading; Resource allocation},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Vasquez-Capacho2025,
  title         = {Modeling the road to decarbonization: A high-performance computing approach to electric mobility scenarios in Colombian cities},
  author        = {V\'{a}squez-Capacho, John W. and Chac\'{o}n-Velasco, Jorge L.},
  year          = 2025,
  journal       = {Sustainable Cities and Society},
  volume        = 131,
  doi           = {10.1016/j.scs.2025.106745},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105013741680&doi=10.1016%2Fj.scs.2025.106745&partnerID=40&md5=55e4a7075faa007d9cf826c7639d3d7d},
  note          = {Cited by: 0},
  abstract      = {This study presents a computational framework for modeling electric vehicle (EV) adoption and infrastructure requirements in Colombian cities, using high-performance computing (HPC) resources to simulate multiple growth scenarios through 2040. Leveraging a set of algorithmic models, we estimate EV fleet expansion, charging infrastructure needs, and environmental impacts under compound annual growth rates (CAGR) of 10 \%, 14 \%, and 18 \%. Our baseline scenario projects a national fleet of over 85,000 EVs by 2028 and approximately 98,000 by 2040. Bucaramanga serves as a mid-sized urban case study to explore regional dynamics in infrastructure deployment and public transport electrification. Results suggest that policy incentives, coordinated infrastructure investment, and localized manufacturing can significantly influence sustainable transport adoption. While tailored to Colombia's context, the framework is adaptable to other Latin American settings. Limitations include the static treatment of grid emissions and a lack of empirical model validation, which are noted for future work. This original research contributes to sustainable urban mobility planning by combining policy analysis, spatial modeling, and parallel simulation techniques within a replicable and data-driven architecture. \textcopyright{} 2025},
  author_keywords = {Electric vehicle adoption; Policy frameworks; Public transport electrification; Sustainable cities; Urban transport decarbonization},
  keywords      = {Bucaramanga; Colombia; Santander [Colombia]; Electric utilities; Electric vehicles; Electrification; Environmental impact; Fleet operations; Investments; Mass transportation; Public policy; Sustainable city; Sustainable development; Vehicle to infrastructure; Colombians; Decarbonisation; Electric vehicle adoption; Performance computing; Policy framework; Public transport; Public transport electrification; Sustainable cities; Urban transport; Urban transport decarbonization; carbon emission; electric vehicle; electrification; mobility; public transport; road; sustainability; technology adoption; urban planning; urban policy; Urban transportation},
  type          = {Article},
