@inproceedings{10993943,
  title         = {High Performance Simulation of Spaceborne Radar for Remote-Sensing Oceanography: Application to an Altimetry Scenario},
  author        = {Monnier, Goulven and Camus, Benjamin and Hellouvry, Yann-Herv\'{e}},
  year          = 2024,
  month         = {Oct},
  booktitle     = {2024 International Radar Conference (RADAR)},
  pages         = {1--6},
  doi           = {10.1109/radar58436.2024.10993943},
  abstract      = {In this paper, we detail the high-performance implementation of our spaceborne radar simulator for satellite oceanography. Our software simulates the sea surface and the signal to imitate, as far as possible, the measurement process, starting from its lowest level mechanisms. In this perspective, raw data are computed as the sum of many illuminated scatterers, whose time-evolving properties are related to the surface roughness, topography, and kinematics. To achieve efficient performance, we intensively use GPU computing. Moreover, we propose a fast simulation mode based on the assumption that the instantaneous Doppler spectrum within a range gate varies on a timescale significantly larger than the PRI. The sea surface can then be updated at a frequency much smaller than the PRF, drastically reducing the computational cost. When the surface is updated, Doppler spectra are computed for all range gates. Signals segments are then obtained through 1D inverse Fourier transforms and pondered to ensure a smooth time evolution between surface updates. We validate this fast simulation mode with a radar altimeter simulation case of the Sentinel-3 SRAL instrument, showing that simulated raw data can be focused and retrieved using state-of-the-art algorithms. Finally, we show that, using a modest hardware configuration, our simulator can generate enough data in one day to compute the SWH and SSH spectra of a scene. This demonstrate that we achieved an important state-of-the-art speed-up.},
  keywords      = {Sea surface;Radar remote sensing;Spaceborne radar;Surface roughness;Surface topography;Rough surfaces;Oceanography;Altimetry;Surface treatment;Remote sensing;radar;simulation;SAR;altimetry;high-performance computing;focusing}
}
@inproceedings{11002872,
  title         = {Advancements in IC Substrate Packaging: A Process to Metallize Embedded Trench for Enhanced Performance and Sustainability},
  author        = {Dharmarathna, Saminda and Zhang, Fengqi and Sy, Maddux and Chu, Howard and Kim, Leslie and Gokey, Brian and Long, Ernie},
  year          = 2025,
  month         = {April},
  booktitle     = {2025 International Conference on Electronics Packaging and iMAPS All Asia Conference (ICEP-IAAC)},
  pages         = {221--222},
  doi           = {10.23919/icep-iaac64884.2025.11002872},
  abstract      = {As we navigate the evolving landscape of electronics miniaturization, the role of high-yield, cost-effective integrated circuit (IC) substrates becomes increasingly pivotal. These substrates are essential for facilitating dense interconnections between chips and boards. Central to optimizing the use of substrate space is the reduction of the distance between copper (Cu) traces, also referred to as line and space (L/S). Whereas traditional PCB technology typically features L/S dimensions greater than 40 \mathrm{\mu}m, cutting-edge wafer-level technologies have achieved L/S ratios as fine as 2 \mathrm{\mu}m, Over the last ten years, the dimensions of chips and their associated L/S on substrates have significantly contracted. This trend towards smaller chip sizes and reduced L/S distances presents unique challenges to both the PCB and semiconductor industries. Fan-out panel-level packaging (FOPLP) represents a burgeoning technology that aims to merge the realms of PCB and IC/semiconductor manufacturing more closely. Although still in its nascent stages, the potential for high-volume production in this sector offers substantial economic incentives for pioneering innovative solutions that facilitate technology adoption. A critical quality metric in this area is the uniformity of plating, or planarity, which ensures the flatness of trace and via tops--key in multilayer processes where deviations in lower layers can propagate upwards, potentially leading to severe failures like short circuits. Moreover, a non-planar surface can degrade signal transmission, emphasizing the need for plating solutions that achieve consistent, planar results without necessitating additional post-treatment steps. We introduce a cutting-edge process for embedded trench substrate (ETS) that ensures remarkably uniform plating and precision in right-angle patterns, crucial for high-speed data transfers and enhanced device reliability. Our process achieves a significant uniformity with less than 1 \mathrm{\mu}m variation across components, enhancing yield and component integrity. By delivering a coplanar surface and robust square trace profiles, this method eliminates the need for subsequent polishing steps, streamlining production and improving the durability of the final products.},
  keywords      = {Technological innovation;Process control;Production;Packaging;Plating;Aerospace electronics;Sustainable development;Substrates;Surface treatment;Standards;Advanced Packaging;IC Substrates;Embedded Trench;Uniformity;Interconnect}
}
