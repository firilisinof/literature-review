@article{Fischer2021,
  title         = {Seismic-scale finite element stress modeling of the subsurface},
  author        = {Fischer, Karsten and Pearce, Andrew and Garcia-Teijeiro, Xavier and Mallinson, Andrew and Lloyd, Ian and Anderson, Stephen and Gomez, Francisco and Kisra, Saad and Rodriguez-Herrera, Adrian},
  year          = 2021,
  journal       = {Geomechanics for Energy and the Environment},
  volume        = 28,
  doi           = {10.1016/j.gete.2021.100245},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85104938294&doi=10.1016%2Fj.gete.2021.100245&partnerID=40&md5=794598364d41747bfd2734044ec1b73c},
  note          = {Cited by: 8; All Open Access; Hybrid Gold Open Access},
  abstract      = {The stress field in rock formations of the subsurface is a key element to understand for the planning of underground operations in a safe and sustainable way. Such operations include the drilling of wells, hydrocarbon production, fluid injection for enhanced oil recovery and CO<sub>2</sub> storage, hydraulic stimulation for unconventional resources, geothermal reservoirs, and many more. Modeling the subsurface stress field using 3D finite element (FE) simulations is common practice in the oil and gas and other industries. It allows to understand the prevailing in-situ stress and changes in terms of stress, deformation and rock failure that could result from planned operations. Such modeling is thus key to guide safe subsurface operations of many types and it is paramount that all available data and known complexity is captured in the highest possible resolution in these models. This results in a continuous quest for larger numerical simulations, which in turn demand software and linear solver technology to keep pace and ensure those do not become a limiting factor for computing the in-situ stress field. In this study, a FE simulator for 3D geomechanical modeling is optimized in multiple aspects to efficiently solve high resolution numerical stress simulations on large scales consisting of hundreds of millions of elements. This capability is demonstrated using a real-world dataset from the Gulf of Mexico to generate multiple geomechanical models from 500 million to over 1 billion elements. The models include fully heterogeneous material distributions and are built directly from seismic inversion data following a new direct modeling workflow that significantly facilitated pre and postprocessing. Using state-of-the-art high-performance compute (HPC) infrastructure, such models can be solved in less than 4 h with more than 3000 processors by applying hybrid parallelization methods. This demonstrates feasible turnaround times for such large stress simulations that enable geomechanical investigations in sufficient detail to improve the safety and sustainability of subsurface operations. \textcopyright{} 2021 The Author(s)},
  author_keywords = {3D seismic to numerical​ simulation; Advances in numerical simulation; Billion element model; High-performance computing; Large-scale stress simulation},
  keywords      = {Atlantic Ocean; Gulf of Mexico; Digital storage; Enhanced recovery; Finite element method; Geomechanics; Geothermal fields; Injection (oil wells); Resource valuation; Seismology; Stresses; Sustainable development; 3-D seismics; 3d seismic to numerical​ simulation; Advance in numerical simulation; Billion element model; Element models; High-performance computing; Large-scale stress simulation; Large-scales; Performance computing; Scale stress; Stresses simulation; data processing; drilling; effective stress; enhanced oil recovery; finite element method; fluid injection; geothermal engineering; in situ stress; numerical model; rock mechanics; seismicity; subsurface flow; Numerical models},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Fleming200722,
  title         = {Community capacity building for health promotion: Lessons from a Regional Australian Initiative},
  author        = {Fleming, Mary-Louise and Higgins, Helen and Owen, Neville and Clavarino, Alexandra and Brown, Wendy and Lloyd, Jacqui and Gould, Trish},
  year          = 2007,
  journal       = {Australian Journal of Primary Health},
  volume        = 13,
