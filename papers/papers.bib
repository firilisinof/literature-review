  author        = {Mongelli, Marialuisa and Bellagamba, Irene and Iannone, Francesco and Bracco, Giovanni},
  year          = 2018,
  journal       = {International Journal of Masonry Research and Innovation},
  volume        = 3,
  number        = 3,
