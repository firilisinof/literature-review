}
@conference{Wang20043231,
  title         = {A configurable Mu itiprocessor and dynamic load balancing for parallel LU factorization},
  author        = {Wang, Xiaofang and Ziavras, Sotirios G.},
  year          = 2004,
  journal       = {Proceedings - International Parallel and Distributed Processing Symposium, IPDPS 2004 (Abstracts and CD-ROM)},
  volume        = 18,
