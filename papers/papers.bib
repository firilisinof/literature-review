@article{Sabbrojjaman2024,
  title         = {A comparative review on the utilisation of recycled waste glass, ceramic and rubber as fine aggregate on high performance concrete: Mechanical and durability properties},
  author        = {Sabbrojjaman, Md and Liu, Yue and Tafsirojjaman, T.},
  year          = 2024,
  journal       = {Developments in the Built Environment},
  volume        = 17,
  doi           = {10.1016/j.dibe.2024.100371},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85186118369&doi=10.1016%2Fj.dibe.2024.100371&partnerID=40&md5=5611c2b8d3c32dd0745bc9107d28e8c9},
  note          = {Cited by: 68; All Open Access; Gold Open Access; Green Open Access},
  abstract      = {Waste materials are a major issue for environmental challenges, due to greenhouse gas emissions, reduce natural resources, demolition storage, and energy consumption and generate pollution. The growing concern for sustainable construction practices has increased interest in incorporating recycled materials into concrete production. Therefore, numerous research studies conducted to explore the feasibility of utilising waste glass, ceramic and rubber as recycled fine aggregates (RFA) in concrete. This review paper presents a comprehensive comparative review of the utilisation of recycled waste glass, ceramic, and rubber as fine aggregate (FA) in high-performance concrete (HPC), focusing on the mechanical properties such as modulus of elasticity, compressive strength, tensile strength, and flexural strength, as well as their impact on durability characteristics including workability, density, water absorption, drying shrinkage, and chloride-ion penetration. The utilisation of waste glass and waste ceramic as RFA in concrete demonstrated stable and improved mechanical and durability performance compared to waste rubber. Although, the incorporation of waste rubber as RFA showed a reduction in mechanical and durability performances, concrete containing a lower percentage of waste rubber as RFA still exhibited satisfactory mechanical performance. This evaluation indicates that RGC performs optimally when incorporating up to 30\% RFG, while RCC exhibits the best performance with a replacement of 50\% RFC. In contrast, RRC demonstrates optimal performance with a lower percentage of RFR, specifically less than 25\%. Therefore, proper mix design and optimisation are crucial for achieving desired concrete properties. However, there has not yet been a comprehensive comparative review concentrating on mechanical and durability properties aspects of waste glass, ceramic and rubber in HPC, particularly as fine aggregate. Therefore, the findings of this review provide insights into both the potential benefits and limitations of utilising these recycled materials in HPC. Additionally, this comprehensive comparative review can serve as a foundational reference for future research efforts and contribute to the development of more sustainable and environmentally friendly concrete solutions. \textcopyright{} 2024 The Authors},
  author_keywords = {Green concrete; Recycled fine ceramic; Recycled fine glass; Recycled fine rubber; Waste materials},
  keywords      = {Chlorine compounds; Compressive strength; Concrete aggregates; Density (specific gravity); Durability; Energy utilization; Gas emissions; Greenhouse gases; High performance concrete; Recycling; Rubber; Shrinkage; Sustainable development; Tensile strength; Water absorption; Fine ceramics; Glass-ceramics; Green concrete; High-performance concrete; Recycled fine aggregates; Recycled fine ceramic; Recycled fine glass; Recycled fine rubber; Waste glass; Waste rubber; Glass},
  type          = {Review},
  publication_stage = {Final},
  source        = {Scopus}
}
@book{Saber2025299,
  title         = {The Double- Edged Sword: Evaluating the Climate Impact of Speech Processing Technologies},
  author        = {Saber, Abeer and Elbedwehy, Samar and Hassan, Esraa and Emara, Tamer},
  year          = 2025,
  journal       = {Advancements in Speech Processing for Human-Computer Interaction},
  pages         = {299--331},
  doi           = {10.4018/979-8-3373-3048-8.ch010},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105024051733&doi=10.4018%2F979-8-3373-3048-8.ch010&partnerID=40&md5=183469f504873ef414fa2813878c724f},
  note          = {Cited by: 0},
  abstract      = {Speech artificial intelligence has become central to digital life, yet its carbonfootprint is substantial. Training large-scale models requires high-performance computing, driving electricity demand and greenhouse gas emissions. While inference is lighter per task, billions of daily interactions on smartphones, smart speakers, and call centers magnify energy use. Indirect impacts include data centers, global networking, and device manufacturing, contributing embodied carbon and e-waste, worsened by always-listening devices and raphardware turnover. Uneven renewable energy adoption across regions deepens inequalities. To align with the Sustainable Development Goals, sustainable speech processing advances lightweight architectures, pruning, quantization, and hardware-software co-optimization. Strategies such as green data centers, edge deployment, and lifecycle assessment reflect a circular economy perspective, framing responsible AI as vital for balancing innovation, accessibility, and environmental stewardship. \textcopyright{} 2026, IGI Global Scientific Publishing. All rights reserved.},
  keywords      = {Artificial life; Circular economy; Green computing; Greenhouse gas emissions; Life cycle; Life cycle assessment; Speech processing; Sustainable development; Wastes; Call centers; Climate impacts; Digital life; Electricity demands; Energy use; Greenhouse gas emissions; Large-scale modeling; Performance computing; Smart phones; Speech processing technologies; Greenhouse gases},
