  author        = {Afsary, Noor and Uddin, Md Nasir and Ishtiaq, A. K. M Naim and Alam, Md Koushik and Ali, Md Ashraf and Hoque, Karimul and Faruk Rasel, Md Omar},
  year          = 2025,
  journal       = {Physica B: Condensed Matter},
  volume        = 696,
  doi           = {10.1016/j.physb.2024.416645},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85207649040&doi=10.1016%2Fj.physb.2024.416645&partnerID=40&md5=5033a6ccd397b5ee100bf22453b38d3b},
  note          = {Cited by: 1},
  abstract      = {With the rapid development of telecommunication systems, supercomputers, and large data centers, there is a growing need for advanced photonic materials to overcome the limitations of traditional photonic circuitry. This paper introduces monoclinic TaPO<sub>5</sub>, an indirect-bandgap semiconductor material, as a compact platform for photonic integrated circuits. TaPO<sub>5</sub>, with a bandgap of 2.148 eV, is analyzed for its structural, vibrational, thermodynamic, and optical properties using pseudo-potential plane waves within the density functional theory (DFT) framework. Our analysis reveals that TaPO<sub>5</sub>'s thermodynamic properties, such as entropy, internal energy, and heat capacity, increase with temperature, while Helmholtz's free energy decreases. The materials demonstrate favorable optical characteristics, including a refractive index (n) of 2.11, an extinction coefficient (k) of 1.2 \texttimes{} 10⁻⁵, and a dielectric function with a real part of 4.45 and an imaginary part of 5.1 \texttimes{} 10⁻⁵ at a wavelength of 1.55 \ensuremath{\mu}m. TaPO<sub>5</sub> exhibits promising performance metrics for photonic applications. Specifically, a proposed 1 \texttimes{} 2 multimode interference (MMI) splitter demonstrates 0.03 dB excess loss, a compact footprint of 4 \texttimes{} 18 \ensuremath{\mu}m<sup>2</sup>, and a 50:50 splitting ratio at 1.55 \ensuremath{\mu}m. These findings indicate that TaPO<sub>5</sub> is a viable material for next-generation photonic integrated circuits, offering theoretical and practical advantages for various applications in photonic technology. \textcopyright{} 2024 Elsevier B.V.},
  author_keywords = {DFT calculation; First principles analysis; MMI splitter; Photonic integrated circuits; Photonic semiconductor material; Semiconductor material platform},
  keywords      = {Application specific integrated circuits; Carrier concentration; Density (optical); Energy gap; Optical beam splitters; Photonic devices; Photonic integration technology; Refractive index; Wide band gap semiconductors; Density-functional theory calculations; First principle analyze; First principles; Large data; Multimode interference splitters; Photonic circuitry; Photonic semiconductor material; Photonics Integrated Circuits; Principle analysis; Semiconductor material platform; Photonic integrated circuits},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
