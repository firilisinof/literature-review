}
@article{Srikanth2022,
  title         = {Effect of Nano Ground Granulated Blast Furnace Slag (GGBS) Volume \% on Mechanical Behaviour of High-Performance Sustainable Concrete},
  author        = {Srikanth, Seelam and Krishna, Chunchu Bala Rama and Srikanth, T. and Sai Nitesh, K.J.N. and Nadh, V. Swamy and Kumar, Sanjeev and Thanappan, Subash},
  year          = 2022,
