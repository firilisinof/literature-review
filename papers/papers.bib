  author        = {Li, Guoliang and Zheng, Xuezhe and Lexau, Jon and Luo, Ying and Thacker, Hiren and Pinguet, Thierry and Dong, Po and Feng, Dazeng and Liao, Shirong and Shafiiha, Roshanak and Asghari, Mehdi and Yao, Jin and Shi, Jing and Shubin, Ivan N. and Patil, Dinesh and Liu, Frankie and Raj, Kannan and Ho, Ron and Cunningham, John E. and Krishnamoorthy, Ashok V.},
  year          = 2010,
