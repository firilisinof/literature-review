}
@article{Solanki201621,
  title         = {Carbon footprints estimation of a novel environment-aware cloud architecture},
  author        = {Solanki, Neha and Purohit, Rajesh},
  year          = 2016,
  journal       = {Advances in Intelligent Systems and Computing},
  volume        = 438,
  pages         = {21--30},
  doi           = {10.1007/978-981-10-0767-5_3},
