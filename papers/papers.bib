  author        = {Xu, Yufeng and Ding, Xiaonan and Fang, Fang and Ma, Hua and Yang, Jixiang},
  year          = 2026,
  journal       = {Bioresource Technology},
  volume        = 445,
  doi           = {10.1016/j.biortech.2026.134132},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105030256771&doi=10.1016%2Fj.biortech.2026.134132&partnerID=40&md5=6c2c1ad1ce86cfbb59d8af6050351be1},
  note          = {Cited by: 0; All Open Access; Hybrid Gold Open Access},
  abstract      = {This study addressed the challenge of optimizing the continuous-flow Anaerobic–Oxic–Anoxic (AOA) process for treating low carbon-to-nitrogen ratio municipal wastewater in China. An activated sludge model was first established, which confirmed that the AOA process can be modeled, and the model results matched experimental discoveries well. Therefore, by integrating the activated sludge model with a differential evolution algorithm and supercomputing, an automated optimization framework was developed to efficiently identify optimal operational parameters. The framework successfully determined key conditions, including a hydraulic retention time of approximately 8~h (reducible to 5–6.5~h with supplementary filtration), sludge retention times of 18–22~days, and balanced reactor volume distributions favoring anoxic zones. Dynamic modeling validated the robustness of these strategies, confirming compliance with stringent effluent standards. The results demonstrate that data-driven optimization can significantly enhance process efficiency, reduce footprint, and lower operational costs. This approach can be applied to other bioprocesses, such as AAO, offering a transformative pathway for sustainable wastewater treatment. \textcopyright{} 2026 Elsevier Ltd. All rights are reserved, including those for text and data mining, AI training, and similar technologies.},
  author_keywords = {Activated sludge; AOA; Differential Evolution; Low C/N; Supercomputing},
  keywords      = {Algorithms; Anaerobiosis; Bioreactors; China; Nitrogen; Oxygen; Sewage; Wastewater; Water Purification; China; Activated sludge process; Data mining; Efficiency; Effluents; Evolutionary algorithms; Filtration; Optimization; Reclamation; Regulatory compliance; Supercomputers; carbon; nitrogen; organic matter; phosphate; nitrogen; oxygen; Activated sludge; Anaerobics; Anerobic–oxic–anoxic; Anoxic process; Differential Evolution; Higher efficiency; Low C/N; Optimisations; Sludge models; Supercomputing; activated sludge; algorithm; optimization; retention; wastewater treatment; activated sludge; anaerobic oxic anoxic; Article; bioprocess; controlled study; data mining; differential evolution algorithm; effluent; effluent standard; filtration; hydraulic retention time; municipal wastewater; nutrient concentration; process model; process optimization; solids retention time; suspended particulate matter; volume of distribution; waste water management; algorithm; anaerobic growth; bioreactor; chemistry; China; microbiology; procedures; sewage; wastewater; water management; Wastewater treatment},
