  year          = 2025,
  journal       = {New Journal of Chemistry},
  volume        = 49,
  number        = 27,
  pages         = {11614--11626},
  doi           = {10.1039/d5nj00314h},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105008725251&doi=10.1039%2Fd5nj00314h&partnerID=40&md5=57c180998ccca023ed972ca16b009299},
  note          = {Cited by: 1},
  abstract      = {The advancement of stimulus-responsive pesticide delivery systems offers a pivotal strategy for reconciling agricultural productivity with ecological sustainability. This study engineers a cellulose-functionalized vaterite calcium carbonate (CaCO<sub>3</sub>) nanoplatform (Pro\@CaCO<sub>3</sub>\@HPC, PCH) endowed with pH/cellulase dual-responsive intelligence for targeted prochloraz delivery. The hierarchically porous vaterite architecture facilitates superior drug loading (12.4\%, w/w), while demonstrating environmentally triggered release kinetics. Controlled liberation studies reveal 2.37-fold and 2.13-fold cumulative release enhancements under acidic conditions and cellulase exposure, respectively, compared to neutral environments--a response mechanism strategically aligned with the pathophysiological microenvironment of Sclerotinia sclerotiorum infection. The multifunctional nanoformulation exhibits threefold advantages: (1) enhanced antifungal performance, achieving 96.1\% mycelial inhibition at 1 \mathrm{\mu}g mL<sup>-1</sup> compared to conventional formulations (72.7\%); (2) reduced environmental footprint through 27.7\% decreased soil mobility relative to free prochloraz; (3) improved biosafety profiles, maintaining crop germination rates 13.3\% higher than commercial formulations while demonstrating attenuated cytotoxicity. This phytopathology-activated delivery system establishes a technological paradigm that synchronizes three critical agricultural requirements: pathogen-responsive precision, environmental persistence mitigation, and non-target organism protection. Therefore, this study provides an environmentally friendly, intelligent and efficient strategy, which shows great potential in the field of Sclerotinia sclerotiorum control. \textcopyright{} 2025 The Royal Society of Chemistry.},
  keywords      = {Calcium Carbonate; Cellulose; Delivery; Farm Crops; Folding Endurance; Fungicides; Ph; Release; Crops; Fungicides; calcium carbonate; cellulase; fungicide; hydroxypropylcellulose; prochloraz; A cellulose; Agricultural productivity; Calcium carbonate CaCO; Ecological sustainability; Environmentally safe; Functionalized; Pesticide delivery systems; Sclerotinia Sclerotiorum; Stimuli-responsive; Vaterite; Article; biosafety; contact angle; controlled study; cytotoxicity; environmental footprint; environmental impact; fungal plant disease; fungicidal activity; germination rate; in vitro study; in vivo study; leaching; microenvironment; mycelium; nonhuman; pH; plant disease; plant leaf; precipitation; Sclerotinia sclerotiorum; soil; synthesis; transmission electron microscopy; wettability; Calcium carbonate; Cellulose},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Cai2026,
  title         = {Towards green high-performance composite structures: Axial behavior of circular LC-HPC filled steel tubular stub columns},
  author        = {Cai, Heng and Zhang, Mingyuan and Yuan, Jianyi and Xu, Jianqiang},
  year          = 2026,
  journal       = {Journal of Building Engineering},
  volume        = 119,
  doi           = {10.1016/j.jobe.2026.115311},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105028262962&doi=10.1016%2Fj.jobe.2026.115311&partnerID=40&md5=6f5c5b43bf7bb878342d945524747e65},
  note          = {Cited by: 0},
  abstract      = {Low carbon high-performance concrete (LC-HPC) filled steel tube (LC-HPCFST) was a promising green high-performance composite structural form. To promote its practical application, a total of 16 LC-HPCFST stub columns and 2 ordinary Portland cement concrete (OPC) filled steel tube (OPCFST) stub columns were fabricated and tested under axial loading. The failure modes, axial load-shortening curves, and strain responses were comprehensively analyzed and discussed. On this basis, a mesoscale finite element (FE) model was established to reveal working mechanisms, and a simplified method for predicting bearing capacity was proposed. Finally, a comprehensive comparison and evaluation of carbon emissions and production costs for the composite columns were conducted. The test results indicated the steel tube and the infilled LC-HPC exhibited a good synergistic effect, with strength index (SI) ranging from 1.02 to 1.28 (0.318 \leq{} \ensuremath{\xi} \leq{} 0.746); the proposed calculation method could accurately predict the bearing capacities of LC-HPCFST columns. The utilization of LC-HPC can reduce the carbon emissions of the composite column by 35.4 \% compared to the infilled OPC, with comparable costs and without compromising bearing capacity. As the steel fiber content increased from 0.5 \% to 2 \%, the carbon emissions and production costs of the composite column increased by 25.1 \% and 22.4 \%, respectively. \textcopyright{} 2026 Elsevier Ltd},
  author_keywords = {Axial behavior; Bearing capacities; Carbon emission; LC-HPCFST; Mesoscale model},
  keywords      = {Axial loads; Beams and girders; Carbon; Columns (structural); Composite structures; Costs; High performance concrete; Low carbon steel; Steel fibers; Steel testing; Tubular steel structures; (LC-HPC) filled steel tube; Axial behavior; Carbon emissions; Composite column; High performance composites; High-performance concrete; Low carbon; Meso-scale modeling; Steel tube; Stub columns; Bearing capacity},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@conference{Calafiura2015,
  title         = {Running ATLAS workloads within massively parallel distributed applications using Athena Multi-Process framework (AthenaMP)},
  author        = {Calafiura, Paolo and Leggett, Charles and Seuster, Rolf and Tsulaia, Vakhtang and Van Gemmeren, Peter},
  year          = 2015,
  journal       = {Journal of Physics: Conference Series},
  volume        = 664,
  number        = 7,
  doi           = {10.1088/1742-6596/664/7/072050},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84961912380&doi=10.1088%2F1742-6596%2F664%2F7%2F072050&partnerID=40&md5=6a35f7818ee9f26396ee821877ed6d27},
  note          = {Cited by: 17; All Open Access; Gold Open Access; Green Open Access},
  abstract      = {AthenaMP is a multi-process version of the ATLAS reconstruction, simulation and data analysis framework Athena. By leveraging Linux fork and copy-on-write mechanisms, it allows for sharing of memory pages between event processors running on the same compute node with little to no change in the application code. Originally targeted to optimize the memory footprint of reconstruction jobs, AthenaMP has demonstrated that it can reduce the memory usage of certain configurations of ATLAS production jobs by a factor of 2. AthenaMP has also evolved to become the parallel event-processing core of the recently developed ATLAS infrastructure for fine-grained event processing (Event Service) which allows the running of AthenaMP inside massively parallel distributed applications on hundreds of compute nodes simultaneously. We present the architecture of AthenaMP, various strategies implemented by AthenaMP for scheduling workload to worker processes (for example: Shared Event Queue and Shared Distributor of Event Tokens) and the usage of AthenaMP in the diversity of ATLAS event processing workloads on various computing resources: Grid, opportunistic resources and HPC. \textcopyright{} Published under licence by IOP Publishing Ltd.},
  keywords      = {Computer operating systems; Analysis frameworks; Application codes; Computing resource; Event Processing; Event processors; Massively parallels; Memory footprint; Multi-Processes; High energy physics},
  type          = {Conference paper},
  publication_stage = {Final},
  source        = {Scopus}
}
@conference{Calafiura2015_2,
  title         = {The ATLAS event service: A new approach to event processing},
  author        = {Calafiura, P. and De, K. and Guan, W. and Maeno, T. and Nilsson, P. and Oleynik, D. and Panitkin, S. and Tsulaia, V. and Van Gemmeren, P. and Wenaus, T.},
  year          = 2015,
  journal       = {Journal of Physics: Conference Series},
  volume        = 664,
  number        = 6,
  doi           = {10.1088/1742-6596/664/6/062065},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84962287372&doi=10.1088%2F1742-6596%2F664%2F6%2F062065&partnerID=40&md5=1d1f0b7bdc01a908659cb042f0d3909c},
  note          = {Cited by: 18; All Open Access; Gold Open Access; Green Open Access},
  abstract      = {The ATLAS Event Service (ES) implements a new fine grained approach to HEP event processing, designed to be agile and efficient in exploiting transient, short-lived resources such as HPC hole-filling, spot market commercial clouds, and volunteer computing. Input and output control and data flows, bookkeeping, monitoring, and data storage are all managed at the event level in an implementation capable of supporting ATLAS-scale distributed processing throughputs (about 4M CPU-hours/day). Input data flows utilize remote data repositories with no data locality or pre-staging requirements, minimizing the use of costly storage in favor of strongly leveraging powerful networks. Object stores provide a highly scalable means of remotely storing the quasi-continuous, fine grained outputs that give ES based applications a very light data footprint on a processing resource, and ensure negligible losses should the resource suddenly vanish. We will describe the motivations for the ES system, its unique features and capabilities, its architecture and the highly scalable tools and technologies employed in its implementation, and its applications in ATLAS processing on HPCs, commercial cloud resources, volunteer computing, and grid resources. Notice: This manuscript has been authored by employees of Brookhaven Science Associates, LLC under Contract No. DE-AC02-98CH10886 with the U.S. Department of Energy. The publisher by accepting the manuscript for publication acknowledges that the United States Government retains a non-exclusive, paid-up, irrevocable, world-wide license to publish or reproduce the published form of this manuscript, or allow others to do so, for United States Government purposes.},
  keywords      = {Data transfer; Digital storage; High energy physics; Middleware; Software design; Software engineering; Distributed processing; Event Processing; Input and outputs; ITS applications; Processing resources; Tools and technologies; U.S. Department of Energy; Volunteer computing; Distributed computer systems},
  type          = {Conference paper},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Calderon-Loor2023,
  title         = {Integrated high-resolution, continental-scale land change forecasting},
  author        = {Calder\'{o}n-Loor, Marco and Hadjikakou, Michalis and Hewitt, Richard and Marcos-Martinez, Raymundo and Bryan, Brett A.},
  year          = 2023,
  journal       = {Environmental Modelling and Software},
  volume        = 166,
  doi           = {10.1016/j.envsoft.2023.105749},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85160817804&doi=10.1016%2Fj.envsoft.2023.105749&partnerID=40&md5=1f9902d781615d19f4f3ad5f8982d3c2},
  note          = {Cited by: 6; All Open Access; Hybrid Gold Open Access},
  abstract      = {Predicting future land change is crucial in anticipating societal and environmental impacts and informing responses at different scales. We designed an integrated, high-resolution, land-change model and forecasted Australia's land change for the years 2020, 2025 and 2030 for Cropland, Forest, Grassland, and Built-up land-uses using cloud-based and high-performance computing. A spatially explicit set of drivers was fed into a random forest classifier to generate 30-m per-class suitability layers for the country, which were then used for allocating land-use. The model was validated against 2015 data, then land-use was projected until 2030. Accuracy at the national level was \sim{}94\%. Forecasts showed increases in Grassland and Built-up areas and decreases in Forest and Cropland. Our modelling framework expands the current capabilities of large-scale land-change models and provides a first-of-its-kind multiclass land forecast for Australia that can inform land policy at multiple scales in Australia. \textcopyright{} 2023 The Authors},
  author_keywords = {Forecast; Google earth engine; Integrated model; Land-use change; Random forest},
  keywords      = {Australia; Environmental impact; Forecasting; Forestry; Australia; Forecast; Google earth engine; Google earths; High resolution; Integrated modeling; Land change modeling; Land changes; Landuse change; Random forests; agricultural land; environmental impact; forest; land use change; model; modeling; Land use},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Camerini202233,
  title         = {The kinetic of calcium silicate hydrate formation from silica and calcium hydroxide nanoparticles},
  author        = {Camerini, Rachel and Poggi, Giovanna and Ridi, Francesca and Baglioni, Piero},
  year          = 2022,
  journal       = {Journal of Colloid and Interface Science},
  volume        = 605,
  pages         = {33--43},
  doi           = {10.1016/j.jcis.2021.06.168},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85111079348&doi=10.1016%2Fj.jcis.2021.06.168&partnerID=40&md5=e1abbff862cf9369d3dc4b90a4215d02},
  note          = {Cited by: 35; All Open Access; Green Open Access},
  abstract      = {Hypothesis: The mechanism of calcium silicate hydrate (CSH) formation, a relevant component of cement, the largest used material by mankind, is well documented. However, the effects of nano-sized materials on the CSH formation have not yet been evaluated. To this aim, a kinetic study on CSH formation via the ``pozzolanic reaction'' of nanosilica and calcium hydroxide nanoparticles, and in the presence of hydroxypropyl cellulose (HPC) as hydration regulator, is reported in this paper. Experiments: The reagents were mixed with water and cured at 10, 20, 30 and 40 \textdegree{}C. The reaction kinetics was studied with differential scanning calorimetry (DSC). A Boundary Nucleation and Growth model (BNGM) combined with a diffusion-limited model was used to analyze the data, yielding induction times, reaction rates, activation energies, nucleation and linear growth rates, and the related diffusion coefficients. Findings: The rate constants k<sub>B</sub> and k<sub>G</sub>, which are, respectively, the rate at which the nucleated boundary area transforms, and the rate at which the non-nucleated grains between the boundaries transform, increase with temperature. Their different temperature dependence accounts for the prevailing effect of nucleation over nuclei growth at progressively lower temperatures. The nucleation rate, I<sub>B</sub>, is strongly enhanced when using nanomaterials, while the linear growth rate, G, is limited by the tightly packed structure of the transforming matrix. HPC influences the kinetics between 10 and 30 \textdegree{}C; at 40 \textdegree{}C the temperature effect becomes predominant. HPC delays induction and acceleration periods, increases E<sub>a</sub>(k<sub>B</sub>), and enhances the reaction efficiency during the diffusion regime, by retaining and delivering water over the matrix, thus allowing a higher water consumption in the hydration reaction of CSH. \textcopyright{} 2021 Elsevier Inc.},
  author_keywords = {Boundary nucleation and growth model; Calcium hydroxide nanoparticles; Calcium silicate hydrate; Diffusion model; Hydration kinetics; Hydroxypropyl cellulose; Silica nanoparticles},
  keywords      = {Activation Energy; Calcium Hydroxide; Calcium Silicate; Crystallization; Diffusion; Hydrates; Calcium Compounds; Calcium Hydroxide; Kinetics; Materials Testing; Microscopy, Electron, Scanning; Nanoparticles; Silicates; Silicon Dioxide; X-Ray Diffraction; Activation energy; Calcium silicate; Crystallization; Differential scanning calorimetry; Diffusion; Hydrated lime; Hydrates; Hydration; Kinetics; Lime; Matrix algebra; Nanoparticles; Nucleation; Rate constants; Silica; Silicate minerals; Temperature distribution; calcium hydroxide; calcium silicate; nanoparticle; silica nanoparticle; calcium derivative; calcium silicate; silicate; silicon dioxide; Calcium silicate hydrate; Hydroxypropyl cellulose; Nanosized materials; Nucleation and growth model; Pozzolanic reaction; Reaction efficiency; Relevant components; Temperature dependence; Article; chemical reaction kinetics; chemical structure; depolymerization; differential scanning calorimetry; diffusion; fluid intake; Fourier transform infrared spectroscopy; growth rate; hydration; scanning electron microscopy; temperature dependence; temperature sensitivity; thermogravimetry; kinetics; materials testing; X ray diffraction; Growth rate},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
