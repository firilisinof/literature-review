@article{Leto2026,
  title         = {Variable-precision neuromorphic state space model for on-edge activity classification},
  author        = {Leto, Benedetto and Urgese, Gianvito and Macii, Enrico and Fra, Vittorio},
  year          = 2026,
  journal       = {Future Generation Computer Systems},
  volume        = 176,
  doi           = {10.1016/j.future.2025.108193},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105019739410&doi=10.1016%2Fj.future.2025.108193&partnerID=40&md5=fa7d58d6a7bc3717d80ac6d609da1b43},
  note          = {Cited by: 1; All Open Access; Hybrid Gold Open Access},
  abstract      = {Neuromorphic computing is rising as a promising paradigm for efficient AI, leveraging event-driven computation to achieve low-power and high-performance computing. Due to the real-time processing required by edge devices with minimal power consumption, optimizing neuromorphic models for on-edge applications can be crucial to address the issue of power efficiency and resource-constraint devices. This work explores the definition of a neuromorphic state space model and its deployment on non-dedicated hardware. Structured sparsity and quantization techniques are leveraged to enhance the model's efficiency. By compressing synaptic operations and memory footprint, we demonstrate how neuromorphic models can be adapted for on-edge deployment, ensuring low-latency and memory efficient inference. This study highlights the potential of neuromorphic models as a scalable solution for real-world embedded systems with limited resources. \textcopyright{} 2025 The Author(s). Published by Elsevier B.V. This is an open access article under the CC BY-NC-ND license. http://creativecommons.org/licenses/by-nc-nd/4.0/},
