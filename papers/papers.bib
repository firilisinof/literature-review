@article{Arellano-Archan201816934,
  title         = {Optimizing the Coverage Density of Functional Groups over SiO2 Nanoparticles: Toward High-Resistant and Low-Friction Hybrid Powder Coatings},
  author        = {Arellano-Arch\'{a}n, Edgar and Esneider Alcal\'{a}, Miguel and Vega-Becerra, Oscar E. and Lara-Ceniceros, Tania E. and Bonilla-Cruz, Jos\'{e}},
  year          = 2018,
  journal       = {ACS Omega},
  volume        = 3,
  number        = 12,
  pages         = {16934--16944},
  doi           = {10.1021/acsomega.8b01845},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85058284723&doi=10.1021%2Facsomega.8b01845&partnerID=40&md5=034373226f8ca91063b5987dc83bbaf7},
  note          = {Cited by: 13; All Open Access; Gold Open Access; Green Open Access},
  abstract      = {Hybrid powder coatings (HPC) with low friction and high hardness enhance the sliding speed and allow interlocking or meshing products to slide effortlessly within each other, saving energy. In automobiles, they decrease fuel consumption and greenhouse gas emission. In the present work, a new insight of the key role played by the coverage density of triethoxyphenylsilane (TPS) grafted to SiO<sub>2</sub> nanoparticles over the friction coefficient, hardness, elastic modulus, and roughness of HPC is presented for the first time. In all cases, a very low amount (0.1 wt \%) of functionalized or unfunctionalized SiO<sub>2</sub> nanoparticles were added to a powder-coating formulation based on polyester resin. HPC formulated with functionalized nanoparticles at a suitable coverage density (HPC-TPS3) exhibited significantly low friction coefficient (\ensuremath{\mu} = 0.12), strong wear resistance (under dry sliding conditions at 1 and 5 N of load), low roughness (R<sub>q</sub> = 3.5 nm), and high hardness and elastic modulus on the surface. We demonstrated that it is possible to tune the macroscopic properties by varying only the coverage density of TPS that is chemically attached to SiO<sub>2</sub> nanoparticles. Also, a physicochemical explanation was disclosed, wherein a hydrophilic-hydrophobic balance between -OH and phenyl groups was proposed. In all cases, the phenyl group allows the migration of functionalized nanoparticles through the polyester matrix, enhancing the hardness and elastic modulus on the surface. Thus, the functional nanomaterial design with tunable coverage density is a powerful tool to improve the physical and superficial properties of powder coatings using low amounts of nanomaterial. Copyright \textcopyright{} 2018 American Chemical Society.},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@conference{Arnold1999,
  title         = {Successful pilot of thermosyphon process heater reduces GHG emissions and operating costs},
  author        = {Arnold, W.A. and Neulander, J.I.},
  year          = 1999,
  journal       = {Annual Technical Meeting 1999, ATM 1999},
  doi           = {10.2523/54107-ms},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85087227105&doi=10.2523%2F54107-ms&partnerID=40&md5=ee27021b081a2ba4432db65d1536eadd},
  note          = {Cited by: 0},
  abstract      = {PanCanadian originally pursued thermosyphon technology to lower operating costs. However, it is now apparent that a more significant benefit is reduction of greenhouse gas (GHG) emissions. Other benefits include loss management, increased safety, improved operability and maintenance cost reduction. A prototype Thermflo<sup>TM</sup> thermosyphon process heater was developed by Hudson Products Corporation (HPC) as a joint effort with PanCanadian Petroleum Ltd. The unit was installed in a 320 m<sup>3</sup> atmospheric heavy oil tank in northeastern Alberta in November '97. Performance testing was carried out over the next several months and evaluated using API Standards \& Recommended Practices. The testing was carried out in two phases. In phase one, we compared the performance of the thermosyphon to a naturally drafted venturi style nozzle burner in a firetube located in an adjacent tank. Both units were fired using sales utility gas. Increased combustion efficiency and improved heat transfer reduced fuel gas consumption by 33\% and cut GHG emissions by 40\%. In phase two of the testing, the prototype successfully burned solution gas normally vented to atmosphere. This translates to an annual operating cost saving of about \$40,000 and GHG emission reduction of about 10,000 tonnes per year. \textcopyright{} 1999 Petroleum Society of Canada (PETSOC). All rights reserved.},
  keywords      = {Capillary flow; Crude oil; Emission control; Energy efficiency; Gas emissions; Gasoline; Greenhouse gases; Heat transfer; Heavy oil production; Oil tanks; Operating costs; Siphons; Thermosyphons; Annual operating costs; Combustion efficiencies; Increased safety; Lower operating costs; Maintenance cost; Performance testing; Recommended practice; Thermosyphon technology; Cost reduction},
  type          = {Conference paper},
  publication_stage = {Final},
  source        = {Scopus}
}
@conference{Arora2019687,
  title         = {Understanding the impact of socket density in density optimized servers},
  author        = {Arora, Manish and Skach, Matt and Huang, Wei and An, Xudong and Mars, Jason and Tang, Lingjia and Tullsen, Dean M.},
  year          = 2019,
  journal       = {Proceedings - 25th IEEE International Symposium on High Performance Computer Architecture, HPCA 2019},
  pages         = {687--700},
  doi           = {10.1109/hpca.2019.00066},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85064225541&doi=10.1109%2FHPCA.2019.00066&partnerID=40&md5=e0f67a7ceab0536930170ed4ca5f7267},
  note          = {Cited by: 3; All Open Access; Green Open Access},
  abstract      = {The increasing demand for computational power has led to the creation and deployment of large-scale data centers. During the last few years, data centers have seen improvements aimed at increasing computational density-the amount of throughput that can be achieved within the allocated physical footprint. This need to pack more compute in the same physical space has led to density optimized server designs. Density optimized servers push compute density significantly beyond what can be achieved by blade servers by using innovative modular chassis based designs. This paper presents a comprehensive analysis of the impact of socket density on intra-server thermals and demonstrates that increased socket density inside the server leads to large temperature variations among sockets due to inter-socket thermal coupling. The paper shows that traditional chip-level and data center-level temperature-aware scheduling techniques do not work well for thermally-coupled sockets. The paper proposes new scheduling techniques that account for the thermals of the socket a task is scheduled on, as well as thermally coupled nearby sockets. The proposed mechanisms provide 2.5\% to 6.5\% performance improvements across various workloads and as much as 17\% over traditional temperature-aware schedulers for computation-heavy workloads. \textcopyright{} 2019 IEEE.},
  author_keywords = {Data center; Density Optimized Server; Scheduling; Server},
  keywords      = {Scheduling; Servers; Supercomputers; Comprehensive analysis; Computational density; Computational power; Data centers; Large temperature variations; Scheduling techniques; Temperature aware; Thermal coupling; Computer architecture},
  type          = {Conference paper},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Artioli2025,
  title         = {C6EnPLS: A High-Performance Computing Job Dataset for the Analysis of Linear Solvers' Power Consumption},
  author        = {Artioli, Marcello and Borghesi, Andrea and Chinnici, Marta and Ciampolini, Anna and Colonna, Michele and De Chiara, Davide and Loreti, Daniela},
  year          = 2025,
  journal       = {Future Internet},
  volume        = 17,
  number        = 5,
  doi           = {10.3390/fi17050203},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105006431146&doi=10.3390%2Ffi17050203&partnerID=40&md5=5adc0362e5ad3d8f09c716e528a89023},
  note          = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access},
  abstract      = {In recent decades, driven by global efforts towards sustainability, the priorities of HPC facilities have changed to include maximising energy efficiency besides computing performance. In this regard, a crucial open question is how to accurately predict the contribution of each parallel job to the system's energy consumption. Accurate estimations in this sense could offer an initial insight into the overall power requirements of the system, and provide meaningful information for, e.g., power-aware scheduling, load balancing, infrastructure design, etc. While ML-based attempts employing large training datasets of past executions may suffer from the high variability of HPC workloads, a more specific knowledge of the nature of the jobs can improve prediction accuracy. In this work, we restrict our attention to the rather pervasive task of linear system resolution. We propose a methodology to build a large dataset of runs (including the measurements coming from physical sensors deployed on a large HPC cluster), and we report a statistical analysis and preliminary evaluation of the efficacy of the obtained dataset when employed to train well-established ML methods aiming to predict the energy footprint of specific software. \textcopyright{} 2025 by the authors.},
  author_keywords = {high-performance computing; parallel linear solvers; power consumption dataset},
  keywords      = {Job shop scheduling; Computing performance; Energy; Energy-consumption; High-performance computing; Linear solver; Parallel jobs; Parallel linear solvers; Performance computing; Power; Power consumption dataset; Energy utilization},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@book{Arularasan2025467,
  title         = {Utilization of advanced IoT and high-performance computing for enhanced agricultural systems},
  author        = {Arularasan, A.N. and Kalaiyarasi, D. and Ashokkumar, P. and Suresh, K. and Rajasekar, M. and Rajendra Prasad, A.},
  year          = 2025,
  journal       = {Integrating Artificial Intelligence Into the Energy Sector},
