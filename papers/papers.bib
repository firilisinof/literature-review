@conference{Royuela2025,
  title         = {HiPART: High-Performance Technology for Advanced Real-Time Systems},
  author        = {Royuela, Sara and Munera, Adrian and Yu, Chenle and Pinot, Josep},
  year          = 2025,
  journal       = {OpenAccess Series in Informatics},
  volume        = 127,
  doi           = {10.4230/OASIcs.PARMA-DITAM.2025.6},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-86000253911&doi=10.4230%2FOASIcs.PARMA-DITAM.2025.6&partnerID=40&md5=8be2e31e887c0cbab57edea91c170a94},
  note          = {Cited by: 0},
  abstract      = {Cyber-physical systems (CPS) attempt to meet real-time and safety requirements by using hypervisors that provide isolation via virtualisation and Real-Time Operating Systems that manage the concurrency of system tasks. However, the operating system's (OS) decisions may hinder the efficiency of tasks because it needs more awareness of their specific intricacies. Hence, one critical limitation to efficiently developing CPSs is the lack of tailored parallel programming models that can harness the capabilities of advanced heterogeneous architectures while meeting the requirements integral to CPSs, such as real-time behaviour and safety requirements. While conventional HPC languages, like OpenMP and CUDA, cannot accommodate critical non-functional properties, safety languages, like Rust and Ada, are limited in their capabilities to exploit complex systems efficiently. On top of that, accessibility to the programming task is essential to making the system usable to different domain experts. HiPART tackles these challenges by developing a comprehensive framework holistically addressing efficiency, interoperability, reliability, and sustainability. The HiPART framework, based on OpenMP, provides tailored support for (1) real-time behaviour and safety requirements and (2) the efficient exploitation of advanced parallel and heterogeneous processor architectures. This support is exposed to users through extensions to the OpenMP specification and its implementation in the LLVM framework, including the compiler and the OpenMP runtime library. With this framework, HiPART will contribute to realising more capable and reliable autonomous systems across various domains, from autonomous mobility to space exploration.  \textcopyright{} Sara Royuela, Adrian Munera, Chenle Yu, and Josep Pinot.},
  author_keywords = {Adaptability; Cyber-physical systems; Efficiency; Interoperability; OpenMP; Parallel and heterogeneous architectures; Real-time; Reliability; Resilience},
  keywords      = {Ada (programming language); Interoperability; Problem oriented languages; Program compilers; Systems analysis; Adaptability; Cybe-physical systems; Cyber-physical systems; Heterogeneous architectures; Openmp; Parallel and heterogeneous architecture; Real time behavior; Real- time; Resilience; Safety requirements; Parallel architectures},
  type          = {Conference paper},
  publication_stage = {Final},
  source        = {Scopus}
}
@conference{Rozanec2025213,
  title         = {Learning anomalies from graph: predicting compute node failures on HPC clusters},
  author        = {Ro\v{z}anec, Jo\v{z}e M. and Krumpak, Roy and Molan, Martin and Bartolini, Andrea},
  year          = 2025,
  journal       = {Proceedings of Machine Learning Research},
