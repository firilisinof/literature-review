  source        = {Scopus}
}
@article{Janowska-Renkas2026,
  title         = {Application of an aggregated model to a decision-making process for evaluation of high performance concretes used for open-frame industrial structures},
  author        = {Janowska-Renkas, El\.{z}bieta and Fabianowski, Dariusz and Matyjaszczyk, Damian},
  year          = 2026,
  journal       = {Construction and Building Materials},
  volume        = 520,
  doi           = {10.1016/j.conbuildmat.2026.145932},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105033210706&doi=10.1016%2Fj.conbuildmat.2026.145932&partnerID=40&md5=2398da12c11a1e90c03f0ac267bc6f7b},
  note          = {Cited by: 0},
  abstract      = {Modern civil engineering design must consider multiple criteria such as structural safety, cost efficiency, and sustainability, which justifies the growing importance of multi-criteria decision-making methods. This study analysed 13 variants of concretes modified with silica fume (D), limestone powder of different fineness (MW1 G or MW2 D), and nanosilica (HI or HF). High-performance concrete (HPC) achieved compressive strength of 76.7–93.1 MPa, water absorption of 2.2–4.5\%, water penetration depth of 6–31 mm, and freeze–thaw resistance class F100. To evaluate the variants, hybrid models combining Analytic Hierarchy Process(AHP) + Zero Unitarization Method (ZUM) and AHP + Hellwig's method were applied. The consistency of results was confirmed by the Spearman rank correlation coefficient (r = 0.9505), indicating variants V6 and V10 as optimal. The novelty of this study lies in applying hybrid models combining Multi Criteria Decision Analysis (MCDA) algorithms with taxonomic methods for a specific decision-making problem. In Hellwig's method, a different approach to the normalization of dimensional parameters was introduced, with ZUM applied as the normalization procedure. \textcopyright{} 2026 Elsevier Ltd.},
  author_keywords = {Chemical admixture; Decision Support System; Decision-making process; Hall structures; High-performance concrete; Hydrophilic and hydrophobic nanosilica; Limestone flour; Modified concrete; Optimisation; Silica fume},
  keywords      = {Analytic hierarchy process; Compressive strength; Concrete aggregates; Cost effectiveness; Cost engineering; Decision making; Hierarchical systems; High performance concrete; Lime; Limestone; Optimization; Structural design; Sustainable development; Water absorption; Chemical admixture; Decision supports; Decision-making process; Hall structure; High-performance concrete; Hydrophilic and hydrophobic; Hydrophilic and hydrophobic nanosilica; Limestone flour; Modified concrete; Nano Silica; Optimisations; Support systems; Decision support systems},
  type          = {Article},
