  author        = {Kachuma, Dickson and Hasanzade, Rasim and Tomin, Pavel and Thomadakis, Michael E. and Franc, Jacques and Magri, Victor A. P. and Byer, Thomas J. and Cusini, Matteo and Settgast, Randolph R. and Gross, Herve and Castelletto, Nicola},
  year          = 2026,
