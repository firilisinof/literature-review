@inproceedings{10.1145/3772052.3772241,
  title         = {GridGreen: Integrating Serverless Computing in HPC Systems for Performance and Sustainability},
  author        = {Samanta, Amit and Stutsman, Ryan and Roy, Rohan Basu},
  year          = 2026,
  booktitle     = {Proceedings of the 2025 ACM Symposium on Cloud Computing},
  publisher     = {Association for Computing Machinery},
  address       = {New York, NY, USA},
  series        = {SoCC '25},
  pages         = {388–401},
  doi           = {10.1145/3772052.3772241},
  isbn          = 9798400722769,
  url           = {https://doi.org/10.1145/3772052.3772241},
  abstract      = {We present GridGreen, a scheduling framework that improves the sustainability and performance of scientific workflow execution by integrating serverless computing with traditional on-premise high performance computing (HPC) clusters. GridGreen allocates workflow components across HPC and serverless environments leveraging spatio-temporal variation of carbon intensity and component execution characteristics. It incorporates component-level optimization, speculative pre-warming, I/O-aware data management, and fallback adaptation to jointly minimize carbon footprint and service time under user-defined cost constraints. Our evaluations on large-scale bioinformatics workflows across leadership-class HPC facilities and cloud-based serverless regions demonstrate that GridGreen achieves robust, cost-effective execution while improving carbon efficiency.},
  numpages      = 14,
  keywords      = {Cloud Computing, High Performance Computing, Serverless Computing, Carbon Footprint, Sustainability}
}
@inproceedings{10.1145/3772900.3772919,
  title         = {The Impact of Green Investment on Carbon Emission Intensity in a Dual-Carbon Context: An Empirical Study Based on Listed Companies},
  author        = {Liang, Yao},
  year          = 2026,
  booktitle     = {Proceedings of the 2025 International Conference on Information Economy, Data Modeling and Cloud Computing},
  publisher     = {Association for Computing Machinery},
  address       = {New York, NY, USA},
  series        = {Icidc '25},
  pages         = {117–121},
  doi           = {10.1145/3772900.3772919},
  isbn          = 9798400720963,
  url           = {https://doi.org/10.1145/3772900.3772919},
  abstract      = {This study constructs a multivariate regression model based on fixed-effects panel data, integrating mediation effect mechanisms and heterogeneity analysis, to explore the impact of green investment on carbon emission intensity using a sample of Chinese listed companies from 2015 to 2022. The research framework incorporates green investment intensity and control variables into the traditional environmental performance analysis, while leveraging advanced computer-based statistical programming and high-performance computing environments to implement data preprocessing, algorithmic modeling, and automated robustness and group regression tests, thereby enhancing causal identification. The empirical analysis, supported by automated regression algorithms and visualization tools, reveals that for every unit increase in green investment intensity, carbon emission intensity decreases by 0.256 on average, with a greater reduction observed in non-state-owned enterprises (0.284) compared to state-owned enterprises (0.187). The R\ensuremath{^2} of each model exceeds 0.29, confirming a moderate level of explanatory power and validating the robustness of the models, with statistical significance assessed through both p-values and computational diagnostics.},
  numpages      = 5,
  keywords      = {Carbon emission intensity, Green investment, Heterogeneity analysis, Regression model}
}
@inproceedings{10.1145/3774904.3793034,
  title         = {Online GPU Energy Optimization with Switching-Aware Bandits},
  author        = {Xu, Xiongxiao and Bekele, Solomon Abera and Videau, Brice and Shu, Kai},
  year          = 2026,
  booktitle     = {Proceedings of the ACM Web Conference 2026},
  location      = {United Arab Emirates},
  publisher     = {Association for Computing Machinery},
  address       = {New York, NY, USA},
  series        = {Www '26},
  pages         = {9211–9219},
  doi           = {10.1145/3774904.3793034},
  isbn          = 9798400723070,
  url           = {https://doi.org/10.1145/3774904.3793034},
  abstract      = {Energy consumption has become a bottleneck for future computing architectures, from wearable devices to leadership-class supercomputers. Existing energy management techniques largely target CPUs, even though GPUs now dominate power draw in heterogeneous high performance computing (HPC) systems. Moreover, many prior methods rely on either purely offline or hybrid offline and online training, which is impractical and results in energy inefficiencies during data collection. In this paper, we introduce a practical online GPU energy optimization problem in a HPC scenarios. The problem is challenging because (1) GPU frequency scaling exhibits performance–energy trade-offs, (2) online control must balance exploration and exploitation, and (3) frequent frequency switching incurs non-trivial overhead and degrades quality of service (QoS). To address the challenges, we formulate online GPU energy optimization as a multi-armed bandit problem and propose EnergyUCB, a lightweight UCB-based controller that dynamically adjusts GPU core frequency in real time to save energy. Specifically, EnergyUCB (1) defines a reward that jointly captures energy and performance using a core-to-uncore utilization ratio as a proxy for GPU throughput, (2) employs optimistic initialization and UCB-style confidence bonuses to accelerate learning from scratch, and (3) incorporates a switching-aware UCB index and a QoS-constrained variant that enforce explicit slowdown budgets while discouraging unnecessary frequency oscillations. Extensive experiments on real-world workloads from the world's third fastest supercomputer Aurora show that EnergyUCB achieves substantial energy savings with modest slowdown and that the QoS-constrained variant reliably respects user-specified performance budgets.},
  numpages      = 9,
  keywords      = {energy, sustainability, bandits, online learning, gpus}
}
@inproceedings{10.1145/3784828.3785157,
  title         = {System-Level Energy Profiling of Wafer-Scale AI Systems: Characterizing Non-Accelerator Overheads in the Cerebras CS-2 System},
  author        = {John, Jophin and Mak, Hoi-Fong and Hoffmann, Michael and Zhang, Alice and Patki, Tapasya and Hammer, Nicolay},
  year          = 2026,
  booktitle     = {Proceedings of the Supercomputing Asia and International Conference on High Performance Computing in Asia Pacific Region Workshops},
  publisher     = {Association for Computing Machinery},
  address       = {New York, NY, USA},
  series        = {SCA/HPCAsiaWS '26},
  pages         = {31–39},
  doi           = {10.1145/3784828.3785157},
  isbn          = 9798400723285,
  url           = {https://doi.org/10.1145/3784828.3785157},
  abstract      = {The escalating energy demands of large-scale artificial intelligence (AI) training highlight the need for a holistic understanding of power consumption across complete computing systems. This is particularly important for emerging wafer-scale architectures such as the Cerebras\&nbsp;CS-2, where energy usage extends beyond the Wafer-Scale Engine (WSE) to include supporting infrastructure such as management nodes that coordinate workflows, worker nodes responsible for data streaming, and MemoryX nodes that handle weight updates and parameter transfers. Conventional GPU-centric profiling approaches overlook these contributors, providing an incomplete view of total system efficiency. Leveraging administrative telemetry access to a dedicated CS-2 installation, this study presents a comprehensive end-to-end analysis of energy consumption across all major subsystems and computational phases. The results show that non-WSE components account for up to 10\% of total system energy and exhibit strong temporal coupling with the accelerator. These findings highlight the necessity of adopting a system-level perspective when evaluating energy efficiency in wafer-scale AI systems and motivate developing tools for fine-grained, phase-aware energy measurements to improve transparency and sustainability.},
  numpages      = 9,
  keywords      = {AI, Energy Efficiency, Wafer-Scale Computing, Cerebras CS-2, Energy Profiling, HPC, Sustainability.}
}
@inproceedings{10.1145/3784828.3785161,
  title         = {Harvesting energy consumption on European HPC systems: Sharing Experience from the CEEC project},
  author        = {Kulkarni, Kajol and Kemmler, Samuel and Schwartz, Anna and Gedik, G\"{u}l\c{c}in and Chen, Yanxiang and Papageorgiou, Dimitrios and Kavroulakis, Ioannis and Iakymchuk, Roman},
  year          = 2026,
  booktitle     = {Proceedings of the Supercomputing Asia and International Conference on High Performance Computing in Asia Pacific Region Workshops},
  publisher     = {Association for Computing Machinery},
  address       = {New York, NY, USA},
  series        = {SCA/HPCAsiaWS '26},
  pages         = {40–49},
  doi           = {10.1145/3784828.3785161},
  isbn          = 9798400723285,
  url           = {https://doi.org/10.1145/3784828.3785161},
  abstract      = {Energy efficiency has emerged as a central challenge for modern high-performance computing (HPC) systems, where escalating computational demands and architectural complexity have led to significant energy footprints. This paper presents the collective experience of the EuroHPC JU Center of Excellence in Exascale CFD (CEEC) in measuring, analyzing, and optimizing energy consumption across major European HPC systems. We briefly review key methodologies and tools for energy measurement as well as define metrics for reporting results. Through case studies using representative CFD applications (waLBerla, FLEXI/GAL\AE{}XI, Neko, and NekRS), we evaluate energy-to-solution and time-to-solution on diverse architectures, including CPU- and GPU-based partitions of LUMI, MareNostrum5, MeluXina, and JUWELS Booster. Our results highlight the advantages of accelerators and mixed-precision techniques for reducing energy consumption while maintaining computational accuracy. Finally, we advocate the need to facilitate energy measurements on HPC systems in order to raise awareness, teach the community, and take actions toward more sustainable exascale computing.},
  numpages      = 10,
  keywords      = {energy consumption, energy measurement, energy-to-solution, mixed-precision, HPC, CFD.}
}
@inproceedings{10.1145/3784828.3785163,
  title         = {Co-Design of a Power State-Aware Scheduler and an Intelligent Power Manager for Energy-Efficient HPC Systems},
  author        = {Prasasta, Raka Satya and Pradata, Santana Yuda and Santiyuda, Kadek Gemilang and Amrizal, Muhammad Alfian and Pulungan, Reza and Takizawa, Hiroyuki},
  year          = 2026,
  booktitle     = {Proceedings of the Supercomputing Asia and International Conference on High Performance Computing in Asia Pacific Region Workshops},
  publisher     = {Association for Computing Machinery},
  address       = {New York, NY, USA},
  series        = {SCA/HPCAsiaWS '26},
  pages         = {13–21},
  doi           = {10.1145/3784828.3785163},
  isbn          = 9798400723285,
  url           = {https://doi.org/10.1145/3784828.3785163},
  abstract      = {Power consumption is a major challenge in large-scale High Performance Computing systems, where idle nodes contribute to a significant portion of the overall system's power consumption. This highlights the need for effective power management strategies capable of deciding when and which nodes should be powered on or off. While simple timeout-based heuristics and more advanced Reinforcement Learning (RL)-based approaches have been explored to enable autonomous power control, existing designs are often not paired with power-state-aware schedulers, hindering their effectiveness. To address these issues, this research introduces a co-designed solution comprising the Power-State-Aware Scheduler (PSAS) and an Intelligent Power Manager (IPM), collectively referred to as PSAS+IPM. PSAS offers clean integration with external power policies by ensuring resource and power-state awareness, while IPM augments scheduling with predictive power control and energy-aware node selection to minimize delay and waste. Extensive simulation results show that PSAS+IPM outperforms both traditional timeout-based and RL-driven strategies. PSAS+IPM also exhibits greater stability and robustness across a wide range of hardware configurations, including varying power transition latencies, power consumption profiles, and system sizes. These findings highlight that tightly coupled scheduler-power manager co-design can yield greater efficiency than more complex but decoupled RL approaches, underscoring coordination as a key determinant of sustainable exascale computing.},
  numpages      = 9,
  keywords      = {High-Performance Computing, Power State Management, Heuristics, Reinforcement Learning, Energy Efficiency}
}
@inproceedings{10.1145/3784828.3785249,
  title         = {Exploring I/O Performance and Power Consumption Trade-offs in Production Environments},
  author        = {Zhu, Zhaobin and Henkel, Andreas and Neuwirth, Sarah},
  year          = 2026,
  booktitle     = {Proceedings of the Supercomputing Asia and International Conference on High Performance Computing in Asia Pacific Region Workshops},
  publisher     = {Association for Computing Machinery},
  address       = {New York, NY, USA},
  series        = {SCA/HPCAsiaWS '26},
  pages         = {399–406},
  doi           = {10.1145/3784828.3785249},
  isbn          = 9798400723285,
  url           = {https://doi.org/10.1145/3784828.3785249},
  abstract      = {Energy efficiency in high-performance computing (HPC) has become increasingly critical as data movement and storage now often rival, or exceed, computation in energy cost. While FLOPS-per-watt has been extensively studied, I/O-related energy consumption remains poorly characterized, in part due to the lack of job-level attribution mechanisms. To address this gap, we investigate how node-local storage can improve I/O energy efficiency by evaluating BeeOND, a node-local, on-demand burst buffer, and by developing a methodology to accurately attribute the energy consumption of Lustre, a shared parallel file system, to individual jobs. By introducing a node-local storage-based execution model, our approach enables precise and transparent measurement of I/O energy consumption at the job level. Using this methodology, we show that BeeOND reduces job-level I/O energy consumption by approximately 72\% compared to Lustre, while increasing IO500 scores by about 45\%. These gains are particularly notable for metadata-intensive workloads, where IOPS nearly double. We further demonstrate that BeeOND integrates seamlessly with Slurm through a SPANK plugin that provisions temporary storage exclusively on nodes allocated to a job, enabling flexible scaling of I/O resources without additional configuration overhead. Overall, our results show that node-local storage can substantially improve both energy efficiency and performance for I/O-intensive workloads in production HPC environments.},
  numpages      = 8,
  keywords      = {HPC, Production Environments, Sustainability, Data Movement, I/O Performance, Power Consumption, I/O Energy Efficiency, Burst Buffers, Node-local Storage, BeeOND, Parallel File Systems, Lustre}
}
@inproceedings{10.1145/3784828.3785250,
  title         = {A Co-Simulation Framework for Building Energy Management as a Testbed for Energy-Aware Data Movement Analysis},
  author        = {Wongphong, Chomphunuch and Wongta, Patchararat and Marurngsith, Worawan},
  year          = 2026,
  booktitle     = {Proceedings of the Supercomputing Asia and International Conference on High Performance Computing in Asia Pacific Region Workshops},
  publisher     = {Association for Computing Machinery},
  address       = {New York, NY, USA},
  series        = {SCA/HPCAsiaWS '26},
  pages         = {407–417},
  doi           = {10.1145/3784828.3785250},
  isbn          = 9798400723285,
  url           = {https://doi.org/10.1145/3784828.3785250},
  abstract      = {Improving energy efficiency through co-simulation frameworks can enhance building and operations management. This is a strategy to reduce the energy use per square meter by 35\% by 2030. Buildings consume more than one-third of global energy. Heating, Ventilation, and Air Conditioning (HVAC) systems account for more than 70\% of this consumption. Unpredictable occupant behavior causes significant energy variability. This variability can range from 100\% to 300\%, even in similar buildings and systems. We propose a co-simulation framework, Twin-B, that integrates a complex building-physics simulation with agent-based occupant-behavior models to improve prediction accuracy. As this framework requires High Performance Computing (HPC) resources, ensuring that the energy spent on simulation does not exceed the energy saved through its prediction is crucial. Recent research shows that frequent data exchange in co-simulation can create bottlenecks. This can increase the processing time by 20-50\% and consume 0.06-0.2 Kilowatt-hours per Gigabyte (kWh/GB) for network transfers. This paper addresses inefficiencies in HPC resources. This issue was identified during Twin-B co-simulation to predict energy efficiency in a university building. Our study reveals that small data exchanges (averaging 37.5 bytes) between simulators account for 66.3\% of stream-synchronized overhead and consume 7.42 J of energy. This host-to-device (H2D) transfer is driven by per-agent decision-making and could be optimized by batching agent operations. We found that batch-based optimization can reduce energy consumption by 99.5\% and achieve 4.5\texttimes{}–10\texttimes{} speedup without sacrificing simulation accuracy. This research quantifies the link between data exchange patterns in building energy co-simulation and HPC energy efficiency, and offers strategies to optimize sustainable digital twin systems.},
  numpages      = 11,
  keywords      = {Energy Efficiency, Co-simulation, Building Energy, Agent-based Model, HPC}
}
@inproceedings{10.1145/3784828.3785251,
  title         = {Quantifying the Energy Cost of Performance Inefficiency in HPC Applications},
  author        = {Liem, Radita and Djebarov, Dlyaver},
  year          = 2026,
  booktitle     = {Proceedings of the Supercomputing Asia and International Conference on High Performance Computing in Asia Pacific Region Workshops},
  publisher     = {Association for Computing Machinery},
  address       = {New York, NY, USA},
  series        = {SCA/HPCAsiaWS '26},
  pages         = {418–427},
  doi           = {10.1145/3784828.3785251},
  isbn          = 9798400723285,
  url           = {https://doi.org/10.1145/3784828.3785251},
  abstract      = {HPC systems consume a significant amount of energy, and inefficiencies in application performance further exacerbate this demand, increasing operational costs and environmental impact. As data center energy usage continues to rise with growing computational workloads, improving the energy efficiency of HPC applications has become a critical priority. This work introduces the Energy-Efficiency Critical Path Tool (EE-CPT), a profiling framework that quantifies the energy costs associated with load balancing and communication-related inefficiencies. Using ICON-A, a production-grade climate modeling application, as a case study, we demonstrate how EE-CPT correlates the traditional time-based performance metrics with energy consumption across different process, thread, and CPU frequency configurations. The results reveal optimal configurations that can balance runtime and energy use while identifying performance bottlenecks that offer opportunities for energy-aware optimization.},
  numpages      = 10,
  keywords      = {performance analysis, critical path analysis, energy consumption}
}
@article{10.1145/3788882.3788890,
  title         = {Measuring Energy Consumption of LLMs Inferences},
