@inproceedings{10405909,
  title         = {Power and Memory Efficient High-Speed RL Based Run time Power Manager for Edge Computation},
  author        = {Vinay, Ratnala and Laad, Kartik and Pal, Chandrajit and Sasmal, Pradip and Haraki, Toshihisa and Juyal, Chirag and Elbakri, Mohamed Amir Gabir and Acharyya, Amit},
  year          = 2023,
  month         = {Aug},
  booktitle     = {2023 IEEE 66th International Midwest Symposium on Circuits and Systems (MWSCAS)},
  pages         = {546--550},
  doi           = {10.1109/mwscas57524.2023.10405909},
  issn          = {1558-3899},
  abstract      = {Run-time power management poses severe challenges in modern-day edge computing and the adaptability of these run-time power managers to new workloads has been a major concern. Reinforcement learning (RL) based algorithms are able to address this issue of adaptability to unseen load scenarios in the area of High-performance computing (HPC). However, the performance of RL-based run time power managers on the edge degrades due to the constraints it faces post-deployment. The primary reasons for the performance degradation of the RL-based run time power manager on edge are the random actions taken during the long exploratory phase and the considerable amount of memory required for its smooth execution. This motivated us to propose a power and memory-efficient high-speed RL-based run time manager for the edge computation. This reduces the exploratory time by offline-online co-optimization policy and memory consumption post-deployment by removing sparse states. Subsequently, the proposed methodology is implemented on the edge device Jetson Xavier board. It reduces exploratory time by 36\% with a reduction in memory footprint by 40\% compared to state-of-the-art approaches with average power savings of 29.21\% compared to OS\_Performance mode, 26.77\% compared to OS\_Schedutil mode, 19.24\% compared to OS\_Ondemand mode and 15.42\% compared to state-of-the-art Q-learning on edge computing platforms.},
  keywords      = {Degradation;Q-learning;Power system management;High performance computing;Memory management;Computational efficiency;Edge computing;Edge computing;Reinforcement learning (RL);Power manager;Exploratory phase;Memory;Offline;Online;Co-optimization;Sparse state}
}
@inproceedings{10413188,
  title         = {Potential for Waste Heat Recovery in a Digital Currency Mining Facility: A Building Infrastructure Case Study},
  author        = {Parrado-Duque, A. and Dub\'{e}, Y. and Charrel, S. and Gaden, C. and Henao, N. and Agbossou, K. and Guibault, Y.},
  year          = 2023,
  month         = {Oct},
  booktitle     = {2023 IEEE 64th International Scientific Conference on Power and Electrical Engineering of Riga Technical University (RTUCON)},
  pages         = {1--7},
  doi           = {10.1109/rtucon60080.2023.10413188},
  abstract      = {The digital asset industry, including generative artificial intelligence, Bitcoin mining, and high-performance computing, is known for its significant energy consumption and heat generation. This study quantitatively assesses the heat energy potential in digital asset mining, specifically focusing on two commonly used cryptocurrency machines: AntMiner S19j Pro and WhatsMiner M30s. Two case studies Were conducted in different settings–a mining facility With an air-to-air cooling system and a closed-room laboratory. The research involved extensive data collection, utilizing digital thermal sensors, anemometers, manometers, and electrical sensors over 41 days. Our findings reveal that heat energy potential employing an air-to-air cooling system, compared to a closed operating room, can be significantly reduced by a thirty percent average. Moreover, machines in the air-to-air cooling system exhibit significantly lower outlet air temperatures compared to the closed operating room, with reductions of up to twenty-four degrees Celsius per machine. This research provides valuable insights into the potential for utilizing heat recovery technologies in the digital asset sector to meet industrial heat demand, addressing environmental concerns and energy costs.},
  keywords      = {Analytical models;Electric potential;Costs;Cooling;Waste heat;Data mining;Heat recovery;Energy efficiency;Energy modeling;Digital currency mining;Heat energy recovery}
}
