@inproceedings{10.1145/3789242.3789249,
  title         = {Scaling up Computing Chip(lets) for the Generative AI Era},
  author        = {Benini, Luca},
  year          = 2026,
  booktitle     = {Proceedings of the Conference on ACM Europe Summer School on HPC Computer Architectures for AI and Dedicated Applications},
  location      = {Barcelona, Spain},
  publisher     = {Association for Computing Machinery},
  address       = {New York, NY, USA},
  series        = {SummerSchool '25},
  doi           = {10.1145/3789242.3789249},
  url           = {https://doi.org/10.1145/3789242.3789249},
  abstract      = {AI is accelerating into the generative era, and it is poised to disrupt multiple businesses, including HPC. With the Emergence of reasoning models, inference is becoming the key workload and computational challenge. Cloud and HPC system need to scale out and scale up to meet the challenge. In this talk I discuss how to scale up chip(lets) for efficient generative AI inference, optimizing the whole hardware stack, from processing elements to the global interconnect. I emphasize the strategic importance of an end-to-end (models, software, instruction set architecture, digital design) open-platform approach to ensure a healthy innovation ecosystem, with long term sustainability.},
