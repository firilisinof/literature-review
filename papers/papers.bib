@conference{Hofsaess2025,
  title         = {First Deployment of XCache for Workflow and Efficiency Optimizations on Opportunistic HPC Resources in Germany},
  author        = {Hofsaess, Robin and Giffels, Manuel and Gottmann, Artur and Quast, G\"{u}nter and Petzold, Andreas and Schnepf, Matthias and Streit, Achim},
