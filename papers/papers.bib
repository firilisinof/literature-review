@article{Montessori2023,
  title         = {Thread-safe lattice Boltzmann for high-performance computing on GPUs},
  author        = {Montessori, Andrea and Lauricella, Marco and Tiribocchi, Adriano and Durve, Mihir and La Rocca, Michele and Amati, Giorgio and Bonaccorso, Fabio and Succi, Sauro},
  year          = 2023,
  journal       = {Journal of Computational Science},
  volume        = 74,
  doi           = {10.1016/j.jocs.2023.102165},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85174747723&doi=10.1016%2Fj.jocs.2023.102165&partnerID=40&md5=e2f1e1703bf91e6c0bd0b03319e4e914},
  note          = {Cited by: 14; All Open Access; Hybrid Gold Open Access},
  abstract      = {We present thread-safe, highly-optimized lattice Boltzmann implementations, specifically aimed at exploiting the high memory bandwidth of GPU-based architectures. At variance with standard approaches to LB coding, the proposed strategy, based on the reconstruction of the post-collision distribution via Hermite projection, enforces data locality and avoids the onset of memory dependencies, which may arise during the propagation step, with no need to resort to more complex streaming strategies. The thread-safe lattice Boltzmann achieves peak performances, both in two and three dimensions and it allows to reduce significantly the memory footprint (tens of GigaBytes for order billions lattice nodes simulations) by retaining the algorithmic simplicity of standard LB computing. Our findings open attractive prospects for high-performance simulations of complex flows on GPU-based architectures. \textcopyright{} 2023 The Author(s)},
  author_keywords = {Complex flows; High performance computing; Lattice Boltzmann method},
  keywords      = {Graphics processing unit; Memory architecture; Complex flow; Data locality; Hermite; High memory bandwidth; High performance computing; Lattice boltzmann; Lattice Boltzmann method; Performance computing; Post-collision; Propagation step; Program processors},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
