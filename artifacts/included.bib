@inproceedings{11264644,
 abstract = {As GPU architectures continue to diversify across high-performance computing (HPC) systems, ensuring code portability and minimizing environmental impact have become critical challenges. This paper investigates how different programming models affect the carbon-performance efficiency of a Reverse Time Migration (RTM) application, a key workload in geophysics. We provide twelve implementations of the RTM code using CUDA, HIP, Kokkos, RAJA, and OpenMP Target, and evaluate their behavior on eleven GPUs from NVIDIA and AMD. Our analysis covers execution time, energy consumption, and carbon footprint. Results show that HIP, when tuned per architectures and RAJA, achieve the highest code portability in terms of carbon-efficiency, reaching up to 93.7\% and 93.4\% efficiency across all platforms, respectively. Overall, while HIP and CUDA deliver peak performance and the lowest emissions when properly optimized, the gap between these native models and high-level abstractions such as RAJA and Kokkos is steadily narrowing, indicating growing potential for portable and sustainable HPC development.},
 author = {Lorenzon, Arthur F. and Navaux, Phillipe O. A. and Sardinha, Alexandre and Messer, Bronson},
 booktitle = {2025 IEEE/SBC 37th International Symposium on Computer Architecture and High Performance Computing (SBAC-PAD)},
 doi = {10.1109/sbac-pad66369.2025.00018},
 issn = {2643-3001},
 keywords = {Energy consumption;Codes;High performance computing;Computational modeling;Graphics processing units;Computer architecture;Geophysics;Programming;Sustainable development;Hip;Code Portability;Sustainability;HPC;Carbon-Performance efficiency;RTM},
 month = {Oct},
 pages = {91--101},
 title = {Evaluating Code Portability for Carbon-Efficient RTM Computing},
 year = {2025}
}

@inproceedings{11437713,
 abstract = {With the increasing demand of artificial intelligence (AI), data science and cryptocurrency mining in recent years, the application of High-Powered Computing (HPC) is increasing. The paper estimates the global power consumption and resulting Greenhouse Gas (GHG) emissions of HPC considering the current energy mix and energy utilization, and subsequently analyzes the wider impact of HPC on the global environment and explores the potential role of renewable energy in mitigating these impacts. We analyze the potential benefits of hybrid energy from various aspects such as carbon emissions, costs and environmental pollution. Considering the future development needs, we use ARIMA prediction model to predict the future development trend of HPC, and use Grey Wolf optimization algorithm to explore the best mixing ratio of hybrid energy with the change of HPC energy consumption. This paper also analyzes the change of the environmental impact of HPC energy consumption as the proportion of clean energy increases. The results show that HPC energy consumption has a significant impact on the environment. However, if clean energy technologies are vigorously developed, increasing the proportion of clean energy can significantly reduce the emissions of greenhouse gases and harmful gases.},
 author = {Wang, Zixuan and Yang, Shuwen and Wei, Zihang and Chen, Wenyue},
 booktitle = {2025 IEEE 4th International Conference of Safe Production and Informatization (IICSPI)},
 doi = {10.1109/iicspi66775.2025.11437713},
 keywords = {Green energy;Energy consumption;Costs;Renewable energy;Carbon dioxide;Production;Prediction algorithms;Artificial intelligence;Greenhouse gases;Optimization;High-Powered Computing;Greenhouse Gas Emissions;Grey Wolf optimization;Hybrid Energy Optimization},
 month = {Dec},
 pages = {867--871},
 title = {Optimal Energy Planning for High-Powered Computing Based on Grey Wolf Model},
 year = {2025}
}

