@article{11048712,
  title         = {A Fast Floating-Point Multiply–Accumulator Optimized for Sparse Linear Algebra on FPGAs},
  author        = {Li, Kun and Hao, Xiangyu and Ma, Zhenguo and Yu, Feng and Zhang, Bo and Xing, Qianjian},
  year          = 2025,
  month         = {Sep.},
  journal       = {IEEE Transactions on Very Large Scale Integration (VLSI) Systems},
  volume        = 33,
  number        = 9,
  pages         = {2592--2596},
  doi           = {10.1109/tvlsi.2025.3578619},
  issn          = {1557-9999},
  abstract      = {This brief presents a pipelined floating-point Multiply–Accumulator (FPMAC) architecture designed to accelerate sparse linear algebra operations. By designing a lookup-table-based 5–3 carry-save adder (CSA) and combining it with a 3–2 CSA, the proposed design minimizes the critical path and boosts operational speed. Moreover, the proposed architecture takes advantage of data characteristics in sparse linear algebra to displace the shift unit in the critical accumulation loop, further increasing the throughput rate. In addition, the integration of a lookup-table-based leading-zero anticipator (LZA) enhances normalization efficiency. Experimental results show that, compared with reported FPMAC designs, the proposed architecture may achieve a significantly higher maximum clock frequency for single-precision floating-point operations.},
  keywords      = {Computer architecture;Field programmable gate arrays;Adders;Feedback loop;Table lookup;Delays;Linear algebra;Encoding;Very large scale integration;Resource management;Floating-point multiply-accumulator (FPMAC);pipeline architecture;single-cycle accumulation;sparse linear algebra}
}
