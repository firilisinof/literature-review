  author        = {Canfora, Aldo and Bergamaschi, Eleonora and Mioli, Riccardo and Battini, Federico and Degli Esposti, Mirko and Pedrazzi, Giorgio and Dellacasa, Chiara},
  year          = 2026,
  journal       = {Urban Science},
