  author        = {Barth, John and Reohr, William and Parries, Paul and Fredeman, Greg and Golz, John and Schuster, Stanley and Matick, Richard and Hunter, Hillery and Tanner, Charles and Harig, Joseph and Kim, Hoki and Khan, Babar and Griesemer, John and Havreluk, Robert and Yanagisawa, Kenji and Kirihata, Toshiaki and Iyer, Subramanian},
  year          = 2007,
  month         = {Feb},
