@article{Soleimani2017190,
  title         = {Assessment of microbial and physiochemical quality of ballast water in commercial ships entering Bushehr port, along the Persian Gulf},
  author        = {Soleimani, Farshid and Dobaradaran, Sina and Taherkhani, Reza and Saeedi, Reza and Mohammadi, Mohammad Javad and Keshtkar, Mozhgan and Ghaderi, Maryam and Mirahmadi, Roghayeh},
