  author        = {Bauer, Simon and Bunge, Hans-Peter and Drzisga, Daniel and Ghelichkhan, Siavash and Huber, Markus and Kohl, Nils and Mohr, Marcus and R\"{u}de, Ulrich and Th\"{o}nnes, Dominik and Wohlmuth, Barbara},
  year          = 2020,
