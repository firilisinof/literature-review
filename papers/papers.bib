@book{Chien202613,
  title         = {From HPC Datacenters to Grid-integrated AI Datacenters},
  author        = {Chien, Andrew A.},
  year          = 2026,
  journal       = {Scheduling Variable Capacity Resources for Sustainability},
  pages         = {13--31},
  doi           = {10.1201/9781003564270-2},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105033144348&doi=10.1201%2F9781003564270-2&partnerID=40&md5=46d6602ced2250da874655ac4531dcb4},
  note          = {Cited by: 0},
  abstract      = {To provide understanding of the opportunities and challenges of datacenters, we describe the basic elements of a datacenter – including power distribution, cooling, and of course computing. We elucidate how these systems create opportunities for dynamic flexibility in capacity, the key element required for grid-integration, and the driving motivation for variable capacity scheduling. We discuss grid dynamics and how growing datacenter demand challenges the decarbonization of the grid with variable renewable generation. This leads to discussion of the important role that datacenters can play in both increasing grid power capacity and accelerating grid decarbonization, and what datacenters (and computation workloads) need to do to help society forward into a more sustainable future, combined with the growth of artificial intelligence. Finally, we discuss some implications for scheduling problems, and some interesting research directions. \textcopyright{} selection and editorial matter, Anne Benoit, Andrew A. Chien, and Yves Robert; individual; chapters, the contributors.},
  keywords      = {Basic-elements; Capacity scheduling; Datacenter; Decarbonisation; Dynamic flexibility; Grid integration; Key elements; Power distributions; Renewable generation; Variable capacity; Artificial intelligence},
  type          = {Book chapter},
  publication_stage = {Final},
