@article{Su2024,
  title         = {Ni-plated viscose-based carbon fibers/biomass-derived hierarchical porous carbon for high-performance lithium-sulfur battery free-standing cathodes},
  author        = {Su, Zhiqin and Lv, Yang and Qiu, Linlin and Liu, Yang and Bai, Bing and Liu, Zhipeng and Sheng, Kai and Du, Pingfan},
  year          = 2024,
  journal       = {Journal of Alloys and Compounds},
  volume        = 970,
  doi           = {10.1016/j.jallcom.2023.172593},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85174469411&doi=10.1016%2Fj.jallcom.2023.172593&partnerID=40&md5=0e4e6c2374eedbe0862bd536b66989dd},
  note          = {Cited by: 12},
  abstract      = {Developing high-performance lithium-sulfur batteries has become an important strategy to achieve sustainable development. In this study, a novel and high-performance stand-alone cathode material, containing Ni-plated viscose-based carbon fiber (VBCF/Ni) and hierarchical porous carbon (HPC), was prepared. The conductivity, adsorption and catalytic effect of the VBCF substrate, on the Li<sub>2</sub>S/LiPSs, were improved after Ni-plating. HPC, containing micro- and mesopores, was obtained by carbonizing edible sweet potato flour and served as a direct host for sulfur (HPC\@S). The large specific surface area (386.8 m<sup>2</sup> g<sup>-1</sup>) and pore volume (0.4556 cm<sup>3</sup> g<sup>-1</sup>) of HPC were suitable for achieving a good sulfur loading and LiPSs adsorption. Due to the synergistic effect of the polar metallic Ni and non-polar carbon groups, the performance of the VBCF/Ni/HPC\@S cathode was significantly improved. The obtained cell showed a reversible capacity of 1206 mAh g<sup>-1</sup> at 0.1 C, maintained 892.2 mAh g<sup>-1</sup> after 200 cycles at a rate of 0.2 C, and showed a capacity retention rate of 82.6\%. \textcopyright{} 2023 Elsevier B.V.},
  author_keywords = {Hierarchical porous carbon; Lithium-sulfur battery; Nickel-plated modification; Viscose-based carbon fiber},
  keywords      = {Carbon fibers; Cathodes; Lithium batteries; Lithium compounds; Porous materials; Adsorption effect; Battery-free; Cathodes material; Free standings; Hierarchical porous carbons; Lithium/sulfur batteries; Nickel-plated modification; Performance; Stand -alone; Viscose-based carbon fiber; Lithium sulfur batteries},
  type          = {Article},
