}
@article{10640323,
  title         = {Hypercomplex Signal Processing in Digital Twin of the Ocean: Theory and application},
  author        = {Yu, Zhaoyuan and Li, Dongshuang and Du, Pei and Luo, Wen and Kou, Kit Ian and Bhatti, Uzair Aslam and Benger, Werner and Lv, Guonian and Yuan, Linwang},
  year          = 2024,
  month         = {May},
  journal       = {IEEE Signal Processing Magazine},
  volume        = 41,
  number        = 3,
  pages         = {33--48},
  doi           = {10.1109/msp.2024.3389496},
  issn          = {1558-0792},
  abstract      = {The digital twin of the ocean (DTO) is a groundbreaking concept that uses interactive simulations to improve decision-making and promote sustainability in earth science. The DTO effectively combines ocean observations, artificial intelligence (AI), advanced modeling, and high-performance computing to unite digital replicas, forecasting, and what-if scenario simulations of the ocean systems. However, there are several challenges to overcome in achieving the DTO's objectives, including the integration of heterogeneous data with multiple coordinate systems, multidimensional data analysis, feature extraction, high-fidelity scene modeling, and interactive virtual–real feedback. Hypercomplex signal processing offers a promising solution to these challenges, and this study provides a comprehensive overview of its application in DTO development. We investigate a range of techniques, including geometric algebra, quaternion signal processing, Clifford signal processing, and hypercomplex machine learning, as the theoretical foundation for hypercomplex signal processing in the DTO. We also review the various application aspects of the DTO that can benefit from hypercomplex signal processing, such as data representation and information fusion, feature extraction and pattern recognition, and intelligent process simulation and forecasting, as well as visualization and interactive virtual–real feedback. Our research demonstrates that hypercomplex signal processing provides innovative solutions for DTO advancement and resolving scientific challenges in oceanography and broader earth science.},
  keywords      = {Analytical models;Computational modeling;Data visualization;Geoscience;Signal processing;Predictive models;Hypercomplex;Digital twins;Oceanography;Artificial intelligence;High performance computing;Geoscience}
}
@inproceedings{10641657,
  title         = {Destination Earth Platform: A Digital Ecosystem Enabling Destine Data Exploitation},
  author        = {Tona, Calogera and Borgia, Barbara and Scarda, Barbara and Longuet, Alexis},
  year          = 2024,
  month         = {July},
  booktitle     = {IGARSS 2024 - 2024 IEEE International Geoscience and Remote Sensing Symposium},
  pages         = {878--882},
  doi           = {10.1109/igarss53475.2024.10641657},
  issn          = {2153-7003},
  abstract      = {This article explains the Destination Earth Service Core Platform, known as DestinE Platform, which is an integral part of Destination Earth (DestinE), a significant undertaking of the European Commission under DG CONNECT. DestinE's primary goal is to construct an incredibly precise digital replica of Earth--a 'digital twin'--to oversee and forecast changes in the environment and human impact, thereby bolstering sustainable development.The DestinE Platform serves as an accessible gateway for DestinE users. The platform is designed to furnish decision-making tools, applications, and services founded on a cloud-based computing system that is open, adaptable, and secure. It will harmonise data, cloud, and HPC infrastructures, providing entry to an expanding array of Digital Twins as they progressively become accessible through interconnected European Commission and national initiatives.Moreover, the platform will grant access to pertinent AI tools, high-capacity data analysis, and capabilities for monitoring, simulating, and predicting Earth-system phenomena, allocating specific resources to DestinE users, enabling them to personalise the platform, merge their data, and craft their own applications and services for the benefits of societies.},
  keywords      = {Earth;Technological innovation;Ecosystems;Decision making;Europe;Geoscience and remote sensing;Logic gates;DestinE Platform;Destination Earth;Digital Twin;ecosystem}
}
@inproceedings{10658697,
  title         = {MSPARQ: A RISC-V Vector Processor Array Optimized for Low-Resolution Neural Networks},
  author        = {Humblet, Elisabeth and Dupuis, Th\'{e}o and Fournier, Yoan and AskariHemmat, Mohammad Hossein and Leduc-Primeau, Fran\c{c}ois and David, Jean Pierre and Savaria, Yvon},
  year          = 2024,
  month         = {Aug},
  booktitle     = {2024 IEEE 67th International Midwest Symposium on Circuits and Systems (MWSCAS)},
  pages         = {464--468},
  doi           = {10.1109/mwscas60917.2024.10658697},
  issn          = {1558-3899},
  abstract      = {This paper explores using a multicore RISC- V vector processor to enhance the performance of convolutional neural networks (CNNs) quantized to low and ultra-low precisions. Optimizing CNNs' efficiency is crucial in resource-constrained environments such as embedded systems. To this end, we use Sparq, a 64-bit RISC-V RVV1.0 processor derived from ``Ara''. This paper introduces MSPARQ, its multicore version developed using the OpenPiton framework and implemented in GlobalFoundries 22FDX FD-SOI technology. The performance of a CNN conv2d kernel is evaluated by emulating MSPARQ on a Xilinx Alveo U280 FPGA board. Results show that through an adequate mapping of this kernel, a 4-core configuration can achieve a speedup of 3.6 to 3.8 times over the single-core configuration, while sub-byte optimizations included in the Sparq core deliver an additional speedup by 2.1 and 1.8 times respectively for 1-bit and 2-bit precisions, over the 16-bit implementation of the conv2d operation.},
  keywords      = {Power demand;Multicore processing;Scalability;Parallel processing;Throughput;Vectors;Convolutional neural networks;RISC-V;Vector ISA;Multi-core;Convolution}
}
@inproceedings{10664369,
  title         = {OHIO: Improving RDMA Network Scalability in MPI\_Alltoall Through Optimized Hierarchical and Intra/Inter-Node Communication Overlap Design},
  author        = {Tran, Tu and Kuncham, Goutham Kalikrishna Reddy and Ramesh, Bharath and Xu, Shulei and Subramoni, Hari and Abduljabbar, Mustafa and Panda, Dhabaleswar K. DK},
  year          = 2024,
  month         = {Aug},
  booktitle     = {2024 IEEE Symposium on High-Performance Interconnects (HOTI)},
  pages         = {47--56},
  doi           = {10.1109/hoti63208.2024.00019},
  issn          = {2332-5569},
  abstract      = {The presence of exascale computers has pushed a new boundary in computing capability, which poses performance challenges in parallel programming models on how to exploit such systems efficiently. A dominant programming model for running parallel programs is the Message Passing Interface. Among primitives provided by MPI, Alltoall is a communication-intensive operation, which is utilized by many applications and is well-known for being difficult to optimize. Alltoall algorithms can be mainly classified into flat and hierarchical. The hierarchical designs avoid the slowdown of intra-node communication by inter-node communication by decoupling them. The hierarchical designs also reduce network congestion by reducing concurrently injected messages into the network. This work demonstrates an additional benefit of hierarchical designs to improve connection scalability in RDMA networks. This is attributed to the cache thrashing happening inside network adapters. All of these advantages of hierarchical schemes collectively contribute to the network scalability of Alltoall. This motivates us to propose a further optimized hierarchical design to enhance performance and network scalability. The design is network-agnostic and evaluated on clusters with InfiniBand and Omni-Path network adapters. The proposed design achieves average latency improvements of 61.13\%, 56.40\%, 37.49\%, and 51.90\% over Open MPI + UCX, HPC-X, Intel MPI, and MVAPICH2-X at micro-benchmark level with up to 7168 cores, respectively. In addition, the evaluation at application-level with Car-Parrinello Molecular Dynamics code shows 24.98 \%, 40.44 \% and 50.48 \% improvement in the simulation time, compared to MVAPICH2-X, Open MPI + UCX, and Intel MPI, respectively.},
  keywords      = {Computers;Protocols;Codes;Parallel programming;Scalability;Computational modeling;Message passing;Alltoall;Collective;MPI;Optimization;Performance;Scalability;Network Agnostic;Transport Protocol}
}
@inproceedings{10667286,
  title         = {ResNet50V1.5 Evaluation for GPU Disaggregation},
  author        = {Shama, Ethan and Grant, Ryan E.},
  year          = 2024,
  month         = {Aug},
  booktitle     = {2024 IEEE Canadian Conference on Electrical and Computer Engineering (CCECE)},
  pages         = {105--106},
  doi           = {10.1109/ccece59415.2024.10667286},
  issn          = {2576-7046},
  abstract      = {The emergence of Artificial Intelligence (AI) and Machine Learning (ML) has unleashed groundbreaking tools, expanding the boundaries of what's achievable. Given the time, energy, and CO2 emissions associated with the rising use of resources for training AI/ML models, researchers and industry alike must optimize this process to reduce its associated financial, ecological, and social impacts. Large-scale AI/ML training requires the computational power of High-Performance Computing Clusters (HPCC) [1] . Underutilization and inefficiencies, resulting from codes' inability to utilize allocated hardware simultaneously, leave unused resources consuming power [2] , [3] .},
  keywords      = {Training;Industries;Sensitivity analysis;High performance computing;Graphics processing units;Computer architecture;Switches}
}
@inproceedings{10678731,
  title         = {Workflow Provenance in the Computing Continuum for Responsible, Trustworthy, and Energy-Efficient AI},
  author        = {Souza, Renan and Caino-Lores, Silvina and Coletti, Mark and Skluzacek, Tyler J. and Costan, Alexandru and Suter, Fr\'{e}d\'{e}ric and Mattoso, Marta and Da Silva, Rafael Ferreira},
  year          = 2024,
  month         = {Sep.},
  booktitle     = {2024 IEEE 20th International Conference on e-Science (e-Science)},
  pages         = {1--7},
  doi           = {10.1109/e-Science62913.2024.10678731},
  issn          = {2325-3703},
  abstract      = {As Artificial Intelligence (AI) becomes more pervasive in our society, it is crucial to develop, deploy, and assess Responsible and Trustworthy AI (RTAI) models, i.e., those that consider not only accuracy but also other aspects, such as explainability, fairness, and energy efficiency. Workflow provenance data have historically enabled critical capabilities towards RTAI. Provenance data derivation paths contribute to responsible workflows through transparency in tracking artifacts and resource consumption. Provenance data are well-known for their trustworthiness helping explainability, reproducibility, and accountability. However, there are complex challenges to achieve RTAI, which are further complicated by the heterogeneous infrastructure in the computing continuum (Edge-Cloud-HPC) used to develop and deploy models. As a result, a significant research and development gap remains between workflow provenance data management and RTAI. In this paper, we present a vision of the pivotal role of workflow provenance in supporting RTAI and discuss related challenges. We present a schematic view between RTAI and provenance, and highlight open research directions.},
  keywords      = {Computational modeling;Distributed databases;Energy efficiency;Reproducibility of results;Data models;Stakeholders;Telemetry;Artificial Intelligence;Provenance;Machine Learning;AI workflows;ML workflows;Responsible AI;Trustworthy AI;Reproducibility;AI Lifecycle;Energy-efficient AI}
}
@inproceedings{10679383,
  title         = {Transitioning SSH European Research Infrastructures to Critical Infrastructure Through Resilience},
  author        = {Bellini, Emanuele and Degl'Innocenti, Emiliano},
  year          = 2024,
  month         = {Sep.},
  booktitle     = {2024 IEEE International Conference on Cyber Security and Resilience (CSR)},
  pages         = {801--806},
  doi           = {10.1109/csr61664.2024.10679383},
  abstract      = {European Social Sciences and Humanities (SSH) Research Infrastructures (RIs) are advanced socio-technical ecosystems that play a pivotal role in understanding complex cultural and social phenomena and addressing critical societal challenges. As digital resources related to SSH and Cultural Heritage (CH) become increasingly available, RIs are becoming more relevant and are frequent targets for cyber-attacks and cyber-warfare. This paper describes the main steps in the transition process from Research Infrastructures to Critical Infrastructures (CIs), focusing on the SSH domain. It highlights their vulnerabilities, supports the adoption of enhanced cybersecurity measures, discusses emerging cyber-threats faced by SSH infrastructures, and proposes adaptive strategies to ensure their resilience. Furthermore, the paper emphasizes the importance of protecting SSH research infrastructures as critical components of our societal and cultural fabric and promotes the development of a framework to support this transition.},
  keywords      = {Social sciences;Ecosystems;Europe;Focusing;Fabrics;Critical infrastructure;Cultural differences}
}
