  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105026314864&doi=10.1590%2F1517-7076-RMAT-2025-0467&partnerID=40&md5=49b3db03826b5d38faf5359629f247aa},
  note          = {Cited by: 0; All Open Access; Gold Open Access},
  abstract      = {This study explores the influence of nanosilica on the mechanical and durability properties of high-performance concrete (HPC) incorporating pineapple leaf fiber (PALF) as secondary reinforcement, with an optimum PALF content of 2.5\%. Simultaneously, nano-silica was used to partially replace Portland cement at levels of 0.5\% to 2.5 wt.\%. Concrete mixtures were evaluated for workability, sorptivity, rapid chloride ion penetration, water absorption, compressive strength, flexural strength, splitting tensile strength, and abrasion resistance. The addition of nano-silica enhanced the overall mechanical and durability performance of HPC, with optimal benefits observed at a 2 wt.\% replacement level. However, increasing nano-silica content led to higher water demand due to its high specific surface area, although consistent workability was maintained using superplasticizers. Nano-silica functioned both as a pozzolanic activator and micro-filler, refining the microstructure and enhancing interfacial bonding. Microstructural analyses using scanning electron microscopy (SEM), X-ray diffraction (XRD), and Fourier-transform infrared spectroscopy (FTIR) confirmed the improved matrix density and reduced porosity. The combined use of PALF and nano-silica demonstrates strong potential for sustainable and durable structural applications in HPC. \textcopyright{} 2025, Universidade Federal do Rio de Janeiro. All rights reserved.},
  author_keywords = {Concrete Properties; Durability; High-Performance Concrete; Nano-silica; Pineapple leaf fiber},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Chen20122109,
  title         = {Biological stability of drinking water in an eastern China city},
