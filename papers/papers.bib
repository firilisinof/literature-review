}
@article{Tomei2022537,
  title         = {A computational approach for progressive architecture shrinkage in action recognition},
  author        = {Tomei, Matteo and Baraldi, Lorenzo and Fiameni, Giuseppe and Bronzin, Simone and Cucchiara, Rita},
  year          = 2022,
  journal       = {Software - Practice and Experience},
  volume        = 52,
  number        = 2,
  pages         = {537--554},
  doi           = {10.1002/spe.3035},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85115937902&doi=10.1002%2Fspe.3035&partnerID=40&md5=c6fb85099b6b1e8402339cdc095908f0},
  note          = {Cited by: 1; All Open Access; Green Open Access; Hybrid Gold Open Access},
  abstract      = {Efficiency plays a key role in video understanding modeling, and developing more efficient spatiotemporal deep networks is a key ingredient for enabling their usage in production scenarios. In this work, we propose a methodology for reducing the computational complexity of a video understanding backbone while limiting the drop in accuracy caused by architectural changes. Our approach, named, Progressive Architecture Shrinkage, applies a sequence of reduction operators to the hyperparameters of a network to reduce its computational footprint. The choice of the sequence of operations is automatically optimized in a coordinate-descent schema, and the approach transfers knowledge from both the initial network and previous stages of the shrinking process by employing a Knowledge Distillation and an adaptive fine-tuning strategy. As each iteration of the shrinking algorithm requires to train a large-scale video understanding network, we perform experiments on MARCONI 100--a supercomputer equipped with an IBM Power9 architecture and Volta NVIDIA GPUs. Experimental evaluations are conducted using two backbones and three different action recognition benchmarks. We show that, through our approach, high accuracy levels can be maintained while reducing the number of multiply–adds operations by four times with respect to the original architectures. Code will be made available. \textcopyright{} 2021 The Authors. Software: Practice and Experience published by John Wiley \& Sons Ltd.},
  keywords      = {Distillation; Iterative methods; Network architecture; Program processors; Supercomputers; \% reductions; Action recognition; Architectural changes; Architectural optimization; Computational approach; Distributed training; Optimisations; Practice and experience; Software practices; Video understanding; Shrinkage},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Tong2025,
  title         = {Towards sustainable reinforced concrete: Bond performance and anchorage reliability of steel rebar embedded in low-carbon high-performance concrete},
  author        = {Tong, Zhihao and Huang, Le and Tang, Tao and Gao, Benhao and Gao, Huan and Chi, Yin and Xu, Lihua},
  year          = 2025,
  journal       = {Engineering Structures},
  volume        = 343,
  doi           = {10.1016/j.engstruct.2025.121271},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105014919132&doi=10.1016%2Fj.engstruct.2025.121271&partnerID=40&md5=aefde1945f9ff8127358b5ea903ed731},
  note          = {Cited by: 3},
  abstract      = {Understanding the bond performance between low-carbon high-performance concrete (LC-HPC) and rebar is fundamental to enhancing the structural integrity and sustainability of reinforced concrete systems. This investigation examines LC-HPC/rebar bond characteristics through 91 monotonic pull-out tests, incorporating multivariate analysis of steel fiber (0–1.5 \%), polypropylene fiber (0–0.15 \%), cement replacement ratios (60–80 \%), water-binder ratios (0.19–0.23), and confinement configurations. The experimental results revealed that the steel fibers improved bond strength up to 33 \%, while stirrup confinement increased post-peak energy absorption by 34–44 \%, altering the failure mode from brittle fracture to ductile failure. Subsequent to a meso-scale finite element modeling, establishing a multi-phase bond performance evolution model validated against experimental curves, the bond failure mechanism between LC-HPC and rebar has been elucidated. Afterward, through dimensional analysis and multivariate regression, a novel equation quantifying the bond strength (R\ensuremath{^2}=0.97) has been proposed. The probabilistic analysis using the central point reliability method yielded an anchorage length formula, demonstrating 31–43 \% reductions compared to Chinese code GB/T 50010–2010 provisions when applied to LC-HPC. These findings not only advance the understanding of bond behavior in LC-HPC but also provide tools for optimizing the design and application of LC-HPC in reinforced concrete structures. \textcopyright{} 2025},
  author_keywords = {Bond performance; Failure mechanism; Low-carbon high-performance concrete; Numerical simulation; Rebar anchorage length},
  keywords      = {Anchorages (concrete construction); Anchorages (foundations); Bond length; Bond strength (chemical); Bond strength (materials); Brittle fracture; Concrete buildings; Ductile fracture; High performance concrete; Rebar; Regression analysis; Reinforced concrete; Steel fibers; Structural analysis; Anchorage lengths; Bond performance; Concrete system; Failure mechanism; High-performance concrete; Low carbon; Low-carbon high-performance concrete; Performance; Rebar anchorage length; Steel rebars; computer simulation; failure mechanism; numerical model; performance assessment; reinforced concrete; reinforcement; reliability analysis; steel; Multivariant analysis},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Tong2025_2,
  title         = {Stable production of immortalized hPC-MSC-derived extracellular vesicles: integrated cargo analysis and functional validation},
  author        = {Tong, Yingying and Sun, Jie and Jiang, Xin and Jia, Xu and Jia, Yu and Wang, Hua and Wu, Jiamin and Li, Zhuocheng and Sun, Hui and Yang, Guanghua},
  year          = 2025,
  journal       = {Stem Cell Research and Therapy},
  volume        = 16,
  number        = 1,
  doi           = {10.1186/s13287-025-04743-2},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105020992877&doi=10.1186%2Fs13287-025-04743-2&partnerID=40&md5=2c6a9723a3482b40b274ce293a58bbd7},
  note          = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access},
  abstract      = {Extracellular vesicles (EVs) play a critical role in intercellular communication and have shown great potential in disease treatment and tissue repair. However, large-scale production and clinical application of EVs still face challenges such as donor heterogeneity, batch-to-batch variability, and high production costs. This study aimed to establish a stable and reproducible EV production platform using hTERT-immortalized placental mesenchymal stromal cells (PC-MSCs). We demonstrated that stable expression of the TERT gene promotes cell proliferation in vitro while retaining surface marker expression patterns and differentiation capabilities similar to those of primary cells. The EVs produced by immortalized cells maintain similar particle size distributions, protein markers, and protein expression profiles to those of their parental cells, and their therapeutic efficacy was validated in a bleomycin (BLM)-induced pulmonary fibrosis (PF) rat model. In summary, we systematically described the effect of immortalization via ectopic hTERT gene expression on EVs produced from PC-MSCs. These findings provide a new theoretical basis for the sustainable production and scale-up of EVs, as well as a new solution for the treatment of PF. \textcopyright{} The Author(s) 2025.},
  author_keywords = {Chorionic mesenchymal stromal cells; Extracellular vesicles (EVs); Functional proteins; Immortalization; Pulmonary fibrosis (PF)},
