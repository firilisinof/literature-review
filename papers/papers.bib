@article{Rakshita202316775,
  title         = {Highly efficient and self-activating Zn3V2O8 phosphor for the fabrication of cool-white light emitting devices},
  author        = {Rakshita, M. and Sharma, Aachal A. and Pradhan, Payal P. and Durga Prasad, K.A.K. and Jayanthi, K. and Haranath, D.},
  year          = 2023,
  journal       = {Ceramics International},
  volume        = 49,
  number        = 11,
  pages         = {16775--16785},
  doi           = {10.1016/j.ceramint.2023.02.038},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85149380735&doi=10.1016%2Fj.ceramint.2023.02.038&partnerID=40&md5=0566d968e273bfc3d41cc609ec5c63e4},
  note          = {Cited by: 25},
  abstract      = {Achieving an ideal white light with eco-friendly phosphor material with a high quantum efficiency (QE) together with an appreciable correlated color temperature (CCT) and color rendering index (CRI) is considered as a global challenge. To address the issue, we have fabricated a self-activated Zn<sub>3</sub>V<sub>2</sub>O<sub>8</sub> phosphor-based white light emitting device (WLED) as single emitting compound with desired CCT and color purity values of \sim{}5074 K and 10.47 \texttimes{} 10<sup>-2</sup> respectively, using a moderately low temperature assisted solid-state reaction process carefully ruled out the presence of rare-earth ions. The prepared Zn<sub>3</sub>V<sub>2</sub>O<sub>8</sub> phosphor exhibited a highly visible yellow (575 nm) photoluminescence (PL) induced by the <sup>3</sup>T<sub>2</sub> (t<sub>1</sub><sup>5</sup>2e) \rightarrow{}<sup>1</sup>A<sub>1</sub> and <sup>3</sup>T<sub>1</sub>(t<sub>1</sub><sup>5</sup>2e) \rightarrow{}<sup>1</sup>A<sub>1</sub> (t<sub>1</sub><sup>6</sup>) transitions of vanadate [VO<sub>4</sub>]<sup>3-</sup>, which unveil a significant QE of 67\%. The temperature-dependent PL spectra showed a high thermal stability and CIE color coordinates (0.45, 0.47), falling in the exact yellow region. The combination of Zn<sub>3</sub>V<sub>2</sub>O<sub>8</sub> phosphor and deep blue (405 nm, 40 mW) emission from LED resulted in white light emission with CIE color coordinates and CRI of (0.33, 0.36) and 93, respectively. This work shows that the newly exposed broadband yellow-emitting Zn<sub>3</sub>V<sub>2</sub>O<sub>8</sub> phosphors as a potential candidate for phosphor-converted WLEDs with high color quality via a non-rare-earth activation approach. \textcopyright{} 2023},
  author_keywords = {Deep-blue emitter; Photoluminescence; Vanadate; White-LED},
  keywords      = {Chemical activation; Color; Current density; Fabrication; Light emitting diodes; Metal ions; Photoluminescence; Rare earths; Solid state reactions; Supercomputers; Temperature; Zinc compounds; Color coordinates; Color rendering index; Colour-rendering indices; Cool whites; Correlated color temperature; Deep blue emitters; Vanadate; White LED's; White light; White light emitting device; Phosphors},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Ram20205290,
  title         = {Highly Selective and Rapid Naked-Eye Colorimetric Sensing and Fluorescent Studies of Cu2+Ions Derived from Spherical Nanocellulose},
  author        = {Ram, Bhagat and Jamwal, Shivani and Ranote, Sunita and Chauhan, Ghanshyam S. and Dharela, Rohini},
  year          = 2020,
  journal       = {ACS Applied Polymer Materials},
  volume        = 2,
  number        = 11,
  pages         = {5290--5299},
  doi           = {10.1021/acsapm.0c01025},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85097519439&doi=10.1021%2Facsapm.0c01025&partnerID=40&md5=2ec325e14d53d336dc7d15b729d8cd34},
  note          = {Cited by: 26},
  abstract      = {Nanocellulose has emerged as the most promising sustainable nanomaterial to develop cost-effective smart materials for various applications with consequential positive environmental impact. In the present study, we report spherical nanocellulose (SNC) modified with diethylenetriamine (DETA) and/or ethanolamine (EA) (SNC-DETA, SNC-EA, and SNC-DETA-EA) as Cu<sup>2+</sup>ion sensors. Structure dependence of the sensing properties is the highlight of this work, as SNC-DETA-EA and SNC-DETA showed colorimetric naked-eye and fluorescent activity, with the former showing the same at very low ion concentrations with high selectivity, whereas SNC-EA lacked the same. The solution color changed rapidly to deep blue, and the fluorescence intensity was quenched when the ion concentration increased in the range 0.5-100 ppm, thus facilitating dual-channel ion detection. SNC-DETA-EA showed 1.03 ppm or a 1.622 \texttimes{} 10<sup>-5</sup>M limit of detection and high Cu<sup>2+</sup>ion uptake with maximum Langmuir capacity (q<sub>m</sub>) of 212.76 mg/g. \textcopyright{} 2020 ACS. All rights reserved.},
  author_keywords = {adsorption capacity; Cu<sup>2+</sup>ion sensor; fluorescence quenching; reversibility; spherical nanocellulose},
  keywords      = {Cellulose; Cellulose nanocrystals; Color; Colorimetry; Cost effectiveness; Environmental impact; Fluorescence; Ions; Supercomputers; Colorimetric naked-eye; Colorimetric sensing; Diethylenetriamine; Fluorescence intensities; Ion concentrations; Limit of detection; Sensing property; Structure dependence; Nanocellulose},
  type          = {Article},
