  keywords      = {Computer Graphics; Computer Simulation; Humans; Hydrodynamics; Models, Anatomic; Models, Biological; Respiratory Mechanics; Respiratory System; Computational fluid dynamics; Computer graphics; Computer software selection and evaluation; Medical applications; Program processors; Adaptive meshing; Cartesian mesh; Computation speed; Data access; Gpu clusters; GPU computation; Graphics Processing Unit; High-performance computing; Lattice Boltzmann method; Lattice boltzmann methods (LBM); Medical practice; Optimisations; patient-specific modelling; Pulmonary airflow; Sub-domains; article; audiovisual equipment; biological model; breathing mechanics; comparative study; computer graphics; computer simulation; evaluation; histology; human; hydrodynamics; physiology; respiratory system; Computer graphics equipment},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Mikutaite2026755,
  title         = {Testing Methods for Chemical Prestressing and Adaptation to GFRP Rods},
  author        = {Mikutaite, Vita and Donchev, Ted and Petkova, Diana and Bescher, Eric and Paniagua, Julio},
  year          = 2026,
  journal       = {Lecture Notes in Civil Engineering},
  volume        = {777 Lnce},
  pages         = {755--764},
  doi           = {10.1007/978-3-032-09399-8_71},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105031506710&doi=10.1007%2F978-3-032-09399-8_71&partnerID=40&md5=6f23255575b57178b9b2522ff6c31bf0},
  note          = {Cited by: 0},
  abstract      = {Chemical prestressing of FRP rods is emerging as an alternative solution for external prestressing of FRP rods with wedge anchors. One effective material in this approach is concrete with added Calcium Sulfoaluminate cement (CSA), which not only helps reduce the carbon footprint but also provides expansion characteristics similar to mechanical anchors. Prestressing by about 30\% of ultimate capacity can be a solution to improve serviceability of glass fibre reinforcement bars (GFRP). GFRP with established durability tests and a proven serviceability limit of 100~years could be a potentially economical option. GFRP rebar with proved long term durability and bond strength tests can gain additional benefits from chemical prestressing without a damage to the FRP rebar end. CSA-enhanced concrete demonstrates a high level of residual strain, non-linearity, significant plastic deformation compared to conventional concrete. To evaluate these properties, the Standard Test Method for Restrained Expansion of shrinkage-compensating concrete proved to be the most effective. Initial expansive concrete studies proved that HPC mix achieved higher expansion than NSC mix.To monitor the expansion, a variety of measurement tools were employed, however these techniques will have to be repeated with HPC \&CSA mix. To assess the effects of GFRP chemicaly prestressed structural elements, the right HPC \& CSA balance and numerical analysis must be established. \textcopyright{} The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
  author_keywords = {Chemical Prestresing; CSA; Expansion; FRP; GFRP; Prestressing; Rebar},
  keywords      = {Anchor bolts; Anchors; Bond strength (chemical); Bond strength (materials); Calcium compounds; Concrete mixtures; Concrete testing; Durability; Expansive concrete; Glass fibers; Rebar; Shrinkage; Alternative solutions; Calcium sulfoaluminate cement; Chemical prestresing; Effective materials; External prestressing; FRP; FRP rods; GFRP; Mechanical; Testing method; Expansion; Prestressing},
  type          = {Conference paper},
