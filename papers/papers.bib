@article{DuttaPramanik20225199,
  title         = {Predicting resource availability in local mobile crowd computing using convolutional GRU},
  author        = {Dutta Pramanik, Pijush Kanti and Sinhababu, Nilanjan and Nayyar, Anand and Masud, Mehedi and Choudhury, Prasenjit},
  year          = 2022,
  journal       = {Computers, Materials and Continua},
