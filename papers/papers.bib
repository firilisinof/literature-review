@article{Lv2025,
  title         = {Tailoring MoSe2 microstructure through oxygen-induced strategy for fast and stable potassium ion storage},
  author        = {Lv, Meiying and Ji, Xue-yang and Zhang, Xianghua and Wei, Denghu and Jin, Chuanyu and Du, Yongxu},
  year          = 2025,
  journal       = {Electrochimica Acta},
  volume        = 544,
  doi           = {10.1016/j.electacta.2025.147640},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105020907232&doi=10.1016%2Fj.electacta.2025.147640&partnerID=40&md5=10629f3f71b20aa432b1885c75fa11cb},
  note          = {Cited by: 0},
  abstract      = {Potassium-based energy storage emerges as a promising option for large-scale, sustainable storage solutions, attributed to its cost-effectiveness and abundant availability. However, most high-performance crystalline anodes for potassium ion storage suffer from serious volume expansion and sluggish reaction kinetics. Herein, we propose an innovative oxygen-induced strategy to synthesize low-crystallinity MoSe<sub>2</sub>\@HPC hybrids for efficient potassium ion storage. The design ensures that MoSe<sub>2</sub> can be firmly anchored on hollow porous carbon via enhanced chemical bonding to avoid exfoliation and pulverization over long cycles. Moreover, the unique microstructure of MoSe<sub>2</sub> exposes more active sites to facilitate the adsorption of potassium ions and significantly alleviates volume expansion throughout the electrochemical process. Benefiting from the synergistic advantages of both MoSe<sub>2</sub> microstructure and conductive carbon substrate, the resultant MoSe<sub>2</sub>\@HPC composites demonstrate conspicuous rate capability and excellent cycle life as anodes for potassium ion batteries/capacitors. The oxygen group-induced strategy offers a promising way to regulate the microstructure of two-dimensional materials, as well as paves the path for the rapid development of sustainable energy storage technologies. \textcopyright{} 2025 Elsevier Ltd.},
  author_keywords = {Anode; MoSe<sub>2</sub>; Oxygen induction; Potassium ion storage},
  keywords      = {Carbon; Carbon cycle; Chemical bonds; Cost effectiveness; Energy storage; Ions; Molybdenum compounds; Oxygen; Porous materials; Potassium; Reaction kinetics; Selenium compounds; Storage (materials); Energy; Ion storage; Large-scales; Low crystallinity; Oxygen induction; Performance; Potassium ion storage; Potassium ions; Storage solutions; Volume expansion; Anodes},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
