}
@article{Zhou2025274,
  title         = {Impact of Distributed Generation on the Power Supply Reliability of Distribution Networks and Research on Optical Integration Optimization},
  author        = {Zhou, Yi and Zhao, Xuan and Zhao, Yinan and Li, Shunxin and Zhao, Min},
  year          = 2025,
