  title         = {Performance Comparison of CFD Microbenchmarks on Diverse HPC Architectures},
  author        = {Galeazzo, Flavio C. C. and Garcia-Gasulla, Marta and Boella, Elisabetta and Pocurull, Josep and Lesnik, Sergey and Rusche, Henrik and Bn\`{a}, Simone and Cerminara, Matteo and Brogi, Federico and Marchetti, Filippo and Gregori, Daniele and Wei\ss{}, R. Gregor and Ruopp, Andreas},
  year          = 2024,
  journal       = {Computers},
