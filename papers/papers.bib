  title         = {Toughened cellulose aerogel sustainable electronics with strain-pressure decoupling monitoring and thermochromic visualization},
  author        = {Liu, Shuai and Lai, Shuyu and Li, Wenwen and Wang, Xinyi and Lu, Liang and Wu, Jianpeng and Yao, Yue and Gong, Xinglong and Leung, Ken Cham-Fai and Xuan, Shouhu},
  year          = 2026,
