}
@book{Guerin2023245,
  title         = {Molecular Engineering of Bio-Assemblies: Prospects and Design Rules for Sustainable, Wearable Electromechanical Materials},
  author        = {Guerin, Sarah and Cazade, Pierre-Andr\'{e} and O'Donnell, Joseph and Tofail, Syed A.M. and Thompson, Damien},
