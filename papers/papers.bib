@inproceedings{9996937,
  title         = {moreMCU: A Runtime-reconfigurable RISC-V Platform for Sustainable Embedded Systems},
  author        = {Scheipel, Tobias and Angermair, Florian and Baunach, Marcel},
  year          = 2022,
  month         = {Aug},
  booktitle     = {2022 25th Euromicro Conference on Digital System Design (DSD)},
  pages         = {24--31},
  doi           = {10.1109/dsd57027.2022.00013},
  issn          = {2771-2508},
  abstract      = {As the number of embedded systems continues to grow, so does the amount of disposed electronic devices. This is mainly due to partially or fully outdated hardware, caused by new legal regulations in jurisdiction or cutting-edge features within a new generation of devices or hardware components. As most devices are designed without having long-term maintainability in mind and can be easily replaced without much monetary effort, it is often easier to dispose of them. This throw-away mentality, however, increases the carbon footprint enormously. Within this work, we propose a platform that can be used to design future embedded systems in a more sustainable way by preparing them for long-term hardware adaptations. To do so, we aim to make logic updatable and re-usable while the device stays operational. This is achieved by carefully co-designing an operating system and a microcontroller platform with reconfigurable logic. In this paper, we use a RISC-V-based microcontroller running on a field-programmable gate array. The said microcontroller is designed to feature a modular pipeline and replaceable on-chip peripherals alongside a partial reconfiguration controller that can hot-swap parts of the microcontroller while it is running. It is supported by an operating system that handles the reconfiguration as well as functionality emulation, in case it is not (yet) available in hardware. Both the hardware and the software are aware of each other and can manipulate shared data structures for the management of the reconfiguration concept. The experimental evaluation that was carried out on a Artix-7 device shows the proper operation alongside performance measurements and resource utilization of the on-the-fly reconfiguration of a proof-of-concept system without affecting the execution of the remainder of the system.},
  keywords      = {Measurement;Embedded systems;Microcontrollers;Pipelines;Reconfigurable logic;Hardware;Software;dynamic partial reconfiguration;embedded systems;processor architecture;operating system;hardware software co-design;RISC-V}
}
@conference{Aalto2015,
  title         = {Multi-wavelength transceiver integration on SOI for high-performance computing system applications},
  author        = {Aalto, Timo and Harjanne, Mikko and Ylinen, Sami and Kapulainen, Markku and Vehmas, Tapani and Cherchi, Matteo and Neumeyr, Christian and Ortsiefer, Markus and Malacarne, Antonio},
  year          = 2015,
  journal       = {Proceedings of SPIE - The International Society for Optical Engineering},
  volume        = 9368,
  doi           = {10.1117/12.2079682},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84930150780&doi=10.1117%2F12.2079682&partnerID=40&md5=8cc7c87c5a5c762965dbaf6ed8d99f80},
  note          = {Cited by: 5},
  abstract      = {We present a vision for transceiver integration on a 3 \ensuremath{\mu}m SOI waveguide platform for systems scalable to Pb/s. We also present experimental results from the first building blocks developed in the EU-funded RAPIDO project. At 1.3 \ensuremath{\mu}m wavelength 80 Gb/s per wavelength is to be achieved using hybrid integration of III-V optoelectronics on SOI. Goals include athermal operation, low-loss I/O coupling, advanced modulation formats and packet switching. An example of the design results is an interposer chip that consists of 12 \ensuremath{\mu}m thick SOI waveguides locally tapered down to 3 \ensuremath{\mu}m to provide low-loss coupling between an optical single-mode fiber array and the 3 \ensuremath{\mu}m SOI chip. First example of experimental results is a 4x4 cyclic AWGs with 5 nm channel spacing, 0.4 dB/facet fiber coupling loss, 3.5 dB center-tocenter loss, and -23 dB adjacent channel crosstalk in 3.5x1.5 mm<sup>2</sup> footprint. The second example result is a new VCSEL design that was demonstrated to have up to 40 Gb/s operation at 1.55 \ensuremath{\mu}m. \textcopyright{} 2015 SPIE.},
  author_keywords = {arrayed waveguide grating; electro absorption modulator; hybrid integration; optical interconnect; optical interposer; optical packet switching; optoelectronics; semiconductor optical amplifier; Silicon photonics; silicon-on-insulator; VCSEL},
  keywords      = {Arrayed waveguide gratings; Integration; Lead; Light amplifiers; Optical interconnects; Optical switches; Optical waveguides; Optoelectronic devices; Packet switching; Photonics; Semiconducting silicon; Semiconductor optical amplifiers; Silicon on insulator technology; Single mode fibers; Surface emitting lasers; Transceivers; Waveguides; Hybrid integration; Optical interconnect; optical interposer; Optical packet switching; Silicon photonics; Optical fiber coupling},
  type          = {Conference paper},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Abbas2018199,
  title         = {Simplex-lattice strength and permeability optimization of concrete incorporating silica fume and natural pozzolan},
  author        = {Abbas, Y.M.},
  year          = 2018,
  journal       = {Construction and Building Materials},
  volume        = 168,
  pages         = {199--208},
  doi           = {10.1016/j.conbuildmat.2018.02.144},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85042403613&doi=10.1016%2Fj.conbuildmat.2018.02.144&partnerID=40&md5=fbd92e3a60ec90f536794f084790b083},
  note          = {Cited by: 16},
  abstract      = {In this paper, 24 high performance concrete (HPC) mixtures with 0.25 and 0.40 water-to-binder ratios (w/b) were designed and cast with binary and ternary blends of Portland cement (PC), silica fume (SF) and natural pozzolan (NP). The effect of using NP and SF on the strength and the chloride permeability of the concrete was investigated. The experimental results and simplex-lattice theory were used to develop the quadratic and third order analytical models for predicting the strength and the permeability of HPC. ANOVA confirms the accuracy of the quadratic model and therefore its efficiency requires relatively less experimental data. Two different numerical methods have been used to optimize the cementitious components of HPC using the quadratic model and lower and upper bounds of the experimental test results. Firstly, the ``solver'' tool of MS office provides unique optimum components of PC, SF and NP. The corresponding optimum percentages (by weight) of PC, SF and NP for HPC with 0.25 and 0.40 w/b are 86.04\%, 8.16\% and 5.80\% and 88.78\%, 5.85\% and 5.37\%, respectively. Secondly, the ternary plots produced by MATLAB establishes a single area for manufacturing HPC with w/b of 0.40 (the optimized PC-SP-NP component ranges are 0.875–0.925, 0.10–0.15 and 0.000–0.075, respectively) and two candidate superior strength zones for developing HPC with w/b of 0.25 (the optimum PC-SP-NP components are 0.875–0.950, 0.050–0.075, and 0.00–0.08 or 0.875–0.900, 0.08–0.15, and 0.12–0.22, respectively). For better sustainable, cost-effect and eco-friendly designs, it is suggested to use the topography of the targeted response surface for optimization purposes. \textcopyright{} 2018 Elsevier Ltd},
  author_keywords = {Concrete strength; Modeling; Natural pozzolan; Optimization; Permeability; Silica fume; Simplex-lattice design},
  keywords      = {Binary mixtures; Bins; Chlorine compounds; Concrete mixtures; Concretes; High performance concrete; Mechanical permeability; Models; Numerical methods; Optimization; Portland cement; Pozzolan; Silica; Silica fume; Chloride permeability; Concrete strength; Experimental test; Lower and upper bounds; Natural pozzolan; Quadratic modeling; Simplex-lattice design; Water-to-binder ratio; Lattice theory},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
