  author        = {Kang, Shujiang and Nair, Sujithkumar Surendran and Kline, Keith L. and Nichols, Jeffrey A. and Wang, Dali and Post, Wilfred M. and Brandt, Craig C. and Wullschleger, Stan D. and Singh, Nagendra and Wei, Yaxing},
  year          = 2014,
  journal       = {GCB Bioenergy},
