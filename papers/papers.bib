}
@article{Wang2025_2,
  title         = {Super-hydrophilic cellulose-based aerogel with designed hierarchical porous structure for efficient solar-driven interfacial evaporation},
  author        = {Wang, Daxin and Zong, Jiale and Dai, Yunfei and Zhang, Zhiwei and Zang, Xiaoling},
  year          = 2025,
  journal       = {Separation and Purification Technology},
  volume        = 377,
  doi           = {10.1016/j.seppur.2025.134372},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105010872819&doi=10.1016%2Fj.seppur.2025.134372&partnerID=40&md5=483c453673bd69a9819dc83a7201bc14},
  note          = {Cited by: 2},
  abstract      = {Solar-driven interfacial water evaporation has been recognized as a sustainable and energy-efficient solution for addressing global freshwater scarcity. With the development of advanced photothermal materials in recent years, optimizing vertical mass transport within evaporators has become critical for performance enhancement. In this study, we developed a super-hydrophilic HPC-PVA/GN aerogel featuring a hierarchical pore structure, fabricated through chemical crosslinking and freeze-drying strategies. Among the components, graphene exhibits excellent photothermal conversion performance, providing the necessary thermal energy for the evaporation process. Meanwhile, the synergistic effect of superhydrophilicity and the engineered hierarchical pores facilitates efficient mass transfer within the HPC-PVA/GN aerogel. Consequently, the aerogel achieves an evaporation rate of 3.08 kg m<sup>-2</sup>h<sup>-1</sup> under 1 kW/m<sup>2</sup> simulated solar illumination and demonstrates exceptional stability. Furthermore, the HPC-PVA/GN aerogel exhibits excellent salt resistance in high-salinity environments, maintaining stable evaporation without salt accumulation. This strategy provides new insight for designing efficient solar-driven evaporators and offers a promising design framework for desalination systems. \textcopyright{} 2025 Elsevier B.V.},
  author_keywords = {Hierarchical pores; HPC aerogel; Photothermal conversion; Solar interfacial evaporator; Super-hydrophilic},
  keywords      = {Aerogels; Deionization; Evaporation; Evaporators; Exhibitions; Mass Transfer; Performance; Polyvinyl Acetate; Aerogels; Crosslinking; Desalination; Energy efficiency; Evaporation; Mass transfer; Pore structure; Superhydrophilicity; Energy efficient; Hierarchical pores; Hierarchical porous structures; HPC aerogel; Hydrophilic cellulose; Interfacial water; Photothermal conversion; Solar interfacial evaporator; Super-hydrophilic; Water evaporation; Evaporators},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Wang2025_3,
  title         = {Artificial General Intelligence (AGI) Applications and Prospect in Oil and Gas Reservoir Development},
  author        = {Wang, Jiulong and Luo, Xiaotian and Zhang, Xuhui and Du, Shuyi},
  year          = 2025,
  journal       = {Processes},
  volume        = 13,
  number        = 5,
  doi           = {10.3390/pr13051413},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105006760066&doi=10.3390%2Fpr13051413&partnerID=40&md5=30ac8d13f2d5bb2632604136a22e9baf},
  note          = {Cited by: 4; All Open Access; Gold Open Access},
  abstract      = {The cornerstone of the global economy, oil and gas reservoir development, faces numerous challenges such as resource depletion, operational inefficiencies, safety concerns, and environmental impacts. In recent years, the integration of artificial intelligence (AI), particularly artificial general intelligence (AGI), has gained significant attention for its potential to address these challenges. This review explores the current state of AGI applications in the oil and gas sector, focusing on key areas such as data analysis, optimized decision and knowledge management, etc. AGIs, leveraging vast datasets and advanced retrieval-augmented generation (RAG) capabilities, have demonstrated remarkable success in automating data-driven decision-making processes, enhancing predictive analytics, and optimizing operational workflows. In exploration, AGIs assist in interpreting seismic data and geophysical surveys, providing insights into subsurface reservoirs with higher accuracy. During production, AGIs enable real-time analysis of operational data, predicting equipment failures, optimizing drilling parameters, and increasing production efficiency. Despite the promising applications, several challenges remain, including data quality, model interpretability, and the need for high-performance computing resources. This paper also discusses the future prospects of AGI in oil and gas reservoir development, highlighting the potential for multi-modal AI systems, which combine textual, numerical, and visual data to further enhance decision-making processes. In conclusion, AGIs have the potential to revolutionize oil and gas reservoir development by driving automation, enhancing operational efficiency, and improving safety. However, overcoming existing technical and organizational challenges will be essential for realizing the full potential of AI in this sector. \textcopyright{} 2025 by the authors.},
  author_keywords = {artificial intelligence; large language models; oil and gas reservoir development},
  keywords      = {Advanced Analytics; Data accuracy; Drilling equipment; Electric prospecting; Electromagnetic prospecting; Exploratory oil well drilling; Gas oils; Gravitational prospecting; Intelligent well technology; Magnetic prospecting; Offshore petroleum prospecting; Petroleum reservoir evaluation; Prediction models; Proven reserves; Radioactive prospecting; Seismic prospecting; Artificial general intelligences; Decision-making process; Gas reservoir development; Global economies; Language model; Large language model; Oil and gas reservoir; Oil-reservoir development; Resource depletion; Safety concerns; Gas industry},
  type          = {Review},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Wang2025_4,
  title         = {ANN-based prediction of compressive strength in sustainable HPC using industrial waste},
  author        = {Wang, Caijin and Zhang, Hongjian and Xie, Liangfu and Zhu, Chuanxin and Jin, Zhiyi and Hu, Xueling and Zhang, Tao and Cai, Guojun and Liu, Songyu},
  year          = 2025,
  journal       = {Construction and Building Materials},
  volume        = 505,
  doi           = {10.1016/j.conbuildmat.2025.144780},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105024067385&doi=10.1016%2Fj.conbuildmat.2025.144780&partnerID=40&md5=3c5dcf9238fdc5ddf970aed4712d9156},
  note          = {Cited by: 2; All Open Access; Hybrid Gold Open Access},
  abstract      = {Sustainable high-performance concrete (HPC) with industrial waste is a new building material with environmental significance and engineering value. As a critical parameter of construction materials, the compressive strength of concrete is an important index for determining the practical engineering application of concrete materials, and it is of great significance to accurately predict the compressive strength of sustainable HPC with industrial waste. This study uses an improved artificial neural network (ANN) model to predict the compressive strength of sustainable HPC with industrial waste, considering eight input parameters. A high-performance concrete compressive strength prediction model based on ANNs was established using different optimization algorithms, and the model was validated using K-fold cross-validation. The proposed ANN model, optimized with virus colony search (VCS), achieved coefficient of determination R <sup>2</sup>> 0.97, root mean squared error ( RMSE ) of 1.95–2.33 MPa, and mean absolute error ( MAE ) of 1.26–1.39 MPa, outperforming traditional models. This research result plays an important role in accurately predicting the compressive strength of sustainable HPC under different mix ratios. \textcopyright{} 2025 Elsevier Ltd.},
  author_keywords = {ANN; Compressive strength; K-fold cross-validation; Optimization algorithm; Sustainable concrete},
  keywords      = {Forecasting; High performance concrete; Industrial wastes; Neural networks; Optimization; Prediction models; Sustainable development; Artificial neural network modeling; Compressive strength of concrete; Environmental significance; High-performance concrete; K fold cross validations; Network-based; Neural-networks; New building materials; Optimization algorithms; Sustainable concretes; Compressive strength},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Wang202510968,
  title         = {Scalable Production of Hygroscopic Gel Spheres to Enhance Seedling Growth via Atmospheric Water Harvesting and Controlled Fertilizer Release},
  author        = {Wang, Xiangbing and Sun, Kanjun and Peng, Hui and Zhang, Zhe and Zhang, Wenxu and Ma, Guofu},
  year          = 2025,
  journal       = {Environmental Science and Technology},
  volume        = 59,
  number        = 22,
  pages         = {10968--10979},
  doi           = {10.1021/acs.est.5c02795},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105006823657&doi=10.1021%2Facs.est.5c02795&partnerID=40&md5=04f1dfaa3da291590ddf815e91f95801},
  note          = {Cited by: 11},
  abstract      = {Atmospheric water harvesting (AWH) technologies offer potential solutions for alleviating agricultural water scarcity. However, it faces significant challenges, including environmental compatibility, scalability, and multifunctional integration. Therefore, there is an urgent need for novel strategies to improve agricultural water use efficiency. Herein, natural polysaccharides sodium alginate (SA) and thermoresponsive hydroxypropyl cellulose (HPC) are selected as the matrix, with SA cross-linking with Ca<sup>2+</sup> to enable rapid gelation and continuous production of shape-controllable spheres. Additionally, carbon black (CB) and urea are incorporated through physical doping and chemical interactions to enable solar energy collection and slow-release fertilization. The synergistic effect of the hygroscopic salt and porous matrix resulted in water uptake of 0.64-3.38 g g<sup>-1</sup> at 30-90\% relative humidity. The photothermal of CB, combined with the low-temperature phase transition of HPC, facilitated low-temperature desorption and rapid solar-driven water release, achieving maximum desorption rate of 4.07 g g<sup>-1</sup> h<sup>-1</sup>. Notably, as water was released from the material and the matrix degraded, urea was gradually discharged, with release of 224.6 \pm{} 5.2 mg kg<sup>-1</sup> over 30 days, providing sustained support for crop growth. This innovative approach provides sustainable and geographically unconstrained solution for agricultural water management in arid regions. \textcopyright{} 2025 American Chemical Society.},
  author_keywords = {controlled fertilizer release; Hygroscopic materials; solar-thermal conversion; water harvesting},
  keywords      = {Fertilizers; Harvesting; Hydroxypropyl Cellulose; Production; Release; Spheres; Temperature; Water Management; Agriculture; Alginates; Cellulose; Fertilizers; Gels; Seedlings; Water; Fertilizers; Low temperature production; Wastewater treatment; alginic acid; calcium ion; carbon; fertilizer; gel; hydroxypropylcellulose; polysaccharide; sodium chloride; urea; cellulose; gel; water; Atmospheric water; Controled fertilizer release; Gel spheres; Hydroxypropyl cellulose; Hygroscopic materials; matrix; Scalable production; Seedling growth; Solar thermal conversion; Water harvesting; arid region; black carbon; calcium; fertilizer; hygroscopicity; relative humidity; seedling; solar power; urea; water management; water use efficiency; Article; chemical interaction; cross linking; degradation; desorption; fertilization; fluid intake; gelation; harvesting; low temperature; moisture; nonhuman; phase transition; plant growth; plant water use; relative humidity; solar energy; synergistic effect; water insecurity; water management; water transport; agriculture; chemistry; growth, development and aging; seedling; Crosslinking},
  type          = {Article},
