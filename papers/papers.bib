@conference{Cizmar2006429,
  title         = {Arch bridge made of reactive powder concrete},
  author        = {Cizmar, D. and Mestrovic, D. and Radic, J.},
  year          = 2006,
  journal       = {WIT Transactions on the Built Environment},
  volume        = 85,
  pages         = {429--437},
  doi           = {10.2495/hpsm06042},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-36148966198&doi=10.2495%2FHPSM06042&partnerID=40&md5=7fdefa36acc82dc99a083553bcbfd899},
  note          = {Cited by: 2; All Open Access; Bronze Open Access},
  abstract      = {Concrete is the most commonly used building material. It is used for buildings, industrial structures, bridges and dams. Every day the concrete is being improved, to achieve better characteristics, reduce price and to be environmental acceptable. In the introduction an historical overview of concrete is given - beginning in the 1950s when the compression strength was 40 N/mm2. Today this is the Industry standard. Concrete with compression strength greater than 40 N/mm2 is called high performance concrete (HPC). The first HPS concretes were made in 1960. Around 1990, Reactive Powder Concrete (RPC) started to appear. Their strengths go up to 800 N/mm<sup>2</sup>. Today, HPC is limited to bridges, and RFC is still very rarely used. In this work we present a method for making a RFC composite material with a compression strength of up to 170 N/mm<sup>2</sup>. Preparation and testing of material is performed in the laboratory of the Faculty of Civil Engineering in Zagreb. In addition to the mechanical properties, the durability parameters are also tested. Detailed concrete mix proportions are given in the article. The possibility that RFC could be used to construct an arch bridge over Bakar strait (Croatia) is analyzed. The bridge would have arch span of 432 m. Due to very high compression strength of RFC the span length may be increased, therefore reducing the total construction cost. RFC is also used to increase the resistance to freeze-thaw cycles, increase abrasion resistance, and reduce chloride permeability. Many large Adriatic bridges have experienced durability problems that are primarily the result of using standard concrete. Each of these durability enhancements provided by RFC decrease maintenance costs and lengthens the service life of a structure, which is vital for bridges in the Adriatic region.},
  author_keywords = {Arch bridge; Construction technology; Reactive powder concrete (RPC)},
  keywords      = {Building materials; Civil engineering; Concretes; Cost effectiveness; Environmental impact; Mechanical properties; arch; bridge; compressive strength; concrete; conference proceeding; freeze-thaw cycle; Compression strength; Construction technology; Industrial structures; Reactive powder concrete (RPC); Arch bridges},
  type          = {Conference paper},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Clancy20242161,
  title         = {Spatiotemporal dynamics of hippocampal-cortical networks underlying the unique phenomenological properties of trauma-related intrusive memories},
  author        = {Clancy, Kevin J. and Devignes, Quentin and Ren, Boyu and Pollmann, Yara and Nielsen, Sienna R. and Howell, Kristin and Kumar, Poornima and Belleau, Emily L. and Rosso, Isabelle M.},
  year          = 2024,
  journal       = {Molecular Psychiatry},
  volume        = 29,
  number        = 7,
  pages         = {2161--2169},
  doi           = {10.1038/s41380-024-02486-9},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85186866943&doi=10.1038%2Fs41380-024-02486-9&partnerID=40&md5=613f3040ac02943051dfc1f6afd4708d},
  note          = {Cited by: 9; All Open Access; Green Open Access; Hybrid Gold Open Access},
  abstract      = {Trauma-related intrusive memories (TR-IMs) possess unique phenomenological properties that contribute to adverse post-traumatic outcomes, positioning them as critical intervention targets. However, transdiagnostic treatments for TR-IMs are scarce, as their underlying mechanisms have been investigated separate from their unique phenomenological properties. Extant models of more general episodic memory highlight dynamic hippocampal-cortical interactions that vary along the anterior-posterior axis of the hippocampus (HPC) to support different cognitive-affective and sensory-perceptual features of memory. Extending this work into the unique properties of TR-IMs, we conducted a study of eighty-four trauma-exposed adults who completed daily ecological momentary assessments of TR-IM properties followed by resting-state functional magnetic resonance imaging (rs-fMRI). Spatiotemporal dynamics of anterior and posterior hippocampal (a/pHPC)-cortical networks were assessed using co-activation pattern analysis to investigate their associations with different properties of TR-IMs. Emotional intensity of TR-IMs was inversely associated with the frequency and persistence of an aHPC-default mode network co-activation pattern. Conversely, sensory features of TR-IMs were associated with more frequent co-activation of the HPC with sensory cortices and the ventral attention network, and the reliving of TR-IMs in the ``here-and-now'' was associated with more persistent co-activation of the pHPC and the visual cortex. Notably, no associations were found between HPC-cortical network dynamics and conventional symptom measures, including TR-IM frequency or retrospective recall, underscoring the utility of ecological assessments of memory properties in identifying their neural substrates. These findings provide novel insights into the neural correlates of the unique features of TR-IMs that are critical for the development of individualized, transdiagnostic treatments for this pervasive, difficult-to-treat symptom. \textcopyright{} The Author(s) 2024.},
  keywords      = {Adult; Brain Mapping; Cerebral Cortex; Emotions; Female; Hippocampus; Humans; Magnetic Resonance Imaging; Male; Memory; Memory, Episodic; Mental Recall; Nerve Net; Stress Disorders, Post-Traumatic; Young Adult; adult; angular gyrus; anterior insula; Article; autobiographical memory; Autobiographical Memory Questionnaire; Clinician Administered Posttraumatic Stress Disorder Scale for DSM-5; default mode network; dorsal anterior cingulate cortex; dorsal attention network; dorsal hippocampus; dorsolateral prefrontal cortex; DSM-5; dynamics; ecological momentary assessment; female; frontoparietal network; functional magnetic resonance imaging; hippocampal-cortical network; human; image analysis; Life Events Checklist for DSM-5; Likert scale; major clinical study; male; medial prefrontal cortex; memory; middle frontal gyrus; nerve cell network; phenomenology; posterior cingulate; posttraumatic stress disorder; posttraumatic stress disorder checklist; questionnaire; recall; salience network; sensorimotor cortex; spatiotemporal analysis; superior frontal gyrus; superior parietal lobule; supramarginal gyrus; trauma-related intrusive memory; ventral attention network; visual cortex; brain cortex; brain mapping; diagnostic imaging; emotion; episodic memory; hippocampus; memory; nerve cell network; nuclear magnetic resonance imaging; pathophysiology; physiology; posttraumatic stress disorder; procedures; psychology; young adult},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@conference{Clave2023,
  title         = {Optimizing the Balance Between Production Availability, Capex and Opex of Projects While Managing Environmental Aspects with a Simulation Tool},
  author        = {Clav\'{e}, N. and Est\'{e}cahandy, M.},
  year          = 2023,
  journal       = {Society of Petroleum Engineers - ADIPEC, ADIP 2023},
  doi           = {10.2118/216865-ms},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85176814663&doi=10.2118%2F216865-MS&partnerID=40&md5=62ed26fed377eca5255505e1cf9824b1},
  note          = {Cited by: 0},
  abstract      = {With economic and environmental constraints growing stronger every day, engineering high-performance system architectures at an acceptable cost is of critical importance. The ability to quickly model the various alternatives under consideration in order to calculate their production availability plays a key role here. The basis of the technique our team worked out is in fact not really new. The idea is to build a Production Availability or RAM model into a specific tool in a block flow diagram format, that is a well-known approach. Then, by integrating GHG emission estimates and costs, and by modeling the different options under study, the results obtained can provide decision aid support to project teams and operated sites. Many aspects can be tested on future or new installations: design/redundancy levels, operating philosophy, maintenance philosophy, spare part management\ldots{} The final objective is to compare the different options and determine the one optimizing at the best the balance between performances, costs, and environmental aspects. It is important to point out that economic i.e. CAPEX, OPEX, cash flow, NPV\ldots{} calculations performed can only provide rough estimates. Indeed, all topics being not covered in detail, these first economic results have to be confirmed by real calculations performed by architects or strategy team members. The new modeling/simulation tool has been developed in the GRIF software suite environment and is named GRIF-Petro. It is the only software module of its kind in our industry. It has significantly modified the working methods of our reliability engineers and field development engineers, providing effective decision support. It has enabled us to test and validate proposals that have reduced CAPEX and OPEX by more than \$400 million over the past 3 years. New uses for these models are likely to emerge as modeling times are drastically reduced and the solution is connected to our supercomputer. First, our team would like to acknowledge and give our warmest thanks to Jean-Pierre Signoret, retired from TotalEnergies, for having developed 40 years ago the mathematical bases of GRIF that still today make this multi-approach tool one of the best RAM analysis software of the market. Jean-Pierre also conducted the first development activities that allowed to obtain the first interfaces and the first modules of the software suite in the early 2000s. \textcopyright{} 2023, Society of Petroleum Engineers.},
  author_keywords = {CAPEX estimates; Dependability simulation; Economics; Monte-Carlo simulation; OPEX estimates; Petri Nets; Probabilistic model; Production availability; Production performance forecast},
  keywords      = {Cost benefit analysis; Cost engineering; Cost estimating; Decision support systems; Engineers; Gasoline; Greenhouse gases; Intelligent systems; Monte Carlo methods; Supercomputers; CAPEX and OPEX; CAPEX estimate; Dependability simulation; Environmental aspects; Monte Carlo's simulation; OPEX estimate; Probabilistic models; Production availability; Production performance; Production performance forecast; Petri nets},
  type          = {Conference paper},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Coady2023119,
  title         = {Strengthening Prevention Systems to Address the Overdose Crisis Through the HEAL Prevention Cooperative and HEAL Preventing Opioid Use Disorder Research Program},
  author        = {Coady, Jeffrey A. and Nadal, Nelia C.},
