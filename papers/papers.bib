@inproceedings{11413413,
  title         = {Innovative Thermal Design: How Nature is Redefining Heat Management in Supercomputing},
  author        = {Jain, Siddharth and Kaur, Damanpreet and Kakkar, Rajan and Sharma, Nikhil and Sarkar, Tiyas},
  year          = 2025,
  month         = {Dec},
  booktitle     = {2025 IEEE International Conference on Recent Advances in Computing and Systems (REACS)},
  pages         = {1--5},
  doi           = {10.1109/reacs67479.2025.11413413},
  abstract      = {The urgent need to properly manage thermal conditions of supercomputing systems has become increasingly important because of their rising complexity and performance levels. The three standard cooling techniques that use air cooling fans alongside liquid circuits along with elaborate refrigerant systems prevail yet fail to strike equilibrium between environmental sustainability and operational performance. The deployment of such conventional cooling methods consumes vast amounts of power and results in substantial operational expenses alongside environmental deterioration. A meaningful change has occurred through implementing nature-based cooling solutions during the past few years. Thermal load reduction and energy reduction become achievable through innovative utilization of environmental resources including cold air from outdoor temperatures, ocean water, underground temperatures and glacial environments by organizations today. Several real-life examples prove natural cooling methods effective for large-scale high-performance computing operations: Microsoft uses underwater facilities while Facebook operates in Arctic conditions and Google accesses ocean water for cooling. The study evaluates heat management evolution by studying standard cooling practices against nature-driven heat removal solutions. The research explores ways to use natural elements for improving thermal efficiency while simultaneously reducing operational costs toward creating sustainable computing systems. The paper demonstrates through quantitative assessment and concrete environmental applications that natural elements are effective solutions for supercomputing heat management.},
  keywords      = {Heating systems;Cooling;Social networking (online);Green products;Thermal management;Internet;Sustainable development;Water resources;Thermal stability;Ocean temperature;Supercomputing;Thermal Management;Nature-Inspired Cooling;Environmental Cooling;Sustainable Computing;Liquid Cooling;High- Performance Computing (HPC);Eco-Friendly Technology;Heat Dissipation;Green Data Centers;External Environment Cooling;Energy-Efficient Design}
}
@inproceedings{11413864,
  title         = {The Inevitable Shift to Liquid Cooling in Data Centers},
  author        = {Polidoro, Charlie},
  year          = 2026,
  month         = {Feb},
  booktitle     = {2026 Pan Pacific Strategic Electronics Symposium (Pan Pacific)},
  pages         = {67--71},
  doi           = {10.23919/PanPacific70217.2026.11413864},
  abstract      = {The accelerating expansion of data centers have heightened the demand for cooling systems that are both efficient and sustainable. This paper examines the performance, safety, and compatibility of three immersion-cooling fluids: a hydrocarbon oil, Thermasolv ${ }^{\text{TM}}$ CF2 (a fluorinated single-phase fluid), and Thermasolv ${ }^{\text{TM}}$ IM6 (a fluorinated two-phase fluid). Traditionally, air-cooled systems have had limitations in managing high-density workloads. Air-cooled data centers contribute significantly to energy consumption, water usage, and operational costs. As artificial intelligence (AI), highperformance computing, and hyperscale cloud services expand, two-phase immersion cooling has emerged as a viable alternative. This technology immerses IT hardware in dielectric heat-transfer fluids, allowing for significantly improved thermal management, reduced reliance on mechanical refrigeration, and improved Power Usage Effectiveness (PUE). The favorable characteristics of most dielectric fluids allow for optimal surface contact which contributes to a superior heat transfer performance. Case studies demonstrate that immersion cooling can reduce cooling energy consumption related to air handling systems and pumps by up to 40\% and support rack densities exceeding 100 kW which exceed the limits of air-cooled systems. The need for increased data center capacity has made efficient and sustainable two-phase cooling solutions a critical priority.},
  keywords      = {Data centers;Fluids;Cooling;Oils;Immersion cooling;Hydrocarbons;Market research;Safety;Artificial intelligence;Water resources;Data Centers;Two-Phase Immersion Cooling (2PIM);Direct to Chip (D2C);Liquid Cooled Servers;Power Usage Effectiveness (PUE);Artificial Intelligence (AI);Rack Density}
}
@inproceedings{11414602,
  title         = {Smart Farm Productivity Monitoring Model Based on Task Offloading in Edge-Cloud Architecture},
  author        = {Zhang, Wenmei and Jin, Wenquan and Lu, Ziyuan and Wu, Yujing and Xu, Yihu and Qi, Yingxin},
  year          = 2025,
  month         = {Dec},
  booktitle     = {2025 5th International Conference on High Performance Computing, Big Data and Communication Engineering (ICHBC)},
  pages         = {150--153},
  doi           = {10.1109/ichbc68357.2025.11414602},
  abstract      = {Smart farm productivity monitoring is pivotal for advancing agricultural intelligence, ensuring food security, and promoting sustainable development. To achieve the efficient operation and precise management of smart farms, traditional monitoring solutions, whether cloud-centric or standalone edgebased, suffer from inherent flaws such as excessive latency, inefficient bandwidth utilization, and unbalanced computing resource allocation, failing to meet the real-time and precise demands of modern smart farms. To address these challenges, this paper proposes a smart farm productivity monitoring model based on edge-cloud architecture and enhanced by task offloading. The proposed model leverages the high-performance computing and storage capabilities for performing intensive tasks including model training and global data analysis. Therefore, edge devices are enabled to provide real-time data collection, lightweight preprocessing and low-latency monitoring tasks through offloading prediction task to the network edges. The proposed edge-cloudbased model supports an efficient smart farm monitoring workflow that achieves accurate identification of farm productivity by delivering information to the cloud instead of large-size image data. Therefore, the monitoring is operated by edge layer to derive the information of farm environment. Furthermore, the delivered farm information is used for presenting the real-environment in the cloud layer.},
  keywords      = {Smart agriculture;Productivity;Training;Image edge detection;Computational modeling;Computer architecture;Predictive models;Data models;Real-time systems;Monitoring;smart farms;edge-cloud architecture;deep learning;task offloading;productivity monitoring}
}
@inproceedings{11416412,
  title         = {Application of Deep Reinforcement Learning in FPGA Multi-Frequency Clock Phase-Shifting Adaptive Measurement},
  author        = {Yulong, Zhao and Jianxiang, Wang and Qian, Wang and Dongjun, Wang and Zhiwei, Cai and Kuan, Wang},
  year          = 2025,
  month         = {Nov},
  booktitle     = {2025 2nd International Conference on Computer Communication, Networks and Information Science (CCNIS)},
  pages         = {508--515},
  doi           = {10.1109/ccnis69465.2025.00090},
  abstract      = {This paper, in view of traditional FPGA clock frequency phase shift in a dynamic environment adaptive measuring method, precision limited problem, this study proposes a reinforcement learning based on depth (DRL) adaptive measurement algorithm. By constructing a decision-making framework for the interaction between the agent and the environment, a multi-dimensional state space is designed, which includes clock frequency characteristics, phase deviation indicators, environmental interference parameters and system resource states, and a discrete-continuous hybrid action space is determined, such as phase adjustment and measurement strategy selection. As the core, combined with the phase deviation both reward function, resource consumption and environmental interference ResNet and attention mechanism of hybrid neural network is adopted to improve the end-to-end optimization. The experimental results show that compared with traditional method, the DRL will measure precision up to 30 ps, precision is 47\%. At the same time, through the model pruning and knowledge distillation technology, the computing resource consumption is reduced by 63\%. The algorithm in dynamic change frequency clock jitter and + 15 ps environment conditions show the strong robustness, precision measuring equipment for high performance computing and provides a high precision, low utilization of adaptive measuring solution.},
  keywords      = {Temperature measurement;Phase measurement;Voltage measurement;Heuristic algorithms;Computational modeling;Extraterrestrial measurements;Deep reinforcement learning;Frequency measurement;Field programmable gate arrays;Clocks;deep learning;FPGA;Adaptive;Measurement;Phase shift}
}
@inproceedings{11424539,
  title         = {Extending the Service Life and Enhancing Efficiency of Panel Boards in High-Demand Environments},
  author        = {Gabeur, Pascal and Ezhaya, James and Kidd, David and Hu, Yunwei and Yellamati, David and Goktas, Yavuz},
  year          = 2026,
  month         = {Jan},
  booktitle     = {2026 Annual Reliability and Maintainability Symposium (RAMS)},
  pages         = {1--6},
  doi           = {10.1109/rams50514.2026.11424539},
  issn          = {2577-0993},
  abstract      = {SUMMARYThe demand for electrical power is increasing at an unprecedented rate, driven by the explosive growth of Artificial Intelligence (AI) and the corresponding rise in high-performance computing workloads. In data centers, this surge is pushing the limits of power consumption, requiring robust and scalable infrastructure to support AI-driven operations.Modern data center power distribution architectures are designed to deliver reliable and redundant power from utility sources through switchgear, UPS systems, and distribution units, ultimately reaching server racks via low-voltage panel boards. These panel boards are critical components that manage and distribute power to both compute systems and auxiliary infrastructure such as liquid cooling systems, including chillers and pumps.As server hardware evolves and current densities increase, panel boards must be engineered to remain resilient under elevated thermal and electrical stresses. While liquid cooling improves energy efficiency at the rack level, panel boards must accommodate the increased power demands of both the servers and the cooling systems. This results in higher current flow, which can lead to localized heat losses, accelerated aging, and reduced service life, ultimately impacting the energy efficiency and sustainability of the data center.To address these challenges, we have developed a systematic framework that begins with an analysis of Data Center workloads, environmental conditions, and operating profiles. These inputs are used to identify thermal hotspots and quantify the service life of panel boards under realistic stress conditions. The framework integrates field failure data, mission profile analysis, thermal modeling, and fault tree analysis to pinpoint vulnerabilities and contributing factors.A Design of Experiments (DoE) was created to evaluate thermal stresses under various factors. We investigated the dominant failure mechanisms and identified metrics to monitor degradation. Reliability targets were allocated using a Reliability Block Diagram (RBD) and engineering judgment, which informed the sample size and test duration for an Accelerated Life Test (ALT). A custom test setup was developed to execute the ALT.The DoE and ALT will be implemented, and the resulting data will be used to develop an optimization model aimed at minimizing energy consumption and carbon emissions (CO2e). CO2e, or carbon dioxide equivalent, is a standardized metric used to quantify the total impact of greenhouse gases on climate change. This framework is currently being applied to one panel product, with plans to scale across applicable product lines to enhance reliability and sustainability.The methodology combines several analytical approaches:\textbullet{}Pareto Analysis of Field Failures\textbullet{}Mission Profile Impact Analysis\textbullet{}Thermal Modeling\textbullet{}Qualitative Fault Tree Analysis (FTA)\textbullet{}Design of Experiments (DoE)\textbullet{}Accelerated Life Test (ALT)\textbullet{}Reliability Block Diagram (RBD)Qualitative FTA is used to identify areas of weaknesses and potential factors contributing to the weaknesses. RBD and allocation analysis is used to allocate reliability targets. The data generated from DoE and ALT tests will be utilized to set a baseline and optimize mean life for energy savings and reduced CO2e by determining design solutions aimed at extending the lifetime of the panel boards.This paper outlines a roadmap for advancing reliability engineering practices in the context of electrical distribution equipment, with a particular focus on enhancing the quality, resilience, and sustainability of panel boards used in high-demand environments such as data centers.The proposed framework not only addresses the immediate challenges posed by increasing current densities and thermal stresses but also enables continuous improvement in reliability assessment and design optimization. By integrating mission profile analysis, thermal modeling, and accelerated life testing, the approach provides a quantitative foundation for predicting service life and optimizing performance with respect to energy consumption and carbon emissions (CO2e).},
  keywords      = {Analytical models;Thermal engineering;Reliability engineering;Carbon dioxide equivalent;Thermal analysis;Reliability;Servers;Sustainable development;Thermal stresses;Stress;Circuit Breaker;Mission Profile;DOE;P-Diagram;FTA;RBD;CO2e}
}
@inproceedings{11433351,
  title         = {Dynamic Resource Management in HPC Systems Using Dynamic Processes with PSets},
  author        = {Huber, Dominik and Gaddameedi, Keerthi and Neckel, Tobias and Bungartz, Hans-Joachim and Schulz, Martin and Dutot, Pierre-Fran\c{c}ois and Richard, Olivier and Schreiber, Martin and Iserte, Sergio and Pena, Antonio},
  year          = 2025,
  month         = {Dec},
  booktitle     = {2025 IEEE 32nd International Conference on High Performance Computing, Data, and Analytics (HiPC)},
  pages         = {279--289},
  doi           = {10.1109/HiPC66333.2025.00036},
  issn          = {2640-0316},
  abstract      = {With the increasing scale of High-Performance Computing (HPC) systems and a new awareness of the environmental impact of HPC, new strategies are required to improve the efficiency of resource usage on these systems. One such strategy is Dynamic Resource Management (DRM), which allows changing the resources assigned to a job dynamically during its execution. This increased flexibility in resource allocation and job scheduling can lead to improvements in several system efficiency metrics. Despite these benefits, DRM has not yet been established as a ready-to-use technology for production HPC systems. This is caused by the significant changes required in all the layers of the HPC system software stack, which are only achievable with an extensive and holistic co-design process between resource management software and applications. In this work, we demonstrate the applicability of a recently introduced, generic design approach for dynamic resources called Dynamic Processes with PSets (DPP), to enable DRM in realworld systems. To this end, we developed an exemplary, dynamic system software stack implementation following the DPP design principles throughout all layers. Based on this, we assess the applicability and performance of our approach using both synthetic benchmarks and job mixes consisting of several dynamic, real-world applications. On up to $\mathbf{1 0 0}$ nodes, we measure moderate overheads for process reconfiguration in applications while significantly improving the system throughput and average job turnaround time compared to static scheduling in crowded system scenarios.},
  keywords      = {Runtime;High performance computing;Full stack;Production;Dynamic scheduling;Throughput;Time measurement;Resource management;System analysis and design;Optimization;Dynamic Resource Management;High-Performance Computing}
}
@inproceedings{11437713,
  title         = {Optimal Energy Planning for High-Powered Computing Based on Grey Wolf Model},
  author        = {Wang, Zixuan and Yang, Shuwen and Wei, Zihang and Chen, Wenyue},
  year          = 2025,
  month         = {Dec},
  booktitle     = {2025 IEEE 4th International Conference of Safe Production and Informatization (IICSPI)},
  pages         = {867--871},
  doi           = {10.1109/iicspi66775.2025.11437713},
  abstract      = {With the increasing demand of artificial intelligence (AI), data science and cryptocurrency mining in recent years, the application of High-Powered Computing (HPC) is increasing. The paper estimates the global power consumption and resulting Greenhouse Gas (GHG) emissions of HPC considering the current energy mix and energy utilization, and subsequently analyzes the wider impact of HPC on the global environment and explores the potential role of renewable energy in mitigating these impacts. We analyze the potential benefits of hybrid energy from various aspects such as carbon emissions, costs and environmental pollution. Considering the future development needs, we use ARIMA prediction model to predict the future development trend of HPC, and use Grey Wolf optimization algorithm to explore the best mixing ratio of hybrid energy with the change of HPC energy consumption. This paper also analyzes the change of the environmental impact of HPC energy consumption as the proportion of clean energy increases. The results show that HPC energy consumption has a significant impact on the environment. However, if clean energy technologies are vigorously developed, increasing the proportion of clean energy can significantly reduce the emissions of greenhouse gases and harmful gases.},
  keywords      = {Green energy;Energy consumption;Costs;Renewable energy;Carbon dioxide;Production;Prediction algorithms;Artificial intelligence;Greenhouse gases;Optimization;High-Powered Computing;Greenhouse Gas Emissions;Grey Wolf optimization;Hybrid Energy Optimization}
}
@inproceedings{11441693,
  title         = {Learning from the Oracle: A Transformer-based Framework for Green HPC Scheduling},
  author        = {Zhang, Kaichen and Huang, Tianyou and Xue, Xiaozhi and Han, Ziyang and Sun, Peter},
  year          = 2026,
  month         = {Jan},
  booktitle     = {2026 International Conference on Electrical Engineering, Intelligent Control and Artificial Intelligence (EEICAI)},
  pages         = {323--326},
  doi           = {10.1109/eeicai68535.2026.11441693},
  abstract      = {The escalating energy consumption of High-Performance Computing (HPC) facilities presents a critical sustainability challenge. While exact mathematical optimization can theoretically identify energy-efficient schedules, its NP-hard nature precludes real-time application in large-scale heterogeneous clusters. This paper proposes a novel Attention-based Neural Solver that bridges the gap between theoretical optimality and real-time responsiveness. We formulate the scheduling problem as a sequence-to-sequence learning task. A Multi-Objective Mixed-Integer Programming (MIP) solver generates a high-quality "Oracle" dataset of Pareto-optimal schedules. We then train a Transformer-based Pointer Network to mimic this Oracle, leveraging Multi-Head Attention mechanisms to capture complex dependencies between task features and node states. Extensive experiments on real-world traces demonstrate that our model approximates 98.6\% of the optimal energy efficiency while reducing inference latency by four orders of magnitude (20,000\texttimes{}). Furthermore, the model exhibits strong zero-shot generalization capabilities on unseen cluster topologies.},
  keywords      = {Schedules;Visualization;Processor scheduling;Network topology;Transformers;Real-time systems;Mathematical models;Energy efficiency;Topology;Optimization;Green Computing;Deep Learning;Transformer;Combinatorial Optimization;HPC Scheduling}
}
@inproceedings{11450761,
  title         = {Automated Brain Tumor Classification in MRI Scans Using an EfficientNet-B5 Deep Learning Framework},
  author        = {K, Deepak Kumar and R, Selvam and R, Rajalingam and DS, Shaji and I, Noor Mohamed and S, Senthil Pandi},
  year          = 2025,
  month         = {Nov},
  booktitle     = {2025 International Conference on Emerging Technologies and Innovation for Sustainability (EmergIN)},
  pages         = {932--938},
  doi           = {10.1109/EmergIN67762.2025.11450761},
  abstract      = {Brain tumors are one of the most perilous medical conditions today, and getting the diagnosis right, as quickly as possible, could mean the difference between life and death for the patient. This work intends to explore how EfficientNet-B5, a next generation artificial intelligence system, can be used to automatically distinguish between categories of brain tumors based on MRIs of the patient's brain. What is unique to EfficientNet-B5 is that it is designed in a way that provides accuracy relative to speed. In other words, it does not require an enormous amount of computer processing/image processing power, but provides satisfactory performance. We tested the system with thousands of brain MRIs, with images that represented gliomas, meningiomas, pituitary tumors, and an image of a healthy brain. The artificial intelligence learned to detect different conditions by analyzing differences in image patterns. Our results were impressive. EfficientNet-B5 accurately identified brain tumors 96.8\% of the time, better than other artificial intelligence-based computer programs we have accessibility of testing. What is particularly exciting is that it is fast enough to diagnose the conditions in real-time settings, such as in the hospital. The doctor could potentially use it as a second opinion on their diagnosis in seconds, and find conditions that could have been missed, or confirm their thoughts were right. The technology is also efficient enough to be implemented on a standard ho spital desktop computer. Allin-all, this work shows that modern artificial intelligence can be a tool for the medical community in the fight against brain cancer, as it can save lives through improved speed and accuracy with diagnosis.},
  keywords      = {Technological innovation;Accuracy;Hospitals;Magnetic resonance imaging;Brain tumors;Artificial intelligence;Sustainable development;Standards;Medical diagnostic imaging;Testing;EfficientNet-B5;MRIs;Brain tumors;gliomas;meningiomas;pituitary tumors}
}
@inproceedings{11451098,
  title         = {A Novel AI-Driven Framework for Robust Channel Estimation in Reconfigurable Intelligent Surface- Aided Wireless Networks},
  author        = {G, Keerthna and Lavaraju, B. and Jayamala, C.},
  year          = 2025,
  month         = {Dec},
  booktitle     = {2025 International Conference On Emerging Computation and Information Technologies (ICECIT)},
  pages         = {1--6},
  doi           = {10.1109/icecit67774.2025.11451098},
  abstract      = {Reconfigurable Intelligent Surfaces (RIS) are emerging as a transformative paradigm in next-generation wireless networks, enabling programmable control of electromagnetic waves for enhanced signal propagation. Channel estimation in RIS-aided networks is essential but difficult because the cascaded channels are high dimensional and RIS elements are passive. In this paper, RISNet-CE, a new AI-assisted channel estimation framework, has been proposed, which has the capability of incorporating the Transformer network and Bidirectional Long Short-Term Memory (BiLSTM) network so as to obtain the spatial and sequential dependency of the RIS-based system. It is a supervised learning model that maximizes a custom designed loss function (Normalized Mean Squared Error (NMSE) to be more specific) and refined through attention-based feature integration and residual learning to ensure optimal robustness. RISNet-CE model demonstrates better performance when compared with previous and traditional approaches used in deep learning. It achieves 0.0845 at 35 dB SNR, which is better than MMSE (0.2409), RIS-SRNet (0.1012), and DeepCE (0.1609). Also, a reinforcement learning agent based on PPO is incorporated to enable dynamic reconfiguration of RIS phases, which offers, up to 9.01 dB of SNR gains in mmWave LoS conditions. The framework keeps its MAPE under 17.1\% with 160 RIS components and can run on low-latency inference and memory-footprint without needing high-performance computing. RISNet-CE shows promising efficiency, versatility and scaling, which has been confirmed in extensive simulations of different propagation settings, and is a large step toward automated and smart RIS-based wireless systems.},
  keywords      = {Deep learning;Programmable control;Wireless networks;Supervised learning;Channel estimation;Reinforcement learning;Reconfigurable intelligent surfaces;Transformers;Robustness;Signal to noise ratio;Reconfigurable Intelligent Surface;Channel Estimation;Deep Learning;Transformer}
}
@inproceedings{11453623,
  title         = {Optimized Architecture and Strategies for High Performance Computing in Cloud and Hybrid Environments},
  author        = {Shanthi, S. and Karthik, R. and Madhuramya, R. and Varghese, Vimit and Priya, G.M.Banu and Ramasamy, S.},
  year          = 2026,
  month         = {March},
  booktitle     = {2026 8th International Conference on Intelligent Sustainable Systems (ICISS)},
  pages         = {518--523},
  doi           = {10.1109/iciss67859.2026.11453623},
  abstract      = {High-performance computing has traditionally been based on large on-site supercomputers that provide powerful but costly and rigid performance. HPC workloads may now benefit from flexible on-demand access to computing resources because to the expansion of cloud computing. Yet issues like inconsistent performance slow networks and complex data that processing persist when HPC is used to cloud or hybrid environments. A practical method for enhancing the performance of HPC applications in the cloud and hybrid settings is presented in this study. The framework leverages hardware that the acceleration and intelligent scheduling for containerized programs to balance the cost of performance and resource use. To lower communication latency, it also uses the software-defined networking adaptive task transfer and data-aware scheduling. When compared to conventional cloud-based HPC systems that experimental testing using the scientific and industrial workloads demonstrates up to 17\% quicker performance. An average 10- 14\% reduction in cloud compute cost, primarily due to reduced billed execution time on cloud resources. The results demonstrate that while retaining scalability to security and sustainability the suggested hybrid HPC architecture can manage the demanding applications such as genetic research, climate modeling, and AI simulations.},
  keywords      = {Cloud computing;Job shop scheduling;Costs;Processor scheduling;High performance computing;Computational modeling;Dynamic scheduling;Resource management;Artificial intelligence;Sustainable development;Software-Defined Networking;Hardware Acceleration;Workload Optimization;Resource Scheduling;Cloud Computing;Hybrid Cloud and High-Performance Computing}
}
@inproceedings{11459016,
  title         = {High-Performance Distributed Deep Learning Using Adaptive Parallelism and Dynamic Workload Scheduling},
  author        = {Boyapati, Pavan Kumar and Kandula, Siva Teja Reddy},
  year          = 2026,
  month         = {March},
  booktitle     = {2026 14th International Symposium on Digital Forensics and Security (ISDFS)},
  pages         = {01--06},
  doi           = {10.1109/isdfs69419.2026.11459016},
  issn          = {2768-1831},
  abstract      = {Dynamic and large-scale workloads are essential to the management of modern distributed computing and learning systems, particularly in the event of resource failure or failure in execution. This work introduces a scalable and intelligent system of adaptive workload scheduling in highperformance distributed systems. Experiments with Google 2019 cluster workload dataset, a representation of actual resource consumption, task patterns and failures, utilize a preprocessing pipeline in data inspection, feature engineering, normalization, and class imbalance correction using SMOTEENN. MLP and CatBoost models are trained to predict failures on the task and scheduling readiness with accuracies of 99.15\% and 87.62\%, respectively, which is very successful in comparison with MobileNetV2 (70.4\%), Support Vector Regression (70\%), and TSSAP clustering (53.8\%). Findings have shown higher predictive accuracy, scalability and reliability, and therefore the framework is applicable to highperformance computing, cloud data centers and resourceintelligent distributed learning systems.},
  keywords      = {Feeds;Antennas;Central Processing Unit;Circuits;Feedback;Electronic circuits;Internet;Cloud computing;Scheduling algorithms;Computer networks;Workload scheduling;adaptive parallelism;Google 2019 cluster workload dataset;machine learning;deep learning;MLP;CatBoost}
}
@inproceedings{11459310,
  title         = {Performance Evaluation of AI Inference on the Tenstorrent Wormhole RISC-V Accelerator},
  author        = {Damodaran, Kishor Yerol and Patel, Abhishek and Gupta, Krishan Gopal and Sharma, Shashank and Maity, Samrit Kumar and Wandhekar, Sanjay},
  year          = 2025,
  month         = {Dec},
  booktitle     = {2025 IEEE 32nd International Conference on High Performance Computing, Data and Analytics Workshop (HiPCW)},
  pages         = {97--104},
  doi           = {10.1109/HiPCW66559.2025.00025},
  issn          = {2770-0135},
  abstract      = {The growing computational demands of large-scale AI inference have shifted performance bottlenecks from algorithms to hardware, underscoring the need for systematic evaluation of accelerator efficiency. Consequently, architectural analysis of performance, scalability, and energy efficiency is critical for sustainable AI deployment. Existing evaluations predominantly target proprietary GPU and TPU platforms, leaving limited insight into open and customizable alternatives. This study presents a cross-domain performance evaluation of the RISC-V–based Tenstorrent Wormhole n300 across vision (ResNet-50) and language (Llama-1B–8B, Qwen-7B) inference workloads. Experiments were analyzed across four quantitative metrics: throughput, latency, scaling efficiency, and energy efficiency. The vision model achieved 6.3\texttimes{} and 4.9\texttimes{} higher throughput than the Grayskull e150 and RTX A4000, respectively, while the language model achieved comparable GPU-class throughput at one-third the power, delivering 3.5\texttimes{} higher throughput-per-cost than the H100 PCIe GPU. These findings demonstrate that RISC-V accelerators can deliver competitive and cost-efficient inference performance, while highlighting the importance of software-stack maturity for broader adoption in HPC AI workloads.},
  keywords      = {Telemetry;Aerospace and electronic systems;Feeds;Antennas;Central Processing Unit;System-on-chip;AI accelerators;Application specific integrated circuits;Network-on-chip;Microprocessor chips;RISC-V;Tenstorrent Wormhole;AI Inference Performance;Large Language Models (LLMs);Energy Efficiency}
}
@inproceedings{11472495,
  title         = {High-Performance HD-GAA MOSFETs for Energy-Efficient Smart City Applications},
  author        = {Kaur, Gurpurneet and Devi, Ram and Rattan, Munish and Aggarwal, Geetika and Short, Michael and Dawood, Huda and Ushasree, Palat Meethale and Siddqui, Arooj Mubashara},
  year          = 2025,
  month         = {July},
  booktitle     = {2025 5th International Conference on Electrical, Computer and Energy Technologies (ICECET)},
  pages         = {1--6},
  doi           = {10.1109/icecet63943.2025.11472495},
  abstract      = {To combat climate change's effects and reduce carbon emissions for smart cities, this paper proposes a novel low-power, energy-efficient Metal Oxide Field Effect Transistor (MOSFETs) for integration into low-power applications. The proposed MOSFET leverages advanced materials and structural configurations to enhance performance and energy efficiency. By incorporating these MOSFETs into smart city infrastructures, such as sensor networks and communication systems, significant reductions in energy consumption can be achieved, thereby contributing to more sustainable urban environments. Gate All Around (GAA) Nanowire MOSFET devices exhibit superior characteristics, such as high electron mobility, low power consumption, and high-switching speed. As a result, they are significantly used in high-performance computing, Internet of Things, Low Power, and Communication applications. This research paper simulates the design of MOSFETs through the TCAD tool. The results achieved demonstrate optimal performance parameters in terms of electrical and digital characteristics. The Leakage current of designed devices are greatly reduced to an order of 10-15 over 10-9 A in comparison to conventional GAA MOSFET, thus enabling these novel devices suitable to be deployed for low power, energy efficient applications.},
  keywords      = {Circuits;Silicon-on-insulator;Digital circuits;Circuits and systems;Logic devices;Power dissipation;MOSFET circuits;Circuit synthesis;System-on-chip;Logic gates;High Performance;Efficiency;Sustainability;MOSFET;Schottky contact;Short Channel Effects (SCEs)}
}
@inproceedings{11472579,
  title         = {The Simulation of Hyperspectral Observations by the Upcoming Spacecraft "Arab Satellite 813", with the Radiative Transfer Model SCIATRAN},
  author        = {Alhasan, Sara and Gebhardt, Claus},
  year          = 2025,
  month         = {July},
  booktitle     = {2025 5th International Conference on Electrical, Computer and Energy Technologies (ICECET)},
  pages         = {1--5},
  doi           = {10.1109/icecet63943.2025.11472579},
  abstract      = {The Arab Satellite 813, scheduled for launch in 2025 by the UAE Space Agency, is expected to significantly advance Earth observation and climate monitoring efforts across the Middle East and North Africa (MENA) region. This study supports the satellite's operational objectives by contributing to the development of reliable methodologies for generating accurate hyperspectral data, which are essential for informed decision making and sustainable resource management. Mangrove ecosystems, which line parts of the UAE's coastline, play a crucial role in coastal protection, biodiversity support, and carbon sequestration. However, they remain vulnerable to both natural and human-induced environmental pressures. Monitoring their health and extent is therefore critical for ensuring their long-term preservation and ecological function. To address this, the SCIATRAN radiative transfer model was employed to simulate hyperspectral observations in alignment with the 813 Satellite's imaging capabilities. The model setup was initially based on the work of aprevious research, and then adapted to better represent regional mangrove conditions through adjustments of parameters such as Leaf Area Index (LAI) and soil factor (Psoil). The reliability of the simulations was assessed through comparative analysis with hyperspectral observations from the EnMAP satellite.},
  keywords      = {Earth Observing System;Payloads;Satellite images;Sentinel-2;Feedback;Circuits;MIMICs;Millimeter wave integrated circuits;Monolithic integrated circuits;Radio access networks;813 Satellite;SCIATRAN;Hyperspectral Im-ager;Mangroves;EnMAP;Simulations;UAE (United Arab Emi-rates)}
}
@article{11475406,
  title         = {TianheWare: Degree-aware Sampling for Large-scale Graph Learning},
  author        = {Gan, Xinbiao},
  year          = 2026,
  journal       = {IEEE Transactions on Parallel and Distributed Systems},
  pages         = {1--12},
  doi           = {10.1109/tpds.2026.3681468},
  issn          = {1558-2183},
  abstract      = {The scalability of graph neural networks (GNNs) is critically dependent on the efficiency of their sampling and feature aggregation steps, which are often bottlenecked by memory access patterns in large-scale graphs. While sampling algorithms like GraphSAGE reduce computational costs, they rely on underlying sparse storage formats such as the Compressed Sparse Row (CSR) format, treat all non-zero vertices equally, and fail to exploit the skewed degree distribution inherent to real-world graphs. To address these challenges, we introduce TianheWare, a degree-aware sparse storage format specifically engineered to optimize sampling during large-scale graph learning. TianheWare groups the numerous low-degree vertices found in real-world graphs, storing only a starting index for each group to minimize the memory footprint. This design not only reduces memory consumption but also, crucially, enables highly efficient batched memory access during the neighbor sampling phase in frameworks like GraphSAGE. A data-driven threshold automatically computed from the graph's degree distribution, adapts this compression to any graph structure. Integrated as a plugin into GraphSAGE, TianheWare demonstrates its impact on the end-to-end learning pipeline by accelerating the underlying sampling operations, achieving up to 3.37\texttimes{} speedup in sampling throughput and over 85\% memory reduction compared to stateof- the-art methods, while maintaining full sampling fidelity and model accuracy. Our extensive evaluation, including deployment on a production-scale supercomputer, where it exceeded the topranked Graph500 benchmark performance, confirms that TianheWare serves as a foundational optimization, enabling faster, more scalable graph learning without compromising results.},
  keywords      = {Central Processing Unit;Recommender systems;Electronic circuits;MIMICs;Information filtering;Millimeter wave integrated circuits;Monolithic integrated circuits;Radio access networks;Regional area networks;Data communication;Degree Distribution;CSR;Sorted graph;Graph Learning}
}
@inproceedings{1181848,
  title         = {A fine-grain clock synchronization mechanism for Myrinet clusters},
  author        = {Chakravarthi, S. and Pillai, A. and Neelamegam, J.P. and Apte, M. and Skjellum, A.},
  year          = 2002,
  month         = {Nov},
  booktitle     = {27th Annual IEEE Conference on Local Computer Networks, 2002. Proceedings. LCN 2002.},
  pages         = {708--715},
  doi           = {10.1109/lcn.2002.1181848},
  issn          = {0742-1303},
  abstract      = {Clock synchronization is a fundamental requirement for any real-time distributed system operating with global schedules. The presence of a global clock permits co-scheduling, enhances the degree of synchronization between cooperating tasks of parallel programs, and permits implementation of quality of service (QoS) based communication. This paper describes the design and implementation of a high accuracy (/spl plusmn/5/spl mu/s) global clock on a Myrinet network of PC with low software overhead. The clock synchronization scheme uses a novel approach to reduce errors arising from variation of latency of transmitted clock values. The contribution of this work is that high-accuracy of clock synchronization is obtained without significant resource consumption. This makes the synchronization scheme equally suitable for high-performance and real-time distributed systems. The new approach achieves clock accuracy of the order of /spl plusmn/5/spl mu/s, compared to the other known clock synchronization algorithm on Myrinet that achieves accuracy of the order of milliseconds. Programmability of the Myrinet interface card and the presence of an on-board real time clock are critical to achieving this accuracy.},
  keywords      = {Clocks;Frequency synchronization;Switches;Delay;Quality of service;Computer networks;Communication switching;High performance computing;Real time systems;Random access memory}
}
@inproceedings{1194208,
  title         = {Grid object description: characterizing grids},
  author        = {Lanfermann, G. and Schnor, B. and Seidel, E.},
  year          = 2003,
  month         = {March},
  booktitle     = {IFIP/IEEE Eighth International Symposium on Integrated Network Management, 2003.},
  pages         = {519--532},
  doi           = {10.1109/inm.2003.1194208},
  abstract      = {We present a new data model approach to describe the various objects that either represent Grid infrastructure or make use of it. The data model is based on our experiences and experiments conducted in heterogeneous grid environments. While very sophisticated data models exist to describe and characterize, e.g. compute capacities or Web services, we will show that a general description, which combines all of these aspects, is needed to give an adequate representation of objects on a Grid. The Grid Object Description Language (GODsL) is a generic and extensible approach to unify the various aspects that an object on a Grid can have. GODsL provides the content for the XML based communication in Grid migration scenarios, carried out in the GridLab project. We describe the data model architecture on a general level and focus on the Grid application scenarios.},
  keywords      = {Data models;Physics;Grid computing;Middleware;Web services;Large-scale systems;Availability;Computer science;XML;Pervasive computing}
}
@inproceedings{1195065,
  title         = {Implementation of the super-systolic array for convolution},
  author        = {Jae-Jin Lee and Gi-Yong Song},
  year          = 2003,
  month         = {Jan},
  booktitle     = {Proceedings of the ASP-DAC Asia and South Pacific Design Automation Conference, 2003.},
  pages         = {491--494},
  doi           = {10.1109/aspdac.2003.1195065},
  abstract      = {High-performance computation on a large array of cells has been an important feature of systolic array. To achieve even higher degree of concurrency, it is desirable to make cells of systolic array themselves systolic array as well. The architecture of systolic array with its cells consisting of another systolic array is to be called super-systolic array. In this paper we propose a scalable super-systolic array architecture which shows high-performance and can be adopted in the VLSI design including regular interconnection and functional primitives that are typical for a systolic architecture.},
  keywords      = {Convolution;Systolic arrays;Delay;Very large scale integration;Integrated circuit interconnections;Concurrent computing;Computer architecture;CMOS technology;Hardware;Arithmetic}
}
@inproceedings{1199177,
  title         = {Asynchronous DRAM design and synthesis},
  author        = {Ekanayake, V.N. and Manohar, R.},
  year          = 2003,
  month         = {May},
  booktitle     = {Ninth International Symposium on Asynchronous Circuits and Systems, 2003. Proceedings.},
  pages         = {174--183},
  doi           = {10.1109/async.2003.1199177},
  issn          = {1522-8681},
  abstract      = {We present the design of a high performance on-chip pipelined asynchronous DRAM suitable for use in a microprocessor cache. Although traditional DRAM structures suffer from long access latency and even longer cycle times, our design achieves a simulated core sub-nanosecond latency and a respectable cycle time of 4.8 ns in a standard 0.25 /spl mu/m logic process. We also show how the cycle time penalty can be overcome by using pipelined interleaved banks with quasi-delay insensitive asynchronous control circuits. We can thus approach the performance of SRAM, which is typically used for caches, while still benefiting from the smaller area footprint of DRAM.},
  keywords      = {Random access memory;Delay;High performance computing;Circuit simulation;Banking;Laboratories;Design engineering;System-on-a-chip;Microprocessors;Logic design}
}
@inproceedings{1203685,
  title         = {Performance analysis of HP AlphaServer ES80 vs. SAN-based clusters},
  author        = {Gordon, B. and Oral, S. and Li, G. and Su, H. and George, A.},
  year          = 2003,
  month         = {April},
  booktitle     = {Conference Proceedings of the 2003 IEEE International Performance, Computing, and Communications Conference, 2003.},
  pages         = {69--76},
  doi           = {10.1109/pccc.2003.1203685},
  issn          = {1097-2641},
  abstract      = {The last decade has introduced various affordable computing platforms to the parallel computing community. Distributed shared-memory systems and clusters built with commercial-off-the-shelf (COTS) parts and interconnected with high-performance networks have proven to be serious alternatives to expensive supercomputers in terms of both performance and cost. HP's new AlphaServer ES80 is an example of distributed shared-memory systems, while SCI and Myrinet are the two most widely used high-performance interconnects in building parallel-computing clusters. In this study, we experimentally compare the performance of these parallel computer systems. The emphasis is pointing out the strengths and weakness of the HPs AlphaServer ES80 in comparison with high-performance SCI and Myrinet clusters. We evaluated the systems in terms of sustainable memory bandwidth, interprocess communication and overall parallel computation performance using various widely-accepted benchmarks such as STREAM, PALLAS PMB-MP1, and NAS2.3 parallel suite. It was observed that the HPs AlphaServer ES80, executing Linux, provides remarkable computing power while its communication subsystem cannot handle heavy loads of small messages as effectively.},
  keywords      = {Performance analysis;Concurrent computing;Supercomputers;Computer architecture;Parallel processing;Storage area networks;Costs;Bandwidth;Power system reliability;Scalability}
}
@inproceedings{1213282,
  title         = {Sub optimal scheduling in a GRID using genetic algorithms},
  author        = {Di Martino, V.},
  year          = 2003,
  month         = {April},
  booktitle     = {Proceedings International Parallel and Distributed Processing Symposium},
  pages         = {7 pp.-},
  doi           = {10.1109/ipdps.2003.1213282},
  issn          = {1530-2075},
  abstract      = {The computing GRID infrastructure could benefit of techniques that can improve the overall throughput of the system. It is possible that job submission will include different ontology in resource requests due to the generality of the GRID infrastructure. Such flexible resource request could offer the opportunity to optimize several parameters, from network load to job costs in relation to due time, more generally the quality of services. We present the result of the simulation of GRID jobs allocation. The search strategy for this input case do not converge to the optimal case inside the limited number of trial performed, in contrast with previous work on up to 24 jobs. The benefits of the usage of the genetic algorithms to improve the quality of the scheduling is discussed. The simulation has been obtained using a software environment GGAS suitable to study the scheduling of jobs in a distributed group of parallel machines. The modular structure of GGAS permit us to expand its functionalities to include other first level schedule policies with respect to the FCFS that is considered. The result of this paper suggest the usage of a local search strategy to improve the convergence when the number of jobs to be considered is big as in real world operation.},
  keywords      = {Optimal scheduling;Genetic algorithms;Processor scheduling;Grid computing;Computer architecture;Resource management;Cost function;High performance computing;Hardware;Computational modeling}
}
@inproceedings{1263519,
  title         = {RISC microprocessors and scientific computing},
  author        = {Bailey, D.H.},
  year          = 1993,
  month         = {Nov},
  booktitle     = {Supercomputing '93:Proceedings of the 1993 ACM/IEEE Conference on Supercomputing},
  pages         = {645--654},
  doi           = {10.1145/169627.169813},
  issn          = {1063-9535},
  abstract      = {This paper discusses design features in currently available RISC microprocessors that sometimes result in less-than-optimal sustained performance on large-scale scientific calculations. Recommendations for future designs are suggested.},
  keywords      = {Reduced instruction set computing;Microprocessors;Scientific computing;Clocks;Application software;Large-scale systems;Supercomputers;High performance computing;NASA;Postal services}
}
@article{1271883,
  title         = {How to build a supercomputer},
  author        = {Pulleyblank, W.},
  year          = 2004,
  month         = {Jan},
  journal       = {IEE Review},
  volume        = 50,
  number        = 1,
  pages         = {48--52},
  doi           = {10.1049/ir:20040108},
  issn          = {0953-5683},
  abstract      = {Supercomputer performance has been improved by increasing the clock rate of individual central processing units (CPUs) and scaling out to growing numbers of multiple high-performance processors arranged in clusters. The most powerful supercomputers are now comprised of thousands of processors operating in parallel. Such architectures are hitting a performance barrier imposed by constraints on power consumption, footprint and the demands of cooling a machine comprising large numbers of tightly packed, high-frequency electronic components. Sustained performance is also being constrained by the growing disparity between processor and memory access times, which has led to increasingly inefficient utilisation of the processing power available as the CPUs cycle idly, waiting for data to be read or written. The IBM Research team is attacking these problems with Blue Gene/L, one of the first architectures to be developed as part of its Blue Gene project. The Blue Gene approach to resolving this disparity is to employ larger numbers of moderate-frequency processors, in the domain of hundreds of MHz, allowing for a more balanced memory architecture. Systems with more than 100000 moderate-frequency processors are currently planned-interconnected via a massively powerful communication fabric. The potential performance gains of this system are many orders of magnitude larger than what can be obtained with a conventional shared memory machine.}
}
@inproceedings{1302910,
  title         = {Optimization of the POLCOMS hydrodynamic code for Terascale high-performance computers},
  author        = {Ashworth, M. and Holt, J.T. and Proctor, R.},
  year          = 2004,
  month         = {April},
  booktitle     = {18th International Parallel and Distributed Processing Symposium, 2004. Proceedings.},
  pages         = {8-},
  doi           = {10.1109/ipdps.2004.1302910},
  abstract      = {Summary form only given. Advances in computational science are closely tied to developments in high-performance computing. We consider the case of shelf sea modelling where models have been growing in complexity and where model domains have been growing and grid resolutions shrinking in pace with the increasing storage capacity and computing power of high-end systems. Terascale systems are now readily available with performance levels measurable in TeraFlop/s and memories counted in TeraBytes). The scientific case is now being made for regional models at 1 km resolution, allowing the accurate representation of eddies, fronts and other regions containing steep gradients. The hydrodynamic model is increasingly being coupled with other models in multidisciplinary studies e.g. ecosystem modelling and wave modelling. We show that the performance attainable from the POLCOMS hydrodynamic code is measurable at about 0.5 TeraFlop/s on an IBM p690 cluster with 1024 processors. The scalability on this system and others is excellent up to 1000 processors. We describe a wide range of optimisations which have together enabled this code to reach these performance levels.},
  keywords      = {Hydrodynamics;Sea measurements;Power system modeling;Ecosystems;Biological system modeling;Laboratories;Pollution measurement;Oceans;Microprocessors;Vector processors}
}
@inproceedings{1302982,
  title         = {On the feasibility of incremental checkpointing for scientific computing},
  author        = {Sancho, J.C. and Petrini, F. and Johnson, G. and Frachtenberg, E.},
  year          = 2004,
  month         = {April},
  booktitle     = {18th International Parallel and Distributed Processing Symposium, 2004. Proceedings.},
  pages         = {58-},
  doi           = {10.1109/ipdps.2004.1302982},
  abstract      = {Summary form only given. In the near future large-scale parallel computers will feature hundreds of thousands of processing nodes. In such systems, fault tolerance is critical as failures will occur very often. Checkpointing and rollback recovery has been extensively studied as an attempt to provide fault tolerance. However, current implementations do not provide the total transparency and full flexibility that are necessary to support the new paradigm of autonomic computing - systems able to self-heal and self-repair. We provide an in-depth evaluation of incremental checkpointing for scientific computing. The experimental results, obtained on a state-of-the art cluster running several scientific applications, show that efficient, scalable, automatic and user-transparent incremental checkpointing is within reach with current technology.},
  keywords      = {Checkpointing;Concurrent computing;Computer networks;High performance computing;Hardware;Laboratories;Large-scale systems;Fault tolerance;Application software;Costs}
}
@inproceedings{1303239,
  title         = {System-level fault-tolerance in large-scale parallel machines with buffered coscheduling},
  author        = {Petrini, F. and Davis, K. and Sancho, J.C.},
  year          = 2004,
  month         = {April},
  booktitle     = {18th International Parallel and Distributed Processing Symposium, 2004. Proceedings.},
  pages         = {209-},
  doi           = {10.1109/ipdps.2004.1303239},
  abstract      = {Summary form only given. As the number of processors for multiteraflop systems grows to tens of thousands, with proposed petaflops systems likely to contain hundreds of thousands of processors, the assumption of fully reliable hardware has been abandoned. Although the mean time between failures for the individual components can be very high, the large total component count will inevitably lead to frequent failures. It is therefore of paramount importance to develop new software solutions to deal with the unavoidable reality of hardware faults. We will first describe the nature of the failures of current large-scale machines, and extrapolate these results to future machines. Based on this preliminary analysis we will present a new technology that we are currently developing, buffered coscheduling, which seeks to implement fault tolerance at the operating system level. Major design goals include dynamic reallocation of resources to allow continuing execution in the presence of hardware failures, very high scalability, high efficiency (low overhead), and transparency - requiring no changes to user applications. Preliminary results show that this is attainable with current hardware.},
  keywords      = {Fault tolerant systems;Large-scale systems;Parallel machines;Hardware;Laboratories;Supercomputers;Operating systems;Application software;Concurrent computing;Computer aided manufacturing}
}
@inproceedings{1303282,
  title         = {A configurable multiprocessor and dynamic load balancing for parallel LU factorization},
  author        = {Wang, X. and Ziavras, S.G.},
  year          = 2004,
  month         = {April},
  booktitle     = {18th International Parallel and Distributed Processing Symposium, 2004. Proceedings.},
  pages         = {234-},
  doi           = {10.1109/ipdps.2004.1303282},
  abstract      = {Summary form only given. The exponentially increasing complexity of many scientific applications and the high cost of supercomputing force us to explore new, sustainable, and affordable high-performance computing platforms.. Recent significant advances in FPGA technology and the inherent advantages of configurable logic have brought about new research efforts in the configurable computing field: parallel processing on configurable chips. We explore here parallel LU factorization of large sparse block-diagonal-bordered (BDB) matrices on a configurable multiprocessor that we have designed and implemented. A dynamic load balancing strategy is proposed and analyzed. Performance results for IEEE power test systems are provided. Our research provides evidence that configurable logic can be a viable alternative to high-performance scientific computing.},
  keywords      = {Load management;Field programmable gate arrays;Sparse matrices;Parallel processing;Costs;Concurrent computing;Logic;Scientific computing;Equations;Supercomputers}
}
@inproceedings{1303303,
  title         = {DGMonitor: a performance monitoring tool for sandbox-based desktop grid platforms},
  author        = {Cicotti, P. and Taufer, M. and Chien, A.},
  year          = 2004,
  month         = {April},
  booktitle     = {18th International Parallel and Distributed Processing Symposium, 2004. Proceedings.},
  pages         = {246-},
  doi           = {10.1109/ipdps.2004.1303303},
  abstract      = {Summary form only given. Accurate, continuous resource monitoring and profiling are critical for enabling performance tuning and scheduling optimization. In desktop grid systems that employ sandboxing, these issues are challenging because (1) subjobs inside sandboxes are executed in a virtual computing environment and (2) the state of the virtual computing environment within the sandboxes is reset to empty after each subjob completes. DGMonitor is a monitoring tool, which builds a global, accurate, and continuous view of real resource utilization for desktop grids with sandboxing. Our monitoring tool measures performance unobtrusively and reliably, uses a simple performance data model, and is easy to use. Our measurements demonstrate that DGMonitor can scale to large desktop grids (up to 12000 workers) with low monitoring overhead in terms of resource consumption (less than 0.1\%) on desktop PCs. Though we developed DGMonitor with the Entropia DCGrid platform, our tool is easily integrated into other desktop grid systems. In all of these systems, DGMonitor data can support existing and novel information services, particularly for performance tuning and scheduling.},
  keywords      = {Grid computing;Processor scheduling;Personal communication networks;Computerized monitoring;Resource management;Data models;Distributed computing;Computer applications;Availability;High performance computing}
}
@inproceedings{1324037,
  title         = {Lattice Boltzmann simulation and its concurrent visualization on the SX-6 supercomputer},
  author        = {Takei, T. and Bernsdorf, J. and Masuda, N. and Takahara, H.},
  year          = 2004,
  month         = {July},
  booktitle     = {Proceedings. Seventh International Conference on High Performance Computing and Grid in Asia Pacific Region, 2004.},
  pages         = {212--219},
  doi           = {10.1109/hpcasia.2004.1324037},
  abstract      = {An emerging numerical method for simulating reactive flows in complex geometries, called the lattice Boltzmann method, is presented in combination with a concurrent visualization system. This combination enables an efficient simulation and visualization of time dependent transport and reaction processes such as the pollutant transport in porous media and the chemical processes in fixed bed reactors. The sustained computational performance of this lattice Boltzmann code on the NEC SX-6 supercomputer is 73\% with respect to the theoretical maximum performance of its vector processors. An extension to the standard lattice Boltzmann model for adsorption processes is given together with simulation results and visualization examples for adsorption in porous media.},
  keywords      = {Lattice Boltzmann methods;Visualization;Supercomputers;Computational modeling;Solid modeling;Numerical simulation;Geometry;Pollution;Chemical processes;Inductors}
}
@inproceedings{1329633,
  title         = {Small dipole-antenna near Peano high-impedance surfaces},
  author        = {McVay, J. and Hoorfar, A. and Engheta, N.},
  year          = 2004,
  month         = {June},
  booktitle     = {IEEE Antennas and Propagation Society Symposium, 2004.},
  volume        = 1,
  pages         = {305--308 Vol.1},
  doi           = {10.1109/aps.2004.1329633},
  abstract      = {We numerically analyze the radiation performance of an electrically small dipole antenna placed above and within close proximity to a Peano high-impedance surface, which is a metamaterial surface consisting of a 2D periodic array of electrically small, metallic, planar inclusions in parallel with, and a small distance above, a metallic ground plane. The inclusions are created utilizing Peano space-filling curves, a mathematical concept dating back to the late 1800's, The effects of various parameters of the Peano surface on radiation resistance, directivity and efficiency of the dipole antenna are studied, and it is shown that in certain circumstances the radiation performance can be enhanced.},
  keywords      = {Dipole antennas;Resonance;Surface impedance;Hilbert space;Resonant frequency;Concurrent computing;High performance computing;Metalworking machines;Surface resistance;Polarization}
}
@inproceedings{1342632,
  title         = {Comparison of scheduling heuristics for grid resource broker},
  author        = {Zhuk, S. and Chernykh, A. and Avestiyan, A. and Gaissaryan, S. and Kuzjurin, N. and Pospelov, A. and Grushin, D.},
  year          = 2004,
  month         = {Sep.},
  booktitle     = {Proceedings of the Fifth Mexican International Conference in Computer Science, 2004. ENC 2004.},
  pages         = {388--392},
  doi           = {10.1109/enc.2004.1342632},
  abstract      = {We consider parallel task scheduling problems for hierarchical decentralized systems that consist of homogeneous computational resources such as clusters, PCs and supercomputers, and are geographically dispersed. We concentrate on two-level hierarchy scheduling: at the first level, the broker allocates computational tasks to the resource. At the second level, each resource schedules the tasks assigned to it using heuristics based, for instance, on strip-packing algorithms. The allocation strategies and efficiency of proposed hierarchical scheduling algorithms are discussed.},
  keywords      = {Resource management;Processor scheduling;Personal communication networks;Supercomputers;Scheduling algorithm;Dynamic scheduling;Control systems;Mesh generation;Concurrent computing;Clustering algorithms}
}
@inproceedings{1364632,
  title         = {Closing the gap: CPU and FPGA trends in sustainable floating-point BLAS performance},
  author        = {Underwood, K.D. and Hemmert, K.S.},
  year          = 2004,
  month         = {April},
  booktitle     = {12th Annual IEEE Symposium on Field-Programmable Custom Computing Machines},
  pages         = {219--228},
  doi           = {10.1109/fccm.2004.21},
  abstract      = {Field programmable gate arrays (FPGAs) have long been an attractive alternative to microprocessors for computing tasks - as long as floating-point arithmetic is not required. Fueled by the advance of Moore's law, FPGAs are rapidly reaching sufficient densities to enhance peak floating-point performance as well. The question, however, is how much of this peak performance can be sustained. This paper examines three of the basic linear algebra subroutine (BLAS) functions: vector dot product, matrix-vector multiply, and matrix multiply. A comparison of microprocessors, FPGAs, and reconfigurable computing platforms is performed for each operation. The analysis highlights the amount of memory bandwidth and internal storage needed to sustain peak performance with FPGAs. This analysis considers the historical context of the last six years and is extrapolated for the next six years.},
  keywords      = {Field programmable gate arrays;Microprocessors;Bandwidth;Digital signal processing;Laboratories;Floating-point arithmetic;Moore's Law;Electronic mail;Linear algebra;Algorithms;IEEE floating point;arithmetic;FPGA;re-configurable computing}
}
@inproceedings{1382854,
  title         = {Benefits of global grid computing for job scheduling},
  author        = {Ernemann, C. and Hamscher, V. and Yahyapour, R.},
  year          = 2004,
  month         = {Nov},
  booktitle     = {Fifth IEEE/ACM International Workshop on Grid Computing},
  pages         = {374--379},
  doi           = {10.1109/grid.2004.13},
  issn          = {1550-5510},
  abstract      = {In addition to other advantages, computational grids are considered to utilize the participating compute resources more efficiently as well as to improve the response time for user jobs. Due to the lack of common large scale global grids and corresponding studies on grid workloads this assumption is not yet verified. In this paper, the effect of geographical distribution of grid resources on the machine utilization and the average response time is analyzed. To this end, simulations have been performed. The results show a significant benefit for the job scheduling quality due to the participation in a true global grid. The average weighted response times of all submitted jobs decrease up to about 30\%. The results have been verified using different workloads and grid configurations.},
  keywords      = {Grid computing;Processor scheduling;Delay;Large-scale systems;Quality of service;Application software;Performance evaluation;Computational modeling;Collaboration;Standards publication}
}
@inproceedings{1392155,
  title         = {Development of the dedicated numerical platform feasible to very long-term climatic simulations based on the time-space method},
  author        = {Wakashima, S. and Saitoh, T.S.},
  year          = 2002,
  month         = {July},
  booktitle     = {IECEC '02. 2002 37th Intersociety Energy Conversion Engineering Conference, 2002.},
  pages         = {804--808},
  doi           = {10.1109/iecec.2002.1392155},
  abstract      = {Great progress of the performance of recent super computers has been further done. For example, the peak running speed of the "Earth simulator" developed in Japan and completed in 2002 reaches around 36 TFLOPS. Using these supercomputers, a lot of useful numerical studies for estimation of the future terrestrial environmental change and validations of many consumption scenarios of energy, water, food resources are conducted by using the numerical results of climate models. However, in such studies, the details of the terrestrial ecosystem, the most unknown factor on the earth, has not been included because of its complexity and uncertainty. In order to accurately investigate the future change in terrestrial environment, the role of the terrestrial ecosystem must be considered and carefully analyzed. From a numerical standpoint, such inclusion of the terrestrial ecosystem into the numerical modeling of the earth's climate is a hard work because it must be treated in a longer timescale (e.g. 1000 to 10000 years) than in the conventional modeling. Therefore, it is still necessary to make continuous efforts to improve performance of both numerical algorithms and computer architectures if we perform computer simulations with the higher degree of resolution compared with existing ones and handle very long time-scale problems. We have consistently used the time-space method (TSM) as an efficient dynamical-core solver for climate studies with very long time-scales like in ocean general circulation modeling, that is, the development of the dedicated numerical platform feasible to very long-term climatic simulations. The TSM has been proposed by Saitoh et al.(see ibid., 1992) as one of the fastest solvers for general heat transfer and fluid flow problems aiming at a great reduction of CPU time from the former standpoint. This paper presents numerical results of numerical climatic simulations using this efficient platform. The results show the realistic climate features. In addition, we will evaluate the roles of the land ecosystem in further longer-time scale than that treated in previous studies.},
  keywords      = {Ecosystems;Earth;Computational modeling;Supercomputers;Water resources;Uncertainty;Numerical models;Computer architecture;Computer simulation;Oceans}
}
@inproceedings{1392941,
  title         = {Early Experience with Aerospace CFD at JAXA on the Fujitsu PRIMEPOWER HPC2500},
  author        = {Matsuo, Y. and Tsuchiya, M. and Aoki, M. and Sueyasu, N. and Inari, T. and Yazawa, K.},
  year          = 2004,
  month         = {Nov},
  booktitle     = {SC '04: Proceedings of the 2004 ACM/IEEE Conference on Supercomputing},
  pages         = {11--11},
  doi           = {10.1109/sc.2004.23},
  abstract      = {Japan Aerospace Exploration Agency has introduced a new terascale SMP-cluster-type parallel supercomputer system as Numerical Simulator III (NS-III) for aerospace science and engineering research purposes. The system has been in full operation since October 2002. This system is using Fujitsu PRIMEPOWER HPC2500 as main compute engine; it has computing capability 9.3 tflop/s peak performance and 3.6 TB of user memory, with about 1,800 scalar processors for computation. It has mass storage consisting of 57 TB disk storage and a 620 TB tape library. A visualization system is tightly integrated with the computation system. In this paper, we give a brief review for the history of the Numerical Simulator first, then we describe the system configuration in detail as well as the requirement and design of the NS-III. Next, we present the performance evaluation results of the Fujitsu PRIMEPOWER HPC2500 system both for micro- and kernel-benchmarks and aerospace CFD applications used at JAXA, and finally we will discuss how we use the system efficiently.},
  keywords      = {Computational fluid dynamics;Aerospace engineering;Computational modeling;Numerical simulation;Supercomputers;Aerospace simulation;Engines;Libraries;Visualization;History}
}
@article{1407776,
  title         = {A grid service module for natural-resource managers},
  author        = {Wang, D. and Carr, E.A. and Palmer, M.R. and Berry, M.W. and Gross, L.J.},
  year          = 2005,
  month         = {Jan},
  journal       = {IEEE Internet Computing},
  volume        = 9,
  number        = 1,
  pages         = {35--41},
  doi           = {10.1109/mic.2005.2},
  issn          = {1941-0131},
  abstract      = {To facilitate transparent use of the high-performance Across Trophic-Level System Simulation (ATLSS) ecosystem-modeling package for natural-resource management, the authors developed a grid service module. The module exploits grid middleware functionality to process complex computation without requiring users to handle underlying issues. It represents the first application of grid computing to this discipline and provides a potential template for researchers in other disciplines to exploit scientific computation without extensive training in high-performance computing.},
  keywords      = {Grid computing;Biological system modeling;Management training;Computational modeling;Middleware;Resource management;Computer networks;Packaging;Application software;Web and internet services;grid service module;grid computing;distributed computation;software architecture;ecosystem modeling}
}
@inproceedings{1415202,
  title         = {Optimal clustering and non-uniform allocation of Gaussian kernels in scalar dimension for HMM compression [speech recognition applications]},
  author        = {Xiao-Bing Li and Soong, F.K. and Myrvoll, T.A. and Ren-Hua Wang},
  year          = 2005,
  month         = {March},
  booktitle     = {Proceedings. (ICASSP '05). IEEE International Conference on Acoustics, Speech, and Signal Processing, 2005.},
  volume        = 1,
  pages         = {I/669-I/672 Vol. 1},
  doi           = {10.1109/icassp.2005.1415202},
  issn          = {2379-190x},
  abstract      = {We propose an algorithm for optimal clustering and nonuniform allocation of Gaussian kernels in scalar (feature) dimension to compress complex, Gaussian mixture-based, continuous density HMMs into computationally efficient, small footprint models. The symmetric Kullback-Leibler divergence (KLD) is used as the universal distortion measure and it is minimized in both kernel clustering and allocation procedures. The algorithm was tested on the resource management (RM) database. The original context-dependent HMMs can be compressed to any resolution, measured by the total number of clustered scalar kernel components. Good trade-offs between the recognition performance and model complexities have been obtained; the HMM can be compressed to 15-20\% of the original model size, which needs 1-5\% of multiplication/division operations, and results in almost negligible recognition performance degradation.},
  keywords      = {Kernel;Hidden Markov models;Distortion measurement;Clustering algorithms;Speech recognition;High performance computing;Density measurement;Natural languages;Testing;Resource management}
}
@inproceedings{1419914,
  title         = {COTS clusters vs. the Earth simulator: an application study using IMPACT-3D},
  author        = {Chavarria-Miranda, D. and Guohua Jin and Mellor-Crummey, J.},
  year          = 2005,
  month         = {April},
  booktitle     = {19th IEEE International Parallel and Distributed Processing Symposium},
  pages         = {10 pp.-},
  doi           = {10.1109/ipdps.2005.156},
  issn          = {1530-2075},
  abstract      = {In 2002, Japan announced the Earth Simulator - a supercomputer based on low-volume vector processors and a custom network - and reported that computational scientists had used it to achieve 14.9 TFLOPS with the IMPACT-3D code, which is written in high performance Fortran (HPF). Of particular interest was that they had achieved this level of performance using a high-level parallel programming model. There has been considerable concern in the U.S. about the appropriateness of its hardware and software investments in super computing technology. To help assess the U.S. strategy of building systems from commodity-off-the-shelf (COTS) components, we explored using a combination of HPF and scalar compiler technology to tailor IMPACT-3D to microprocessor-based supercomputers and evaluated its performance and scalability on the AlphaServer-based Lemieux cluster at the Pittsburgh Supercomputer Center (PSC). On the Earth Simulator, IMPACT-3D achieved 45\% of peak performance on 4096 processors; on 1024 processors of PSC's Lemieux, we achieved 17.29\% of peak performance.},
  keywords      = {Earth;Supercomputers;Computational modeling;Vector processors;Computer networks;High performance computing;Parallel programming;Hardware;Investments;Appropriate technology}
}
@inproceedings{1419995,
  title         = {Designing scalable FPGA-based reduction circuits using pipelined floating-point cores},
  author        = {Zhuo, L. and Morris, G.R. and Prasanna, V.K.},
  year          = 2005,
  month         = {April},
  booktitle     = {19th IEEE International Parallel and Distributed Processing Symposium},
  pages         = {8 pp.-},
  doi           = {10.1109/ipdps.2005.165},
  issn          = {1530-2075},
  abstract      = {The use of pipelined floating-point arithmetic cores to create high-performance FPGA-based computational kernels has introduced a new class of problems that do not exist when using single-cycle arithmetic cores. In particular, the data hazards associated with pipelined floating-point reduction circuits can limit the scalability or severely reduce the performance of an otherwise high-performance computational kernel. The inability to efficiently execute the reduction in hardware coupled with memory bandwidth issues may even negate the performance gains derived from hardware acceleration of the kernel. In this paper we introduce a method for developing scalable floating-point reduction circuits that run in optimal time while requiring only /spl Theta/ (lg (n)) space and a single pipelined floating-point unit. Using a Xilinx Virtex-II Pro as the target device, we implement reference instances of our reduction method and present the FPGA design statistics supporting our scalability claims.},
  keywords      = {Kernel;Floating-point arithmetic;Scalability;Hardware;Hazards;High performance computing;Coupling circuits;Bandwidth;Performance gain;Acceleration}
}
@inproceedings{1436980,
  title         = {EPEAT: Electronic Product Environmental Tool - development of an environmental rating system of electronic products for governmental/institutional procurement},
  author        = {Katz, J. and Rifer, W. and Wilson, A.R.},
  year          = 2005,
  month         = {May},
  booktitle     = {Proceedings of the 2005 IEEE International Symposium on Electronics and the Environment, 2005.},
  pages         = {1--6},
  doi           = {10.1109/isee.2005.1436980},
  issn          = {2378-7260},
  abstract      = {The Electronic Product Environmental Assessment Tool (EPEAT) is a new approach for institutional purchasers to identify and evaluate environmentally preferable electronic products. It establishes a clear set of performance criteria for desktop computers, laptops, and monitors, and recognizes higher levels of environmental performance. The tool was developed by a multi-stakeholder group composed of equipment manufacturers, governmental and private purchasers, non-governmental organizations, and environmental professionals. It is designed to be easy to use, with an interactive Web site to speed product registration. The registration process does not slow time to market for new products. The tool encompasses a range of environmental attributes, including toxic materials, material selection, life cycle extension, energy use, design for end of life and end of life management, and packaging. There is significant pent-up market demand for EPEAT. Currently 14 federal agencies and 4 states have pledged to use the tool in future electronics purchasing, representing more than \$10 billion in purchasing potential. As a result, several major manufacturers have indicated an interest in registering that their products meet the EPEAT standards. This paper reviews the development of EPEAT, including the structure of the tool, the criteria considered, and the next steps in its development. First, however, we review the current market for green electronic products.},
  keywords      = {Procurement;Consumer electronics;High performance computing;Portable computers;Computer displays;Electronic equipment manufacture;Web page design;Time to market;Energy management;Environmental management}
}
