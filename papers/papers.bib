}
@conference{Wetterer-Nelson2026,
  title         = {Catalyst: Expanding In Situ Analysis and Visualization Workflows for Exascale Computing},
  author        = {Wetterer-Nelson, Corey and Tsolakis, Christos and Lee, Jeffrey A. and Tsalikis, Spiros and Wittenburg, Scott and Yenpure, Abhishek and Ross, Caitlin and Lipsa, Dan and Panchumarti, Jaswant and Geveci, Berk},
  year          = 2026,
