}
@article{Svanes2024464,
  title         = {The environmental effect of utilising domestic plant protein potential and replacing other protein sources in the diet in Norway},
  author        = {Svanes, Erik and Uhlen, Anne Kjersti and M\o{}ller, Hanne},
  year          = 2024,
  journal       = {Sustainable Production and Consumption},
  volume        = 45,
  pages         = {464--475},
  doi           = {10.1016/j.spc.2024.01.024},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85184014008&doi=10.1016%2Fj.spc.2024.01.024&partnerID=40&md5=fd66b25fbd492f4191a65b349672bddc},
  note          = {Cited by: 5},
  abstract      = {From the perspective of health and environment, the consumption of red and processed meat in Norway should be reduced. It is possible to increase domestic production of plant protein from the high protein crops (HPC) peas, faba beans, rapeseed and turnip rapeseed. The aim of this study was to document environmental impacts and impacts on demand for food and feed when increasing the Norwegian production of HPC and using the plant proteins to replace other food protein sources, in particular animal-based-protein. In this study, results from life cycle assessments of certain food groups, import/export statistics, data on food waste and data on feed recipes were used to quantify the environmental impact of realising the full production potential of HPC and using them for human food replacing. Four scenarios have been developed for the Norwegian population's diet in 2030: 1) BUSINESS-AS-USUAL: 2) PLANT: red meat in the diet is partially replaced by HPC; 3) CHICKEN: as scenario PLANT but with an additional reduction of red meat in the diet replaced by chicken meat; 4) SEAFOOD: as CHICKEN but replacing red meat with seafood rather than with chicken meat. Compared to the BUSINESS-AS-USUAL scenario, the impacts covered in this study would for the scenarios, would be decreased annually by 5 and 20 \%. For example emission of greenhouse gases would be reduced annually by between 1.07 and 1.76 million tonnes of CO<sub>2</sub>-eq for the various scenarios, equivalent to 10–16 \% of emissions associated with Norway's total food production. At the same time, less food and feed (141,000–420,000 t per year) and agricultural land (34,000–89,000 ha) would be needed to satisfy the Norwegian population's need for protein. The results shows that increased production of HPC and utilisation for food in Norway could achieve large reductions in environmental impacts, reduce pressure on agricultural land, increase Norway's national self-sufficiency and contribute to a more healthy diet. \textcopyright{} 2024 Institution of Chemical Engineers},
  author_keywords = {Diet; Food; Life cycle assessment; Norway; Plant protein; Self-sufficiency},
  keywords      = {Animals; Environmental impact; Greenhouse gases; Life cycle; Meats; Oilseeds; \% reductions; Agricultural land; Chicken meat; Health and environment; Life cycle assessment; Norway; Plant proteins; Protein sources; Red meats; Self-sufficiency; Proteins},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Swietochowski2024,
  title         = {The Hourly Peak Coefficient of Single-Family and Multi-Family Buildings in Poland: Support for the Selection of Water Meters and the Construction of a Water Distribution System Model},
  author        = {\'{S}wi\k{e}tochowski, Kamil and Andraka, Dariusz and Kalenik, Marek and Gwo\'{z}dziej-Mazur, Joanna},
  year          = 2024,
  journal       = {Water (Switzerland)},
  volume        = 16,
  number        = 8,
  doi           = {10.3390/w16081077},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85191533062&doi=10.3390%2Fw16081077&partnerID=40&md5=655a1fc384b362a48bd5080c00b30b44},
  note          = {Cited by: 8; All Open Access; Gold Open Access; Green Open Access},
  abstract      = {Taking care of water resources and minimizing water losses in water supply networks requires a broad approach to identifying and neutralizing operational problems. The correct selection of water meters to minimize apparent losses requires knowledge of the characteristic flows that may occur in the facility to which water is supplied. The research aimed to develop tools in the form of mathematical models and water consumption curves along with hourly water consumption coefficients to facilitate the process of selecting water meters for engineers and creating computer models of water supply systems. The research involved monitoring the flow of 76 single-family and multi-family buildings in four towns in Poland, followed by data analysis and development of tools supporting the selection of water meters and the construction of computer models of water distribution networks. High correlation coefficients of the studied variables indicate the results' usefulness. Four models were developed to determine the maximum flow values in multi-family buildings (three models) and single-family buildings (one model) in the range of water meter diameters DN15-DN40. Characteristics of the average hourly peak coefficient (HPC) values were also developed, along with the range of changes in HPC values for single-family and multi-family buildings. \textcopyright{} 2024 by the authors.},
  author_keywords = {apparent losses; demand pattern; hourly peak coefficient; remote water meter monitoring; smart water system; water distribution system management; water loss; water meter; water meter management},
  keywords      = {Poland [Central Europe]; Buildings; Construction; Electric power distribution; Water distribution systems; Water meters; Apparent loss; Demand pattern; Hourly peak coefficient; Remote water meter monitoring; Smart water system; Systems management; Water distribution system management; Water loss; Water meter management; Water system; building; water demand; water management; water supply; water use; Water supply},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@conference{Syakira2025,
  title         = {Simulation of bioethanol synthesis from agricultural residues of rice straw and oil palm empty fruit bunches},
  author        = {Syakira, A. and Nazifa, S. and Nuraini, N. and Rinaldi, W. and Yunardi, Y.},
  year          = 2025,
  journal       = {IOP Conference Series: Earth and Environmental Science},
  volume        = 1510,
  number        = 1,
  doi           = {10.1088/1755-1315/1510/1/012053},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105011291433&doi=10.1088%2F1755-1315%2F1510%2F1%2F012053&partnerID=40&md5=4f9e2a1ca4692e5e8f96d7f95206e239},
  note          = {Cited by: 0; All Open Access; Gold Open Access},
  abstract      = {Indonesia faces an ongoing agricultural waste management challenge, with rice straw and oil palm empty fruit bunches (PEFB) often burned or left to decompose, resulting in lost potential for value creation. These lignocellulosic wastes, rich in cellulose, offer a promising source for bioethanol production, which could support sustainable energy goals while addressing waste accumulation. While individual conversion studies of rice straw and EFB to bioethanol exist, research on their combined processing remains limited. This study addresses this gap by utilizing Aspen Plus\textregistered{} v.11 software to simulate and optimize the bioethanol production process using both feedstocks in combination. A conceptual process flow diagram was developed based on biochemical conversion pathways, allowing for an in-depth investigation into how varying feedstock ratios and processing parameters impact bioethanol yield and concentration. Specifically, we explored the effect of the rice straw to PEFB ratio and employed the Separate Hydrolysis and Fermentation (SHF) method, which showed significant improvements in ethanol yield and concentration when compared to other fermentation methods. To produce fuel-grade bioethanol with over 99.5\% purity, essential for direct use as fuel or in fuel blends, we implemented a pressure swing distillation (PSD) system comprising a low-pressure column (LPC) at 1 bar and a high-pressure column (HPC) at 6 bar. Our optimized 35-stage PSD configuration consistently achieved the desired bioethanol purity, demonstrating the viability of this approach for large-scale bioethanol production from Indonesia's abundant agricultural waste. This simulation study highlights the potential of integrating rice straw and PEFB as feedstocks in bioethanol production, contributing to Indonesia's renewable energy strategy and sustainable waste management initiatives.  \textcopyright{} Published under licence by IOP Publishing Ltd.},
  type          = {Conference paper},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Szalkiewicz2022,
  title         = {Environmental Flows Assessment for Macroinvertebrates at the River Reach Scale in Different Degrees of Hydromorphological Alteration},
  author        = {Sza\l{}kiewicz, Ewelina and Ka\l{}u\.{z}a, Tomasz and Grygoruk, Mateusz},
  year          = 2022,
  journal       = {Frontiers in Environmental Science},
  volume        = 10,
  doi           = {10.3389/fenvs.2022.866526},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85128751249&doi=10.3389%2Ffenvs.2022.866526&partnerID=40&md5=5f51f3740c92d9f3762136065d0cd6e1},
  note          = {Cited by: 13; All Open Access; Gold Open Access; Green Open Access},
  abstract      = {One of the most commonly used methods of environmental flows assessment is the approach based on Habitat Suitability Modeling (HSM) and habitat preferences curves (HPCs). Relationships between organisms and physical parameters describing the habitat remain strongly nonlinear and vary depending on several factors. The most common comparisons concern analyses between natural and regulated rivers, where the degree of river channel alterations is undefined and usually refers to all forms of hydromorphological degradation. Additionally, spatial scale and computational range of such a research mostly focus on longer river reaches and statistical analysis of HPC transferability, without detailed estimation of environmental flows values. The main aim of our research was assessment and comparison of environmental flows' values for macroinvertebrates at two reaches of one river with different degrees of hydromorphological alteration. Two research hypotheses were verified: 1) morphological conditions impact on values of environmental flows and weighted usable area; 2) the mean value of environmental flows at the regulated river reach is higher compared to the natural reach. In order to put the obtained values of environmental flows into a broader context, the analyses of hydrological data and calculation of hydrology-based environmental flows were performed. Additionally, before determination of environmental flows, the transferability of habitat suitability criteria between reaches was verified. The obtained results confirmed research hypotheses, revealing strong dependence of environmental flows values to morphological conditions. Additionally, for both studied sections the lower limits of environmental flows were greater than hydrology-based values. Copyright \textcopyright{} 2022 Sza\l{}kiewicz, Ka\l{}u\.{z}a and Grygoruk.},
  author_keywords = {environmental flows; habitat preference curves; habitat suitability criteria; habitat suitability curves; macroinvertbrates; river regulation; sustainability},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
