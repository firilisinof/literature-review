}
@article{Li2009s727,
  title         = {Multi-powder dam concrete with high performance and low adiabatic temperature rise},
  author        = {Li, Xin-Yu and Chen, Wen-Yao and Chen, Wei-Min},
  year          = 2009,
  journal       = {Transactions of Nonferrous Metals Society of China (English Edition)},
  volume        = 19,
  number        = {Suppl. 3},
  pages         = {s727 - s733},
  doi           = {10.1016/s1003-6326(10)60140-9},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-77955672085&doi=10.1016%2FS1003-6326%2810%2960140-9&partnerID=40&md5=4b0795c8d19e47e9b87e2ba50310b530},
  note          = {Cited by: 2},
  abstract      = {Based on the fluidity, strength, heat of hydration and loop crack resistance experiment of multi-powder paste, the components and proportion of multi-powder were optimized and the concrete properties were studied. The multi-powder consists of limestone powder, slag, fly ash and moderate heat Portland cement (PMH cement). The results show that the compressive strength of the multi-powder paste and mortar is close to those of PMH cement, fly ash paste and mortar currently used in dam concrete, yet the flexural strength is relatively higher. The multi-powder paste is featured by larger fluidity, lower heat of hydration and delayed cracking time. In comparison, less unit water consumption and cement is used in multi-powder concrete, and under premise of equal mechanical performance, deformation, thermal performance and durability, the adiabatic temperature rise at 28 d is reduced by 2 \textdegree{}C. In this way, the crack resistance is improved and it is feasible both technically and economically to produce HPC for dam concrete. \textcopyright{} 2009 The Nonferrous Metals Society of China.},
  author_keywords = {Adiabatic temperature rise; Crack resistance; Dam concrete; High performance concrete; Multi-powder paste},
