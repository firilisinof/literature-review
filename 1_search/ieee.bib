  author        = {Fu, Yuhang and Shen, Weiqi and Cui, Jiahuan and Zheng, Yao and Yang, Guangwen and Liu, Zhao and Zhang, Jifa and Ji, Tingwei and Xie, Fangfang and Lv, Xiaojing and Liu, Hanyue and Liu, Xu and Liu, Xiyang and Song, Xiaoyu and Tao, Guocheng and Yan, Yan and Tucker, Paul and Miller, Steven and Luo, Shirui and Koric, Seid and Zheng, Weimin},
  year          = 2023,
  month         = {Nov},
  booktitle     = {SC23: International Conference for High Performance Computing, Networking, Storage and Analysis},
