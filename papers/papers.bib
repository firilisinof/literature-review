  title         = {High-Density MDM Silicon Transmitter Based on Two-Dimensional Grating Coupler for Singlefiber $\mathbf{4} \boldsymbol{\times} \mathbf{8 0}$-Gbps Signaling},
  author        = {Wang, Xinyi and Du, Jiangbing and Zhang, Wenjia and Shen, Weihong and Xu, Ke and He, Zuyuan},
