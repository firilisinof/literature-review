@article{Liu20222380,
  title         = {Natural nori-based porous carbon composite for sustainable lithium-sulfur batteries},
  author        = {Liu, Hu and Liu, WeiLin and Meng, FanCheng and Jin, LiangYu and Li, ShuLin and Cheng, Sheng and Jiang, ShuDong and Zhou, RuLong and Liu, JieHua},
  year          = 2022,
  journal       = {Science China Technological Sciences},
  volume        = 65,
  number        = 10,
  pages         = {2380--2387},
  doi           = {10.1007/s11431-022-2148-7},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85138389758&doi=10.1007%2Fs11431-022-2148-7&partnerID=40&md5=983c9d4c99db26890c9d4780f33e1c1d},
  note          = {Cited by: 5},
  abstract      = {The practical applications of lithium-sulfur (Li-S) batteries are limited by the low conductivity of sulfur and the shuttle effect of soluble polysulfides during the charge-discharge process. At the same time, biomass-based carbon materials have been acknowledged as the cost-effective and direct settlement to mitigate or overcome these problems due to their renewability, facile processing, and pollution-free characteristics. Therefore, in this work, we report the natural nori-based CoO nanoparticles decorated hierarchical porous carbon (HPC) for high-capacity Li-S battery cathodes. The HPC with an extremely high surface area of 2089 m<sup>2</sup> g<sup>-1</sup> provides a good substrate for the accommodation of CoO nanoparticles, which can effectively seize the lithium polysulfides and facilitate their redox conversion. As a result, the CoO-HPC/S cathode exhibits a high discharge capacity of 1557.1 mA h g<sup>-1</sup>, as well as excellent rate performance and cycling stability. Due to the naturally abundant nori-based cathode materials, the resultant Li-S battery is supposed to be an attractive and sustainable energy storage device. \textcopyright{} 2022, Science China Press and Springer-Verlag GmbH Germany, part of Springer Nature.},
  author_keywords = {biomass; cathode; Li-S battery; porous carbon; sustainable},
  keywords      = {Carbon carbon composites; Cobalt compounds; Cost effectiveness; Lithium batteries; Lithium compounds; Lithium sulfur batteries; Nanoparticles; Polysulfides; Porous materials; Carbon composites; Carbon material; Charge-discharge process; Cost effective; Hierarchical porous carbons; Lithium/sulfur batteries; Low conductivity; Polysulphides; Porous carbons; Sustainable; Cathodes},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Liu2024_2,
  title         = {A massive MPI parallel framework of smoothed particle hydrodynamics with optimized memory management for extreme mechanics problems},
  author        = {Liu, Jiahao and Yang, Xiufeng and Zhang, Zhilang and Liu, Moubin},
  year          = 2024,
  journal       = {Computer Physics Communications},
  volume        = 295,
  doi           = {10.1016/j.cpc.2023.108970},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85174614361&doi=10.1016%2Fj.cpc.2023.108970&partnerID=40&md5=adcd625134288f76f2fcebe4c91a907f},
  note          = {Cited by: 19},
  abstract      = {The dynamic failure process of structures under extreme loadings is very common in many fields of engineering and science. The smoothed particle hydrodynamics (SPH) method offers inherent benefits in dealing with complex interfaces and large material deformations in extreme mechanics problems. However, SPH simulations for 3D engineering applications are time-consuming. To address this issue, we introduce MPI (Message Passing Interface) in our SPH scheme to reduce computational time. Some optimizations are adopted to ensure the massive computation of the SPH method. In particular, an optimized memory management strategy is developed to control the memory footprint. With the present MPI-based massive parallelization of the SPH method, several validation examples are tested and analyzed. By comparing the present numerical results with the reference data, the dynamic failure process of complex structures subjected to extreme loadings like explosive and impact loadings can be well captured. A large number of particles, up to 2.04 billion, are adopted in the present simulations. The scaling tests show that the scalability of the massively parallel SPH program achieves a maximum parallel efficiency of 97\% on 10020 CPU cores. \textcopyright{} 2023 Elsevier B.V.},
  author_keywords = {Extreme mechanics problems; Massive high performance computing; Memory management; Message passing interface; Smoothed particle hydrodynamics},
  keywords      = {Failure (mechanical); Hydrodynamics; Software testing; Dynamic failures; Extreme mechanic problem; Failure process; Massive high performance computing; Memory-management; Message passing interface; Message-passing; Performance computing; Smoothed particle hydrodynamics; Smoothed particle hydrodynamics methods; Message passing},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Liu2025,
  title         = {Hydration and freeze-thaw resistance mechanism of high-performance concrete prepared from limestone calcined coal gangue cement},
  author        = {Liu, Shaoqian and Gu, Xiaowei and Ge, Xiaowei and Wang, Hongyu and Liu, Jianping},
  year          = 2025,
  journal       = {Construction and Building Materials},
  volume        = 505,
  doi           = {10.1016/j.conbuildmat.2025.144668},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105023952449&doi=10.1016%2Fj.conbuildmat.2025.144668&partnerID=40&md5=3487428644440fbbd0ef40e0ccc27473},
  note          = {Cited by: 2},
  abstract      = {The utilisation of calcined coal gangue (CCG) in high-performance concrete (HPC) has been demonstrated to contribute to a reduction in energy consumption and the environmental impacts associated with cement usage. The present study focuses on the mineral phase evolution of CCG and its synergistic hydration mechanism with limestone (LS), with a view to revealing characteristics such as strength loss, pore distribution, and degradation mechanism of the interfacial transition zone in HPC subjected to freeze-thaw cycles (FTCs). The results obtained from this study indicate that calcination increases the amorphous phase proportion from 34.7 \% to 61.1 \%, with enhanced polymerization. The substitution of raw coal gangue (RCG) with CCG, the addition of LS, and the use of metakaolin (MK) instead of RCG resulted in a continuous increase in the contents of monocarboaluminate and hemicarboaluminate, while the calcium hydroxide content gradually decreased. The increased pore-filling phase endows HPC with superior resistance to FTCs, and the imbalance between rapid pore expansion and pore filling is the primary cause of strength loss during FTCs. Furthermore, in comparison with the LC3–60-MK group, the LC3–60-CCG specimens exhibited not only a more rational hydration process but also a potential risk ratio of structural damage, with porosity increasing from 18.78 \% to 23.05 \% following FTCs. Copyright \textcopyright{} 2025. Published by Elsevier Ltd.},
  author_keywords = {Calcined coal gangue; Freeze-thaw cycles; High-performance concrete; Hydration},
  keywords      = {Calcination; Cements; Coal; Coal tailings; Copyrights; Energy utilization; Freezing; High performance concrete; Lime; Limestone; Thawing; Calcined coal gangues; Coal gangues; Freeze-thaw cycles; Freeze-thaw resistance; High-performance concrete; Metakaolins; Pore filling; Raw coal; Resistance mechanisms; Strength loss; Hydration},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Liu2025_2,
  title         = {3D O/N/S Tridoped Honeycomb-Like Porous Carbon with Enhanced Performance for High-Mass Loading Supercapacitors},
  author        = {Liu, Xiaofei},
  year          = 2025,
  journal       = {Energy Technology},
  volume        = 13,
  number        = 5,
  doi           = {10.1002/ente.202401925},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85215534943&doi=10.1002%2Fente.202401925&partnerID=40&md5=0d4b72276f3d76e9e24a80ee4ab12d0c},
  note          = {Cited by: 1; All Open Access; Bronze Open Access},
  abstract      = {To satisfy the practical needs of the sustainability and industrialization of supercapacitors, it is essential to maintain good electrochemical performance at high mass loading (>10 mg cm<sup>-2</sup>). Herein, a unique 3D O/N/S tridoped honeycomb-like porous carbon is successfully prepared from chitosan as carbon precursor and L-cysteine as sulfur source using gelation pretreatment and high-temperature pyrolysis methods. Chitosan and L-cysteine hierarchical porous carbons (CL-HPC-3:1) display rich O/N/S heteroatoms content, high specific surface area, (2806 m<sup>2</sup> g<sup>-1</sup>), interconnected hierarchical porous structure, good conductivity (0.23 \ensuremath{\Omega} cm<sup>-1</sup>; 4.35 S cm<sup>-1</sup>), and strong wettability (the contact angle is 19\textdegree{}), which enable fast electron/ion transport and afford additional capacitance. Importantly, CL-HPC-3:1 (3:1 represents the mass ratio of chitosan to L-cysteine.) can maintain excellent electrochemical performance at mass loading of 12.2 mg cm<sup>-2</sup>, which has high specific capacitance (298.36 F g<sup>-1</sup> at 0.1 A g<sup>-1</sup>), high area capacitance (3.64 F cm<sup>-2</sup> at 0.1 A g<sup>-1</sup>), low-open-circuit voltage attenuation rate (21.63 mV h<sup>-1</sup>), high voltage retention (78.54\%), and remarkable cyclic stability (92.06\% capacitance retention after 20 000 cycles). This work demonstrates the successful conversion of chitosan into the sustainable and high-performance electrode materials and also develops a valuable utilization way for chitosan. \textcopyright{} 2025 Wiley-VCH GmbH.},
  author_keywords = {high-mass loading electrodes; O/N/S tridoped honeycomb-like porous carbons; self-discharges; supercapacitors},
  keywords      = {Carbon electrodes; Electrochemical electrodes; Gelation; Honeycomb structures; Electrochemical performance; High-mass loading electrode; Industrialisation; L-cysteine; Loading electrodes; Mass loadings; O/N/S tridoped honeycomb-like porous carbon; Performance; Porous carbons; Self-discharges; Chitosan},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Liu2025_3,
  title         = {Performance analysis of coupled thermal-electric current transmission by liquid metal},
  author        = {Liu, Chuan-Ke and Li, Mao-Lin and Ma, Shun and Liu, Xin-Yi and Cao, Ling-Xiao and He, Zhi-Zhu},
  year          = 2025,
  journal       = {Energy Conversion and Management},
  volume        = 327,
  doi           = {10.1016/j.enconman.2025.119539},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85215568503&doi=10.1016%2Fj.enconman.2025.119539&partnerID=40&md5=6b615384b5d4af570b1620608a438d7b},
  note          = {Cited by: 3},
  abstract      = {High-power direct current fast charging (DC-HPC) is expected to drive electric vehicles (EVs) towards high-energy efficiency and low-carbon sustainability while suffering potential thermal runaway due to extreme-high heat shock. Conventional cooling methods that separate current transmission and heat dissipation struggle to achieve efficient thermal management and structural flexibility, particularly under ultra-high charging current. Herein, a liquid metal (LM)-enabled coupled thermal-electric current transmission strategy is introduced to establish the flexible synergetic power line (FSPL) for EV supercharging even for currents exceeding 1000 A. With the synergetic functions of current-carrying conduction and active-cooling dissipation, the LM-enabled FSPL (LM-FSPL) can rapidly eliminate the superhigh heat density generated by ultra-high charging current, promoting structural simplification and reliable operation of DC-HPC. Experiment results demonstrate that LM-FSPL presents remarkable mechanical elasticity and flexible maneuverability while maintaining electrical stability, achieving a tensile and torsion deformation of 50 \% and 720\textdegree{}. The multiphysics numerical method is also employed to thoroughly investigate the current-heat-fluid mechanisms of different transmission strategies. Compared with copper-based power lines, the LM-FSPL exhibits superior heat transfer and hydrodynamic performance by homogenizing current distribution, suppressing localized heat accumulation, and optimizing thermal-flow pathways, resulting in a 62.7 \% improvement in active-cooling capability. Additionally, we built the LM-FSPL test platform to investigate the adaptability of the system under various geometric configurations and charging currents. Experimental results revealed that the maximum temperature achieved by LM-FSPL only is 37.6 ℃ at the charging current of 1000 A. Our coupled thermal-electric current transmission strategy offers new opportunities for ultra-high power charging to promote the popularization of EVs. \textcopyright{} 2025 Elsevier Ltd},
  author_keywords = {Electric vehicle supercharging; High-heat flux management; Liquid metal; Synergetic transmission; Ultra-high current},
  keywords      = {HVDC power transmission; Power distribution lines; Electric vehicle supercharging; High currents; High heat flux; High-heat flux management; Power lines; Synergetic transmission; Synergetics; Thermal; Ultra-high; Ultra-high current; Liquid metals},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Liu2025_4,
  title         = {Experimental study on the mechanical properties and durability of high-performance concrete for jacking prestressed concrete cylinder pipe},
  author        = {Liu, Guoan and Shan, Changxi and Hu, Shaowei and Sun, Panxu and Wang, Xin and Zhao, Li and Wang, Yu and Xie, Xueting and Xu, Haibing},
  year          = 2025,
  journal       = {Construction and Building Materials},
  volume        = 500,
  doi           = {10.1016/j.conbuildmat.2025.144163},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105020926033&doi=10.1016%2Fj.conbuildmat.2025.144163&partnerID=40&md5=732480f5309547e42bcbeb6252c6f4c5},
  note          = {Cited by: 2},
  abstract      = {Jacking prestressed concrete cylinder pipe (J-PCCP) is a key infrastructure component in large-scale water transfer projects, combining the structural advantages of prestressed concrete cylinder pipe with trenchless jacking technology. Based on code analysis and engineering experience, the target performance parameters of concrete used for J-PCCP were determined, including workability, compressive strength, and durability (chloride ion penetration resistance and water permeability). Considering the early-age strength requirements of core concrete in J-PCCP production, the potential adverse effects of steam curing, and the need for long-term durability, this study developed high-performance concrete (HPC) mixes incorporating multi-mineral admixture systems based on the hydration characteristics of fly ash, mineral powder, silica fume, and superfine powder. Meanwhile, two currently used C50 ordinary concrete mixes were selected as control groups. The workability, mechanical properties, durability, and microstructure of HPC were evaluated under both laboratory and steam curing regimes to verify its suitability for J-PCCP. Test results indicated that the addition of 1.2 \% superplasticizer significantly improved the workability of HPC mixtures (water-binder ratio 0.18). Both ternary and quaternary mineral admixture systems exhibited higher strength and durability than binary systems. Microstructural analyses confirmed the synergistic effects of multi-mineral admixtures, which effectively refined the pore structure of HPC, enhanced the crystallinity of calcium silicate hydrate, and promoted densification of the interfacial transition zone. Finally, the practicality of the developed HPC mixes was verified through cost analysis, carbon emission evaluation, and multi-objective performance evaluation. The proposed ternary mineral admixture system of HPC provides essential material support for J-PCCP manufacturing and offers potential for subsequent lightweight structural design. \textcopyright{} 2025 Elsevier Ltd.},
  author_keywords = {Durability; High-performance concrete; Mechanical properties; Microstructure analysis; Mineral admixtures; Steam curing},
  keywords      = {Calcium silicate; Compressive strength; Concrete additives; Concrete mixtures; Cost benefit analysis; Curing; Fume control; High performance concrete; Hydration; Jacks; Mechanical permeability; Prestressed concrete; Structural design; Trenching; Concrete cylinder pipes; High-performance concrete; Large-scales; Mechanical; Mechanical durability; Microstructures analysis; Mineral admixtures; Pre-stressed; Property; Steam curing; Durability; Fly ash; Silica fume},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Liu2025_6,
  title         = {Carbon Emission Modeling for High-Performance Computing-Based AI in New Power Systems with Large-Scale Renewable Energy Integration},
  author        = {Liu, Haoyang and Zhai, Jiangtao},
  year          = 2025,
  journal       = {Processes},
  volume        = 13,
  number        = 2,
  doi           = {10.3390/pr13020595},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85218987048&doi=10.3390%2Fpr13020595&partnerID=40&md5=ec685b0780725a0275822176128d045a},
  note          = {Cited by: 16; All Open Access; Gold Open Access},
  abstract      = {Under the global impetus toward carbon peak and carbon neutrality, large-scale renewable energy integration has become a key driver in transforming traditional power grids into new power systems. Meanwhile, the growing adoption of advanced artificial intelligence (AI) approaches, especially large-scale models, heavily relies on high-performance computing (HPC) resources, which pose significant sustainability challenges due to their energy consumption and carbon emissions. This study introduces a newly developed carbon emission model (CEM) that accounts for both embodied and operational emissions in HPC systems. The CEM integrates parameters such as energy intensity coefficients, workload distribution patterns, and renewable deficiency rates, providing a lifecycle perspective of emissions in HPC-based AI applications for power systems. Results reveal that operational emissions dominate, constituting 87\% of the total lifecycle footprint. Different regions exhibit varying carbon emissions, and on average, increasing the renewable energy share from 20\% to 50\% reduces total emissions by 43\%, while a full transition to renewable energy achieves a 92\% reduction. Circular economy practices, including hardware recycling and sustainable design, are also highlighted to mitigate embodied emissions. This study offers quantitative evidence and actionable insights for power industry stakeholders, enabling the balance between high-performance AI computations and ambitious carbon neutrality goals in renewable-integrated systems. \textcopyright{} 2025 by the authors.},
  author_keywords = {AI and large models; carbon emission modeling; carbon neutrality; circular economy; high-performance computing (HPC); large-scale renewable energy integration; lifecycle analysis; new power systems},
  keywords      = {Carbon capture and utilization; Low emission; Artificial intelligence and large model; Carbon emission modeling; Carbon emissions; Carbon neutralities; Circular economy; Emission model; High-performance computing; Intelligence models; Large models; Large-scale renewable energy integration; Large-scales; Life cycle analysis; New power system; Performance computing; Power; Renewable energy integrations; Carbon sequestration},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@book{Liu2025138,
  title         = {Agent-based modeling and simulation for smart cities},
  author        = {Liu, Lingbo},
  year          = 2025,
  journal       = {Urban Human Mobility: Practices, Analytics, and Strategies for Smart Cities},
  pages         = {138--147},
  doi           = {10.1201/9781003503262-15},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105014306792&doi=10.1201%2F9781003503262-15&partnerID=40&md5=6c0fe9f83980e63676ce231f110d497e},
  note          = {Cited by: 0},
  abstract      = {This chapter explores how agent-based modeling (ABM) can transform the planning and management of smart cities by simulating individual behaviors, interactions, and collective urban dynamics. Through a fine-grained, bottom-up approach, ABM enables city planners and policymakers to better understand complex systems-ranging from transportation networks to resource allocation and public health-within evolving urban environments. Highlighting recent advancements, the chapter demonstrates how integrating diverse data sources (including geospatial, social, and Internet of Things data) allows ABM to capture nuanced human mobility patterns, forecast traffic flows, inform epidemic control strategies, and assess the introduction of autonomous vehicles. Despite its growing utility, ABM faces challenges in data integration, computational efficiency, and ensuring ethical and equitable representation of urban populations. Strategies such as high-performance computing, machine learning integration, and transparent, participatory modeling can address these issues. The chapter also emphasizes interdisciplinary collaboration to align ABM more closely with real-world policy needs. A case study on crime simulation illustrates how ABM can provide actionable insights without disrupting live city operations. Ultimately, ABM stands as a vital, evolving tool-offering more sustainable, responsive, and inclusive pathways for shaping the future of smart cities. \textcopyright{} 2025 Xiao Huang, Xinyue Ye, Kathleen Stewart, and Subasish Das. All rights reserved.},
  keywords      = {Data integration; Learning systems; Population statistics; Smart city; Urban planning; Urban transportation; Agent-based model; Agent-based modelling and simulations; Bottom up approach; City planners; Fine grained; Individual behavior; Policy makers; Resources allocation; Transportation network; Urban dynamics; Computational efficiency},
  type          = {Book chapter},
  publication_stage = {Final},
  source        = {Scopus}
}
