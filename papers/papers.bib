  note          = {Cited by: 0; All Open Access; Gold Open Access},
  abstract      = {In this study, an integrated machine learning framework is proposed to accurately predict and minimize CO<sub>2</sub> emissions and energy consumption in the manufacturing of High-Performance Concrete (HPC). The methodology combines K-Nearest Neighbor (KNN) and Elastic Net Regression (ENR) models with the Artificial Rabbits Optimization (ARO) algorithm for hyperparameter tuning, and employs Recursive Feature Elimination (RFE) to isolate the most influential input variables. A dataset comprising key HPC mix components was curated from experimental sources and subjected to rigorous preprocessing. Among the tested models, the hybrid ENR + ARO (ENAR) model achieved the best performance for energy prediction with an R<sup>2</sup> of 0.986 and RMSE of 52.63 MJ/m<sup>3</sup>, while the KNN + ARO (KNAR) model yielded the highest accuracy for CO<sub>2</sub> emission prediction with an R<sup>2</sup> of 0.992 and RMSE of 7.57 kg/m<sup>3.</sup> The application of RFE improved model performance by 12.4\% in RMSE reduction for energy prediction and 9.6\% for CO<sub>2</sub> estimation, by eliminating redundant features. Cement and superplasticizer content were identified as the most influential predictors. These results provide a reliable and interpretable framework for enhancing the sustainability of concrete production through data-driven mix optimization. \textcopyright{} (2026), (Jagiellonian University). All rights reserved.},
  author_keywords = {izpostavita cement in superplastifikator kot klju\v{c}na dejavnika<sub>2)</sub> izpostavita cement in superplastifikator kot klju\v{c}na dejavnika.; artificial rabbits optimization; Elastic Net in metahevristiko Artificial Rabbits Optimization z RFE za napovedovanje ter zmanj\v{s}anje CO<sub>2</sub> emisij in energije v visokozmogljivem betonu. Najbolj\v{s}a modela (ENAR za energijo; elastic Net regression; high-performance concrete; K-Nearest neighbor; machine learning; \v{S}tudija zdru\v{z}i KNN},
  keywords      = {Carbon dioxide; Cements; Forecasting; High performance concrete; Learning systems; Machine learning; Nearest neighbor search; Sustainable development; Artificial rabbit optimization; Elastic net; Elastic net in metahevristiko artificial rabbit optimization z recursive feature elimination za napovedovanje ter zmanj\v{s}anje CO2 emisij in energije v visokozmogljivem betonu.; Elastic net regression; High-performance concrete; Izpostavita cement in superplastifikator kot klju\v{c}na dejavnika2) izpostavita cement in superplastifikator kot klju\v{c}na dejavnika.; K-near neighbor; Machine-learning; Najbolj\v{s}a modelum (ENR + ARO za energijo; Nearest-neighbour; Optimisations; Recursive feature elimination; \v{S}tudija zdru\v{z}i K-near neighbor; Energy utilization},
