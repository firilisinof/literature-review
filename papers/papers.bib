  author        = {Yao, Yimin and Zhou, Yang and Spiering, Glenn A. and Coutinho, Isabela Trindade and Anderson, Justin M. and Jordan, Cameron W. and Zhai, Zhenghao and Pritchard, Cailean Q. and Moore, Robert B. and Edgar, Kevin J. and Bortner, Michael J.},
  year          = 2026,
  journal       = {Carbohydrate Polymers},
  volume        = 381,
  doi           = {10.1016/j.carbpol.2026.125128},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105031403799&doi=10.1016%2Fj.carbpol.2026.125128&partnerID=40&md5=82dfe35798118cf0951e66b8fbdb6096},
  note          = {Cited by: 0},
  abstract      = {As the demand for sustainable materials increases, cellulose-based additives have attracted significant attention for use in polymer blends, particularly in applications requiring environmentally responsive behavior. In this work, hydroxypropyl cellulose (HPC)/thermoplastic polyurethane (TPU) blend films were fabricated by a one-step casting method and systematically investigated for their water-triggered optical and physical responses. The films were transparent in the dry state but became opaque upon hydration and regained transparency after drying, demonstrating a reversible transition. Phase contrast optical microscopy revealed microphase separation of HPC-rich domains within the TPU matrix, while confocal microscopy with dye tracing confirmed that these domains selectively absorb water and swell, enhancing refractive index contrast and light scattering. Fourier Transform Infrared Spectroscopy (FTIR) and differential Scanning Calorimetry (DSC) provided molecular-level evidence of hydrogen bonding between water and HPC hydroxyl groups, correlating with the observed swelling behavior. Bulk swelling tests and sorption analysis further confirmed reversible water uptake and deswelling cycles, establishing a clear link between molecular interactions, domain-level swelling, and macroscopic optical modulation. This work positions HPC/TPU blends as scalable, sustainable candidates for moisture-responsive coatings and devices. Copyright \textcopyright{} 2026. Published by Elsevier Ltd.},
  author_keywords = {Cellulose derivatives/polymer blend; Reversible optical performance; Tunable transparency; Water-responsive functionality},
  keywords      = {Casting; Cellulose Derivatives; Hydrogen Bonds; Mixing; Optical Scattering; Blending; Casting; Cellulose; Cellulose derivatives; Cellulose films; Hydrogen bonds; Light scattering; Microphase separation; Molecular structure; Optical films; Polymer blends; Swelling; Transparency; hydroxypropylcellulose; polyurethan; water; Blend films; Cellulose -derivatives; Cellulose derivative/polymer blend; Hydroxypropyl cellulose; Optical performance; Reversible optical performance; Thermoplastic polyurethanes; Tunable transparency; Tunables; Water-responsive functionality; Article; attenuated total reflectance Fourier transform infrared spectroscopy; confocal laser scanning microscopy; confocal microscopy; contact angle; controlled study; differential scanning calorimetry; hydration; hydrogen bond; image processing; light scattering; near infrared spectroscopy; optics; phase contrast microscopy; refraction index; size exclusion chromatography; thermogravimetry; water solubility; X ray diffraction; Differential scanning calorimetry; Fourier transform infrared spectroscopy; Refractive index},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Yaseen2026,
  title         = {The legacy~and~implications of cyberinfrastructure systems in hydrological process modeling},
  author        = {Yaseen, Zaher Mundher},
  year          = 2026,
  journal       = {Acta Geophysica},
  volume        = 74,
