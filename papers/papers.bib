}
@article{Wang2013386,
  title         = {A computational framework for spatially explicit agroecosystem modeling: Application to regional simulation},
  author        = {Wang, D. and Kang, S. and Nichols, J. and Post, W. and Liu, S. and Zhao, Z.},
  year          = 2013,
