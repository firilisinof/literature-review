@inproceedings{10908952,
  title         = {Revitalizing Advanced Packaging in America},
  author        = {Arjunamahanthi, Pavanbabu and Kottur, Himanandhan Reddy and Asadizanjani, Navid and Woychik, Charles},
  year          = 2025,
  month         = {Jan},
  booktitle     = {2025 Pan Pacific Strategic Electronics Symposium (Pan Pacific)},
  pages         = {1--7},
  doi           = {10.23919/PanPacific65826.2025.10908952},
  abstract      = {The resurgence of advanced semiconductor packaging technologies in the United States is crucial for sustaining the nation's position as a global leader in technology. As demands for high-performance computing, artificial intelligence (AI), and energy-efficient electronics intensify, the importance of advanced packaging has grown exponentially. Technologies such as 2.5D and 3D integration, heterogeneous integration, and chiplet architectures are reshaping the semiconductor landscape by enabling unprecedented levels of performance and power efficiency. However, the decline of domestic packaging capabilities over recent decades has left a gap in the U.S.'s ability to meet these demands. To address these challenges, initiatives such as the CHIPS and Science Act have been launched, providing significant funding to reshore manufacturing capabilities and stimulate public-private partnerships. These collaborations between academia, industry, and government institutions aim to overcome technical barriers, such as thermal management, interconnect scaling, and material innovation. The ultimate goal is to build a resilient domestic ecosystem that can respond to the growing demand for advanced packaging technologies across critical applications, including AI systems, data centers, and mobile devices. This article explores the historical trajectory of U.S. semi- conductor packaging, highlighting technological advancements, the role of government initiatives, and ongoing challenges. By examining the intersection of policy, innovation, and industry, this study proposes actionable strategies for revitalizing advanced packaging and ensuring the United States remains at the forefront of the global semiconductor industry.},
  keywords      = {Industries;Technological innovation;Leadership;Government;Multichip modules;Packaging;Thermal management;Artificial intelligence;Three-dimensional integrated circuits;Resilience;CHIPS Act;Heterogeneous Integration;Chiplet Architecture;Advanced Semiconductor Packaging;2.5D and 3D integration}
}
@inproceedings{10909778,
  title         = {New Roadmap for Microelectronics: Charting the Semiconductor Industry's Path Over the Next 5, 10, and 20 Years},
  author        = {Refai-Ahmed, Gamal and Zhirnov, Victor V. and Park, SB and Helmy, Amr S and Sammakia, Bahgat and Ghose, Kanad and Ang, James A. and Bonilla, Griselda and Mahdi, Tayseer and Wieser, Jim and Ramalingam, Suresh},
  year          = 2024,
  month         = {Dec},
  booktitle     = {2024 IEEE 26th Electronics Packaging Technology Conference (EPTC)},
  pages         = {1260--1266},
  doi           = {10.1109/eptc62800.2024.10909778},
  abstract      = {In the past, the role of strategic planning for semiconductor industry was met by the international technology roadmap for semiconductors (ITRS), serving as a guiding light that provided manufacturers, designers, equipment suppliers, and researchers with direction years in advance. By providing a common framework for coordination across semiconductor industry stakeholder and, technology development efforts were efficient and aligned. However, the dissolution of the ITRS in 2015 left a void, leading to years of disconnected efforts. Recognizing the need for unified guidance, the industry rallied for the creation of a new strategic plan - the microelectronics and advanced packaging technologies (MAPT) roadmap (2023) that was developed through the synergistic efforts of industry, academic and government experts. This comprehensive plan outlines ambitious goals for the industry's future.},
  keywords      = {Industries;Technological innovation;Electronics industry;Packaging;Strategic planning;Software;Silicon;Microelectronics;Stakeholders;Sustainable development;HPC;Roadmap;AI;Liquid Cooling;Power;Silicon;Thermal}
}
@inproceedings{10909856,
  title         = {Advantages of Digital Lithography in Patterning of UHD FOWLP Utilizing Novel PI Dielectrics},
  author        = {Varga, K. and Holly, R. and Zenger, T. and Pova\v{z}ay, B. and Uhrmann, T. and Kuo, Y. C. and Lee, Y. Y. and Vandevyvere, M. and Reybrouck, M. and Van Herck, N. and Janssen, D. and Vanclooster, S. and Chang, L. C. and Ouyang, T. Y. and Chang, H. H. and Wang, C. H.},
  year          = 2024,
  month         = {Dec},
  booktitle     = {2024 IEEE 26th Electronics Packaging Technology Conference (EPTC)},
  pages         = {639--642},
  doi           = {10.1109/eptc62800.2024.10909856},
  abstract      = {The UHD FO WLP design that will be required for future HPC and AI devices places stringent requirements on the lithographic patterning of the RDL and VIA. The patterning technology must be sufficiently flexible to accommodate multiple design modifications and provide rapid tape out support for the accelerated development of innovative semiconductor devices. The material must possess enhanced dielectric properties, enabling the patterning of the bottom via profiles with a profile less the 5 \mathrm{\mu}m, with the film thickness remaining at 5 \mathrm{\mu}m, and proving the sustainable development of materials. The combination of the patterning with the recently developed digital lithography system and high-resolution polyimide dielectric ensures that the technology, materials, and processes meet the requisite advanced packaging standards.},
  keywords      = {Lithography;Supply chains;Polyimides;Packaging;Dielectrics;Artificial intelligence;Sustainable development;Substrates;Standards;Research and development}
}
@inproceedings{10910896,
  title         = {Computational Framework for Underwater Surface Modelling Using GPU Accelerated Bathymetric Data Processing},
  author        = {Priyadarshini, Sonali and Dalei, Dilip Kumar and Panigrahi, Narayan},
  year          = 2024,
  month         = {Nov},
  booktitle     = {2024 IEEE Silchar Subsection Conference (SILCON 2024)},
  pages         = {1--5},
  doi           = {10.1109/silcon63976.2024.10910896},
  abstract      = {Rapid advancements in sensor technology have led to an increase in the capture of high-resolution geospatial information, creating a big data repository. Therefore, there is a surge in research and development of High-Performance Computing (HPC) algorithms to mine these geospatial big data. The availability of HPC in the form of multi-CPU and multi-GPU hardware platforms along with computation libraries has made it easy to implement parallel algorithms to mine terra bytes of geospatial data and extract useful patterns. In this paper, we have discussed a bathymetric surface generation and visualization method using a GPU platform that intakes a large volume of depth data and generates a bathymetric surface faster in comparison to the traditional CPU based method. Numerous applications, including Marine Biology, Oil and Gas Exploration, Coastal Environment study, Safe Water Navigation, etc. depend on the charting of undersea topography. Bathymetric data is huge in size and complex in nature. A rigorous process is involved from the gathering of undersea depths to their mapping and visualization. Electronic Navigation Charts (ENC) are crucial tools for recording and archiving underwater depth data. Many ships and boats utilize these charts having bathymetric information suitable for water navigation. Our research examines the efficient computation of surface creation from ENC data using GPU based parallel computing. The processing of bathymetric surface creation has been analysed in terms of execution time on both CPU and GPU platforms. It also highlights various aspects of bathymetric data processing for efficient design of GPU based parallel execution.},
  keywords      = {Interpolation;Analytical models;Navigation;Computational modeling;Graphics processing units;Data models;Surface topography;Geospatial analysis;Fuel processing industries;Surface treatment;Underwater Surface Modelling;Bathymetric Data;GPU Computing;Electronic Navigation Chart;Spatial Interpolation;HPC;Parallel Processing}
}
@inproceedings{10911613,
  title         = {Power and Hardware Assessment of One's Complement Implementation on Kintex Board},
  author        = {Singh, Gurdeep and Kaur, Amanpreet},
  year          = 2024,
  month         = {Nov},
  booktitle     = {2024 4th International Conference on Advancement in Electronics \& Communication Engineering (AECE)},
  pages         = {1366--1369},
  doi           = {10.1109/aece62803.2024.10911613},
  abstract      = {Lowing power consumption in communication circuits will help to achieve sustainable, green communication in the era of the rising need for energy-efficient digital systems. Focusing on the implementation of a one-of-a-kindlement operation on a Kintex FPGA board, this work aims to overcome the energy constraint problem in digital circuits. First focusing on power economy, the recommended architecture guarantees the best performance in the execution of basic arithmetic operations. Reflecting the energy-conscious approach of the system, the design revealed during testing a total power consumption of 1.074 watts. Moreover, thermal management was under control; the thermal margin was observed at 58\textdegree{}C, therefore the system was kept within safe functioning limits without too much heat generation. The board was efficiently exploiting its resources to provide the required functionality with a low I/O consumption of just 2.67\%. Emphasizing the need for hardware optimization in building sustainable digital and communication systems, this work presents the capabilities of fundamental operations, including one's complement, in contributing to energy-efficient design strategies on FPGA platforms.},
  keywords      = {Heating systems;Power demand;Digital systems;Green communications;Focusing;Thermal management;Energy efficiency;Hardware;Field programmable gate arrays;Digital circuits;Vivado;Xilinx;Subtractor;Kintex;FPGA (Field-Programmable Gate Array);Energy efficient;Power saving}
}
@inproceedings{10913534,
  title         = {Eulerian-DL Forecasting of Wind Turbulence for Wind Turbines: Enabling Smart Sustainable Energy},
  author        = {Hassanian, Reza and Riedel, Morris},
  year          = 2024,
  month         = {Dec},
  booktitle     = {2024 International Conference on Engineering and Emerging Technologies (ICEET)},
  pages         = {1--5},
  doi           = {10.1109/iceet65156.2024.10913534},
  issn          = {2831-3682},
  abstract      = {Currently, wind power is the fastest-growing sus-tainable energy resource, and accurately predicting wind velocity for individual turbines is essential. Wind behavior is turbulent, with variable patterns, characteristics, and unpredictable extreme events. Moreover, the wind reaching each turbine is impacted by wake loss effects from surrounding turbines, which underscores the need for a precise local prediction model for each turbine to enhance accuracy in smart wind power production. This study proposes a novel approach using local measurements at fixed points, adopting the Eulerian perspective in fluid dynamics to forecast wind turbulence for the coming hour using a deep learning model. A long short-term memory (LSTM) forecasting model is tuned and applied. Laboratory data from wind tunnel tests are utilized to account for velocity fluctuations and wake loss effects, aiming to establish similarity to an affected single wind turbine. Model training and inference run on the high-performance computing (HPC) DEEP-DAM systems at the Julich Supercomputing Centre. Three train-test datasets are employed to evaluate the model. The measured metrics indicate that the mean absolute error is 0.048, the root mean square error is approximately 0.065, and the Pinball loss for the 90th percentile is 0.0042. The model demonstrates a robust predictive capability, supporting the development of advanced instruments for individ-ual turbines and facilitating smart, clean, and sustainable energy production.},
  keywords      = {Computational modeling;Wind tunnels;Wind speed;Predictive models;Wind power generation;Loss measurement;Wind turbines;Velocity measurement;Wind forecasting;Long short term memory;Wind Turbine;Smart Grid;Deep Learning;Wind Tunnel;Turbulent}
}
@article{10918793,
  title         = {$x$xPUE: Extending Power Usage Effectiveness Metrics For Cloud Infrastructures},
  author        = {Fieni, Guillaume and Rouvoy, Romain and Seinturier, Lionel},
  year          = 2025,
  month         = {Sep.},
  journal       = {IEEE Transactions on Sustainable Computing},
  volume        = 10,
  number        = 5,
  pages         = {908--920},
  doi           = {10.1109/tsusc.2025.3549687},
  issn          = {2377-3782},
  abstract      = {The energy consumption analysis and optimization of data centers have been an increasingly popular topic over the past few years. It is widely recognized that several effective metrics exist to capture the efficiency of hardware and/or software hosted in these infrastructures. Unfortunately, choosing the corresponding metrics for specific infrastructure and assessing its efficiency over time is still considered an open problem. For this purpose, energy efficiency metrics, such as the Power Usage Effectiveness (PUE), assess the efficiency of the computing equipment of the infrastructure. However, this metric stops at the power supply of hosted servers and fails to offer a finer granularity to bring a deeper insight into the Power Usage Effectiveness of hardware and software running in cloud infrastructure. Therefore, we propose to leverage complementary PUE metrics, coined $x$xPUE, to compute the energy efficiency of the computing continuum from hardware components, up to the running software layers. Our contribution aims to deliver real-time energy efficiency metrics from different perspectives for cloud infrastructure, hence helping cloud ecosystems--from cloud providers to their customers--to experiment and optimize the energy usage of cloud infrastructures at large.},
  keywords      = {Cloud computing;Measurement;Servers;Software;Hardware;Energy efficiency;Energy consumption;Data centers;Buildings;Carbon dioxide;Cloud computing;data center power;energy efficiency}
}
@inproceedings{10919702,
  title         = {TransitSim 4.0: Advancing Urban Transit Analysis Through High-Resolution Trajectory Modeling and Multi-Scenario Applications},
  author        = {Fan, Huiying ``Fizzy'' and Lyu, Geyu and Liu, Ziming and Guin, Angshuman and Guensler, Randall},
  year          = 2024,
  month         = {Sep.},
  booktitle     = {2024 IEEE 27th International Conference on Intelligent Transportation Systems (ITSC)},
  pages         = {4164--4171},
  doi           = {10.1109/itsc58415.2024.10919702},
  issn          = {2153-0017},
  abstract      = {As urban transit faces increasing complexities, there is a pressing need for high-resolution data to understand the nuances of transit usage and its environmental impacts. The existing research often lacks the granularity required for precise analysis at trajectory level. TransitSim 4.0 addresses this gap and generate second-by-second trajectory data that enhances the analysis of environmental exposures and travel behaviors across various demographic groups. The system integrates a comprehensive suite of modular tools tailored for a range of analytical needs, from strategic planning to operational assessment. Two case studies exemplify the model's application: assessing transit riders' comfort under extreme heat and evaluating accessibility in urban food deserts. These applications highlight the model's potential to inform sustainable and equitable transit solutions, ultimately contributing to more resilient urban transit systems.},
  keywords      = {Heating systems;Analytical models;Pressing;Strategic planning;Trajectory;Deserts;Complexity theory;Intelligent transportation systems;Faces}
}
@article{10920476,
  title         = {Integrating Energy-Efficient Computing With Computational Research to Accelerate Energy Technology},
  author        = {Martin, Michael James and Andersen, Aaron and Tripp, Charles and Sickinger, David and Munch, Kristin},
  year          = 2025,
  month         = {Jan},
  journal       = {Computing in Science \& Engineering},
  volume        = 27,
  number        = 1,
  pages         = {18--27},
  doi           = {10.1109/mcse.2025.3549359},
  issn          = {1558-366x},
  abstract      = {The National Renewable Energy Laboratory's (NREL's) computational sciences center hosts the largest high-performance computing (HPC) capabilities dedicated to energy research while functioning as a living laboratory for energy-efficient computing. NREL's HPC capabilities support the research needs of the U.S. Department of Energy's Office of Energy Efficiency and Renewable Energy (EERE). In 10 years of operation, HPC use in EERE-sponsored research has grown by a factor of 30, including work in electricity generation, energy efficiency, transportation, and energy system modeling. This article analyzes this research portfolio, providing examples of individual use cases. The article documents NREL's history of operating one of the world's most energy-efficient data centers while examining pathways to reduce economic and environmental impact beyond reduction of power usage efficiency (PUE). This article concludes by examining the unique opportunities created for accelerating improvements in data center efficiency created by combining an HPC system dedicated to energy research and a research program in energy-efficient computing.},
  keywords      = {Computational modeling;Load modeling;Renewable energy sources;Manufacturing;Codes;Atmospheric modeling;Computational fluid dynamics;Graphics processing units;Energy efficient computing;US Department of Energy;Laboratories;Research and development;Data centers;High performance computing}
}
@article{10925535,
  title         = {Supporting Sustainable Computing by Repurposing E-Waste Smartphones as Tiny Data Centers},
  author        = {Ngoy, Perseverance and Dar, Farooq and Liyanage, Mohan and Yin, Zhigang and Norbisrath, Ulrich and Zuniga, Agustin and Pestana, Jo\~{a}o and Radeta, Marko and Nurmi, Petteri and Flores, Huber},
  year          = 2025,
  month         = {Jan},
  journal       = {IEEE Pervasive Computing},
  volume        = 24,
  number        = 1,
  pages         = {53--60},
  doi           = {10.1109/mprv.2025.3541558},
  issn          = {1558-2590},
  abstract      = {AI, data science, and other computing domains are fueling an unprecedented increase in the demand for computing power. Satisfying this demand, however, brings significant environmental challenges as computing is energy-intensive and devices improve rapidly making older devices obsolete and resulting in a significant accumulation of e-waste. We contribute by examining the potential of repurposing smartphones classified as e-waste as small-scale data centers with the aim of extending the life-cycle of these devices, thus reducing e-waste accumulation and contributing toward more sustainable computing practices. We demonstrate how hardware features can be bypassed to enable reprogrammability at a cost of approximately 8\mbox{\texteuro}{} . We use our prototype to implement a custom sensor data collection and analysis solution. We also showcase possible applications, highlighting the range of scenarios where repurposing can be useful, as well as identifying challenges and potential future avenues for research. These include development of better tools to facilitate the repurposing process and development of tools that are agnostic of the underlying hardware characteristics.},
  keywords      = {Data centers;Smart phones;Electronic waste;Batteries;Pervasive computing;Benchmark testing;Three-dimensional printing;Payloads;Internet of Things;Hardware;Sustainable development;Energy efficiency;Power demand;Supply and demand;Artificial intelligence;Power demand;Data science;Costs}
}
@article{10926865,
  title         = {AMD Versal AI Edge Series Gen 2},
  author        = {Knopp, Tomai and Chu, Jeffrey and Ahmad, Sagheer},
  year          = 2025,
  month         = {May},
  journal       = {IEEE Micro},
  volume        = 45,
  number        = 3,
  pages         = {22--30},
  doi           = {10.1109/mm.2025.3551319},
  issn          = {1937-4143},
  abstract      = {AMD's Next-Gen Adaptive System on Chip, Versal AI Edge Series Gen 2, is a high-performance, scalable, and customizable platform for a wide array of markets, including automotive (advanced driver assistance systems and autonomous driving), robotics, audio–video broadcast, aerospace and defense, and industrial. The platform is designed to support ISO-26262 ASIL-D and IEC-61508 SIL3 for safety critical applications and was architected considering the needs of embedded vision applications, where the heterogenous adaptive architecture integrates field programmable gate array programmable logic with high-performance multicluster processors, imaging and video processing engines, and a next-generation artificial (AI) engine array with advanced data types. The advanced MX data types of the AI engine enable embedded vision applications to achieve accuracies comparable to FP32 with reduced AI engine array and memory footprint costs.},
  keywords      = {Artificial intelligence;Safety;Sensors;Program processors;Transceivers;Engines;Training;Real-time systems;Low latency communication;Edge computing;High performance computing;System-on-chip;Product design}
}
@inproceedings{10933896,
  title         = {LLM Acceleration on FPGAs: A Comparative Study of Layer and Spatial Accelerators},
  author        = {Prieto-Sibaja, Luis D. and Le\'{o}n-Vega, Luis G. and Le\'{o}n-Vega, Indra and Castro-God\'{\i}nez, Jorge and Cozzini, Stefano},
  year          = 2024,
  month         = {Nov},
  booktitle     = {2024 IEEE 42nd Central America and Panama Convention (CONCAPAN XLII)},
  pages         = {1--6},
  doi           = {10.1109/concapan63470.2024.10933896},
  issn          = {2687-7244},
  abstract      = {Large Language Models (LLMs) have emerged as the leading technique in Natural Language Processing due to their remarkable capabilities. These models are exceptionally complex, often utilising billions of parameters and consuming tens of gigabytes of memory unless optimised. Typically, LLMs are trained and accelerated using general-purpose Graphics Processing Units (GPUs), with a single inference potentially occupying an entire GPU. Consequently, cloud services may require hundreds of GPUs to deliver high-quality AI assistant services. This demand for extensive hardware acceleration allows exploring alternative architectures that offer improved execution time and energy efficiency.This study evaluates Field-Programmable Gate Arrays (FP-GAs), renowned for their flexibility and efficiency, to accelerate LLMs. We specifically compare the resource consumption and latency of two distinct architectures: layer and spatial accelerators. Analysing the Llama 2-7B model, we identified potential optimisation opportunities within its composition and operational graphs. Our most successful implementations demonstrate a performance improvement ranging from 1.37\texttimes{} to 10.98\texttimes{} over two AMD EPYC processors with 64 cores each. Moreover, our results indicate that, with further refinement, FPGAs have the potential to surpass GPU performance for LLM inference, showcasing their feasibility as a viable alternative for this demanding application.},
  keywords      = {Large language models;High performance computing;Graphics processing units;Computer architecture;Logic gates;Distance measurement;Natural language processing;Field programmable gate arrays;Hardware acceleration;Optimization;Field Programmable Gate Arrays;Hardware Acceleration;Edge Computing;Cloud Computing;High Performance Computing;Large Language Models}
}
@article{10938400,
  title         = {A 80 Gb/s PAM4 All-Silicon Ring-Based Optical Transmitter With CMOS IC},
  author        = {Kumar, Ankur and Yuan, Yuan and Liu, Ruida and Hong, Chaerin and Huang, Zhihong and Kim, Inhyun and Fiorentino, Marco and Beausoleil, Raymond and Palermo, Samuel},
  year          = 2025,
  month         = {June},
  journal       = {Journal of Lightwave Technology},
  volume        = 43,
  number        = 12,
  pages         = {5627--5635},
  doi           = {10.1109/jlt.2025.3554500},
  issn          = {1558-2213},
  abstract      = {Microring resonator modulators (MRM) alongwith four-level pulse amplitude modulation (PAM4) can efficiently scale to higher data-rates on a single channel when combined with CMOS chips. In this work, we present an all-silicon ring-based optical transmitter (TX) which consists of a two-segment MRM heterogeneously integrated over wirebonds with a CMOS IC implemented in 28 nm CMOS process. The MRM device characteristics are modeled in Verilog-A which enables efficient co-simulation. The CMOS TX consists of individual PAM2 AC-coupled pulsed-cascode high-swing voltage-mode drivers for MSB/LSB segments. The drivers achieve a 3.42 Vppd swing and offer independent level-tuning, edge-rate control, and asymmetric post-cursor pre-emphasis on rising and falling edges. The proposed TX operates at 80 Gb/s PAM4 with a power efficiency of 3.66 pJ/bit.},
  keywords      = {Optical transmitters;Modulation;Optical waveguides;Optical resonators;Integrated optics;Artificial intelligence;Optical device fabrication;Optical modulation;Silicon photonics;Refractive index;Heterogeneous integration;microring modulator;optical TX;PAM4;silicon photonics;transmitter}
}
@inproceedings{10941597,
  title         = {An FFT Accelerator IP Core Implemented on FPGA},
  author        = {Challagundla, Vamsi Krishna and Kidav, Jayaraj U and Singh, Shashank Kumar and Hati, Anirban Jyoti and Mandiga, Sai Kumar},
  year          = 2025,
  month         = {Jan},
  booktitle     = {2025 IEEE International Students' Conference on Electrical, Electronics and Computer Science (SCEECS)},
  pages         = {1--4},
  doi           = {10.1109/sceecs64059.2025.10941597},
  issn          = {2688-0288},
  abstract      = {The main objective of this project is to design and implement a Fast Fourier Transform (FFT) IP core. Due to its ability to provide accurate frequency domain analysis of time domain signals, the FFT technique is indispensable in many applications related to digital signal processing. The implementation is based on the radix-2 method, whose lower computational complexity and hardware resource efficiency make it a good fit for FPGA platforms. With its robust FPGA and ARM CortexA53 processors, the ZCU104 board provides an adaptable environment for creating unique IP cores and incorporating them into more complex systems.The objective of this project is to use the Zynq SoC's hardware acceleration capabilities to improve the FFT core for speed and resource consumption. The ZCU104 board is used to test and validate the built IP core, proving its usefulness for real-time signal processing applications. As compared to software-based FFT implementations, the results demonstrate a notable boost in performance, underscoring the potential of FPGA based solutions in high performance computing jobs.},
  keywords      = {Program processors;Fast Fourier transforms;Signal processing algorithms;Throughput;Real-time systems;Radar signal processing;IP networks;Time-domain analysis;Signal analysis;Field programmable gate arrays;Radix 2 FFT;Verilog;ZYNQ Soc ZCU104 board;DDR4 Memory;AXI4 bus;FPGA Signal Processing}
}
@article{10945800,
  title         = {Adaptive Computing for Scale-Up Problems},
  author        = {Griffin, Kevin Patrick and Egan, Hilary and Frahan, Marc T.Henry de and Mueller, Juliane and Vaidhynathan, Deepthi and Wald, Dylan and Chintala, Rohit and Doronina, Olga A. and Sitaraman, Hariswaran and Young, Ethan and King, Ryan and Sanyal, Jibonananda and Day, Marc and Larsen, Ross E.},
  year          = 2025,
  month         = {Jan},
  journal       = {Computing in Science \& Engineering},
  volume        = 27,
  number        = 1,
  pages         = {28--38},
  doi           = {10.1109/mcse.2025.3555589},
  issn          = {1558-366x},
  abstract      = {Adaptive computing is an application-agnostic outer-loop framework to strategically deploy simulations and experiments to guide decision making for scale-up analysis. Resources are allocated over successive batches, which makes the allocation adaptive to some objective, such as optimization or model training. The framework enables the characterization and management of uncertainties associated with predictive models of complex systems when scale-up questions lead to significant model extrapolation. A key advancement of this framework is its integration of multifidelity surrogate modeling, uncertainty management, and automated orchestration of various computing and experimentation resources into a single integrated software package. This enables efficient multifidelity modeling across multiple computing resources by incorporating real-world constraints, such as relative queue times and throughput on individual machines into the multifidelity sampling decision. We discuss applications of this framework to problems in the renewable energy space, including biofuels production, material synthesis, perovskite crystal growth, and building electrical loads.},
  keywords      = {Computational modeling;Uncertainty;Data models;Adaptation models;Optimization;Predictive models;Decision making;Data acquisition;Training;Renewable energy sources;Software packages;Production materials}
}
@inproceedings{10946788,
  title         = {Efficient Caching with A Tag-enhanced DRAM},
  author        = {Babaie, Maryam and Akram, Ayaz and Elsasser, Wendy and Haukness, Brent and Miller, Michael R. and Song, Taeksang and Vogelsang, Thomas and Woo, Steven C. and Lowe-Power, Jason},
  year          = 2025,
  month         = {March},
  booktitle     = {2025 IEEE International Symposium on High Performance Computer Architecture (HPCA)},
  pages         = {745--760},
  doi           = {10.1109/hpca61900.2025.00062},
  issn          = {2378-203x},
  abstract      = {As SRAM-based caches are hitting a scaling wall, manufacturers are integrating DRAM-based caches into system designs to continue increasing cache sizes. While DRAM caches can improve the performance of memory systems, existing DRAM cache designs suffer from high miss penalties, wasted data movement, and interference between misses and demands. In this paper, we propose TDRAM, a novel DRAM microarchitecture tailored for caching. TDRAM enhances existing DRAM, such as HBM3, by adding small, low-latency mats to store tags and metadata on the same die as the data mats. These mats enable tag and data access in lockstep, in-DRAM tag comparison, and conditional data response based on the comparison result (reducing wasted data transfers), akin to SRAM cache mechanisms. TDRAM further optimizes hit and miss latencies through opportunistic early tag probing. Moreover, TDRAM introduces a flush buffer to store conflicting dirty data on write misses, eliminating data bus turnaround delays on write demands. We evaluate TDRAM in a full-system simulation using a set of HPC workloads with large memory footprints, showing that TDRAM, on average, provides $2.65 \times$ faster tag checks, $1.23 \times$ speedup, and 21\% less energy consumption compared to state-of-the-art commercial and research designs.},
  keywords      = {Energy consumption;Microarchitecture;Memory management;Energy conservation;Random access memory;Interference;Metadata;Energy efficiency;Low latency communication;System analysis and design;dram;dram cache;hbm;heterogeneous memories}
}
@inproceedings{10946813,
  title         = {OASIS: Object-Aware Page Management for Multi-GPU Systems},
  author        = {Wang, Yueqi and Li, Bingyao and Ziad, Mohamed Tarek Ibn and Eeckhout, Lieven and Yang, Jun and Jaleel, Aamer and Tang, Xulong},
  year          = 2025,
  month         = {March},
  booktitle     = {2025 IEEE International Symposium on High Performance Computer Architecture (HPCA)},
  pages         = {1678--1692},
  doi           = {10.1109/hpca61900.2025.00124},
  issn          = {2378-203x},
  abstract      = {The ever-growing need for high-performance computing has driven the popularity of employing multi-GPU systems. Modern multi-GPU systems employ unified virtual memory (UVM) to manage page placement and migration. However, the page management in UVM is application object agnostic. In this paper, we characterize the page access behaviors in relation to the application objects, and reveal that the beneficial page management policy varies according to (i) the different data objects within the same application, and (ii) the different execution phases of the same object. This motivates the need for dynamic and proactive page management in multi-GPU systems. To this end, we propose OASIS, which dynamically identifies object patterns during the execution and proactively determines the appropriate page management policies for these objects at runtime. Experimental results show that OASIS improves the performance over uniformly adopting on-touch migration, access counter-based migration, and duplication by an average of $\mathbf{6 4 \%}$, $\mathbf{3 5 \%}$, and $\mathbf{4 2 \%}$, respectively. Moreover, OASIS achieves a $\mathbf{1 2 \%}$ performance improvement over the state-of-the-art technique (i.e., GRIT) while having significantly lower design complexity.},
  keywords      = {Runtime;High performance computing;Memory management;Complexity theory;Object recognition;multi-gpus;numa;page management}
}
@inbook{10948973,
  title         = {36 The Rise of Sovereign AI: A Technological Race with National Stakes},
  author        = {Banafa, Ahmed},
  year          = 2025,
  booktitle     = {Artificial Intelligence in Action: Real-World Applications and Innovations},
  publisher     = {River Publishers},
  pages         = {233--238},
  isbn          = 9788770046190,
  url           = {https://ieeexplore.ieee.org/document/10948973},
  abstract      = {This comprehensive book dives deep into the current landscape of AI, exploring its fundamental principles, development challenges, potential risks, and the cutting-edge breakthroughs that are propelling it forward. Artificial intelligence (AI) is rapidly transforming industries and societies worldwide through groundbreaking innovations and real-world applications. Starting with the core concepts, the book examines the various types of AI systems, generative AI models, and the complexities of machine learning. It delves into the programming languages driving AI development, data pipelines, model creation and deployment processes, while shedding light on issues like AI hallucinations and the intricate path of machine unlearning. The book then showcases the remarkable real-world applications of AI across diverse domains. From preventing job displacement and promoting environmental sustainability, to enhancing disaster response, drone technology, and even nuclear energy innovation, it highlights how AI is tackling complex challenges and driving positive change. The book also explores the double-edged nature of AI, recognizing its tremendous potential while cautioning about the risks of misuse, unintended consequences, and the urgent need for responsible development practices. It examines the intersection of AI and fields like operating system design, warfare, and semiconductor technology, underscoring the wide-ranging implications of this transformative force. As the quest for artificial general intelligence (AGI) and superintelligent AI systems intensifies, the book delves into cutting-edge research, emerging trends, and the pursuit of multimodal, explainable, and causally aware AI systems. It explores the symbiotic relationship between AI and human creativity, the rise of user-friendly "casual AI," and the potential of AI to tackle open-ended tasks. This is an essential guide for understanding the profound impact of AI on our world today and its potential to shape our future. From the frontiers of innovation to the challenges of responsible development, this book offers a comprehensive and insightful exploration of the remarkable real-world applications and innovations driving the AI revolution.}
}
@inbook{10950817,
  title         = {The Sustainability Paradox},
  author        = {Orange, Erica},
  year          = 2024,
  booktitle     = {AI + The New Human Frontier: Reimagining the Future of Time, Trust + Truth},
  publisher     = {Wiley},
  pages         = {60--62},
  isbn          = 9781394276998,
  url           = {https://ieeexplore.ieee.org/document/10950817},
  abstract      = {Summary <p>AI is also being used for environmental monitoring to track changes in ecosystems, wildlife populations, and air quality. But for every way AI could contribute to sustainability efforts, more experts are raising concerns about the environmental costs of AI. The extent of AI's own carbon footprint, however, is quite difficult to measure as AI companies are not fully, if at all, transparent about just how much energy is used. Researchers are merely guessing based on available data. Reputations will be on the line as organizations will need to be more vocal about the AI sustainability paradox\&\#x2014;perhaps even making it an aspect of ESG (environmental, social, and governance) and CSR (corporate social responsibility) initiatives moving forward. Corporate leadership may be under greater pressure to reveal the energy and water consumption involved in the development and distribution of their products and could be held to greater public scrutiny for perpetuating the sustainability paradox.</p>},
  keywords      = {Artificial intelligence;Sustainable development;Data centers;Companies;Supercomputers;Cooling;Training;Supply chains;Ecosystems;Disasters}
}
