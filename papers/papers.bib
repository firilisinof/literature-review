  source        = {Scopus}
}
@article{Baratian2026,
  title         = {Integrated BWM-deep learning for medical waste collection in circular economy: sustainability considerations in pandemics},
  author        = {Baratian, Samira and Fazlollahtabar, Hamed},
  year          = 2026,
  journal       = {Journal of Supercomputing},
  volume        = 82,
  number        = 3,
  doi           = {10.1007/s11227-025-08218-2},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105029082272&doi=10.1007%2Fs11227-025-08218-2&partnerID=40&md5=99d06e684eb41e867e23507d4b1590f3},
  note          = {Cited by: 0},
  abstract      = {Covid-19 intensified the operational complexity and scale of medical waste collection and treatment. We study how circular economy-oriented recycling policies interact with sustainability indicators by integrating the best–worst method (BWM) for multi-criteria weighting with a deep learning (DL) model that predicts policy effectiveness. To ensure reproducibility, we provide full BWM matrices, consistency checks (CR = 0.006), and the DL architecture. In line with the scope, we articulate and evaluate the computational demands of large-scale policy simulation: our DL training and batched scenario evaluation are parallelizable and GPU-accelerated, and the workflow is designed to scale to national, multi-year datasets via data-parallel and model-parallel strategies. Results show that SDG 8 (Decent Work \& Economic Growth), SDG 17 (Partnerships), and SDG 6 (Clean Water \& Sanitation) receive the highest weights from experts, while SDG 3 (Good Health \& Well-Being) is ranked lower; we explain this counter-intuitive outcome via the economic leverage of recycling programs during crises. The DL classifier achieves 82.61\% accuracy with balanced class metrics, and we report robustness checks. We discuss implications, limitations, and the scalability of our pipeline on high-performance computing (HPC) platforms for real-time decision support in future health emergencies. To enhance clarity, we explicitly describe the analytical pipeline: expert judgments inform the BWM-derived SDG weights, which are subsequently integrated into the deep learning classifier to evaluate scenario-level sustainability performance. \textcopyright{} The Author(s), under exclusive licence to Springer Science+Business Media, LLC, part of Springer Nature 2026.},
  author_keywords = {Best–worst method; Covid-19; Deep learning; Medical waste; Sustainability},
  keywords      = {Circular economy; Decision support systems; Economic analysis; Learning systems; Pipelines; Recycling; Scales (weighing instruments); Sustainable development; Waste treatment; BAD methods; Best–bad method; Circular economy; Covid-19; Deep learning; Learning classifiers; Medical wastes; Operational scale; Sustainability considerations; Waste collection; Deep learning},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Barbhuiya2025,
  title         = {Structural performance and implementation challenges of next-generation concrete materials},
  author        = {Barbhuiya, Salim and Das, Bibhuti Bhusan and Rajput, Aditya and Katare, Vasudha and Das, Avik Kumar},
  year          = 2025,
  journal       = {Structures},
  volume        = 81,
  doi           = {10.1016/j.istruc.2025.110169},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105015304991&doi=10.1016%2Fj.istruc.2025.110169&partnerID=40&md5=23f4c57ce27726bd705f7e6666e1ac7c},
  note          = {Cited by: 4; All Open Access; Hybrid Gold Open Access},
  abstract      = {Conventional concrete faces limitations in durability, sustainability, and adaptability to modern structural demands, constraining its use in high-rise, bridge, and extreme-environment applications. This study examines emerging concrete mixes--HPC, UHPC, SCC, FRC, GPC, and 3D-Printed Concrete--by evaluating their mechanical properties, implementation challenges, and future opportunities. A review of experimental data, case studies, and comparative analyses was conducted to assess strength, durability, workability, and structural applications. Results show that HPC and UHPC reach compressive strengths of 60–200 MPa, GPC achieves 40–80 MPa with reduced CO₂ emissions, SCC demonstrates slump flows of 600–800 mm, and fibre reinforcement enhances tensile strength to 8–15 MPa. These findings highlight superior performance, sustainability, and constructability, though high costs, lack of standards, and scalability issues remain obstacles to widespread adoption. This review uniquely integrates comparative insights on High-Performance, Ultra-High-Performance, Self-Compacting, Fibre-Reinforced, Geopolymer, and 3D-Printed concretes, bridging laboratory findings with real-world applications. Unlike existing reviews, it emphasizes structural implementation challenges and opportunities. Key obstacles--including high cost, lack of standards, and scalability--are outlined to contextualize pathways for sustainable adoption. Overall, next-generation concretes deliver enhanced strength, durability, and sustainability, making them viable for critical infrastructure. Future studies should focus on advancing standardization, integrating nanotechnology and AI for mix optimization, and developing cost-effective, large-scale deployment strategies. \textcopyright{} 2025 The Authors},
  author_keywords = {3D-Printed Concrete; Durability; Geopolymer Concrete (GPC); Sustainability; Ultra-High-Performance Concrete (UHPC)},
  keywords      = {Bridges; Compressive strength; Cost effectiveness; Reinforced concrete; Scalability; Structural analysis; Sustainable development; Tensile strength; Ultra-high performance concrete; 3d-printed concrete; Concrete materials; Geopolymer concrete; High costs; High-performance concrete; Performance; Structural performance; Ultra high performance; Ultra-high-performance concrete; Durability},
  type          = {Review},
  publication_stage = {Final},
  source        = {Scopus}
}
@conference{Barbosa2016,
  title         = {Power monitoring and control for large scale projects: SKA, a case study},
  author        = {Barbosa, Domingos and Barraca, Joa\~{o} Paulo and Maia, Dalmiro and Carvalho, Bruno and Vieira, Jorge and Swart, Paul and Le Roux, Gerhard and Natarajan, Swaminathan and Van Ardenne, Arnold and Seca, Luis},
