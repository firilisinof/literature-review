  author        = {Grigorov, I.V. and Kolarov, G.V. and Stoyanov, D.V.},
  year          = 2008,
  journal       = {Proceedings of SPIE - The International Society for Optical Engineering},
  volume        = 7027,
  doi           = {10.1117/12.822508},
