@article{Gentzsch200955,
  title         = {Porting applications to grids and clouds},
  author        = {Gentzsch, Wolfgang},
  year          = 2009,
  journal       = {International Journal of Grid and High Performance Computing},
  volume        = 1,
  number        = 1,
  pages         = {55--77},
  doi           = {10.4018/jghpc.2009010105},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-78149312910&doi=10.4018%2Fjghpc.2009010105&partnerID=40&md5=45cf37a3af3adb1f853af32b2173f197},
  note          = {Cited by: 4; All Open Access; Green Open Access},
  abstract      = {A Grid enables remote, secure access to a set of distributed, networked computing and data resources. Clouds are a natural next step of Grids towards the provisioning of computing as a service. To "Grid-enable" applications, users have to cope with: complexity of grid architectures; different compute and data nodes; wide spectrum of grid middleware tools and services; the e-science application architectures, algorithms and programs. Therefore, the aim of this chapter is to guide users through the important stages of implementing applications on Grid and Cloud infrastructures, together with a discussion of important challenges and their potential solutions. As a case study, we present the DEISA Distributed European Infrastructure for Supercomputing Applications and describe the DEISA Extreme Computing Initiative DECI for porting and running scientific grand challenge applications on the DEISA Grid. This chapter concludes with an outlook on Compute Clouds, and the top ten rules of building a sustainable Grid. Copyright \textcopyright{} 2009, IGI Global.},
  author_keywords = {Cloud computing; Data management; Distributed systems; Grid applications; Grid computing; Grid portals; Grid resources},
  keywords      = {Application programs; Cloud computing; Distributed computer systems; Information management; Middleware; Cloud infrastructures; Distributed systems; E-science applications; Grid applications; Grid portals; Grid resource; Networked computing; Supercomputing applications; Grid computing},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@book{Gentzsch200962,
