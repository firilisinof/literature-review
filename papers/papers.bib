}
@article{Shi2025,
  title         = {Interpretable prediction of sulfate resistance in high-performance concrete based on ensemble learning and SHAP analysis},
  author        = {Shi, Jiawei and Wang, Qiao and Niu, Xinqiang and Zhou, Wei and Chang, Xiaolin and Zhang, Sifan},
  year          = 2025,
  journal       = {Case Studies in Construction Materials},
  volume        = 23,
  doi           = {10.1016/j.cscm.2025.e05350},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105017963480&doi=10.1016%2Fj.cscm.2025.e05350&partnerID=40&md5=349ad14733334a56e134cb4a5649bcaa},
  note          = {Cited by: 3; All Open Access; Gold Open Access; Green Open Access},
  abstract      = {Given increasing resource scarcity and environmental pressures, improving high-performance concrete (HPC) durability in marine environments is crucial for sustainable development. Current sulfate resistance assessment suffers from time-consuming and resource-intensive repetitive experimental testing, while existing machine learning approaches focus on isolated durability factors rather than comprehensive multi-variable marine conditions and most studies lack in-depth analysis of complex interactions within available experimental data. To address these limitations, this study develops an ensemble learning framework that leverages existing experimental data to avoid costly repetitive testing, systematically considers multi-variable interactions including SCM types, replacement levels, and employs interpretable analysis to reveal hidden patterns in sulfate resistance mechanisms. A dataset of 241 records from published studies was constructed and evaluated using five ensemble models with the corrosion resistance coefficient (K<sub>f</sub>[jls-end-space/]) as target. The Stack model achieved exceptional accuracy (R\ensuremath{^2}=0.961), significantly outperforming individual models. SHAP analysis revealed that GGBS at 15–25\hspace{0.167em}\% replacement synergistically enhances durability when combined with fly ash. A cost-durability Pareto optimization framework yielded three mix designs with clear engineering thresholds, providing practical tools for sulfate-rich marine environments. \textcopyright{} 2025 The Authors. Published by Elsevier Ltd. This is an open access article under the CC BY-NC-ND license. http://creativecommons.org/licenses/by-nc-nd/4.0/},
  author_keywords = {Ensemble learning; High-performance concrete; NSGA-II; SHAP analysis; Sulfate resistance},
  keywords      = {Corrosion resistance; Cost benefit analysis; Cost engineering; High performance concrete; Multiobjective optimization; Multivariable systems; Pareto principle; Sustainable development; Concrete durability; Ensemble learning; Environmental pressures; High-performance concrete; Marine environment; Multi variables; NSGA-II; Resource scarcity; SHAP analyze; Sulfate resistance; Durability},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Shi202511416,
  title         = {Dynamic tailoring of the gradient porosity of biomass-derived porous carbons for highly effective CO2 capture},
  author        = {Shi, Weiwei and Guo, Yanzhen and Lu, Qixin and Li, Haitao and Liang, Yachao and Ma, Faxue and Yang, Baocheng and Chang, Binbin},
  year          = 2025,
  journal       = {Green Chemistry},
  volume        = 27,
  number        = 37,
  pages         = {11416--11428},
  doi           = {10.1039/d5gc03217b},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105016692476&doi=10.1039%2Fd5gc03217b&partnerID=40&md5=79a627d29e7968c5a436b90e0bd25c21},
  note          = {Cited by: 9},
  abstract      = {Carbon capture has emerged as an efficient technology for mitigating the escalating atmospheric CO<sub>2</sub> levels. Porous carbons show promising potential for CO<sub>2</sub> capture by virtue of their tunable porosity and surface chemistry, while they typically exhibit limited capacity owing to the trade-off between high porosity and surface functionalization. Herein, we develop an innovative dynamic activation strategy with CuCl<sub>2</sub> as a porogen to construct biomass-derived hierarchical porous carbons (HPCs) with gradient porosity. This method not only enables the precise tailoring of pore size and surface heteroatom doping to synchronously achieve a high porosity and rich surface groups, but also allows for the recycling of porogens, aligning with green and sustainable chemistry principles. The optimized HPC material exhibits ultrahigh specific surface area (up to 2856.9 m<sup>2</sup> g<sup>-1</sup>), well-interconnected micropores and satisfactory surface functional groups contents. Systematic investigations reveal that ultramicropores (<0.7 nm) dominate CO<sub>2</sub> adsorption at low pressures, while larger micropores and mesopores contribute more to capacity at high pressures. The optimal sample achieves superior CO<sub>2</sub> uptakes of 6.95, 4.32, and 2.07 mmol g<sup>-1</sup> at 273, 298, and 323 K under 1 bar, respectively, alongside a high CO<sub>2</sub>/N<sub>2</sub> selectivity (up to 91 at 298 K). Furthermore, pyridinic-N and pyrrolic-N groups significantly improve selectivity, and meanwhile, the HPC materials demonstrate rapid adsorption kinetics and excellent cycling stability. This work not only advances the fundamental understanding of dynamic activation mechanisms but also establishes a sustainable pathway for designing porous carbon adsorbents for highly effective CO<sub>2</sub> capture. \textcopyright{} 2025 The Royal Society of Chemistry.},
  keywords      = {Adsorbents; Carbon capture; Carbon capture and storage; Carbon capture and utilization; Carbon dioxide; Carbon sequestration; Chemical activation; Chlorine compounds; Copper compounds; Functional groups; Micropores; Microporosity; Pore size; Porous carbon; Porous materials; Surface chemistry; Sustainable chemistry; Atmospheric CO 2; Dynamic tailoring; Efficient technology; Hierarchical porous carbons; High porosity; Micropores; Porogens; Porous carbon materials; Porous carbons; Tunables; Economic and social effects},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@conference{Shiau2010517,
  title         = {A real-time high-resolution underwater ecological observation streaming system},
  author        = {Shiau, Y.H. and Chen, Y.H. and Tseng, K.T. and Cheng, J.S. and Lin, S.I. and Lo, S.W. and Chou, H.M.},
  year          = 2010,
  journal       = {International Archives of the Photogrammetry, Remote Sensing and Spatial Information Sciences - ISPRS Archives},
  volume        = 38,
  pages         = {517--521},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84905084647&partnerID=40&md5=26be043d6bd0fd8a3b5d0f6a62e0b63c},
  note          = {Cited by: 6},
  abstract      = {This paper proposes a distributed architecture for real-time high-resolution underwater ecological observation streaming. The system, based on a three-tier architecture, includes stream receiver unit, stream processor unit, and presentation unit. It is a distributed computing and a loose coupling architecture. Stream receiver unit supports a variety of capture source devices, such as HDV, DV, WebCam, TV Card, Capture Card, etc., and stream compress encoding formats, such as MPEG-1/2/4, FLV, WMV, MJPEG, etc., that are commonly used. The multiple format supported feature made our system an outstanding platform, on which streaming can easily be broadcasted in real-time. Stream processor unit has two options: one directly streaming to presentation unit, the other to slices streaming into sequence of images and can be extracted and stored for further implement image processing. Presentation unit supports multiple display devices handy to end users. A web-based user interface was designed to allow users to select multiple realtime streams to browse. The system has been demonstrated to ecological observation in Taiwan. Ken-Ting National Park is located on the southernmost tip of Taiwan and is known for its dazzling coral reef. Four underwater CCTV cameras and three underwater high-resolution cameras are deployed to monitor the ecosystem of coral reefs continually and videos captured are streamed and processed in real-time. For HDV cameras, the challenges are network bandwidth and decode a high-resolution stream in real-time. The distributed servers are putted on NMMBA (National Museum of Marine Biology and Aquarium), and streams are transferred back to NCHC's (National Center for High-performance Computing) multicasting pool. Experimental results showed that the proposed distributed system is robust, adaptive, and powerful. Google Earth is a virtual globe and geographic program. It displays satellite images of varying resolution of the Earth's surface, and users can see the details, such as cities and streets, on Earth. Due to the powerful functions and population of Google Earth, we integrated our streaming system on Google Earth. Users can browse the real-time streaming and the surrounding environment on Google Earth.},
  author_keywords = {Distributed architecture; Ecological observation; GIS; High-resolution streaming; Real-time streaming},
  keywords      = {Cameras; Display devices; Ecology; Geographic information systems; Image processing; Marine biology; Motion Picture Experts Group standards; Multicasting; Network architecture; Real time systems; Reefs; Remote sensing; Social networking (online); User interfaces; Web browsers; Distributed architecture; Ecological observation; High performance computing; High resolution; High resolution camera; Real time streaming; Surrounding environment; Three-tier architecture; Computer architecture},
  type          = {Conference paper},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Shim2025,
  title         = {Quantifying job-level carbon efficiency in HPC: an empirical study based on the PM100 dataset},
  author        = {Shim, Hyungwook},
  year          = 2025,
  journal       = {Energy Informatics},
  volume        = 8,
  number        = 1,
  doi           = {10.1186/s42162-025-00586-6},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105021648981&doi=10.1186%2Fs42162-025-00586-6&partnerID=40&md5=df9b7bc8de3def22e7d2597efee4379f},
  note          = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access},
  abstract      = {This study utilizes the PM100 dataset to quantitatively estimate job-level carbon emissions and analyze efficiency across different resource configurations. A multilayer perceptron (MLP) regression model was applied to predict emissions using execution time along with CPU, memory, and node-level power consumption data. To evaluate efficiency, we proposed the Carbon Efficiency Score (CES), which enables the classification of jobs into efficiency tiers. The analysis revealed that long-running jobs with excessive memory usage tend to exhibit low efficiency, whereas jobs with balanced resource configurations demonstrate relatively higher efficiency. CES-based classification further showed a difference of more than 200-fold between the most and least efficient jobs. Overall, this study provides a foundational framework for developing carbon-aware scheduling strategies in HPC environments and offers practical insights for the design of sustainable supercomputing operational policies. \textcopyright{} The Author(s) 2025.},
  author_keywords = {CO2; Energy efficiency; HPC; Job-Level analysis},
  keywords      = {Carbon; Carbon dioxide; Carbon Economy; Job analysis; Supercomputers; Zero-carbon; Carbon analysis; Carbon efficiency; Carbon emissions; Empirical studies; Energy; HPC; Job-level analyze; Multilayers perceptrons; Regression modelling; Resource configurations; Energy efficiency},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Shim2025689,
  title         = {Comparative study on national HPC core strategies for AI adaptation-focusing on South Korea and the United States},
  author        = {Shim, Hyungwook and Suh, Minho},
  year          = 2025,
  journal       = {Edelweiss Applied Science and Technology},
  volume        = 9,
  number        = 3,
  pages         = {689--696},
  doi           = {10.55214/25768484.v9i3.5283},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105000095165&doi=10.55214%2F25768484.v9i3.5283&partnerID=40&md5=e2a2a868bfe2cb8578dd2516887e4bc7},
  note          = {Cited by: 0; All Open Access; Gold Open Access},
  abstract      = {This study compares high-performance computing policies in the United States and South Korea to derive an effective future policy model, an efficient governance structure, and key policy implications. By analyzing the National Strategic Computing Initiative and the 3rd National HPC Master Plan, the study examines their technology development and industrial promotion strategies based on five key criteria: policy priorities, implementation system, technology development strategy, infrastructure, and resource management. The findings reveal that the NSCI prioritizes global technological leadership, next-generation technology development, and cybersecurity, whereas the Master Plan focuses on AI-driven demand, technological independence, and industrial applications. These differences highlight the need for a concrete policy model with execution roadmaps, particularly for quantum computing resource development and core software technologies tailored to new architectures. Strengthening governance structures and enhancing resource management strategies will be crucial for ensuring sustainable growth and competitiveness in HPC. The study provides valuable insights for policymakers in designing more effective and future-proof HPC strategies. \textcopyright{} 2025 by the authors; licensee Learning Gate.},
  author_keywords = {AI; HPC; Master plan; NSCI; Strategy},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
