  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105020672809&doi=10.1016%2Fj.mseb.2025.118944&partnerID=40&md5=5c745eeb28b43dac1e81001b4aa175e2},
  note          = {Cited by: 0; All Open Access; Hybrid Gold Open Access},
  abstract      = {This study presents an eco-friendly and cost-effective strategy for synthesizing hierarchical porous carbon (HPC) from readily available alfalfa biomass for high-performance supercapacitor (SC) electrodes. The Alfalfa-HPC material was synthesized via carbonization followed by optimized KOH activation to engineer a highly favorable porous structure. Structural, morphological, and electrochemical analyses revealed that the activation temperature and precursor ratios significantly influenced pore development and beneficial intrinsic heteroatom doping (N, O). The resulting material possesses an exceptionally high specific surface area, enhancing ion transport and charge storage. Among the prepared samples, AC-7 exhibited the superior electrochemical performance, achieving a high specific capacitance of 502 F g<sup>-1</sup> in a three-electrode system. When assembled in symmetric coin cells with 6 M KOH electrolyte, AC-7 delivered a gravimetric capacitance of 97.6 F g<sup>-1</sup>, corresponding to a remarkable energy density of 13.56 Wh kg<sup>-1</sup> at a power density of 125 W kg<sup>-1</sup>. Critically, the electrode also demonstrated excellent cyclic stability, retaining over 92 \% of its initial capacitance after 2000 cycles. The superior performance of AC-7 is attributed to its optimal mesoporous content and greater heteroatom doping, which collectively enhanced ion diffusion and pseudocapacitive activity. This research successfully validates the utilization of abundant agricultural waste, like alfalfa, as a sustainable and low-cost precursor for developing next-generation high-performance carbon electrodes. \textcopyright{} 2025 Elsevier B.V.},
  author_keywords = {Biomass; Energy density; Heteroatom doping; KOH activation; Pore size distribution; Supercapacitor},
  keywords      = {Activation analysis; Activation energy; Carbon electrodes; Cost effectiveness; Electrochemical electrodes; Electrolytes; Electrolytic capacitors; Environmental protection; Porous carbon; Porous materials; Potassium hydroxide; Alfalfa biomass; Eco-friendly; Energy; Energy density; Heteroatom doping; Heteroatoms; Hierarchical porous carbons; KOH activation; Performance; Pore-size distribution; Biomass; Capacitance; Pore size; Supercapacitor},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Ashenfelder2009541,
  title         = {NDIIPP models for mass data transmission and storage},
  author        = {Ashenfelder, Mike and Boyko, Andy and Mandelbaum, Jane and Minor, David and McDonald, Robert and Moore, Richard},
  year          = 2009,
  journal       = {Library Trends},
