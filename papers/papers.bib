  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Mazzoni20191829,
  title         = {Developing a Methodology for a Participatory Ergonomics Evaluation Process: Human Performance and Productivity Cycle},
  author        = {Mazzoni, Cl\'{a}udia Ferreira and Campos, M\^{o}nica Vieira Garcia and Sirqueira, Carla Aparecida Gon\c{c}alves and Krause, Frank and de Kraker, Heleen and K\"{o}nemann, Reinier and Douwes, Marjolein},
  year          = 2019,
  journal       = {Advances in Intelligent Systems and Computing},
  volume        = 824,
  pages         = {1829--1838},
  doi           = {10.1007/978-3-319-96071-5_190},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85052297073&doi=10.1007%2F978-3-319-96071-5_190&partnerID=40&md5=99757351b167f66155d21e0f08185e9f},
  note          = {Cited by: 2},
  abstract      = {Applying ergonomics in an industry in a systemic way can generate benefits and cost savings, since it contributes to reduce financial losses due to injuries, accidents and absenteeism with consequent increase in productivity. The current assumption considers that managing human factors is the key to improve the performance of organizations. The objective of this paper is to present the application of the Human Performance and Productivity Cycle – HPC method developed by the Center of Innovation in Ergonomics with the support of the TNO ergonomics team. The HCP was created as a virtuous cycle that underlies five steps to achieve effective solutions in ergonomics. The method was tested in a wagon workshop of a railway industry located in Minas Gerais, Brazil. In order to reach solutions, principles of ergonomics, technical knowledge and adequate human performance were considered. The strong involvement of the workers and managers led to assertiveness in understanding the risks and proposing solutions culminating in the agile process. Co-responsibility for the successful implementation of ergonomic improvements was achieved. The framework's validation at the wagon workshop shows that the tools and techniques should be articulated and integrated. In such way, it can support the development of an ergonomic process to manage health, safety and productivity indicators of a sustainable model of prevention. \textcopyright{} 2019, Springer Nature Switzerland AG.},
  author_keywords = {Human performance; Method; Participatory ergonomics; Physical workload; Productivity},
  keywords      = {Accident prevention; Human resource management; Losses; Productivity; Railroad accidents; Vehicles; Effective solution; Ergonomic improvements; Human performance; Method; Minas Gerais , Brazil; Participatory ergonomics; Physical workloads; Tools and techniques; Ergonomics},
  type          = {Conference paper},
  publication_stage = {Final},
  source        = {Scopus}
}
@conference{McColl2019,
  title         = {The load confluence algorithm applied to a combined rotor/fuselage loads model with extended application to structural fatigue life tracking},
  author        = {McColl, Chance and Bauchau, Oliver and Sonneville, Valentin and deMontfort, Chad and Harper, Brian and McGinty, Robert and Bazilevs, Yuri},
  year          = 2019,
  journal       = {The Vertical Flight Society - Forum 75: The Future of Vertical Flight - Proceedings of the 75th Annual Forum and Technology Display},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85083945023&partnerID=40&md5=52ad4fe34644cfe6119bad6cf238cf73},
  note          = {Cited by: 1},
  abstract      = {This paper presents research addressing the technological gap in the predictive capabilities of modern computational fluid-structures interaction (FSI) in the context of the US Navy's requirement for accurate loads prediction for both critical rotorhead and fuselage components in the context of a real aircraft's fatigue life tracking program, with the ultimate objective of loads accuracy and performance robust enough to support near real-time lifing assessments across the full flight regime. This research, funded via US Navy STTR N17A-T009, touches on a broad range of innovative research areas, starting with application of the Load Confluence Algorithm (LCA) to a coupled main rotor-fuselage/tail rotor model for the UH-60A. This paper will document research to date, extending beyond traditional approaches such as the main rotor analyzed in isolation or a fuselage model affected only by the inflow generated via an actuator disk model of the main rotor. This includes the development of use of modal super-elements (MSEs) to model more complex rotorcraft components, such as the fuselage for use in main rotor loads simulations, as well as the stationary and rotating swashplates, and the rotating scissors. This paper will also document advances made in geometry modeling and mesh generation, computational mechanics of fluids and structures, modeling of coupled multi-physics phenomena, and high-performance computing, with improved representation of complex geometry and multi-physics phenomena. Lastly, these enhanced whole aircraft loads prediction methods will be examined within the context of future application to a structural fatigue life tracking program, in terms of accuracy, usability, and application performance. Copyright \textcopyright{} 2019 by the Vertical Flight Society. All rights reserved.},
  keywords      = {Actuator disks; Aircraft; Aircraft detection; Application programs; Computational mechanics; Fuselages; Mesh generation; Vehicle performance; Application performance; Computational fluid; Future applications; High performance computing; Innovative research; Multiphysics phenomena; Predictive capabilities; Traditional approaches; Fatigue of materials},
  type          = {Conference paper},
  publication_stage = {Final},
  source        = {Scopus}
}
@conference{McCombs2017,
  title         = {Performance benchmarking of the r programming environment on the stampede 1.5 supercomputer},
  author        = {McCombs, James R. and Michael, Scott},
  year          = 2017,
  journal       = {ACM International Conference Proceeding Series},
  volume        = {Part F128771},
  doi           = {10.1145/3093338.3093346},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85025810544&doi=10.1145%2F3093338.3093346&partnerID=40&md5=7933af71ae8b9c750e2b4fbcea25be18},
  note          = {Cited by: 0},
  abstract      = {We present performance results obtained with a new single-node performance benchmark of the R programming environment on the many-core Xeon Phi Knights Landing and standard Xeonbased compute nodes of the Stampede supercomputer cluster at the Texas Advanced Computing Center. The benchmark consists of microbenchmarks of linear algebra kernels and machine learning functionality that includes clustering and neural network training from the R distribution. The standard Xeon-based nodes outperformed their Xeon Phi counterparts for matrices of small to medium dimensions, performing approximately twice as fast for most of the linear algebra microbenchmarks. For matrices of medium to large dimensions, the Knights Landing nodes were competitive with or outperformed the standard Xeon-based nodes with most of the linear algebra microbenchmarks, executing as much as five times faster than the standard Xeon-based nodes. For the clustering and neural network training microbenchmarks, the standard Xeonbased nodes performed up to four times faster than their Xeon Phi counterparts for many large data sets, indicating that commonly used R packages may need to be reengineered to take advantage of existing optimized, scalable kernels. \textcopyright{} 2017 Association for Computing Machinery.},
  author_keywords = {Benchmarking; Many-core; R; Scalability; Xeon Phi; XSEDE},
  keywords      = {Algebra; Benchmarking; Cluster computing; Landing; Linear algebra; Neural networks; Scalability; Supercomputers; Sustainable development; Computing center; Large dimensions; Many core; Neural network training; Performance benchmarking; Single-node performance; Xeon Phi; XSEDE; Matrix algebra},
  type          = {Conference paper},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{McDonagh2022,
  title         = {Modelling a permanent magnet synchronous motor in FEniCSx for parallel high-performance simulations},
  author        = {McDonagh, James and Palumbo, Nunzio and Cherukunnath, Neeraj and Dimov, Nikolay and Yousif, Nada},
  year          = 2022,
  journal       = {Finite Elements in Analysis and Design},
  volume        = 204,
  doi           = {10.1016/j.finel.2022.103755},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85127629116&doi=10.1016%2Fj.finel.2022.103755&partnerID=40&md5=961f9cf1041f5109a6e7b0d1d794c5be},
  note          = {Cited by: 10; All Open Access; Green Open Access; Hybrid Gold Open Access},
  abstract      = {There are concerns that the extreme requirements of heavy-duty vehicles and aviation will see them left behind in the electrification of the transport sector, becoming the most significant emitters of greenhouse gases. Engineers extensively use the finite element method to analyse and improve the performance of electric machines, but new highly scalable methods with a linear (or near) time complexity are required to make extreme-scale models viable. This paper introduces a three-dimensional permanent magnet synchronous motor model using FEniCSx, a finite element platform tailored for efficient computing and data handling at scale. The model demonstrates comparable magnetic flux density distributions to a verification model built in Ansys Maxwell with a maximum deviation of 7\% in the motor's static regions. Solving the largest mesh, comprising over eight million cells, displayed a speedup of 198 at 512 processes. A preconditioned Krylov subspace method was used to solve the system, requiring 92\% less memory than a direct solution. It is expected that advances built on this approach will allow system-level multiphysics simulations to become feasible within electric machine development. This capability could provide the near real-world accuracy needed to bring electric propulsion systems to large vehicles. \textcopyright{} 2022 The Authors},
  author_keywords = {Electric machine; FEniCS; Finite element method; High-performance computing; Maxwell's equations; Open-source software},
  keywords      = {Data handling; Greenhouse gases; Maxwell equations; Open source software; Open systems; Permanent magnets; Propulsion; Synchronous motors; Vehicle performance; FEniCS; Greenhouses gas; Heavy duty vehicles; High-performance computing; High-performance simulation; Performance; Performance computing; Permanent Magnet Synchronous Motor; Scalable methods; Transport sectors; Finite element method},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
