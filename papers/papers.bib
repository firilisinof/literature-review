@article{Pan2024,
  title         = {Sustainable, super-stable thermochromic material by coupling hydroxypropyl cellulose and sodium carboxymethyl cellulose},
  author        = {Pan, Pengyu and Liu, Yuanyuan and Zhu, Zhishuang and Liu, Yang and Wei, Renzhong and Wang, Qiang and Miao, Qingxian and Lei, Yilian and Guo, Chengshui and Zhang, Hongjie and Huang, Liulian and Chen, Lihui and Li, Jianguo},
  year          = 2024,
  journal       = {International Journal of Biological Macromolecules},
  volume        = 268,
  doi           = {10.1016/j.ijbiomac.2024.131945},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85191660792&doi=10.1016%2Fj.ijbiomac.2024.131945&partnerID=40&md5=3bd17b49b553f529f8bb15a0685bc517},
  note          = {Cited by: 17},
  abstract      = {Hydroxypropyl cellulose (HPC) is a green thermochromic material in energy-saving buildings, anti-counterfeiting, and data security fields. However, the high lower critical solution temperature (LCST) of HPC, around 42 \textdegree{}C (higher than the human thermal comfort temperature), limits its thermochromic sensitivity, poor stability, and short lifespan. Herein, we developed a durable, high-performance cellulose-based thermochromic composite with a lower LCST and easy preparation capability by combining HPC with sodium carboxymethyl cellulose (CMC). In such thermochromic cellulose, CMC constructs a hydrophilic skeleton to enable uniform dispersion of HPC, and functions as a stronger competitor to attract the water molecules compared to HPC, both of which trigger high thermochromic sensitivity and low LCST (just 32.5 \textdegree{}C) of our CMC/HPC. In addition, CMC/HPC shows superior stability, such as 100-day working capability and 60-time recyclability. This advancement marks a significant step forward in creating sustainable, efficient thermochromic materials, offering new opportunities for energy conservation in the building. \textcopyright{} 2024 Elsevier B.V.},
  author_keywords = {Cellulose; Energy-saving; Environmentally friendly; Stability; Thermochromic},
  keywords      = {Carboxymethyl Cellulose; Energy Conservation; Hydroxypropyl Cellulose; Molecules; Sodium; Carboxymethylcellulose Sodium; Cellulose; Hydrophobic and Hydrophilic Interactions; Temperature; Cellulose; Historic preservation; Intelligent buildings; Molecules; Sodium; carboxymethylcellulose; hydroxypropylcellulose; cellulose; hydroxypropylcellulose; Carboxymethyl cellulose; Critical solution temperature; Energy  savings; Energy-savings; Environmentally friendly; Hydroxypropyl cellulose; Lower critical; Sodium carboxymethyl cellulose; Thermo-chromic; Thermochromic materials; Article; counterfeiting; energy conservation; information security; lower critical solution temperature; chemical phenomena; chemistry; temperature; Energy conservation},
  type          = {Article},
