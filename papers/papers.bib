@article{Wu201811108,
  title         = {Hierarchically Porous Carbons Derived from Biomasses with Excellent Microwave Absorption Performance},
  author        = {Wu, Zhengchen and Tian, Ke and Huang, Ting and Hu, Wei and Xie, Feifei and Wang, Jingjing and Su, Mengxing and Li, Lei},
  year          = 2018,
  journal       = {ACS Applied Materials and Interfaces},
  volume        = 10,
  number        = 13,
  pages         = {11108--11115},
  doi           = {10.1021/acsami.7b17264},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85044930951&doi=10.1021%2Facsami.7b17264&partnerID=40&md5=fc86effb12c05ac2d0c1e52cf1e1cf60},
  note          = {Cited by: 415},
  abstract      = {A variety of biomass-based carbon materials with two-level porous structure have been successfully prepared by one-step carbonization process. The first level of microscale pores templates from the inherent porous tissues, while the second one of nanopores is produced by the in situ etching by the embedded alkaline metal elements. The superimposed effect of nano and microscale pores endows the hierarchically porous carbons (HPCs) with excellent microwave absorption (MA) performance. Among them, the spinach-derived HPC exhibits a maximum reflection loss of -62.2 dB and a broad effective absorption bandwidth of 7.3 GHz. Particularly, this excellent MA performance can be reproduced using the biomass materials belonging to different families, harvested seasons, and origins, indicating a green and sustainable process. These encouraging findings shed the insights on the preparation of biomass-derived microwave absorbents with promising practical applications. \textcopyright{} 2018 American Chemical Society.},
  author_keywords = {biomass; carbon; hierarchically porous structure; in-suit activation; microwave absorption},
  keywords      = {Carbon; Carbonization; Microwaves; Porosity; Porous materials; Carbonization process; Effective absorption; Hierarchically porous; Hierarchically porous carbons; Microwave absorbent; Microwave absorption; Porous structures; Sustainable process; Biomass},
