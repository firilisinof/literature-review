@article{Hsu2019e1810,
  title         = {Lots of little ones: Analysis of charitable donations to a hospice and palliative care unit in Taiwan},
  author        = {Hsu, Ya-Chuan and Chu, Feng-Yuan and Chen, Tzeng-Ji and Chou, Li-Fang and Chang, Hsiao-Ting and Lin, Ming-Hwai and Hwang, Shinn-Jang},
  year          = 2019,
  journal       = {International Journal of Health Planning and Management},
  volume        = 34,
  number        = 4,
  pages         = {e1810 - e1819},
  doi           = {10.1002/hpm.2897},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85070932290&doi=10.1002%2Fhpm.2897&partnerID=40&md5=36b8306f3faa6065ad9a4dd4f6e46a79},
  note          = {Cited by: 4},
  abstract      = {Background: Charitable donations play a major role in the provision of hospice and palliative care (HPC) services, most of which are not reimbursed by health insurance programs. A good understanding of the constitution and use of donations is thus conducive to maintaining a high-quality HPC unit. Methods: The data sources were the publicly available balance sheet, work report, and donor lists of a foundation exclusively supporting one of the best HPC units in Taiwan in the fiscal year of 2017. The analysis included the donation amounts and frequencies by donor type (individual, corporate, and group) and the categories of expenses. Results: The foundation received 3033 donations worth a total of 7.8 million New Taiwan dollars (NTD) (approximately 258 thousand US dollars) in 2017. Two-thirds of the donations were allocated to the provision of direct care services. Of the 3033 donations, only 11 (0.4\%) were worth 100 000 NTD or more, while 108 (3.6\%) were valued between 10 000 and 99 999 NTD, 1268 (41.8\%) were valued between 1000 and 9999 NTD, and 1646 (54.2\%) were worth less than 1000 NTD. Of 1051 donors, 974 (92.7\%) were individuals, 378 (36.0\%) donated more than once, and 106 (10.1\%) donated 12 or more times in one year. Conclusion: HPC services in Taiwan are sponsored by lots of individuals and small donations. For sustainability of standards-based and quality HPC services, the benevolence of the public should be thus cherished and adequately responded to. \textcopyright{} 2019 John Wiley \& Sons, Ltd.},
  author_keywords = {charitable donation; hospice and palliative care; Taiwan},
  keywords      = {Charities; Foundations; Health Expenditures; Hospices; Humans; Palliative Care; Taiwan; Taiwan; health care; health insurance; health services; hospital sector; standard (regulation); sustainability; adult; article; controlled study; female; hospice; human; human experiment; major clinical study; male; palliative therapy; Taiwan; economics; health care cost; non profit organization; social welfare; Taiwan},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Hu2019479,
  title         = {Satellite-based high-resolution mapping of ground-level PM                         2.5                          concentrations over East China using a spatiotemporal regression kriging model},
  author        = {Hu, Hongda and Hu, Zhiyong and Zhong, Kaiwen and Xu, Jianhui and Zhang, Feifei and Zhao, Yi and Wu, Pinghao},
  year          = 2019,
  journal       = {Science of the Total Environment},
  volume        = 672,
  pages         = {479--490},
  doi           = {10.1016/j.scitotenv.2019.03.480},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85063917441&doi=10.1016%2Fj.scitotenv.2019.03.480&partnerID=40&md5=2b8da4c4df332826aa47ff738b193d5e},
  note          = {Cited by: 46},
  abstract      = {Statistical modeling using ground-based PM                             <sub>2.5</sub>                              observations and satellite-derived aerosol optical depth (AOD) data is a promising means of obtaining spatially and temporally continuous PM                             <sub>2.5</sub>                              estimations to assess population exposure to PM                             <sub>2.5</sub>                             . However, the vast amount of AOD data that is missing due to retrieval incapability above bright reflecting surfaces such as cloud/snow cover and urban areas challenge this application. Furthermore, most previous studies cannot directly account for the spatiotemporal autocorrelations in PM                             <sub>2.5</sub>                              distribution, impacting the associated estimation accuracy. In this study, fixed rank smoothing was adopted to fill the data gaps in a semifinished 3 km AOD dataset, which was a combination of the Moderate Resolution Imaging Spectroradiometer (MODIS) 3 km Dark Target AOD data and MODIS 10 km Deep Blue AOD data from the Terra and Aqua satellites. By matching the gap-filled 3 km AOD data, ground-based PM                             <sub>2.5</sub>                              observations, and auxiliary variable data, sufficient samples were screened to develop a spatiotemporal regression kriging (STRK) model for PM                             <sub>2.5</sub>                              estimation. The STRK model achieved notable performance in a cross-validation experiment, with a R square of 0.87 and root-mean-square error of 16.55 \ensuremath{\mu}g/m                             <sup>3</sup>                              when applied to estimate daily ground-level PM                             <sub>2.5</sub>                              concentrations over East China from March 1, 2015 to February 29, 2016. Using the STRK model, daily PM                             <sub>2.5</sub>                              concentrations with full spatial coverage at a resolution of 3 km were generated. The PM                             <sub>2.5</sub>                              distribution pattern over East China can be identified at a relatively fine spatiotemporal scale. Thus, the STRK model with gap-filled high-resolution AOD data can provide reliable full-coverage PM                             <sub>2.5</sub>                              estimations over large areas for long-term exposure assessment in epidemiological studies.                          \textcopyright{} 2019},
  author_keywords = {Aerosol optical depth; Fixed rank smoothing; MODIS;                              PM                             <sub>2.5</sub>                                                                                  ; Spatiotemporal regression kriging},
  keywords      = {China; Aerosols; Interpolation; Mean square error; Optical properties; Radiometers; Regression analysis; Satellites; Supercomputers; Aerosol optical depths; Fixed rank smoothing; MODIS; PM2.5; Regression-kriging; aerosol property; autocorrelation; image resolution; kriging; MODIS; particulate matter; regression analysis; satellite data; spatiotemporal analysis; Article; China; concentration (parameter); controlled study; environmental impact; geographic distribution; kriging; long term exposure; particulate matter; predictive value; priority journal; statistical model; urban area; Population statistics},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Hu20245655,
  title         = {A surrogate model-based ESM parameter tuning scientific workflow management framework for HPC},
  author        = {Hu, Liang and Wu, Xianwei and Che, Xilong},
  year          = 2024,
  journal       = {Earth Science Informatics},
  volume        = 17,
  number        = 6,
  pages         = {5655--5670},
  doi           = {10.1007/s12145-024-01460-x},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85203048089&doi=10.1007%2Fs12145-024-01460-x&partnerID=40&md5=e17109ff10577930ad84f72092a48e73},
  note          = {Cited by: 0},
  abstract      = {In the present era, scientific computation is gradually becoming a primary research method, with an increasing number of researchers engaging in simulation studies on various high-performance computing platforms. Scientific workflows play a crucial role in organizing these complex research tasks effectively. However, poorly managed scientific workflows can lead to wastage of HPC computational resources and fail to alleviate the operational burden on researchers. The parameter optimization of Earth System Models (ESM) poses specific challenges due to its complexity, exacerbating these issues. To address these challenges, we propose a scientific workflow management framework for surrogate-based ESM parameter optimization. This framework consists of four layers: the resource layer, which gathers current resource information; the service layer, which provides various components to ensure the accurate execution of workflows; the management layer, which monitors the execution status of workflows; and the software environment interaction layer, which serves as the interface for data exchange between users and the framework. We monitored a team engaged in tuning CAM parameters before and after adopting the framework, and the results showed significant improvements in operation numbers, task execution time, and storage resource consumption after deploying the framework. This validates that our proposed scientific workflow management framework effectively addresses the challenges in user operations and resource management during surrogate-based ESM optimization processes, demonstrating the potential of our framework. \textcopyright{} The Author(s), under exclusive licence to Springer-Verlag GmbH Germany, part of Springer Nature 2024.},
  author_keywords = {HPC; Parameter tuning; Scientific workflow; Workflow management framework},
  keywords      = {numerical model; optimization; performance assessment; resource management; software},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Hu2025,
  title         = {One stone, several birds: A carboxyl-carbazole-rich fluorescent covalent organic framework for the detection of tetrabromobisphenol S, Fe\ensuremath{^3} ⁺, ascorbic acid, D/L-arginine, and the removal of tetrabromobisphenol S},
  author        = {Hu, Jiaqi and Wang, Mingyue and Wang, Min and Wang, Dandan and Xiao, Yuqiang and Lan, Yue and Li, Lingling and Yang, Meiling and Wang, Minmin and Peng, Leijiao and Ke, Famin and Guo, Xiurong and Gao, Die},
  year          = 2025,
  journal       = {Journal of Hazardous Materials},
  volume        = 499,
  doi           = {10.1016/j.jhazmat.2025.140328},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105020252796&doi=10.1016%2Fj.jhazmat.2025.140328&partnerID=40&md5=d6aaf10b24bfb1a90628528c6dee0c37},
  note          = {Cited by: 1},
  abstract      = {Considering the efficient utilization of resources and the simultaneous detection of multiple analytes, achieving selective detection of diverse analytes on one fluorescent covalent organic framework (COF) is of great significance. Herein, a carboxyl-carbazole-rich fluorescent COF (COF-DABT) was strategically synthesized using 3,6-diamino carbazole, capable of forming halogen bonds with analytes, and 2,5-bis(4\ensuremath{'}-formylphenyl) terephthalic acid, rich in carboxyl groups, which interacts with various analytes and adjusts fluorescence performance via its electron-withdrawing properties. The introduction of carbazole imparts fluorescence to COF-DABT through the intramolecular charge transfer (ICT) effect, while enabling selective fluorescence quenching. Specifically, the ICT of carbazole can be disrupted via linear halogen bond interactions with TBBPS, resulting in selectively detection of TBBPS in a fluorescence-off mode. Furthermore, efficient enrichment of TBBPS is facilitated by halogen bonds with carbazole and hydrogen bonds with carboxyl groups on COF-DABT. Selective fluorescence quenching of COF-DABT by Fe<sup>3 +</sup> is achieved through chelating effect around carboxyl group, as well as cation-\ensuremath{\pi} interaction with carbazole benzene ring. This enables high selectivity detection of Fe<sup>3+</sup> via a fluorescence-off mode. Additionally, Fe<sup>3+</sup> can be reduced by ascorbic acid through REDOX reaction, mitigating interference with TBBPS detection and facilitating fluorescence-off-on mode detection of AA. Besides, rich carboxyl groups on COF-DABT exert a negative regulatory effect on the carbazole ICT mechanism. To counter this, D/L-Arg, with a size complementary to the adjacent carboxyl groups on COF-DABT, is introduced. Hydrogen bond interactions between D/L-Arg and carboxyl groups reduce the negative regulatory effect, allowing fluorescence enhancement for highly selective detection of D/L-Arg. Through rational design and functional optimization of fluorescent COF structures, multi-mode detection methods enable simultaneous detection of different analytes, achieving the goal of ``one stone, several birds.'' \textcopyright{} 2025 Elsevier B.V.},
  author_keywords = {Ascorbic acid; Carboxyl-carbazole rich fluorescent covalent organic framework; D/L- arginine; Fe<sup>3+</sup>; Multi-mode detection; Tetrabromobisphenol S},
  keywords      = {Arginine; Birds; Correlation detectors; Fluorescence quenching; Hydrogen bonds; Negative ions; Polycyclic aromatic hydrocarbons; Positive ions; Redox reactions; Signal detection; Supercomputers; arginine; ascorbic acid; bisphenol derivative; carbazole derivative; carboxyl group; ferric ion; halogen; lake water; metal organic framework; river water; sulfur; tap water; tetrabromobisphenol s; unclassified drug; benzene; cation; terephthalic acid; Carboxyl-carbazole rich fluorescent covalent organic framework; Covalent organic frameworks; D/L- arginine; Fe 3+; L-Arginine; Mode detection; Multi-mode detection; Multimodes; Tetrabromobisphenol; Tetrabromobisphenol S; ascorbic acid; benzene; fluorescence; hydrogen; optimization; adsorption; Article; environmental sustainability; fish; fluorescence; fluorescence intensity; hydrogen bond; isoelectric point; limit of detection; nonhuman; oxidation reduction reaction; plasma; reaction temperature; thermostability; ultraviolet visible spectroscopy; waste component removal; X ray diffraction; animal experiment; article; chelation; controlled study; drug analysis; male; Ascorbic acid},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
