@conference{Fan2017,
  title         = {Tornado hazard assessment for the continental of United States},
  author        = {Fan, Fanfu and Pang, Weichiang and Wang, Jin},
  year          = 2017,
  journal       = {2017 Americas Conference on Wind Engineering, ACWE 2017},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85029797257&partnerID=40&md5=b52800dbc090fd9e66e7d5a8be40807d},
  note          = {Cited by: 0},
  abstract      = {According the records of Storm Prediction Center (SPC) of the National Oceanic Atmospheric Administration (NOAA), approximately more than 1000 tornadoes spawned every year in the continental United States. Tornadoes often cause significant damages, injuries and economic losses to the affected regions. Compared to hurricanes, the damage footprint of a tornado is relatively small. While the damage potential of a tornado is high, the occurrence of a tornado at a given geographic location can be characterized as a low probability but high consequent event. The SPC maintains a database of historical tornado events with approximately 65 years of data. Since the historical data is limited and the impact of a tornado is very localized, it is not feasible to use solely the raw historical data or tracks to properly quantify the tornado risk for a given structure or a community that has not been affected by a past tornado event. This paper presents a stochastic simulation framework to generate synthetic tornado tracks for the Continental United States. The annual spawn rate was modeled using a negative binomial distribution. The spawn or touchdown locations were simulated using spawn probability density GIS maps, which specifically account for the variability of tornado properties at different geographic regions (e.g. tornado alley, Dixie alley and etc.), developed using the kernel density estimation (KDE). A database of 500,000 years of simulated tornado tracks were simulated using the Clemson high performance computing facility, the Palmetto Cluster. The track parameters included the tornado occurrence rate, intensity (EF-scale), touchdown location, touchdown time, and path direction. All these parameters are geographic dependent, meaning the properties vary based on the geographic locations. The simulated spawn rates and other key parameters for selected major cities in the United States were compared to the observations. Good agreements were observed between the simulations and observations. Using the simulated track database and a 2D tornado wind field model, the wind speed distributions for different return periods were computed for selected cities. As an illustration for the application of the tornado database, the computed wind speed distributions were used in a fragility framework to quantify the damage risk and loss potential of tornado hazards to a low-rise building.},
  author_keywords = {Risk analysis; Simulation; Tornado hazards; Tornado wind field; Wind speed},
  keywords      = {Cluster computing; Database systems; Hazards; Location; Losses; Magnetic disk storage; Probability density function; Risk analysis; Risk assessment; Safety engineering; Stochastic models; Stochastic systems; Wind; Wind effects; High performance computing; Kernel Density Estimation; National oceanic atmospheric administrations; Negative binomial distribution; Simulation; Tornado wind field; Wind speed; Wind speed distribution; Tornadoes},
  type          = {Conference paper},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Fan2024,
  title         = {Development of New Method for Concrete Carbon Emission evaluation: The Anti-freezing durability-oriented Carbon Emission Indicator (CEI) System and its application in design of low carbon HPC with high durability},
  author        = {Fan, Haotian and Yu, Hongfa and Ma, Haiyan and Ma, Haoxia and Chen, Xiaoqing and Xu, Yu and Zhang, Meng and Du, Qian},
  year          = 2024,
  journal       = {Journal of Cleaner Production},
  volume        = 478,
  doi           = {10.1016/j.jclepro.2024.143903},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85206636579&doi=10.1016%2Fj.jclepro.2024.143903&partnerID=40&md5=043f418ae230fdda1d5c76e292580fc5},
  note          = {Cited by: 9},
  abstract      = {This research focuses on the development of the Anti-freezing Durability-Oriented Carbon Emission Indicator (CEI) system for assessing concrete's carbon footprint with an emphasis on durability, particularly in freeze-thaw conditions. This novel approach reduces the environmental impact of concrete by integrating durability metrics into carbon emission evaluations. The paper presents experimental findings on mix designs for high-strength, low-carbon concrete, which demonstrate improved freeze-thaw durability. And found out that concrete mixes using sulfate-resistant cement with GGBS outperform those with FA and OPC in terms of low-carbon performance, in the newly developed 19 mixes, concrete mix incorporating air-entraining agents with sulfate-resistant cement and 40\% GGBS as a supplementary cementitious material, namely the HPC1-P\textbullet{}HSRF-S group, demonstrates a distinct low-carbon advantage across various indicators. Overall, the inclusion of fibers is shown to improve freeze-thaw durability, though with limited impact on compressive strength. The research underlines the importance of optimizing concrete mix designs for both environmental and durability considerations, presenting a significant step towards more sustainable construction practices. \textcopyright{} 2024},
  author_keywords = {Anti-freezing durability-oriented CEI; Fiber reinforcement in concrete; Freeze-thaw durability; Low-carbon high-performance concrete (HPC); Sulfate-resistant cement and GGBS},
  keywords      = {Carbon capture; Carbon capture and utilization; Carbon cycle; Carbon footprint; Carbon sequestration; Concrete mixers; Direct air capture; Environmental design; Environmental impact; Fiber reinforced concrete; Thawing; Zero-carbon; Anti-freezing; Anti-freezing durability-oriented carbon emission indicator; Carbon emissions; Fiber reinforcement (e); Fiber reinforcement in concrete; Freeze-thaw durability; High-performance concrete; Low carbon; Low-carbon high-performance concrete; Sulfate resistant cements; Sulphate-resistant cement and GGBS; Cements},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Fan2025,
  title         = {Refinement and application of life cycle assessment (LCA) for concrete: Development of a carbon emission metric normalized by salt-freezing durability and its use in designing high-durability, low-carbon, high-performance concrete},
  author        = {Fan, Haotian and Yu, Hongfa and Ma, Haiyan and Chen, Xiaoqing and Li, Lingyu and Du, Qian and zhang, Meng and Ma, Haoxia and Wu, Chao},
  year          = 2025,
  journal       = {Sustainable Materials and Technologies},
  volume        = 45,
  doi           = {10.1016/j.susmat.2025.e01622},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105014386833&doi=10.1016%2Fj.susmat.2025.e01622&partnerID=40&md5=fcd3d9667ed46e0045f7c75ea5fe37cf},
  note          = {Cited by: 2},
  abstract      = {This study proposes a novel and structured life cycle assessment (LCA) framework for evaluating low-carbon, high-durability concrete, with a specific focus on salt-freeze resistance in cold regions. The framework consists of four components: (1) a durability-normalized carbon emission index combining compressive strength and salt-freeze resistance; (2) a climate-adaptive service life prediction model based on environmental data from six representative global cities; (3) optimized mix designs utilizing ground granulated blast furnace slag (GGBS), air-entraining agents, and polypropylene fibers; and (4) quantitative validation under both laboratory and regional environmental conditions. Results show that the proposed high-performance concrete (e.g., HPC5-P-HSRF-S) achieves over 11.3 times the salt-freeze service life of conventional OPC concrete, while reducing life cycle carbon emissions from 397 kg CO₂/m<sup>3</sup> to 10.8 kg CO₂/m<sup>3</sup>, representing a 97.3 \% reduction. Even across varying climatic zones, the durability-normalized emissions index remains consistent, demonstrating the robustness and practical relevance of the model. These findings highlight the potential of integrating durability into LCA for more accurate, engineering-oriented design of sustainable infrastructure materials. \textcopyright{} 2025 Elsevier B.V.},
  author_keywords = {Carbon emission; Concrete salt-freeze durability; High-performance concrete (HPC); Life cycle assessment (LCA)},
  keywords      = {Carbon; Carbon cycle; Carbon emissions; Climate models; Compressive strength; Ecodesign; Freezing; High performance concrete; Life cycle assessment; Low emission; Particulate emissions; Service life; Sustainable development; A-carbon; Carbon emissions; Cold regions; Concrete salt-freeze durability; Emission index; High durability; High-performance concrete; Life cycle assessment; Low carbon; Durability},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Fan2026,
  title         = {Optimizing the mesopore ratio of lignin-derived hierarchical porous carbon via etching and exfoliation towards high-performance supercapacitors},
  author        = {Fan, Dezhe and Fu, Fangbao and Qiu, Shuoyang and Zhang, Wenli and Li, Zhixian and Huang, Jinhao},
  year          = 2026,
  journal       = {Chemical Engineering Science},
  volume        = 319,
  doi           = {10.1016/j.ces.2025.122222},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105011373461&doi=10.1016%2Fj.ces.2025.122222&partnerID=40&md5=bfa6632a24a1dd5dc42d438c3145e8c7},
  note          = {Cited by: 0},
  abstract      = {The trade-off between specific capacitance and rate performance in hierarchical porous carbons (HPC) hinders their widespread use in supercapacitors. Herein, we report a cost-effective synthesis of HPC with a high specific surface area of 2192 m<sup>2</sup>/g, and interconnected micro-mesopores using industrial lignin via in situ etching and gas exfoliation carbonization process. Investigation shows that when the specific surface area is similar, the mesopore-to-micropore volume ratio (R) is critical for balancing specific capacitance and rate performance. Higher micropore volume (low R) enhances capacitance by providing abundant active sites but impedes ion diffusion and degrading rate performance. Conversely, dominant mesopore volume (high R) facilitates rapid ion transport yet reduces adsorption capacity due to limited active sites. Notably, our optimized HPC with R of 0.62 achieves a remarkable specific capacitance of 354 F/g at 0.5 A/g and retains 271 F/g (76.6 \% retention) at 20 A/g. The symmetric supercapacitor demonstrates outstanding energy-power characteristics (11.9 Wh/kg at 302 W/kg) and long-term cycling stability (97.4 \% retention after 10,000 cycles). This work provides a strategy for designing advanced carbon electrode materials and a sustainable pathway for biomass utilization. \textcopyright{} 2025 Elsevier Ltd},
  author_keywords = {Hierarchical porous carbon; Lignin; Rate performance; Supercapacitor},
  keywords      = {Carbonization; Cost Effectiveness; Etching; Porosity; Porous Materials; Specific Surface; Carbonization; Cost effectiveness; Economic and social effects; Etching; Mesopores; Micropores; Microporosity; Porous carbon; Porous materials; Specific surface area; Active site; Capacitance performance; Cost effective; Hierarchical porous carbons; Mesopore; Micropore volumes; Performance; Rate performance; Specific capacitance; Trade off; Capacitance; Lignin; Supercapacitor},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Fan2026_2,
  title         = {Mathematical modeling of unsealed shrinkage in ultra high-performance concrete: analyzing influential factors and model performance},
  author        = {Fan, Hongjun and Yu, Jianhua and Wang, Gang and Gao, Hui and Deng, Xiaojun},
  year          = 2026,
  journal       = {Multiscale and Multidisciplinary Modeling, Experiments and Design},
  volume        = 9,
  number        = 1,
  doi           = {10.1007/s41939-025-01076-8},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105019492076&doi=10.1007%2Fs41939-025-01076-8&partnerID=40&md5=0ae7cfb298a7adaf335cd275809f4577},
  note          = {Cited by: 0},
  abstract      = {Accurate prediction of concrete shrinkage is crucial for enhancing durability and reducing service-life issues in construction. Conventional empirical methods frequently fail to account for the intricate nonlinear interactions between material components and ambient variables that affect shrinkage behavior. This study utilized machine learning techniques to improve predictive accuracy, optimizing Support Vector Regression (SVR) and Decision Tree Regression (DTR) models with advanced metaheuristic algorithms, specifically the Arithmetic Optimization Algorithm (AOA) and Aquila Foraging Technique (AFT). This paradigm sought to equilibrate precision, interpretability, and computing efficiency. The collection included unsealed shrinkage measurements affected by mix composition and environmental factors. Recursive Feature Elimination was employed for feature selection, guaranteeing the retention of the most pertinent variables for modeling. The model's performance was assessed using common measures, such as R\ensuremath{^2} and RMSE, with independent validation and test sets utilized to reduce overfitting. The optimized models exhibited superior predictive capacity, with coefficients of determination surpassing 0.98 in the test data. The dual-tree AOA-based method had the maximum accuracy, but with increased computational expense. The comparison research revealed a trade-off between predictive effectiveness and efficiency, indicating that simpler models may be more beneficial for quick applications. These findings indicate that optimization-assisted machine learning can function as a dependable instrument for predicting shrinkage behavior. The practical consequences encompass aiding mix design decisions, directing shrinkage control tactics, and enhancing the durability, cost-effectiveness, and sustainability of construction processes. \textcopyright{} The Author(s), under exclusive licence to Springer Nature Switzerland AG 2025.},
  author_keywords = {Alibaba and the forty thieves; AOA; DTR; SVR; US of HPC},
  keywords      = {Computational efficiency; Cost effectiveness; Durability; Learning algorithms; Learning systems; Machine learning; Optimization; Shrinkage; Alibaba and the forty thief; Arithmetic optimization algorithm; Decision tree regression; High-performance concrete; Influential factors; Optimization algorithms; Shrinkage behavior; Support vector regressions; Ultra high performance; US of HPC; Economic and social effects},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Faneca201935129,
  title         = {Tuning silicon-rich nitride microring resonances with graphene capacitors for high-performance computing applications},
  author        = {Faneca, Joaquin and Hogan, Benjamin T. and Diez, Iago R. and Gardes, Frederic Y. and Baldycheva, Anna},
  year          = 2019,
  journal       = {Optics Express},
  volume        = 27,
  number        = 24,
  pages         = {35129--35140},
  doi           = {10.1364/oe.27.035129},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85075712753&doi=10.1364%2FOE.27.035129&partnerID=40&md5=ee9b50e94af2db0875ac6cfd480778e4},
  note          = {Cited by: 13; All Open Access; Gold Open Access; Green Open Access},
  abstract      = {We demonstrate the potential of a graphene capacitor structure on silicon-rich nitride micro-ring resonators for multitasking operations within high performance computing. Capacitor structures formed by two graphene sheets separated by a 10 nm insulating silicon nitride layer are considered. Hybrid integrated photonic structures are then designed to exploit the electro-absorptive operation of the graphene capacitor to tuneably control the transmission and attenuation of different wavelengths of light. By tuning the capacitor length, a shift in the resonant wavelength is produced giving rise to a broadband multilevel photonic volatile memory. The advantages of using silicon-rich nitride as the waveguiding material in place of the more conventional silicon nitride (Si<sub>3</sub>N<sub>4</sub>) are shown, with a doubling of the device's operational bandwidth from 31.2 to 62.41 GHz achieved while also allowing a smaller device footprint. A systematic evaluation of the device's performance and energy consumption is presented. A difference in the extinction ratio between the ON and OFF states of 16.5 dB and energy consumptions of <0.3 pJ/bit are obtained. Finally, it has been demonstrated that increasing the permittivity of the insulator layer in the capacitor structure, the energy consumption per bit can be reduced even further. Overall, the resonance tuning enabled by the novel graphene capacitor makes it a key component for future multilevel photonic memories and optical routing in high performance computing. \textcopyright{} 2019 OSA - The Optical Society. All rights reserved.},
  keywords      = {Digital storage; Energy utilization; Nitrides; Silicon nitride; Tuning; Capacitor structures; High performance computing; High-performance computing applications; Integrated photonics; Operational bandwidth; Resonant wavelengths; Silicon rich nitrides; Systematic evaluation; Graphene},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Fang20202123,
  title         = {Facile construction of honeycomb-shaped porous carbon electrode materials using recyclable sodium chloride template for efficient lithium storage},
  author        = {Fang, ShiQing and He, HaoXuan and Yu, YingHui and Li, Xiao and Xie, WeiCheng and Li, Wei and Jin, LuQiao and Yang, ZhenYu and Cai, JianXin},
  year          = 2020,
  journal       = {Science China Technological Sciences},
  volume        = 63,
  number        = 10,
  pages         = {2123--2130},
  doi           = {10.1007/s11431-019-1557-2},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85090792803&doi=10.1007%2Fs11431-019-1557-2&partnerID=40&md5=5b2584789a461cdb52d1413953a4c5c6},
  note          = {Cited by: 3},
  abstract      = {Carbon materials are the preferred anode materials for Li-ion batteries. Here, we propose an easy and sustainable strategy to prepare honeycomb-shaped porous carbon (HPC) electrode materials through a process involving simple calcination and subsequent water washing by using polyvinyl-pyrrolidone (PVP) as carbon source and NaCl as pore-forming agent. A controllable cavity size and distribution of the carbon materials can be readily obtained solely by adjusting the NaCl amount. Results showed that the optimized HPC sample had a relatively uniform cavity distribution and a highly porous structure. Moreover, the special honeycomb-shaped structure was conducive to the electronic conductivity of the electrode materials, provided a short path for Li-ion transport and a wide interface with the electrolyte, and buffered the volume change of active materials. The special honeycomb-shaped structure was also maintained well after long cycles, which improved electrode stability. When used as anode materials for Li-ion batteries (LIBs), the sample demonstrated excellent cycling stability and rate performance, with a high specific capacity of 230 mA h g<sup>-1</sup> and a reversible capacity of 197 mA h g<sup>-1</sup>, after 1200 cycles at 2 C. Overall, we introduced a simple strategy for the potential mass production of porous carbon materials for LIBs. \textcopyright{} 2020, Science China Press and Springer-Verlag GmbH Germany, part of Springer Nature.},
  author_keywords = {honeycomb-shaped; lithium-ion batteries; polyvinyl-pyrrolidone; porous carbon materials; sodium chloride},
  keywords      = {Anodes; Carbon; Electrolytes; Honeycomb structures; Ions; Porous materials; Sodium chloride; Electrode stability; Electronic conductivity; High specific capacity; Polyvinyl pyrrolidone; Pore-forming agents; Porous carbon electrodes; Porous carbon materials; Sustainable strategies; Lithium-ion batteries},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@book{Farber2015129,
  title         = {Deep-Learning Numerical Optimization},
  author        = {Farber, Rob},
  year          = 2015,
  journal       = {High Performance Parallelism Pearls: Multicore and Many-core Programming Approaches},
  pages         = {129--142},
  doi           = {10.1016/b978-0-12-802118-7.00007-8},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84942891052&doi=10.1016%2FB978-0-12-802118-7.00007-8&partnerID=40&md5=2224958c09c38c5a6a15a539d18b1a6e},
  note          = {Cited by: 1},
  abstract      = {The massively parallel mapping and code described in this chapter are generic and can be applied to a broad spectrum of numerical optimization and machine-learning algorithms ranging from neural networks to support vector machines to expectation maximization and independent components analysis. Many of these techniques are heavily used in lucrative data-mining and social media workflows as well as real-time robotics, computer vision, signal processing, and augmented reality applications. The code in this chapter demonstrates that it is possible to exceed a TeraFLOP per second of average sustained performance on a single Intel Xeon Phi coprocessor (KNC) using only user-written C-code (no optimized libraries needed). The message passing interface (MPI) version described in this chapter can run with near-linear scalability and petascale performance on the current generation of leadership class supercomputers. It is expected this same mapping is exascale capable, an assertion that can be tested when such a machine is built. Both high performance and large memory make the Intel Xeon Phi coprocessor family an ideal platform for training on the large datasets that are required to solve complex and high-dimensional pattern recognition problems. However, the goodness does not stop with Intel Xeon Phi coprocessors as the optimized models produced by the code in this chapter can be used on ultra-low-power and small memory-footprint devices such as CPUs, DSPs, FPGA, and ASICs to perform a variety of real time and robotic tasks. \textcopyright{} 2015 Elsevier Inc. All rights reserved.},
  author_keywords = {Applied mathematics; Artificial neural networks; Deep-learning; Exascale; Intel Xeon Phi; Neural networks; Nonlinear principle components analysis; Numerical optimization; Principle components analysis; Robotics; Signal processing; System modeling and prediction; Vision},
  keywords      = {Augmented reality; C (programming language); Codes (symbols); Computer vision; Coprocessor; Data mining; Deep learning; Deep neural networks; Independent component analysis; Large dataset; Learning algorithms; Machine components; Mapping; Maximum principle; Message passing; Neural networks; Optimization; Principal component analysis; Program processors; Robotics; Signal processing; Supercomputers; Support vector machines; Vision; Applied mathematics; Exascale; Intel Xeon Phi; Nonlinear principle components; Numerical optimizations; Principle components analysis; System modeling; Machine learning},
  type          = {Book chapter},
  publication_stage = {Final},
  source        = {Scopus}
}
@conference{Farber2017,
  title         = {Crushing the dust in the western mojave desert using cost-effective, innovative and creative methodologies},
  author        = {Farber, Robert J. and Cowherd, Chatten and Cloud-Hughes, Michelle and Roberts, Earl and Roberts, Rick and Countess, Richard J. and Nguyen, Paul and Minshew, Hudson and DeSalvio, Alan and Banks, Brett and Rausch, Vicki and Campbell, Rich and Doster, Lloyd and Foster, Dan and Irwin, Sean and Noga, Andrew and Newton, Don and Yamasaki, Tammy and Schuder, Julie and Grim, Julia},
  year          = 2017,
  journal       = {Proceedings of the Air and Waste Management Association's Annual Conference and Exhibition, AWMA},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85039154392&partnerID=40&md5=c2333d392748f598faff12e9666aa0e1},
  note          = {Cited by: 0},
  abstract      = {The arid desert of the southwestern United States (US) experiences frequent dust problems that can lead to PM10 violations. Blowing dust is one of the major air quality problems of the arid desert. From 1992 through the present, a group of research scientists, the Dustbuster Research Group (DRG or Dustbusters), have been investigating techniques and developing methods for mitigating the windblown dust in the Mojave Desert and more specifically the Antelope Valley near Palmdale and Lancaster, California. Wind blown dust had worsened since the most recent drought began in 2012. Instead of an annual average seven inches of precipitation, less than two inches of annual precipitation has fallen beginning in 2012. This minimizes weedy annual vegetation in the spring windy season. Compounding this problem is the recent solar farm developments in the deserts. Thousands of acres have been disturbed and have led to more areas of blowing sand in a saltating domino effect. However, in the current winter of 2016-2017 precipitation has returned to above normal. While we don't expect this to continue, due to ocean warming, these winter rains have greatly put a dent in the drought short term. Honda closed their track in 2010. However, they reopened it in April 2016, spending \$25 million to renovate the Honda Proving Center (HPC). This paper focuses on the latest thinking for addressing approximately 300,000 cubic yards of unwanted "beach" sand plaguing the northern Fremont Valley. This area is home to HPC, the towns of Rancho Seco and Cantil and recently several utility scale photovoltaic solar farms. To aid solar farm construction companies and others, three user-friendly guidebooks addressing how- to dust mitigation solutions for a variety of problem areas were published in June 2011. These publications are geared for homeowners, farmers and large area land managers. Already, dust mitigation measures resulting from this 25-year Dustbuster program are being successfully implemented in the western Mojave Desert and elsewhere.},
  author_keywords = {Desert nursery; Desert re-vegetation; Dust mitigation; Ecological restoration; Excess blown sand integration; Fugitive dust; PM<sub>10</sub>; Rehabilitation of blow sand areas; Solar farms; Western Mojave Desert; Wind blown dust},
  type          = {Conference paper},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Fares2017703,
  title         = {Properties of high-performance concrete incorporating high-volume ground scoria rocks as natural pozzolan},
  author        = {Fares, Galal and Alhozaimy, Abdulrahman and Alawad, Omer Abdulla and Al-Negheimish, Abdulaziz},
  year          = 2017,
  journal       = {Magazine of Concrete Research},
  volume        = 69,
  number        = 14,
  pages         = {703--715},
  doi           = {10.1680/jmacr.15.00420},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85020720292&doi=10.1680%2Fjmacr.15.00420&partnerID=40&md5=a7ffada97b3be4e296b114d8780bc92e},
  note          = {Cited by: 8},
  abstract      = {In this paper, high-volume ground scoria rocks (SR) are investigated as alternative natural pozzolanic materials to produce sustainable high-performance concrete (HPC). The effects of the source and replacement levels of up to 50\% SR (by mass of cement) on the properties of HPC were investigated. Compressive strength greater than 50 MPa at 28 d was achieved for the SR replacement level of 50\%. The contribution of SR to the mechanical and microstructural properties is shown to be the result of dual pozzolanic-geopolymeric-like reactions. Permeability and pore size distribution analyses were used to evaluate the contribution of SR to the mechanical improvement in the hardened concrete. Different analysing techniques were used to examine the microstructure. Comparative study of the performance of SR powders against silica fume and fly ash validated the occurrence of the dual reactions in SR mixtures. The results are encouraging and show that SR from the Arabian shield can be used as a non-traditional local source for pozzolanic material to produce durable and sustainable HPC mixtures. The use of SR at a high replacement level of up to 50\% will significantly decrease cement consumption and contribute to more sustainable concrete construction in the Gulf region.},
  author_keywords = {Cement; Cementitious materials; Permeability \& pore-related properties; Sustainability},
  keywords      = {Cements; Compressive strength; Concretes; Fly ash; Mechanical permeability; Mixtures; Pore size; Silica fume; Sustainable development; Cement consumption; Cementitious materials; Comparative studies; Hardened concrete; Micro-structural properties; Natural pozzolan; Pozzolanic materials; Replacement level; High performance concrete},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Fares2019428,
  title         = {Fine limestone dust from ornamental stone factories: A potential filler for a high-performance cementitious matrix},
  author        = {Fares, Galal and Albaroud, Mahmoud Hamad and Khan, M. Iqbal},
  year          = 2019,
  journal       = {Construction and Building Materials},
  volume        = 224,
  pages         = {428--438},
  doi           = {10.1016/j.conbuildmat.2019.07.027},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85069494043&doi=10.1016%2Fj.conbuildmat.2019.07.027&partnerID=40&md5=1af72862aea1e00e51b2538572b878fe},
  note          = {Cited by: 8},
  abstract      = {The benefits of using waste materials as supplementary cementitious materials (ASCMs) become greater as their use will minimize the chemical, biological and even visual pollutions caused when they are left in an unexploited form. For example, the estimated amount of industrial fine limestone dust (FLSD) released from ornamental stone factories is enormous. Accordingly, efficient recycling of these types of dusts in concrete provides many ecological and economic advantages. FLSD particles were found to have a spherical morphology due to the grinding and polishing steps used in the factories causing their emission. In this research, FLSD has been incorporated into different cement pastes. These pastes contained different replacement levels of 0, 15, 30 and 45\% FLSD at various water-to-binder (W/B) ratios of 0.25, 0.35 and 0.45. They have been subjected to the effect of normal and sulfate attack conditions. The results showed that the paste mixture with a high FLSD replacement level did not demand for higher superplasticizer dosage in contrary to other types of dusts while gaining a high resistance to sulfate exposure. It has also been shown that the mixtures with 45\% FLSD had the minimum deterioration due to sulfate effect. In addition, at a low W/B ratio of 0.25, the resistance to sulfate attack was significant, as confirmed using ultrasonic pulse velocity (UPV) and microstructure analyses. The mixture with W/B ratio of 0.25 and 45\% FLSD has been deemed the optimum for the use in formulating high performance concrete. FLSD is proposed as a fine material with a high potential as a filler for HPC. \textcopyright{} 2019 Elsevier Ltd},
  author_keywords = {Filler; Fine limestone dust; High performance cementitious matrix; Ornamental stone factories},
  keywords      = {Biological materials; Concrete mixtures; Deterioration; Fillers; Grinding (machining); High performance concrete; Lime; Limestone; Mixtures; Morphology; Sulfur compounds; Cementitious matrices; Ecological and economic; Microstructure analysis; Ornamental stone; Resistance to sulfate attack; Superplasticizer dosages; Supplementary cementitious material; Ultrasonic pulse velocity; Dust},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Fares2020,
  title         = {Fine limestone dust from ornamental stone factories: a potential filler in the production of High-Performance Hybrid Fiber-Reinforced Concrete},
  author        = {Fares, Galal and Hamad Albaroud, Mahmoud and Iqbal Khan, M.},
  year          = 2020,
  journal       = {Construction and Building Materials},
  volume        = 262,
  doi           = {10.1016/j.conbuildmat.2020.120009},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85087590640&doi=10.1016%2Fj.conbuildmat.2020.120009&partnerID=40&md5=84ea62960a89de395e5cba8c5a282a77},
  note          = {Cited by: 9},
  abstract      = {The utilization of alternative supplementary cementitious materials (ASCM) and additives in concrete becomes a daily practice due to the increased awareness of their socio-ecological impacts. Exploring for renewable resources of ASCM has been the driving force for the research on this topic since decades. Waste materials have been shown to possess intrinsic physico-chemical properties dependent on their chemical source and physical status. However, wastes evolved in the form of fine dust are known to cause chemical, biological and visual pollution when left in open areas without collection and proper recycling or damping. The ornamental stone factories, necessary for the decoration of the contemporary constructions, produce fine limestone dust (FLSD), which was elucidated as an example in this study. A huge amount of FLSD is released from this industry. The incorporation of a high volume of FLSD and hybrid combination of steel fibers and polyvinyl alcohol (PVA) microfibers in the production of high-performance concrete (HPC) was the main objective of the study. The replacement level of 45\% FLSD has enabled a high dispersion of 0.35\% PVA microfibers in the presence of 1\% steel fibers of the total mix volume. Moreover, the presence of FLSD has also mitigated the occurrence of PVA balling effect, which often takes place at much lower dosages. The results of the mechanical and chloride-ion penetration resistance of the final concrete mixture were encouraging. Both high compressive strength of 70 MPa and elevated modulus of rupture of 12 MPa with a cementitious matrix of very low penetration for chloride ions, supported with enhanced microstructure, could be obtained. The production of high-performance hybrid fiber-reinforced concrete containing high volume ornamental stone dust is proved feasible, ecofriendly and sustainable. \textcopyright{} 2020 Elsevier Ltd},
  author_keywords = {Filler; Fine limestone dust; High performance hybrid fiber-reinforced concrete; Ornamental stone factories},
  keywords      = {Chlorine compounds; Compressive strength; Concrete additives; Concrete construction; Concrete mixtures; Concrete products; Dust; Hardness; High performance concrete; Lime; Limestone; Microfibers; Steel fibers; Cementitious matrices; Chloride ion penetration; Hybrid fiber-reinforced concrete; Modulus of rupture; Poly (vinyl alcohol) (PVA); Renewable resource; Replacement level; Supplementary cementitious material; Fiber reinforced concrete},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Farooq2021,
  title         = {Predictive modeling for sustainable high-performance concrete from industrial wastes: A comparison and optimization of models using ensemble learners},
  author        = {Farooq, Furqan and Ahmed, Wisal and Akbar, Arslan and Aslam, Fahid and Alyousef, Rayed},
  year          = 2021,
  journal       = {Journal of Cleaner Production},
  volume        = 292,
  doi           = {10.1016/j.jclepro.2021.126032},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85100425370&doi=10.1016%2Fj.jclepro.2021.126032&partnerID=40&md5=8782388ec746f4381a17020fb899d0b3},
  note          = {Cited by: 393},
  abstract      = {The cementitious matrix of high-performance concrete (HPC) is highly complex, and ambiguity exists with its mix design. Compressive strength can vary with the composition and proportion of constituent material used. To predict the strength of such a complex matrix the use of robust and efficient machine learning approaches has become indispensable. This study uses machine intelligence algorithms with individual learners and ensemble learners (bagging, boosting) to predict the strength of (HPC) prepared with waste materials. This is done by employing Anaconda (Python). Ensemble learner bagging, adaptive boosting algorithm, and random forest as modified bagging algorithm are employed to construct strong ensemble learner by incorporating weak learner. The ensemble learners are used on individual learners or weak learners including support vector machine and decision tree through regression and multilayer perceptron neural network. The data consists of 1030 data samples in which eight parameters namely cement, water, sand, gravels, superplasticizer, concrete age, fly ash and granulated blast furnace slag were chosen to predict the output. Twenty bagging and boosting sub-models are trained on data and optimization was done to give maximum R<sup>2</sup>. The test data is also validated by means of K-Fold cross-validation using R<sup>2</sup>, MAE, and RMSE. Moreover, evaluation of ensemble models with individual one is also checked by statistical model performance index (e.g., MAE, MSE, RMSE, and RMLSE). The result suggested that the individual model response is enhanced by using the bagging and boosting learners. Overall, random forest and decision tree with bagging give the robust performance of the models with R<sup>2</sup> = 0.92 with the least errors. On average, the ensemble model in machine learning would enhance the performance of the model. \textcopyright{} 2021 Elsevier Ltd},
  author_keywords = {Artificial intelligence; Concrete strength; Ensemble model in concrete; Machine learning; Prediction; Supervised machine learning; Waste materials},
  keywords      = {Blast furnaces; Complex networks; Compressive strength; Decision trees; Fly ash; Forecasting; High performance concrete; Matrix algebra; Multilayer neural networks; Predictive analytics; Random errors; Random forests; Slags; Support vector machines; Support vector regression; Adaptive boosting algorithms; Cementitious matrices; Constituent materials; Granulated blast furnace slag; K fold cross validations; Machine learning approaches; Multi-layer perceptron neural networks; Statistical modeling; Learning systems},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@book{Fathoni2026371,
  title         = {Computational Infrastructure and Software Tools for Robust Econometrics},
  author        = {Fathoni, Faiz Izaz and Sekti, Binastya Anggara},
  year          = 2026,
  journal       = {Robust Methods for Anomaly Detection in Econometrics},
