  note          = {Cited by: 40; All Open Access; Bronze Open Access},
  abstract      = {A cement-based material that meets the general goals of mechanical properties, workability, and durability as well as the ever-increasing demands of environmental sustainability is produced by varying the type and quantity of individual constituents in high-performance concrete (HPC) and ultrahigh-performance concrete (UHPC). Expensive and time-consuming laboratory experiments can be used to estimate the properties of concrete mixtures and elements. As an alternative, these attributes can be approximated by means of predictive models created through the application of artificial intelligence (AI) methodologies. AI approaches are among the most effective ways to solve engineering problems due to their capacity for pattern recognition and knowledge processing. Machine learning (ML) and deep learning (DL) are a subfield of AI that is gaining popularity across many scientific domains as a result of its many benefits over statistical and experimental models. These include, but are not limited to, better accuracy, faster performance, greater responsiveness in complex environments, and lower economic costs. In order to assess the critical features of the literature, a comprehensive review of ML and DL applications for HPC and UHPC was conducted in this study. This paper offers a thorough explanation of the fundamental terms and ideas of ML and DL algorithms that are frequently used to predict mechanical properties of HPC and UHPC. Engineers and researchers working with construction materials will find this paper useful in helping them choose accurate and appropriate methods for their needs. \textcopyright{} 2024 fib. International Federation for Structural Concrete.},
  author_keywords = {deep learning; high-performance concrete; machine learning; ultra-high-performance concrete},
  keywords      = {Concrete mixtures; Durability; High performance concrete; Learning systems; Pattern recognition; Soft computing; Sustainable development; Cement based material; Concrete performance; Critical review; Deep learning; High-performance concrete; Machine-learning; Mechanical durability; Prediction of mechanical properties; Softcomputing techniques; Ultra high performance concretes (UHPC); Deep learning},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{KumarDas2023,
  title         = {A seismic investigation of lithospheric velocities beneath the Chhotanagpur Plateau (India) using waveform modeling of shear-coupled PL waves and other phases},
  author        = {Kumar Das, Mukesh and Agrawal, Mohit and Patel, Anupam},
  year          = 2023,
  journal       = {Journal of Asian Earth Sciences},
  volume        = 256,
  doi           = {10.1016/j.jseaes.2023.105798},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85165993502&doi=10.1016%2Fj.jseaes.2023.105798&partnerID=40&md5=5d76a1edc8dfa98c10c91fdec0c45c38},
  note          = {Cited by: 0},
  abstract      = {We performed waveform modeling of shear-coupled PL waveforms and other phases to estimate the crust and uppermost mantle's shear and compressional wave velocity structure beneath the Chhotanagpur Plateau and its adjacent regions. The modeling scheme involves a modified form of the reflectivity method which generates synthetic seismograms for the range of frequencies between 0.002 Hz and 0.25 Hz, and the calculation of responses are distributed over 32 nodes of a High-Performance Computing (HPC) cluster through Message Passing Interface (MPI). It reduces the computation time to allow the model search space to be explored rigorously via a nonlinear global optimization method called Very Fast Simulated Annealing (VFSA). We used teleseismic earthquakes' waveforms of magnitude between 5.5 and 8.0 and focal depth between 300 km and 600 km at broadband seismic stations located in the Chhotanagpur plateau. The crustal thickness of the study area varies from \sim{} 40.5 km (at Khunti in SW) to \sim{} 45.6 km (at Sahibganj in NE). The thick crust under Sahibganj may be due to the subsidence of the Indian lithosphere in the Himalayan footprint. A low-velocity zone in the upper crust observed at Sahibganj may be due to the sediment deposition of the Ganga-Koshi formation. The higher Poisson's ratios for seismic stations at Sahibganj (\sim{}0.29), Dhanbad (\sim{}0.29), and Bokaro (\sim{}0.30) indicate the possible presence of partial melt mafic in the lower crust. Statistical tools such as the Posterior Probability Density functions (PPDs) and Parameter Correlation Matrices (PCMs) are used to find the uncertainties around best-fitting models. \textcopyright{} 2023 Elsevier Ltd},
  author_keywords = {Body waves; Composition and structure of the continental crust; Statistical methods; Time series analysis},
  keywords      = {Chhotanagpur; Himalayas; India; body wave; compression; continental crust; crustal thickness; earthquake magnitude; lithospheric structure; probability density function; seismic response; seismic survey; seismic velocity; seismic wave; seismogram; structural geology; time series analysis; velocity structure; wave modeling; waveform analysis},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Kunkel2014,
  title         = {Spiking network simulation code for petascale computers},
  author        = {Kunkel, Susanne and Schmidt, Maximilian and Eppler, Jochen M. and Plesser, Hans E. and Masumoto, Gen and Igarashi, Jun and Ishii, Shin and Fukai, Tomoki and Morrison, Abigail and Diesmann, Markus and Helias, Moritz},
  year          = 2014,
  journal       = {Frontiers in Neuroinformatics},
  volume        = 8,
  number        = {Oct},
  doi           = {10.3389/fninf.2014.00078},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84907973985&doi=10.3389%2Ffninf.2014.00078&partnerID=40&md5=950f698232edfb1bc3a1b0599916e5e6},
  note          = {Cited by: 91; All Open Access; Gold Open Access; Green Open Access},
  abstract      = {Brain-scale networks exhibit a breathtaking heterogeneity in the dynamical properties and parameters of their constituents. At cellular resolution, the entities of theory are neurons and synapses and over the past decade researchers have learned to manage the heterogeneity of neurons and synapses with efficient data structures. Already early parallel simulation codes stored synapses in a distributed fashion such that a synapse solely consumes memory on the compute node harboring the target neuron. As petaflop computers with some 100,000 nodes become increasingly available for neuroscience, new challenges arise for neuronal network simulation software: Each neuron contacts on the order of 10,000 other neurons and thus has targets only on a fraction of all compute nodes; furthermore, for any given source neuron, at most a single synapse is typically created on any compute node. From the viewpoint of an individual compute node, the heterogeneity in the synaptic target lists thus collapses along two dimensions: the dimension of the types of synapses and the dimension of the number of synapses of a given type. Here we present a data structure taking advantage of this double collapse using metaprogramming techniques. After introducing the relevant scaling scenario for brain-scale simulations, we quantitatively discuss the performance on two supercomputers. We show that the novel architecture scales to the largest petascale supercomputers available today. \textcopyright{} 2014 Kunkel, Schmidt, Eppler, Plesser, Masumoto, Igarashi, Ishii, Fukai, Morrison, Diesmann and Helias.},
  author_keywords = {Computational neuroscience; Large-scale simulation; Memory footprint; Memory management; Metaprogramming; Parallel computing; Supercomputer},
  keywords      = {Article; coding algorithm; computer program; computer simulation; mathematical analysis; mathematical computing; nerve cell network; nerve cell plasticity},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Kunkel2017,
  title         = {The NEST Dry-Run Mode: Efficient Dynamic Analysis of Neuronal Network Simulation Code},
  author        = {Kunkel, Susanne and Schenck, Wolfram},
  year          = 2017,
  journal       = {Frontiers in Neuroinformatics},
  volume        = 11,
  doi           = {10.3389/fninf.2017.00040},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85043794220&doi=10.3389%2Ffninf.2017.00040&partnerID=40&md5=7265cb22dd787aa61f5c9f2c04f6e3f2},
  note          = {Cited by: 13; All Open Access; Gold Open Access; Green Open Access},
  abstract      = {NEST is a simulator for spiking neuronal networks that commits to a general purpose approach: It allows for high flexibility in the design of network models, and its applications range from small-scale simulations on laptops to brain-scale simulations on supercomputers. Hence, developers need to test their code for various use cases and ensure that changes to code do not impair scalability. However, running a full set of benchmarks on a supercomputer takes up precious compute-time resources and can entail long queuing times. Here, we present the NEST dry-run mode, which enables comprehensive dynamic code analysis without requiring access to high-performance computing facilities. A dry-run simulation is carried out by a single process, which performs all simulation steps except communication as if it was part of a parallel environment with many processes. We show that measurements of memory usage and runtime of neuronal network simulations closely match the corresponding dry-run data. Furthermore, we demonstrate the successful application of the dry-run mode in the areas of profiling and performance modeling. Copyright \textcopyright{} 2017 Kunkel and Schenck.},
  author_keywords = {high-performance computing; large-scale simulation; memory footprint; performance analysis; profiling; spiking neuronal networks; supercomputer},
  keywords      = {article; memory; nerve cell network; protein fingerprinting; simulation},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Kuschel2017647,
  title         = {High-performance simulation of nation-sized smart grids},
  author        = {Kuschel, Christian and R\"{u}de, Ulrich},
  year          = 2017,
  journal       = {International Journal of Parallel, Emergent and Distributed Systems},
  volume        = 32,
  number        = 6,
  pages         = {647--668},
  doi           = {10.1080/17445760.2016.1218876},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84983472014&doi=10.1080%2F17445760.2016.1218876&partnerID=40&md5=b15e1da8da2bccf4291d74dcf870bea4},
  note          = {Cited by: 2},
  abstract      = {This paper develops a large scale simulation approach for smart grids with a fine temporal resolution. This permits a detailed simulation of every single smart grid participant facilitating real-time estimates on a realistic scale about load distribution, demand and supply. This is especially interesting when considering the sustainability and efficiency of renewable energy generation. The smart grid model is based on a multi-agent system. Each agent is modelled by an optimisation problem which minimises its costs to meet a prescribed demand. In order to bestow some flexibility to each agent, it can generate energy, by e.g. solar panels, or store energy. All agents participate in a cooperative bargaining game to compute their respective optimal solution. By doing so, the energy prices are dynamically adapted to the agents' solutions so that an energy market is formed. This bargaining game is designed that a unique Nash equilibrium exists. The computations to obtain the equilibrium point are performed in parallel. To this end, a synchronisation scheme is derived to ensure convergence of the proposed parallel bargaining algorithm. The smart grid structure and capacity limitations are also taken into account. The solutions of the bargaining game are compliant with the smart grid's capacities by solving a modified network flow problem and forcing the bargaining solution within the capacity limitations in an iterative procedure. The correctness of the presented parallel algorithm is validated in tests along with a parallel performance evaluation. As a proof of concept of the practical applicability of this approach, a smart grid with over 30 million private households and multiple energy types is simulated. \textcopyright{} 2016 Informa UK Limited, trading as Taylor \& Francis Group.},
  author_keywords = {Cooperative bargaining; high-performance computing; market model; multi-agent system; smart grid},
  keywords      = {Commerce; Electric power transmission networks; Game theory; Iterative methods; Multi agent systems; Optimization; Renewable energy resources; Cooperative bargaining; High performance computing; High-performance simulation; Large scale simulations; Market model; Optimisation problems; Renewable energy generation; Smart grid; Smart power grids},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@book{Kushwah2025331,
  title         = {Balancing optimization and emissions in heuristics and metaheuristics for hard combinatorial problems},
  author        = {Kushwah, Ashok and Tiwary, Amrit and Vuppuluri, Prem Prakash},
  year          = 2025,
  journal       = {Nature-inspired Metaheuristic Algorithms: Solving Real World Engineering Problems},
  pages         = {331--342},
  doi           = {10.1201/9781003612858-13},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105012010863&doi=10.1201%2F9781003612858-13&partnerID=40&md5=b34ef9a6c5ffa5b86274344e0e5e3fa4},
  note          = {Cited by: 0},
  abstract      = {Energy consumption and sustainability are becoming increasingly critical concerns in computing today. While high-performance computing (HPC) has made remarkable strides in solving complex real-world engineering and computational problems, this progress has often been at the cost of significant energy consumption and carbon emissions. It is therefore essential that we carefully assess the environmental impact of the algorithmic approaches used in solving such problems. This chapter presents a novel approach that considers both solution quality and the carbon footprint of the computational processes involved. For this purpose, three well-known NP-hard combinatorial problems are considered: the Traveling Salesman Problem (TSP), Quadratic Knapsack Problem, and Leaf-Constrained Minimum Spanning Tree (LCMST) problem. We compare the performance and environmental impact of extant heuristics and metaheuristics proposed in the literature for each problem. The study reveals that, in many cases, the heuristics with significantly lower carbon emissions can produce solutions that are nearly as close to optimality as those obtained by the (relatively computationally intensive) metaheuristics. The findings underscore the need for careful algorithm selection, particularly when small improvements in solution quality come at the cost of disproportionately higher energy consumption and emissions. Furthermore, our results provide motivation for the careful design of energy-efficient memetic algorithms, which can blend the strengths of both heuristics and metaheuristics while minimizing their environmental footprint. This study contributes to the growing discourse on sustainable computing in the field of optimization. \textcopyright{} 2025 selection and editorial matter, Sulabh Bansal, Aprna Tripathi, Shilpa Srivastava and Prem Prakash Vuppuluri; individual chapters, the contributors.},
  keywords      = {Carbon; Carbon footprint; Combinatorial optimization; Computational methods; Energy utilization; Environmental impact; Green computing; Heuristic algorithms; Problem solving; Sustainable development; Combinatorial problem; Computational problem; Energy sustainability; Energy-consumption; Engineering problems; Metaheuristic; Optimisations; Performance computing; Real-world; Solution quality; Energy efficiency},
  type          = {Book chapter},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Kutzli2023,
  title         = {Formation and characterization of plant-based amyloid fibrils from hemp seed protein},
  author        = {Kutzli, Ines and Zhou, Jiangtao and Li, Ting and Baier, Stefan K. and Mezzenga, Raffaele},
  year          = 2023,
  journal       = {Food Hydrocolloids},
  volume        = 137,
  doi           = {10.1016/j.foodhyd.2022.108307},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85142736243&doi=10.1016%2Fj.foodhyd.2022.108307&partnerID=40&md5=a07431a4f29c8b6beb5cdc32ab2420cd},
  note          = {Cited by: 94; All Open Access; Green Open Access; Hybrid Gold Open Access},
  abstract      = {Amyloid fibrils from plant-based food protein sources bear a large unexploited potential for applications in food and other biomaterials due to their techno-functional features. However, their low solubility and highly complex, inhomogeneous protein composition often hamper fibrillization. The objective of this study was to evaluate the feasibility of amyloid fibril production from hemp seed protein, known as a sustainable and low-allergenic protein source. Hemp protein concentrate (HPC), primarily constituted of the 11 S globulin edestin, with 89.0\% protein solubility (0.25\% w/w HPC, pH 2) was extracted using gentle micellization. Fibrillization of HPC (2\% w/w, pH 2, 90 \textdegree{}C, 300 rpm) was monitored over 5 h by ThT fluorescence, exhibiting a steep increase in fluorescence signal after a lag phase of 180 min. SDS-PAGE analysis indicated progressive polypeptide hydrolysis upon heating and the formation of large proteinaceous aggregates after 160 min. Conformational changes towards increased \ensuremath{\beta}-sheet content were demonstrated by CD and FTIR. The morphology of the formed fibrillar aggregates was characterized by TEM and AFM. While essentially linear, branching effects of the fibrils became visible and kept increasing with incubation time. After a relatively short incubation time of 4 h, fibrils had an average height of 7.8 nm, a contour length of 1.8 \ensuremath{\mu}m, and a persistence length of \sim{}2.7 \ensuremath{\mu}m. These results suggest, that under the chosen conditions for protein extraction and incubation, HPC forms relatively flexible amyloid fibrils with a high aspect ratio and tendency to form branches. By revealing the potential of hemp seed proteins for amyloid fibril formation, these results contribute to expand the understanding of plant protein fibrillization. \textcopyright{} 2022 The Authors},
  author_keywords = {Edestin; Fibril morphology; Hemp protein concentrate; Micellization; Protein extraction; Protein nanofibrils; Protein self-assembly},
  keywords      = {Aggregates; Extraction; Fluorescence; Glycoproteins; Hemp; Micelles; Morphology; Proteins; Seed; Self assembly; Solubility; Amyloid fibril; Edestin; Fibril morphology; Hemp protein concentrate; Hemp seeds; Protein concentrates; Protein extraction; Protein nanofibrils; Protein self-assemblies; Seed protein; Aspect ratio},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Kynclova201163,
  title         = {High performance concrete as a sustainable material},
  author        = {Kynclova, Magdalena and Fiala, Ctislav and Hajek, Petr},
  year          = 2011,
  journal       = {International Journal of Sustainable Building Technology and Urban Development},
