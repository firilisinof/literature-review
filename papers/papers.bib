@article{Montanana202061,
  title         = {Open Source Framework for Enabling HPC and Cloud Geoprocessing Services},
  author        = {Monta\~{n}ana, Jos\'{e} Miguel and Marangio, Paolo and Herv\'{a}s, Antonio},
  year          = 2020,
  journal       = {Agris On-line Papers in Economics and Informatics},
  volume        = 12,
