@article{Zhou2019,
  title         = {waveformlidar: An R package for waveform LiDAR processing and analysis},
  author        = {Zhou, Tan and Popescu, Sorin},
  year          = 2019,
  journal       = {Remote Sensing},
  volume        = 11,
  number        = 21,
  doi           = {10.3390/rs11212552},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85074660701&doi=10.3390%2Frs11212552&partnerID=40&md5=00c5ed0e604cfb754f7e05b6ff1f3889},
  note          = {Cited by: 20; All Open Access; Gold Open Access; Green Open Access},
  abstract      = {A wealth of FullWaveform (FW) LiDAR (Light Detection and Ranging) data are available to the public from different sources, which is poised to boost extensive applications of FW LiDAR data. However, we lack a handy and open source tool that can be used by potential users for processing and analyzing FW LiDAR data. To this end, we introduce waveformlidar, an R package dedicated to FW LiDAR processing, analysis and visualization as a solution to the constraint. Specifically, this package provides several commonly used waveform processing methods such as Gaussian, Adaptive Gaussian and Weibull decompositions and deconvolution approaches (Gold and Richard-Lucy (RL)) with users' customized settings. In addition, we also developed functions to derive commonly used waveform metrics for characterizing vegetation structure. Moreover, a new way to directly visualize FW LiDAR data is developed by converting waveforms into points to form the Hyper Point Cloud (HPC), which can be easily adopted and subsequently analyzed with existing discrete-return LiDAR processing tools such as LAStools and FUSION. Basic explorations of the HPC such as 3D voxelization of the HPC and conversion from original waveforms to composite waveforms are also available in this package. All of these functions are developed based on small-footprint FW LiDAR data but they can be easily transplanted to the large footprint FW LiDAR data such as Geoscience Laser Altimeter System (GLAS) and Global Ecosystem Dynamics Investigation (GEDI) data analysis. It is anticipated that these functions will facilitate the widespread use of FW LiDAR and be beneficial for better estimating biomass and characterizing vegetation structure at various scales. \textcopyright{} 2019 by the authors.},
  author_keywords = {Composite waveform; Deconvolution; hyper point cloud; Waveform decomposition; Waveform voxel},
  keywords      = {Aneroid altimeters; Decomposition; Deconvolution; Lithium compounds; Processing; Radio altimeters; Vegetation; Deconvolution approach; Discrete-return lidar; Geoscience laser altimeter systems; LIDAR (light detection and ranging); Point cloud; Vegetation structure; Wave forms; Waveform processing; Optical radar},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Zhou2022,
  title         = {Singlet oxygen-dominated transformation of oxytetracycline by peroxymonosulfate with CoAl-LDH modified hierarchical porous ceramics: Toxicity assessment},
  author        = {Zhou, Qingcan and Chen, Li and Yan, Lianglin and Cheng, Teng and Wang, Xiaolong and Zhang, Yun},
  year          = 2022,
  journal       = {Chemical Engineering Journal},
  volume        = 436,
  doi           = {10.1016/j.cej.2022.135199},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85124630721&doi=10.1016%2Fj.cej.2022.135199&partnerID=40&md5=c08e3cdfdc0c7d3a117b59b5b4781c71},
  note          = {Cited by: 67},
  abstract      = {Singlet oxygen (<sup>1</sup>O<sub>2</sub>) dominated advanced oxidation processes have gained much attention due to their ability to transform or even detoxify organic pollutants. Herein we report that CoAl-LDH modified 3D printed hierarchical porous ceramics (3DP-HPC\@CoAl-LDH) were able to efficiently activate peroxymonosulfate to degrade oxytetracycline (OTC) at pH 6.2 (over 99\% removal in 30 min) and transform it into less toxic by-products. Cl<sup>-</sup> and natural organic matter showed an inhibitory effect on OTC degradation. Quenching experiments and ESR results identified the main contribution of <sup>1</sup>O<sub>2</sub> to OTC oxidation besides SO<sub>4</sub><sup>\textbullet{}-</sup>, O<sub>2</sub><sup>\textbullet{}–</sup> and <sup>\textbullet{}</sup>OH. Several possible pathways of OTC degradation were proposed based on the by-products detected using LC-MS. T.E.S.T calculation based on quantitative structure–activity relationships (QSARs) revealed detoxification of transformation products. Flow cytometry method was applied to quantify the cytotoxic effects of the reaction solution including the degradation products at various reaction times. Density functional theory simulation suggested that the strong electronic interaction between Co (II) and PMS allowed the 3DP-HPC\@CoAl-LDH to effectively adsorb HSO<sub>5</sub><sup>-</sup> and split the O-O bond. Moreover, the 3DP-HPC\@CoAl-LDH can be separated directly from water and reused with a degradation efficiency of more than 83\% after 11 cycles, demonstrating high recyclability and sustainable catalytic efficiency. Furthermore, a 3D printed impeller-agitator was fabricated and evaluated for potential practical application. The strategy proposed in this study may provide alternative approach to design functional devices as PMS activators and treat bio-refractive contaminants for practical applications. \textcopyright{} 2022 Elsevier B.V.},
  author_keywords = {3D printed impeller-agitator; CoAl LDH; Peroxymonosulfate; Singlet oxygen; Toxicity assessment; Transformation products},
  keywords      = {3D printers; Degradation; Density functional theory; Detoxification; Impellers; Organic pollutants; Oxygen; Toxicity; 3d printed impell-agitator; Advanced Oxidation Processes; Coal LDH; Hierarchical porous; Peroxymonosulfate; Porous ceramics; Singlet oxygen; Toxic byproducts; Toxicity assessment; Transformation products; Efficiency},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Zhou2023,
  title         = {Upcycling of real-world HDPE plastic wastes into high-purity methane and hierarchical porous carbon materials: Influence of plastics additives},
  author        = {Zhou, Xiaoli and He, Pinjing and Peng, Wei and L\"{u}, Fan and Shao, Liming and Zhang, Hua},
  year          = 2023,
  journal       = {Journal of Environmental Chemical Engineering},
  volume        = 11,
  number        = 2,
  doi           = {10.1016/j.jece.2023.109327},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85147095668&doi=10.1016%2Fj.jece.2023.109327&partnerID=40&md5=41914bc11c17337b3d46b53b8d1bf9c3},
  note          = {Cited by: 27},
  abstract      = {The massive use and discarding of plastics have brought serious environmental problems. Upcycling of plastic waste into fuels and value-added materials is a promising approach for mitigating environmental pressure and the energy crisis. However, pure plastic resins were used in most current research, and the influence of plastics additives is seldom studied. In this study, real-world high-density polyethylene (HDPE) plastic wastes (PWs) with additives of CaCO3 and carbon black were investigated. PWs were converted into high-purity methane (>93 \%) and hierarchical porous carbon materials (HPCs) with high specific surface area (2785 -2913 m2 g-1) through autogenic pressure pyrolysis-KOH activation. Applied in supercapacitors, HPCs exhibited outstanding specific capacitance (301 F g-1 at 1 A g-1), rate performance (89.1 \% at 20 A g-1), and cyclic stability (82 \% after cycling for 5000 times). The additives showed little influence on the product distribution and methane content, but changed the morphology and properties of HPCs. With additives, the meso- and macro-pore proportion and surface functional groups increased, but the graphitization degree decreased, which further altered the capacitive performances of HPCs. HPC from PWs with additives exhibited higher specific capacitance, and better rate performance, but lower cyclic stability. This work paved an efficient and sustainable way for the high-value utilization of PWs.  \textcopyright{} 2023 Elsevier Ltd.},
  author_keywords = {Autogenic pressure pyrolysis; Hierarchical porous carbon; Plastics additives; Supercapacitors; Upcycling of plastic waste},
  keywords      = {Additives; Calcite; Calcium carbonate; Capacitance; Carbon black; Elastomers; Energy policy; High density polyethylenes; Methane; Morphology; Porous materials; Supercapacitor; Autogenic pressure; Autogenic pressure pyrolyse; Hierarchical porous carbons; High-density polyethylenes; Plastic additives; Plastics waste; Polyethylene plastics; Porous carbon materials; Real-world; Upcycling of plastic waste; Pyrolysis},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Zhou2024,
  title         = {Reductive amination of oxidized hydroxypropyl cellulose with \ensuremath{\omega}-aminoalkanoic acids as an efficient route to zwitterionic derivatives},
  author        = {Zhou, Yang and Yao, Yimin and Zhai, Zhenghao and Mohamed, Mennatallah A. and Mazzini, Fiorella and Qi, Qingqing and Bortner, Michael J. and Taylor, Lynne S. and Edgar, Kevin J.},
  year          = 2024,
  journal       = {Carbohydrate Polymers},
  volume        = 328,
  doi           = {10.1016/j.carbpol.2023.121699},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85181686136&doi=10.1016%2Fj.carbpol.2023.121699&partnerID=40&md5=ac2735f2cb524f66998055ffb935b796},
  note          = {Cited by: 4},
  abstract      = {Zwitterionic polymers, with their equal amounts of cationic and anionic functional groups, have found widespread utility including as non-fouling coatings, hydrogel materials, stabilizers, antifreeze materials, and drug carriers. Polysaccharide-derived zwitterionic polymers are attractive because of their sustainable origin, potential for lower toxicity, and possible biodegradability, but previous methods for synthesis of zwitterionic polysaccharide derivatives have been limited in terms of flexibility and attainable degree of substitution (DS) of charged entities. We report herein successful design and synthesis of zwitterionic polysaccharide derivatives, in this case based on cellulose, by reductive amination of oxidized 2-hydroxypropyl cellulose (Ox-HPC) with \ensuremath{\omega}-aminoalkanoic acids. Reductive amination products could be readily obtained with DS(cation) (= DS(anion)) up to 1.6. Adduct hydrophilic/hydrophobic balance (amphiphilicity) can be influenced by selecting the appropriate chain length of the \ensuremath{\omega}-aminoalkanoic acid. This strategy is shown to produce a range of amphiphilic, water-soluble, moderately high glass transition temperature (T<sub>g</sub>) polysaccharide derivatives in just a couple of efficient steps from commercially available building blocks. The adducts were evaluated as crystallization inhibitors. They are strong inhibitors of crystallization even for the challenging, poorly soluble, fast-crystallizing prostate cancer drug enzalutamide, as supported by surface tension and Flory–Huggins interaction parameter results. \textcopyright{} 2023 Elsevier Ltd},
  author_keywords = {Amphiphilicity; Cellulose; Zwitterionic polymers; \ensuremath{\omega}-Aminoalkanoic acids},
  keywords      = {Amines; Biodegradability; Degree Of Substitution; Diseases; Hydroxypropyl Cellulose; Water; Wettability; Amines; Biodegradability; Biodegradable polymers; Diseases; Drug delivery; Glass transition; Hydrophilicity; Amphiphilicity; Cationics; Degree of substitution; Hydroxypropyl cellulose; Polysaccharide derivatives; Reductive amination; Zwitterionic polymers; Zwitterionic polysaccharides; Zwitterionics; \ensuremath{\Omega}-aminoalkanoic acid; Cellulose},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@conference{Zhou2025256,
  title         = {Deep Learning Approaches for Enhanced Predictive Modeling of Carbon Prices},
  author        = {Zhou, Qi},
  year          = 2025,
  journal       = {Proceedings of 2025 3rd International Conference on Communication Networks and Machine Learning, CNML 2025},
  pages         = {256--262},
  doi           = {10.1145/3728199.3728241},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105008007335&doi=10.1145%2F3728199.3728241&partnerID=40&md5=b28fe88ef3856104ebf723afe9d3470c},
  note          = {Cited by: 1; All Open Access; Gold Open Access},
  abstract      = {The increasing greenhouse effect has led international organizations and governments to place greater emphasis on environmental protection, particularly carbon emissions. In response to policies such as Peak Carbon and Carbon Neutral, there are strict regulations on carbon emissions from factories. This makes it imperative to accurately predict carbon emissions and carbon price fluctuations. Machine Learning (ML) and Deep Learning (DL), some of the fastest growing Artificial Intelligence techniques, are seen as the key to accurate price prediction through supercomputing. In this paper, we present a new method that combines feature extraction and non-linear modelling to predict carbon prices through a combination of deep learning and machine learning techniques. The method combines K Nearest Neighbours, Completely Integrated Empirical Pattern Decomposition with Adaptive Noise, Sample Entropy, Long Short-Term Memory, Stochastic Gradient Descent, and Random Forest. \textcopyright{} 2025 Copyright held by the owner/author(s).},
