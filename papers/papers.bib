}
@conference{Hawkes2019,
  title         = {Unravelling engine combustion using large-scale computations},
  author        = {Hawkes, Evatt R. and Krisman, Alex and Chen, Jacqueline H.},
  year          = 2019,
  journal       = {12th Asia-Pacific Conference on Combustion, ASPACC 2019},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85083952876&partnerID=40&md5=04702dea612b12aa820f0e835701e280},
  note          = {Cited by: 0},
  abstract      = {Global imperatives to reduce emissions of greenhouse gases, to improve urban air quality, and to adapt to new fuel sources are driving continuing developments in reciprocating engines, to improve fuel economy, emissions, and fuel flexibility. In the medium- to heavy-duty engine sector, these efforts are mostly focussed on compression-ignition (CI) engines, the performance of which is underpinned by remarkably complex, interacting phenomena of sprays, turbulence, mixing, combustion chemistry, and heat transfer. In this paper, I will briefly review efforts in our group and our collaborators over the last few years to unravel aspects of this complexity using large-scale computations, principally direct numerical simulations (DNS). With continuing progress in supercomputing capability, it is now possible to carry out DNS in engine-relevant thermochemical conditions. I will discuss a series of DNS studies that investigated the processes of autoignition and combustion. These studies reveal the significant complexity of these processes, involving important effects of both low- and high-temperature chemical pathways, and involving interactions of several combustion modes including cool flames, ignition kernels, partially premixed edge-flames, lean- and rich- premixed flames, and a diffusion flame. \textcopyright{} Asia-Pacific Conference on Combustion, ASPACC 2019.All right reserved.},
  keywords      = {Air quality; Engines; Fuel economy; Fuels; Greenhouse gases; Heat transfer performance; Combustion chemistry; Compression-ignition engines; Heavy duty engines; Large scale computation; Partially-premixed; Reciprocating engines; Rich premixed flames; Urban air quality; Ignition},
  type          = {Conference paper},
  publication_stage = {Final},
  source        = {Scopus}
}
