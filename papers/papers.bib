}
@article{Zhang2023_4,
  title         = {Green Synthesis of Hierarchically Porous Carbon Derived from Coal Tar Pitch for Enhanced Lithium Storage},
  author        = {Zhang, Mengdi and Qu, Meng and Yuan, Wenhan and Mu, Jiawei and He, Zhengqiu and Wu, Mingbo},
  year          = 2023,
  journal       = {Batteries},
  volume        = 9,
  number        = 9,
  doi           = {10.3390/batteries9090473},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85172200412&doi=10.3390%2Fbatteries9090473&partnerID=40&md5=e241f96a6742a472f43f90de8317c94e},
  note          = {Cited by: 7; All Open Access; Gold Open Access; Green Open Access},
  abstract      = {Coal tar pitch (CTP) is a high-quality raw material for producing functional carbon materials owing to its high carbon yield and high degree of condensation. The rational structure regulation of CTP-derived carbon materials is paramount for their special application. Herein, a green template strategy is proposed to fabricate hierarchically porous carbon (HPC) and employ it as the anode material for lithium-ion batteries. It can be demonstrated that the mass ratio of the template (KHCO<sub>3</sub>) and carbon source (CTP) significantly influences the microstructure and electrochemical performances of HPC. HPC-3 synthesized by a mass ratio of 3:1 shows a coral-like lamellar nanostructure with high specific surface area, developed nanopores, and ample defects, enabling fast and high-flux lithium storage. Thus, the HPC-3 electrode achieves an excellent rate capacity of 219 mAh g<sup>-1</sup> at 10 A g<sup>-1</sup> and maintains a high discharge capacity of 660 mAh g<sup>-1</sup> after 1400 cycles at 1 A g<sup>-1</sup>. This work takes a step towards the high-value-added and green utilization of CTP and offers a promising solution for the sustainable production of advanced carbon electrode materials. \textcopyright{} 2023 by the authors.},
  author_keywords = {anode materials; carbon materials; coal tar pitch; green template method; lithium-ion batteries},
  keywords      = {Anodes; Carbon; Coal; Coal storage; Coal tar; Electric discharges; Electrochemical electrodes; Porous materials; Potassium compounds; Anode material; Carbon material; Coal tar pitch; Green synthesis; Green template method; Hierarchically porous carbons; High quality; Lithium storages; Mass ratio; Template methods; Lithium-ion batteries},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Zhang2024,
  title         = {Unraveling the promotive mechanism of nitrogen-doped porous carbon from wasted lignin for Cr (VI) removal},
  author        = {Zhang, Huirong and Shen, Yi and Shi, Xiaokai and Cui, Jinlei and Wang, Baofeng and Guo, Yanxia and Zhang, Dongke and Cheng, Fangqin},
  year          = 2024,
  journal       = {Science of the Total Environment},
  volume        = 956,
  doi           = {10.1016/j.scitotenv.2024.177426},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85208289626&doi=10.1016%2Fj.scitotenv.2024.177426&partnerID=40&md5=16eacf5b12f4c2c68ed7687fc5cd977d},
  note          = {Cited by: 8},
  abstract      = {Persistent environmental pollution by heavy metals, particularly Cr (VI), poses significant risks to ecosystems and human health due to its high toxicity and bioaccumulation potential. The development of high-performance, cost-effective adsorbents from sustainable materials remains a critical challenge in the field of Cr (VI) remediation. This study investigates the influence of pyrrolic-N (N-5) within nitrogen-doped hierarchical porous carbon (N-HPC) on its adsorption capacity. Results indicate that N-HPC variants with a higher N-5 content exhibit superior adsorption abilities. The optimal sample demonstrated an exceptional adsorption capacity of 386.2 mg/g for Cr (VI). Even after seven regeneration cycles, this N-HPC variant maintained a remarkable 77.8 \% removal efficiency for Cr (VI), highlighting its robust stability and selectivity. The relationship between the physicochemical properties of N-5 and N-HPC was thoroughly examined, revealing that N-5 plays a crucial role in the adsorption process. Due to its high electronegativity, nitrogen-doping into the carbon framework generates a dipole moment, enhancing the electronegativity of N-HPC, altering its local electron density and polarity, increasing specific surface area, carbon defect density, and ion exchange capacity. These factors collectively contribute to significant improvements in pore filling, ion exchange efficiency, and electrostatic adsorption by N-HPC. The reduction complexation mechanism emerges as the dominant factor in the adsorption process. N-5 not only provides reducing electrons as an electron donor, facilitating the continuous conversion of Cr (VI) to Cr (III), but also acts as an adsorption active site, complexing Cr to the surface of N-HPC. This synergistic effect strengthens the reduction complexation, enhances adsorption performance, and improves the regeneration cycle and adsorption selectivity for Cr. \textcopyright{} 2024 Elsevier B.V.},
  author_keywords = {Cr (VI) removal; N-doped porous carbon (N-HPC); Pyrrolic-N (N-5); Sodium lignosulfonate (SL)},
  keywords      = {Adsorption; Capacity; Carbon; Efficiency; Heavy Metals; Nitrogen; Processes; Reduction; Defect density; Gas adsorption; Heavy metals; Remediation; Semiconductor doping; chromium; heavy metal; lignin; nitrogen; adsorbent; carbon; heavy metal; sodium; Cr (VI) removal; Hierarchical porous carbons; N-doped; N-doped porous carbon (nitrogen-doped hierarchical porous carbon); Nitrogen-doped; Porous carbons; Pyrrolic; Pyrrolic-N (N-5); Sodium lignosulfonates; Sodium lignosulphonate; bioaccumulation; chromium; ion exchange; lignin; physicochemical property; porous medium; adsorption; Article; bioaccumulation; chemical reaction; chemical structure; crystal structure; electrostatic adsorption; Fourier transform infrared spectroscopy; human; pollution; pore size distribution; porosity; Raman spectrometry; scanning electron microscopy; synergistic effect; toxicity; ultraviolet spectroscopy; wastewater; water flow; X ray diffraction; X ray photoemission spectroscopy; zeta potential; article; bioaccumulation; complex formation; controlled study; dipole; electron; ion exchange; pharmaceutics; physical chemistry; surface area; Electronegativity},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Zhang2024_2,
  title         = {Construction of mechanically robust and recyclable catalytic hydrogel based on hydroxypropyl cellulose-supported by montmorillonite/ionic liquid with different anions for pollutants(4-NP, MB, CR, Rhb) degradation},
  author        = {Zhang, Xikun and Zhang, He and Lv, Xue and Xie, Ting and Chen, Junzheng and Fang, Di and Yi, Shurui},
  year          = 2024,
  journal       = {International Journal of Biological Macromolecules},
  volume        = 273,
  doi           = {10.1016/j.ijbiomac.2024.132788},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85197070673&doi=10.1016%2Fj.ijbiomac.2024.132788&partnerID=40&md5=101676582a92cbc4b33e013048bfceb8},
  note          = {Cited by: 13},
  abstract      = {Dye wastewater poses a serious threat to the environment and human health, necessitating sustainable degradation methods. In this study, Na-based Montmorillonite (MMT) was exfoliated using different ionic liquids ([C16MIM][Cl], [C16MIM][BF<sub>4</sub>], [C16MIM][PF<sub>6</sub>]), and silver nanoparticles (Ag NPs) were green-synthesized using hydroxypropyl cellulose (HPC). The HPC significantly enhanced the dispersion of MMT in the hydrogel. By introducing lauryl methacrylate (LMA), a hydrophobic associative network was constructed in PAM/LMA/HPC/MMT\@ILs\&Ag NPs hydrogel. This hydrogel demonstrated outstanding mechanical properties, with a stress of 833.21 kPa, strain of 3300 \%, and toughness of 14.36 MJ/m<sup>3</sup>. It also exhibited excellent catalytic activity, with a rate constant of 0.83 min<sup>-1</sup> for 4-nitrophenol degradation at 28 \textdegree{}C. The effects of temperature and catalyst concentration on the catalytic reaction were systematically investigated. This study presents a simple green synthesis approach for Ag NPs using HPC, achieving superior mechanical performance and stable MMT dispersion in aqueous solutions. \textcopyright{} 2024},
  author_keywords = {4-Nitrophenol; Hydrogel,Catalyst; Hydroxypropyl cellulose (HPC); Montmorillonite},
  keywords      = {Catalysts; Chromium Compounds; Clay; Degradation; Hydroxypropyl Cellulose; Montmorillonite; Rhodium Compounds; Stresses; Anions; Bentonite; Catalysis; Cellulose; Green Chemistry Technology; Hydrogels; Ionic Liquids; Metal Nanoparticles; Nitrophenols; Silver; Water Pollutants, Chemical; Water Purification; Catalysis; Catalyst activity; Chromium compounds; Clay minerals; Health risks; Ionic liquids; Rate constants; Rhodium compounds; Silver nanoparticles; Synthesis (chemical); 4 nitrophenol; acrylamide; anion; hydrogel; hydroxypropylcellulose; ionic liquid; methacrylic acid; methylene blue; montmorillonite; rhodamine B; silver nanoparticle; 4-nitrophenol; bentonite; cellulose; hydroxypropylcellulose; metal nanoparticle; nitrophenol; silver; 4-Nitrophenol; Dyes wastewaters; Human health; Hydrogel,catalyst; Hydroxypropyl cellulose; Lauryl methacrylate; Mechanically robust; Recyclables; ]+ catalyst; aqueous solution; Article; catalysis; catalyst; crystal structure; degradation; dispersion; environment; Escherichia coli; fatigue; histogram; hysteresis; morphology; oxidation; pollutant; polymerization; scanning electron microscopy; synthesis; temperature; transmission electron microscopy; ultraviolet spectroscopy; wastewater; X ray diffraction; catalysis; chemistry; green chemistry; procedures; water management; water pollutant; Hydrogels},
