@conference{Saxena2012,
  title         = {"Green planet architecture" - A methodology for self-sustainable distributed renewable energy ecosystems},
  author        = {Saxena, Nikita T. and Thomas, Anna E. and Johnson, Shawana and Venners, John P. and Hendricks, Robert C.},
  year          = 2012,
  journal       = {ISROMAC 2012 - 14th International Symposium on Transport Phenomena and Dynamics of Rotating Machinery},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84905715556&partnerID=40&md5=db3e0f516231d90bc56b0a973b3184c5},
  note          = {Cited by: 0},
  abstract      = {Our planet has been endowed with a host of natural mechanisms to keep the environment and climate in balance. Humans are now facing the need to restore this balance that has been upset in the past years because of a growing population and resource demands. To steer dependency away from freshwater crops and decrease environmental damage from humanity's fuel and energy demands, it is necessary to take advantage of the natural adaptive biomass resources that are already in place. Using methods of "Green Planet Architecture," based on compilations of current research and procedures, could lead to new forms of energy and fueling as well as new sources for food and feed. Green Planet Architecture involves climatic adaptive biomass; geospatial intelligence; agri- and aqua-culture life cycles; and soil, wetland, and shoreline restoration. Plants such as Salicornia, seashore mallow, castor, mangroves, and perhaps Moringa can be modified (natural, model-assisted, or genetically modified) to thrive in salt-water and brackish water or otherwise not arable conditions, making them potentially new crops that will not displace traditional farming. These fueling sources also have potential to be used in other rapid-growth industries, such as the aviation industry, that have incentive to move towards more sustainable fuel supplies. This paper highlights an example of how synergistic development of biomass resources and geospatial intelligence high-performance computing capabilities can be focused to resolve potential drought-famine problems. These techniques, provide a basis for future e-science-based discovery (and access) through technology that can be expanded to support global societal applications.},
  keywords      = {Architecture; Biomass; Chemical contamination; Crops; Food supply; Fueling; Genetically modified plants; Life cycle; Restoration; Rotating machinery; Transport properties; Aviation industry; Biomass resources; Environmental damage; Genetically modified; Geospatial intelligence; High-performance computing; Renewable energies; Sustainable fuels; Ecology},
  type          = {Conference paper},
  publication_stage = {Final},
  source        = {Scopus}
}
