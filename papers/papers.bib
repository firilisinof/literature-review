@book{Lakshmanjani2025152,
  title         = {AI and Sustainable Finance: A New Perspective on Data Collection},
  author        = {Lakshmanjani, Pillada Naga},
  year          = 2025,
  journal       = {Using AI to Develop Sustainability Strategies for a Changing Global Economy},
  pages         = {152--167},
  doi           = {10.1201/9781003640776-9},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105021724213&doi=10.1201%2F9781003640776-9&partnerID=40&md5=726a9333d5e09caf86d1ec7addf02dd0},
  note          = {Cited by: 0},
  abstract      = {Finance plays an important role in subverting risk and maximizing profitability. It impacts society through the decisions it makes and also inadvertently affects the environment. It is also clear that there is an interaction between the economy, society, and the environment. But there is a staggering gap between the sustainable goals and the action to be taken. Sustainable finance (SF) is the solution for this as it helps in financing sustainable projects, but it also comes with its limitations. Sustainable practices or financing requires data regarding disclosures, environmental impact, and risk data. The need for data, especially in the field of SF, is very important. Accuracy helps in policy development and strategy implementation. Thus, the need persists to develop a Data-Centric model, where the data is collected from geo-spatial open sources like the Global Forest Watch (GFW), NASA Earthdata Developer Portal, and NASA Worldview. NASA's Global Imagery Browse Services (GIBS) and Bloomberg for financial data. The satellite data collected from different databases is then processed and cleaned from labeling errors using confident learning methods. For image analysis purposes, ResNet-50 is used, which allows multi-layer data analysis based on scores assigned to each feature. For textual data, the Bidirectional Encoder Representations from Transformer (Fin-BERT) model is trained and used. The use of High-Performance Computing (HPC) techniques and Artificial Intelligence (AI) methods for data collection and analysis is the need of the hour. This chapter focuses on the use of AI techniques to directly access environmental data and then connect with appropriate geographic locations and firms. The models chosen would analyze the data and give out accurate results. These results will help in developing strategies for SF. \textcopyright{} 2026 selection and editorial matter, Senthil Kumar A. V., Ankita Chaturvedi, Atul Bansal, and Rohaya Latip; individual chapters, the contributors.},
