  keywords      = {Carbon; Carbon Economy; Carbon emissions; Costs; Environmental protection; Forecasting; Gradient methods; Greenhouse effect; Learning systems; Nearest neighbor search; Prediction models; Random forests; Stochastic systems; Zero-carbon; Carbon emissions; Carbon neutrals; Carbon price; Deep learning; Enhance model; Green finance; International organizations; Learning approach; Machine-learning; Predictive models; Deep learning},
  type          = {Conference paper},
