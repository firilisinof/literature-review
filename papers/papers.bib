@conference{Hosseinverdi2025,
  title         = {Rapidus: Performance-Portable Parallel Flow Solver for Aerospace Applications},
  author        = {Hosseinverdi, Shirzad and Sitaraman, Jay and Jude, Dylan and Premaratne, Pavithra and Erlandson, Lucas and Appelhans, David},
  year          = 2025,
  journal       = {AIAA Science and Technology Forum and Exposition, AIAA SciTech Forum 2025},
  doi           = {10.2514/6.2025-1484},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105001329025&doi=10.2514%2F6.2025-1484&partnerID=40&md5=075bff5929bd6dc306b67f2809998f87},
  note          = {Cited by: 1},
  abstract      = {The high-performance computing landscape has shifted towards heterogeneous systems that combine Central Processing Units (CPUs) and Graphical Processing Units (GPUs). To harness this increasing processing power, performance portability is crucial for simulation software. This ensures that production codes can efficiently utilize available resources, regardless of the underlying architecture. Developing portable simulation software is challenging due to its inherent complexity. Maintaining a single, portable codebase across diverse architectures and future generations of platforms is essential. This paper details the development and validation of Rapidus, a standalone, parallel, and performance-portable unstructured compressible flow solver. Furthermore, Rapidus is extended to be employed as a near-body solver in a dual mesh/multi-solver overset paradigm, within the context of the Helios software. The accuracy and performance of Rapidus for both single-mesh and dual-mesh overset frameworks are evaluated for fixed-wing and rotary-wing applications. A modified multicolor Gauss-Seidel linear solver with a low memory footprint is proposed to improve the performance of the solver on GPUexecution. \textcopyright{} 2025, American Institute of Aeronautics and Astronautics Inc, AIAA. All rights reserved.},
  keywords      = {Case hardening; Compressible flow; Computer software portability; Graphics processing unit; Parallel architectures; Parallel flow; Strain hardening; Dual meshes; Flow solver; Graphical processing units; Heterogeneous systems; Performance; Performance computing; Power performance; Processing power; Processing units; Simulation software; Mesh generation},
  type          = {Conference paper},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Host2008976,
  title         = {Forest patch modeling: Using high performance computing to simulate aboveground interactions among individual trees},
  author        = {Host, George E. and Stech, Harlan W. and Lenz, Kathryn E. and Roskoski, Kyle and Mather, Richard},
  year          = 2008,
  journal       = {Functional Plant Biology},
  volume        = 35,
  number        = 10,
  pages         = {976--987},
  doi           = {10.1071/fp08075},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-55949120773&doi=10.1071%2FFP08075&partnerID=40&md5=7f15e711ef4d9ffcb6abe6db09e14967},
  note          = {Cited by: 16},
  abstract      = {Functional-structural plant models (FSPMs) typically integrate suites of detailed physiological and phenological processes to simulate the growth of individual plants. Recent advances in high-performance computing have allowed FSPMs to be extended to patches of interacting trees. Here, we describe a parallel modelling strategy to run simultaneous individual tree models across an 8 x 8 patch of trees. The 64 'core' trees are surrounded by multiple rings of neighbour trees to remove edge effects. A sensitivity analysis of the patch model demonstrates that computational factors such as the number of independently simulated trees (9 v. 36) or number of neighbour rings (3 v. 6) did not significantly influence model estimates of tree volume growth. Updated submodels for phenology and redistribution of overwinter carbohydrate storage allow the simulation to be more responsive to above ground competition among trees in a patch over multiple growing seasons. An 8-year patch-scale simulation of aspen clones 216 and 259 was conducted using high-resolution environmental data from the Aspen FACE Experiment, a long-term free-air carbon dioxide enrichment (FACE) study. Tree heights and volumes were comparable to 8-year growth measurements made at the Aspen FACE site. \textcopyright{} CSIRO 2008.},
  author_keywords = {Canopy light interception; Computer simulation; FACE; Parallel processing; Patch-scale modeling; Phenology; Physiological process model; Populus},
  keywords      = {Carbohydrates; Carbon Dioxide; Data Storage; Forest Canopy; Forestry; Organic Compounds; Physiology; Populus; Sensitivity; Simulation; Synthesis; Populus; Carbohydrates; Carbon dioxide; Computational methods; Data storage equipment; Fischer-Tropsch synthesis; Forestry; Organic compounds; Sensitivity analysis; ecological modeling; edge effect; growing season; interspecific interaction; light availability; patch dynamics; phenology; physiology; Canopy light interception; FACE; Parallel processing; Patch-scale modeling; Phenology; Physiological process model; Populus; Physiological models},
