  author        = {Xiao, Yang and Wang, Yucheng and Fan, Xuran and Yang, Yuzhu and Wang, Runqing and Liu, Jie and Dai, Zhongde and Zheng, Junfeng and Yao, Lu and Jiang, Wenju and Yang, Lin},
  year          = 2026,
  journal       = {Fuel},
  volume        = 423,
  doi           = {10.1016/j.fuel.2026.139343},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105034074993&doi=10.1016%2Fj.fuel.2026.139343&partnerID=40&md5=8ba54d41667f6fff4f31b6d027f627c7},
  note          = {Cited by: 0},
  abstract      = {This study developed an engineered porous hydrochar (HPC-Z/W) through cascade utilization of ZnCl<sub>2</sub> for biomass catalytic hydrothermal carbonization followed by in-situ ZIF-8 functionalization. Optimal preparation conditions were hydrothermal treatment at 180 \textdegree{}C for 12 h with a ZnCl<sub>2</sub>/biomass mass ratio of 3/1, followed by ZIF-8 synthesis at a MBC/Hmim mass ratio of 2/1. Catalytic hydrothermal carbonization enhanced surface aromaticity, while ZIF-8 functionalization created advanced hierarchical pore structures (S<sub>BET</sub> = 765 m<sup>2</sup>/g, V<sub>mic</sub> = 0.302 cm<sup>3</sup>/g, V<sub>mes</sub> = 0.149 cm<sup>3</sup>/g) and introduced abundant nitrogen-containing functional groups. The optimized HPC-Z/W(2/1) exhibited excellent toluene adsorption capacity (271 mg/g) following a physical adsorption mechanism. The material demonstrated effective removal of ethyl acetate (232 mg/g) and acetone (163 mg/g), with remarkable toluene selectivity (up to 16.45) in multicomponent adsorption. Additionally, HPC-Z/W(2/1) showed good humidity resistance and regeneration performance. This work provides a sustainable strategy for preparing functionalized hydrochar with excellent potential for selective separation of aromatic VOCs. \textcopyright{} 2026 Elsevier Ltd.},
  author_keywords = {Adsorption removal; Cascade Use ofZnCl<sub>2</sub>; Catalytic Hydrothermal Carbonization; Hydrochar; Toluene; ZIF-8 Functionalization},
  keywords      = {Acetone; Adsorption; Carbonization; Chlorine compounds; Hydrothermal synthesis; Pore structure; Zinc chloride; Adsorption removal; Cascade use ofzncl2; Catalytic hydrothermal carbonization; Functionalizations; Hydrochar; Hydrothermal carbonization; Mass ratio; Toluene adsorption; ZIF-8 functionalization; ZnCl 2; Toluene},
  type          = {Article},
