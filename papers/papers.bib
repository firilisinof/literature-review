@article{Jagan2025433,
  title         = {Investigation of Metakaolin Utilization as a Supplement to Cement in Sustainable High-performance Concrete Production},
  author        = {Jagan, S. and Kiruthiga, N. and Ramya, R. and Shri Hariharan, S.N. and Jagadeesh, S.},
  year          = 2025,
  journal       = {Journal of Environmental Nanotechnology},
