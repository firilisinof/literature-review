  volume        = 9,
  number        = 4,
  pages         = {40--48},
  doi           = {10.1109/mcse.2007.71},
  issn          = {1558-366x},
  abstract      = {Recent advances in miniaturization, computing power, remote sensing, and modeling are revolutionizing the science of natural resource management. But these advances also bring many challenges. This article highlights some key problems in resource management that represent opportunities for computer scientists and engineers in search of challenging practical problems.},
  keywords      = {Resource management;Biology computing;Power engineering computing;Biological system modeling;Distributed computing;Grid computing;Floods;Computer networks;Peer to peer computing;Optimal control;natural resource management;geographic information systems;GIS;spatial control;grid computing;ecological modeling}
