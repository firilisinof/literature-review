@article{11048712,
  title         = {A Fast Floating-Point Multiply–Accumulator Optimized for Sparse Linear Algebra on FPGAs},
  author        = {Li, Kun and Hao, Xiangyu and Ma, Zhenguo and Yu, Feng and Zhang, Bo and Xing, Qianjian},
  year          = 2025,
  month         = {Sep.},
  journal       = {IEEE Transactions on Very Large Scale Integration (VLSI) Systems},
  volume        = 33,
  number        = 9,
  pages         = {2592--2596},
  doi           = {10.1109/tvlsi.2025.3578619},
  issn          = {1557-9999},
  abstract      = {This brief presents a pipelined floating-point Multiply–Accumulator (FPMAC) architecture designed to accelerate sparse linear algebra operations. By designing a lookup-table-based 5–3 carry-save adder (CSA) and combining it with a 3–2 CSA, the proposed design minimizes the critical path and boosts operational speed. Moreover, the proposed architecture takes advantage of data characteristics in sparse linear algebra to displace the shift unit in the critical accumulation loop, further increasing the throughput rate. In addition, the integration of a lookup-table-based leading-zero anticipator (LZA) enhances normalization efficiency. Experimental results show that, compared with reported FPMAC designs, the proposed architecture may achieve a significantly higher maximum clock frequency for single-precision floating-point operations.},
  keywords      = {Computer architecture;Field programmable gate arrays;Adders;Feedback loop;Table lookup;Delays;Linear algebra;Encoding;Very large scale integration;Resource management;Floating-point multiply-accumulator (FPMAC);pipeline architecture;single-cycle accumulation;sparse linear algebra}
}
@inproceedings{11049379,
  title         = {Trustworthy Matchmaking for Intelligent Computing Services},
  author        = {Mu, Xiaojun and Song, Yulun and Li, Kunyan and Jia, Xiongwei and Zhang, Rongfang and Xie, Yunlong and Jia, Xiaoyun and Sun, Lin},
  year          = 2024,
  month         = {Dec},
  booktitle     = {2024 International Conference on Ubiquitous Computing and Communications (IUCC)},
  pages         = {548--553},
  doi           = {10.1109/iucc65928.2024.00100},
  abstract      = {This paper proposes a trustworthy matchmaking mechanism for intelligent computing services. By decoupling the supply and demand of intelligent computing services, it achieves dynamic tracking of service status, efficient, secure, and resilient data delivery, as well as fair and trustworthy transaction matching for intelligent computing services. The trustworthy matchmaking for intelligent computing services integrates the trusted traceability and decentralization characteristics of blockchain, the intelligent analysis and automation capabilities of artificial intelligence, the elasticity and resource management advantages of edge and cloud computing, as well as the access control and data encryption functions provided by secure infrastructure. This mechanism ensures the efficiency and quality of matching transactions for intelligent computing services, facilitating sustainable development for both supply and demand sides.},
  keywords      = {Supply and demand;Elasticity;Ubiquitous computing;Solids;Dynamic scheduling;Real-time systems;Sensors;Encryption;Resource management;Sustainable development;Trustworthy;Intelligent Computing services;Matchmaking}
}
@inproceedings{11051796,
  title         = {Soft Switching Boost Converter with Passive Lossless Snubber},
  author        = {Yau, Yeu-Torng and Hong, Po-Hong and Wang, Chao Wei},
  year          = 2025,
  month         = {May},
  booktitle     = {2025 Asia-Pacific International Symposium and Exhibition on Electromagnetic Compatibility (APEMC)},
  pages         = {217--220},
  doi           = {10.1109/apemc62958.2025.11051796},
  issn          = {2640-7469},
  abstract      = {Data centres and high-performance computing systems rely on numerous network switches for data management and often integrate renewable energy sources (such as solar power) with storage batteries to ensure a stable power supply. In this paper, we introduce a novel regenerative snubber for boost converters with the aim of reducing the component count and footprint compared to conventional designs. Traditional boost converters suffer from high switching losses due to hard switching techniques. Although soft-switching methods can reduce these losses, they often involve costly and bulky components. In the proposed design, a minimal additional inductor is employed to achieve both turn-on and turn-off soft switching, enhancing efficiency without increasing size or complexity. The paper includes a detailed description of the circuit's operation and timing, prototype test results, and a comparative analysis to demonstrate the advantages of this new approach over existing solutions in the literature.},
  keywords      = {Renewable energy sources;Power supplies;Snubbers;Soft switching;Prototypes;Switching loss;Switches;Pulse width modulation;Timing;Standards;Boost Converter;Soft Switching;Lossless Snubber}
}
@inproceedings{11053120,
  title         = {An Integrated Approach to AI-Enhanced Security Information and Event Management},
  author        = {K, Mugeshwaran and Maharajan, K. and Nithish, Dumala and S, Dinesh and Uday, N.},
  year          = 2025,
  month         = {May},
  booktitle     = {2025 International Conference on Computational Robotics, Testing and Engineering Evaluation (ICCRTEE)},
  pages         = {1--6},
  doi           = {10.1109/iccrtee64519.2025.11053120},
  abstract      = {An SIEM system enabled by Artificial Intelligence (AI) was proposed to solve the major challenges of current security monitoring practices. The proposed architecture incorporates the use of artificial intelligence at all levels of the security operation center to transform traditional security operations from passive detection to active protection. The system design incorporates the application of machine learning for pattern recognition, contextual analysis, and alert prioritization to overcome the major challenges of traditional SIEM solutions that are based on rules and produce numerous alerts. The detection efficiencies for complicated attack patterns, including APT and zero-day attacks, were found to be significantly higher than those of the conventional systems in the experimental analysis. Integration with high-performance computing provides real-time security data analysis without compromising the performance, whereas the mean time to detection and response is significantly reduced. The effectiveness of the system in detecting threats early, classifying them correctly, and recommending response actions in multiple case studies involving various attacks was demonstrated. The architecture is a major improvement over current security monitoring technologies, and it provides more effective protection against ever-increasing threats with less analyst workload through contextualized and automated alerts.},
  keywords      = {Technological innovation;Security information and event management;Computer architecture;Transforms;Real-time systems;Threat assessment;Security;Protection;Monitoring;Testing;Security information and event management (SIEM);AI-powered SIEM;deep learning security analytics;real-time threat detection;AI-driven security event processing;adaptive threat defense;machine learning for cybersecurity;automated incident response;Innovation \& Infrastructure;Resilient Digital Infrastructure;Secure \& Sustainable Societies}
}
@inproceedings{11053914,
  title         = {Research on Performance Optimization of Cloud Rendering Technology in Simulation of Pumped Storage Power Station Construction},
  author        = {Kong, Jihong and Xiang, Zhenglin and Liu, Quan and Zhu, Kaixuan and Qiu, Guonian and Meng, Jun},
  year          = 2025,
  month         = {March},
  booktitle     = {2025 International Conference on Power Electronics and Electric Drives (PEED)},
  pages         = {184--193},
  doi           = {10.1109/peed63748.2025.00040},
  abstract      = {This study presents a cloud-native simulation framework integrating physics-informed particle swarm optimization (PSO) with GPU-accelerated cloud rendering for pumped storage power station (PSPS) operations. The framework addresses three critical challenges in dynamic hydraulic optimization under renewable energy volatility: 1) A hybrid master-worker cloud architecture achieves $4.8 \times$ computational acceleration through adaptive GPU resource allocation, reducing 24-hour simulation time by 58\% compared to conventional high-performance computing clusters; 2) A flow-priority PSO algorithm enhances power output by 23\% through asymmetric reservoir optimization and hydraulic inertia modeling; 3) Predictive swarm damping mechanisms maintain grid response stability within $\pm 3 \%$ error margins under $\pm 12 \%$ stochastic load fluctuations. Experimental results demonstrate logarithmic energy storage growth ($8 \times 10^{\wedge} 6 ~\text{Wh}$ at 24 -hour operation) with sub-hourly climate adaptation capabilities, establishing PSPS as dynamic grid stabilizers that reconcile thermodynamic constraints with renewable intermittency.},
  keywords      = {Cloud computing;Renewable energy sources;Hydraulic systems;Transforms;Rendering (computer graphics);Reservoirs;Real-time systems;Particle swarm optimization;Optimization;Power generation;cloud rendering;particle swarm optimization;pumped storage power station;hydraulic inertia;grid stabilization}
}
@inproceedings{11059071,
  title         = {Beyond Traditional Computing - Harnessing the Power of DNA Computing for Massive-Scale Data Processing},
  author        = {Dineshkumar, R. and Parthipan, V. and Vennila, G. and Padmasree, K. B. and Ramesh, P. S.},
  year          = 2024,
  month         = {Nov},
  booktitle     = {2024 International Conference on Advances in Computing, Communication and Materials (ICACCM)},
  pages         = {1--6},
  doi           = {10.1109/icaccm61117.2024.11059071},
  issn          = {2642-7354},
  abstract      = {Still, DNA computing which is a relatively new paradigm of data processing represents an amazing potential for seeing the ability to solve computational issues on a vast level. This paper seeks to discuss how DNA molecules can be used to compute, given that the molecules can process problems in parallelism, store data, and use minimal energy. The proposed methodology represents abstract computational problems in form of DNA sequences so that biochemical operations can be performed in parallel on large scale. Results have shown that this approach to parallelism has separated tremendous computational time improvements, as much as 97\%, and energy decrease of up to 99\%. 99\%, as compared to the conventional computing systems. The feasibility and practical applications of DNA computing have been demonstrated by this method's capacity to solve NP-complete and combinatorial problems such as TSP, Boolean satisfiability, and protein folding and the applicability of this method in cryptography and possibly in big data applications. The higher error rates are a problem that cannot be erased entirely and are attributed to biochemical limitations. Added to this, error correction mechanisms are also incorporated into the methodology to improve accuracy but there is a required development for critical improvement for its broad application. This study shows the applicability and enormous benefits of using DNA computing to perform computations on a large scale making it more feasible to support silicon-based systems that are viable in the future computing for hard problem solving.},
  keywords      = {Proteins;Error analysis;Scalability;Parallel processing;Traveling salesman problems;Data processing;Supercomputers;Error correction;Problem-solving;DNA computing;DNA computing;massive-scale data processing;parallel operations;energy efficiency;combinatorial optimization;NP-complete problems;biochemical operations;error correction;scalability;sustainable computing}
}
