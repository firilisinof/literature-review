}
@article{Howard2004241,
  title         = {Evaluation of microbiological and physicochemical indicators for wastewater treatment},
  author        = {Howard, I. and Espigares, E. and Lardelli, P. and Mart\'{\i}n, J.L. and Espigares, M.},
  year          = 2004,
  journal       = {Environmental Toxicology},
  volume        = 19,
  number        = 3,
  pages         = {241--249},
  doi           = {10.1002/tox.20016},
