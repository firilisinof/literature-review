  author        = {Yang, Kou and Wang, Qinyue and Nikolaev, Konstantin G. and Wang, Qian and Moskalenko, Ivan V. and Zhang, Shanqing and Qiu, Xueqing and Timashev, Eduard O. and Skorb, Ekaterina V. and Novoselov, Kostya S. and Andreeva, Daria V.},
  year          = 2025,
  journal       = {ACS Nano},
  volume        = 19,
  number        = 40,
  pages         = {35483--35492},
  doi           = {10.1021/acsnano.5c08653},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105018669147&doi=10.1021%2Facsnano.5c08653&partnerID=40&md5=0d868327510d742cc056308fd8da9483},
  note          = {Cited by: 2},
  abstract      = {A nanoconfined thermoresponsive membrane composed of Ti<sub>3</sub>C<sub>2</sub>T<sub>x</sub>MXene and hydroxypropyl cellulose (HPC) was developed for selective Li<sup>+</sup>extraction. By integrating the electrothermal conductivity of MXenes and hydration-responsive gating of HPC, the membrane forms heterochannels with tunable spacing that regulate ion transport through nanoconfinement-enhanced mechanisms based on interaction energy and hydration radius. While density functional theory calculations predicted stronger sorption for Mg<sup>2+</sup>, experimental data revealed a clear preference for Li<sup>+</sup>uptake from both simulated brine and battery black mass. This selectivity is attributed to favorable interactions of Li<sup>+</sup>within the nanoconfined composite channels, where the subnanometer interlayer spacings promote partial dehydration and size-sieving effects. Li<sup>+</sup>retention is governed not only by thermodynamic affinity but also by kinetic acceleration in nanoconfined pathways and hydration-based steric control. The membrane exhibits a reversible thermal response and maintains stable performance under Joule heating. It achieves \&gt;90\% extraction efficiency from simulated Atacama brine and up to 98\% Li<sup>+</sup>recovery from black mass supplied by VGM Sustainability Solutions (SG3R, Pte. Ltd.). \textcopyright{} 2025 American Chemical Society},
  author_keywords = {brines and black mass; electro-thermo-chemical regulation; ion selectivity; lithium extraction; MXene/cellulose membranes; nanoconfinement},
  keywords      = {Cellulose; Dehydration; Extraction; Lithium Compounds; Membranes; Cellulose; Dehydration; Density functional theory; Extraction; Lithium; Lithium batteries; Lithium compounds; Membranes; Titanium compounds; cellulose; hydroxypropylcellulose; lithium; magnesium ion; Brine and black mass; Cellulose membranes; Chemical regulation; Electro-thermo-chemical regulation; Ion selectivity; Li +; Lithium extraction; Mxene/cellulose membrane; Nanoconfinements; Thermo-chemical; acceleration; article; calculation; conductance; controlled study; dehydration; density functional theory; heating; hydration; ion transport; kinetics; membrane; pharmaceutics; simulation; thermodynamics; Hydration},
  type          = {Article},
