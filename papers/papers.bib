  type          = {Conference paper},
  publication_stage = {Final},
  source        = {Scopus}
}
@conference{Ferreira2023,
  title         = {Preliminary Assessment of Environmental Impacts from the Demise of Reentering Satellites in the Upper Atmosphere},
  author        = {Ferreira, Jos\'{e} P. and Nomura, Ken-ichi and Wang, Joseph},
  year          = 2023,
  journal       = {Accelerating Space Commerce, Exploration, and New Discovery Conference, ASCEND 2023},
  volume        = {1 PartF},
  doi           = {10.2514/6.2023-4773},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85195633831&doi=10.2514%2F6.2023-4773&partnerID=40&md5=bd8b7b93c29ce8665aeb9b133bdeb7ae},
  note          = {Cited by: 2},
  abstract      = {Over the last decades, the number of orbiting satellites has grown unrestricted and unregulated. Ongoing plans to build mega-constellations of microsatellites will inevitably exacerbate the situation, adding to the ever-growing number of pieces of debris. Reentry rates are expected to continue growing as the number of orbiting bodies increases with more satellites and launch vehicles remaining in orbit. While it is widely understood that most objects will completely burn during reentry, the effect of spacecraft demise on Earth's atmosphere has only been lightly studied, and the long-term impact remains unknown. We resort to Reactive Molecular Dynamics simulations to resolve the oxidation process of the key structural material of aluminum for mesospheric reentry through large-scale supercomputer runs on the generation of aluminum oxides. In 2022, the total mass of reentering objects from Low-Earth Orbit amounted to 309 metric tons, resulting in an 18 \% increase compared with the previous year. This consists of a 29.5 \% increase in the yearly mass rate of aluminum injected from satellites at the top of the atmosphere compared to natural sources, yielding approximately 17 metric tons of aluminum oxides from spacecraft demise. Such byproducts are expected to cluster into nanoparticles and take an average of 3 decades to decay to the upper ozone layer. \textcopyright{} 2023, American Institute of Aeronautics and Astronautics Inc, AIAA. All rights reserved.},
  keywords      = {Alumina; Environmental impact; Molecular dynamics; Orbits; Ozone; Ozone layer; Satellites; Supercomputers; Dynamics simulation; In-orbit; Large-scale supercomputers; Long-term impacts; Microsatellites; Orbiting satellites; Oxidation process; Preliminary assessment; Reactive molecular dynamics; Total mass; Aluminum oxide},
  type          = {Conference paper},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Ferro2023,
  title         = {Towards a sustainable artificial intelligence: A case study of energy efficiency in decision tree algorithms},
  author        = {Ferro, Mariza and Silva, Gabrieli D. and de Paula, Felipe B. and Vieira, Vitor and Schulze, Bruno},
  year          = 2023,
  journal       = {Concurrency and Computation: Practice and Experience},
  volume        = 35,
  number        = 17,
  doi           = {10.1002/cpe.6815},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85122007458&doi=10.1002%2Fcpe.6815&partnerID=40&md5=f3357598d2f9c5d664de2b6c0a683b19},
  note          = {Cited by: 30},
  abstract      = {Artificial intelligence has been showing accelerated growth due to its use in solving problems in several application domains. This success results from the convergence of large amounts of data, high-performance computing, and precision of machine learning (ML) algorithms. Even with the relevance of ML algorithms, little is known about their computational requirements and power consumption, which has become an important task to achieve greener computing. This work aims to evaluate the energy efficiency of the ML algorithms to identify their energy hotspots. Also, to investigate which influences the energy consumption (EC) of these algorithms and how the parameters design could affect it. We conducted a series of experiments using 27 different datasets, 2 decision trees algorithms, and 2 ensembles for classification and regression tasks to answer these questions. Our results show interesting findings, such as, like some simple parameters choice can have a high impact on EC, as a consequence, finding greener strategies for AI. \textcopyright{} 2021 John Wiley \& Sons Ltd.},
  author_keywords = {artificial intelligence; CO; decision tree; energy efficiency; Green AI; machine learning},
  keywords      = {Classification (of information); Decision trees; Energy utilization; Green computing; Machine learning; Applications domains; Case-studies; Computational power; Computational requirements; Decision-tree algorithm; Energy; Energy-consumption; Large amounts of data; Machine learning algorithms; Performance computing; Energy efficiency},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@conference{Fiala20111045,
  title         = {Potentials for reduction of environmental impacts of construction using hpc},
  author        = {Fiala, Ctislav and Kyn\v{c}lov\'{a}, Magdal\'{e}na and H\'{a}jek, Petr},
  year          = 2011,
