@article{Casale2025,
  title         = {The HPC Infrastructure of the Gran Sasso National Laboratory (INFN) for resilience to natural and anthropogenic disasters},
  author        = {Casale, A. and Belardinelli, P. and Ciaglia, G. and Demin, B. and D'Angelo, G. and Di Michele, F. and Giuliani, P. and Giuliani, R. and Marchegiani, F. and Olmi, M. and Parlati, S. and Pera, D. and Petrizzelli, S. and Piersanti, M. and Possenti, A. and Ricchi, A. and Stalio, S. and Taborgna, N. and Tagliente, G. and Ursini, F.},
