  author        = {Conte, Rosa Ana and Pinatti, Daltro Garcia and Marton, Luiz Fernando M. and Ribeiro, Sebasti\~{a}o and Acosta, Thais Witt and Cruz, Raul A.P.A. and Santiago, Heron F.},
  year          = 2015,
  journal       = {Key Engineering Materials},
  volume        = 634,
  pages         = {72--82},
  doi           = {10.4028/www.scientific.net/KEM.634.72},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84922255404&doi=10.4028%2Fwww.scientific.net%2FKEM.634.72&partnerID=40&md5=3d7f6dd88f5da85c9a292fb22dec622e},
  note          = {Cited by: 1},
  abstract      = {Production of active rice husk silica (ARHS) in bubbling fluidized bed boiler of a thermoelectric unit (TEU) and its addition to high performance concrete (HPC) with a compression resistance of 90 MPa was developed in the last 10 years. A first factory in Brazil was established at Alegrete town, RS, and other factories are under planning. Data of ARHS production, specification and HPC trace are presented. Design of parabolic solar collector coverage (PSCC) for air heating for biomass drying in a special silo of the TEU is presented as well. Cost of HPC/ARHS is 10 times less than steel (USD 200/ton vs. USD 2000/ton, specific mass 2.5 vs. 7.6 g/cm<sup>3</sup>, respectively). Those characteristics allow simultaneous solution of four ecological problems: large span coverage, rain water collection, daily solar energy collection and storage, and drying of biomass. The integration of those characteristics results in decrease of biomass consumption maintaining the same UTE efficiency. Tracking parabolic solar collector can be avoided between Cancer and Capricorn Tropics, and it is sufficient its eastern-western orientation with inclination to the Equator by the latitude angle. Coverage of the area occupied by TEU is sufficient to dry its biomass consumption. Preheating of boiler water with solar energy is possible decreasing biomass consumption in sunny days; biomass is partially consummed at night and cloudy days. Coupling the above technologies with high pressure steam TEU and fast-growing short-rotation forest gives to the biomass electrical energy generation a competitive economical position with hydraulic, coal, natural gas, and aeolic energy generation. \textcopyright{} (2015) Trans Tech Publications, Switzerland.},
  author_keywords = {Active rice husk silica; Biomass; Energy optimization; High performance concrete; Parabolic solar collector},
  keywords      = {Biomass; Boilers; Digital storage; Fluidized beds; Silica; Solar collectors; Solar energy; Biomass consumption; Bubbling fluidized bed boilers; Compression resistance; Energy optimization; High-pressure steam; Rice husk silica; Simultaneous solution; Solar energy collections; High performance concrete},
  type          = {Conference paper},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Cook2011,
  title         = {Cloud management},
  author        = {Cook, Nigel and Milojicic, Dejan and Talwar, Vanish},
  year          = 2011,
  journal       = {HP Laboratories Technical Report},
  number        = 238,
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84855252383&partnerID=40&md5=246f94d1436f0ec9d087cbea0a10c380},
  note          = {Cited by: 1},
  abstract      = {<sup>1</sup>Cloud Computing offers a number of benefits, such as elasticity with the perception of unlimited resources, self-service, on-demand, automation, etc. However, these benefits create new requirements for management of Cloud computing. On the back-end, economic limitations dictate careful consolidation of servers with clear sustainability analysis; managed levels of abstractions are higher (from hardware, to VMs, to services); and reliability, availability, and supportability are built into higher levels of systems and services. On the client-side, Cloud services have to be easy to use/manage, perform well, and be reliable. On both sides, geographical distribution and its implications on business continuity is a rule rather than exception; scalability is built-in by design; and QoS is still being defined. In this paper, we discuss new requirements and approaches to Cloud management. We present a few examples of Cloud management for private, public, and HPC Clouds. Based on these, we derive conclusions about manageability of current platforms and then make predictions about the research challenges of future Cloud management. We expect these findings to help designers of next generation hardware and software platforms to develop more manageable systems and solutions. \textcopyright{} Copyright 2011 Hewlett-Packard Development Company, L.P.},
  author_keywords = {Cloud services; Heterogeneity; Integration; Middleware; Scalability; Service level agreements; Service management},
  keywords      = {Computer hardware; Distributed database systems; Elasticity; Geographical distribution; Management; Middleware; Quality of service; Scalability; Web services; Cloud services; Heterogeneity; Integration; Service Level Agreements; Service management; Cloud computing},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Copolovici2015751,
  title         = {Temperature dependencies of Henry's law constants for different plant sesquiterpenes},
  author        = {Copolovici, Lucian and Niinemets, \"{U}lo},
  year          = 2015,
  journal       = {Chemosphere},
  volume        = 138,
  pages         = {751--757},
  doi           = {10.1016/j.chemosphere.2015.07.075},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84940924096&doi=10.1016%2Fj.chemosphere.2015.07.075&partnerID=40&md5=94f6861595c19d550aabfb899bf3845d},
  note          = {Cited by: 30; All Open Access; Green Open Access},
  abstract      = {Sesquiterpenes are plant-produced hydrocarbons with important ecological functions in plant-to-plant and plant-to-insect communication, but due to their high reactivity they can also play a significant role in atmospheric chemistry. So far, there is little information of gas/liquid phase partition coefficients (Henry's law constants) and their temperature dependencies for sesquiterpenes, but this information is needed for quantitative simulation of the release of sesquiterpenes from plants and modeling atmospheric reactions in different phases. In this study, we estimated Henry's law constants (H<sub>pc</sub>) and their temperature responses for 12 key plant sesquiterpenes with varying structure (aliphatic, mono-, bi- and tricyclic sesquiterpenes). At 25\textdegree{}C, Henry's law constants varied 1.4-fold among different sesquiterpenes, and the values were within the range previously observed for monocyclic monoterpenes. H<sub>pc</sub> of sesquiterpenes exhibited a high rate of increase, on average ca. 1.5-fold with a 10\textdegree{}C increase in temperature (Q10). The values of Q10 varied 1.2-fold among different sesquiterpenes. Overall, these data demonstrate moderately high variation in H<sub>pc</sub> values and H<sub>pc</sub> temperature responses among different sesquiterpenes. We argue that these variations can importantly alter the emission kinetics of sesquiterpenes from plants. \textcopyright{} 2015 Elsevier Ltd.},
  author_keywords = {Flower and leaf volatiles; Henry's law constant; Partition coefficients; Sesquiterpenes; Temperature dependence},
  keywords      = {Air Pollutants; Computer Simulation; Flowers; Kinetics; Models, Theoretical; Molecular Structure; Plant Leaves; Sesquiterpenes; Solubility; Transition Temperature; Vapor Pressure; Volatilization; Hexapoda; Atmospheric chemistry; Gas plants; Monoterpenes; Olefins; Temperature distribution; alpha cedrene; alpha farnesene; alpha longipinene; alpha neoclovene; beta neoclovene; bornyl acetate; caryophyllene; gamma gurjonene; gamma neoclovene; humulene; isosativene; nerolidol; sesquiterpene derivative; unclassified drug; valencene; air pollutant; sesquiterpene; Flower and leaf volatiles; Henry's Law constant; Partition coefficient; Sesquiterpenes; Temperature dependence; atmospheric chemistry; flower; leaf; partition coefficient; quantitative analysis; temperature effect; terpene; volatile substance; Article; enthalpy; Henry law constant; isomer; partition coefficient; temperature; temperature dependence; volatilization; air pollutant; analysis; chemical structure; chemistry; computer simulation; flower; kinetics; plant leaf; solubility; theoretical model; transition temperature; vapor pressure; Atmospheric temperature},
