  abstract      = {A four-channel mode division multiplexing (MDM) transmitter is demonstrated with $4 \times 80$ Gbps signaling, assisted with a low-loss two-dimensional grating coupler over $1.85 ~\text{mm}^{2}$ footprint, exhibiting significant potential for future high-density and large-capacity optical interconnects.},
  keywords      = {Multiplexing;Optical losses;Optical interconnections;Two-dimensional displays;Optical switches;Couplers;Silicon photonics;Propagation losses;Optical transmitters;Gratings;mode division multiplexing;two-dimensional grating coupler;high-density optical interconnects}
}
@inproceedings{11115779,
  title         = {Reducing Digital $\text{CO}_{2}$ Footprint in IT Systems Using Temporal Difference Learning for Energy-Aware Scheduling},
  author        = {Radhakrishnan, Jayabhaduri and R., Shekhar},
  year          = 2025,
  month         = {April},
  booktitle     = {2025 12th International Conference on Computing for Sustainable Global Development (INDIACom)},
  pages         = {01--05},
  doi           = {10.23919/INDIACom66777.2025.11115779},
  abstract      = {Optimizing resource allocation is critical for reducing power consumption and minimizing carbon emissions in high-performance computing environments. This research presents a Deep-Q-Network based Reinforcement Learning DQNAgent to enhance decision-making in CPU/GPU allocation, and workload allocation. For better decision making, the proposed DQNAgent follows an epsilon-greedy policy to balance exploration and exploitation. The agent is trained for 1000 episodes, keeping exploration rate ($\epsilon$) decreases from 1.0 (random action selection) to 0.01 (optimal policy execution), which enables the DQNAgent to make more informed decisions. The DQNAgent is trained on a CPU/GPU workstation. The experimental results clearly indicate that training the agent on a CPU-based system to learn an optimal policy to minimize emissions takes approximately 7 hours and 17 minutes, while utilizing a GPU workstation significantly reduces execution time to less than 2 minutes, thereby accelerating real-time decision-making. Results indicate that the proposed method effectively optimizes energy efficiency, reducing overall power consumption while maintaining computational performance. This research work paves way for leveraging Artificial Intelligence driven reinforcement learning for sustainable and intelligent computing systems.},
  keywords      = {Training;Power demand;Processor scheduling;High performance computing;Decision making;Temporal difference learning;Real-time systems;Workstations;Resource management;Artificial intelligence;Artificial Intelligence;Digital Carbon Footprint;DQNAgent;Reinforcement Learning;Sustainable Computing;High Performance Computing}
}
@article{11122386,
  title         = {Low-Profile Inductor Design for High-Current Vertical Power Delivery Voltage Regulators},
  author        = {Cao, Ruibo and Song, Jian and You, Xiangan and Hou, Fengze and Yan, Na and Wang, Qidong and Cao, Liqiang},
  year          = 2026,
  month         = {Jan},
  journal       = {IEEE Transactions on Power Electronics},
  volume        = 41,
  number        = 1,
  pages         = {68--73},
  doi           = {10.1109/tpel.2025.3597630},
  issn          = {1941-0107},
  abstract      = {In high-current applications, vertical power delivery (VPD) architectures require highly compact inductors to maintain power integrity. However, the nonlinear relationship between magnetic reluctance and the 3-D geometry of the inductor under nonuniform flux distribution becomes complex, making it challenging to optimize inductance density and current density. This letter proposes a design method for low-profile inductor with air gaps under nonuniform flux distribution for high-current VPD voltage regulators, establishing an explicit mapping between inductance and core geometry with different structures. Using this method, a two-phase negative coupled inductor is designed, achieving a high continuous current density of 1.9 A/mm2 within a compact 2.2-mm height. Experimental validation in a buck converter demonstrates that the inductor supports a continuous current of 110 A. Based on the proposed inductor, the height of the 12–1V high current density voltage regulator module can be reduced to 4.2 mm.},
  keywords      = {Inductors;Inductance;Magnetic flux;Magnetic cores;Current density;Air gaps;Permeability;Ferrites;Voltage control;Regulators;Coupled inductor;fringing effect;low-profile;nonuniform flux distribution;vertical power delivery (VPD)}
}
@article{11123801,
  title         = {Hierarchical Reinforcement Learning for Energy-Efficient API Traffic Optimization in Large-Scale Advertising Systems},
  author        = {Ji, Enkai and Wang, Yihan and Xing, Suchuan and Jin, Jianian},
  year          = 2025,
  journal       = {IEEE Access},
  volume        = 13,
  pages         = {142493--142516},
  doi           = {10.1109/access.2025.3598712},
  issn          = {2169-3536},
  abstract      = {Digital advertising infrastructure represents a substantial component of global computing resources, with significant environmental impact due to its massive energy consumption and carbon footprint. This work addresses the sustainability challenges posed by inefficient API traffic management in large-scale advertising systems, where conventional static approaches lead to resource overprovisioning and energy waste. We propose AdaptiveGate, a sustainability-oriented hierarchical reinforcement learning framework that dynamically optimizes API traffic flows to enhance resource efficiency and reduce environmental impact. The proposed methodology employs a constrained Markov Decision Process formulation with a multi-objective reward function explicitly designed to balance system performance with resource efficiency. Our framework implements a two-tier architecture of twin delayed Deep Deterministic Policy Gradient agents: global agents minimize cross-datacenter energy expenditure through intelligent traffic routing, while local agents maximize resource utilization through service-specific load balancing. Empirical evaluation on production advertising systems processing over 2.5 million requests per second reveals significant sustainability improvements: 42.3\% reduction in tail latency, 35.7\% increase in throughput, and 18\% decrease in overall energy consumption compared to state-of-the-art methods. The system demonstrates exceptional adaptability across diverse traffic conditions and operational scales, providing compelling evidence that AI-driven methods can substantially improve digital infrastructure sustainability. This work contributes to sustainable computing by establishing a framework that optimizes computational resource allocation, minimizes energy waste, and advances environmentally responsible high-performance computing systems, aligning with multiple Sustainable Development Goals including responsible consumption and affordable clean energy.},
  keywords      = {Advertising;Routing;Reinforcement learning;Optimization;Resource management;Logic gates;Business;Load management;Throughput;Real-time systems;Reinforcement learning;API traffic management;digital advertising;hierarchical decision making;adaptive systems}
}
@inproceedings{11129602,
  title         = {Scalable Framework for Behavior Execution of Mobility and Transport Digital Twins},
  author        = {Bellini, P. and Ipsaro Palesi, Luciano Alessandro and Mereu, Fabrizio and Nesi, Paolo},
  year          = 2025,
  month         = {July},
  booktitle     = {2025 IEEE 11th International Conference on Big Data Computing Service and Machine Learning Applications (BigDataService)},
  pages         = {1--9},
  doi           = {10.1109/BigDataService65758.2025.00007},
  issn          = {2690-828x},
  abstract      = {The increasing complexity of smart city systems, particularly in mobility and transport domains, demands scalable and interoperable simulation frameworks for digital twins. To address these challenges, this paper introduces the Behavior Execution Framework for Digital Twins (BEFDIT), a modular, scalable solution designed to orchestrate heterogeneous behavioral simulations and predictions across different spatial and temporal scales. BEFDIT supports the co-simulation and co-execution of multiple simulation tools, both open-source and proprietary, through cloud/container-based infrastructures. BEFDIT facilitates real-time and offline management of simulations, dynamic resource allocation, and business model-driven service provisioning. It enables users to configure and manage Groups of Behavioral Executions, supporting independent, interoperable behavioral executors with persistent storage and web-based visualization. The framework's capabilities are demonstrated through the usage of SUMO simulator for urban mobility modeling, showcasing use cases in dynamic routing, congestion management, and real-time data generation for digital twins. Experimental results highlight BEFDIT's effectiveness in enhancing simulation scalability, interoperability, and decision support for smart city applications. The proposed solution can be adopted for what-if analysis frameworks, and for tactic/strategic planning, thus realizing an extremely valuable tool for smart city mobility. The solution has been implemented and is integrated into Snap4city Open-Source platform for Spoke 9 of the Italian National Center for Sustainable Mobility (CN MOST), and the CN MOST flagship OPTIFaaS and scalability SASUAM and adopted on CN HPC in Italy.},
  keywords      = {Smart cities;Scalability;Biological system modeling;Dynamic scheduling;Real-time systems;Digital twins;Complexity theory;Optimization;Interoperability;Business;Digital Twin Behavior;Simulation Framework;SUMO multiprocessing}
}
@inproceedings{11130305,
  title         = {Efficient Deployment of Very Wide and Very Deep Hypersparse FFNs on FPGA},
  author        = {Singh, Paramdeep and Anastasiu, David C.},
  year          = 2025,
  month         = {July},
  booktitle     = {2025 IEEE Computer Society Annual Symposium on VLSI (ISVLSI)},
  volume        = 1,
  pages         = {1--6},
  doi           = {10.1109/isvlsi65124.2025.11130305},
  issn          = {2159-3477},
  abstract      = {Model compression techniques such as quantization and pruning have shown great promise in drastically reducing model size without degrading model effectiveness. Quantization of model parameters when combined with parameter pruning results in a significantly reduced model size. However, such sparse neural networks have irregular structures. As such the forward pass (inference step) of such networks cannot be executed efficiently by processing hardware like GPUs. FPGA's offer a flexible platform to process irregular sparse networks. However, in order to fully realize the efficiency gains promised by the FPGA architecture, it is essential to minimize or completely eliminate off-chip memory accesses. Accommodating a large model completely on the FPGA fabric is restricted by the scarcity of available high-speed on-chip RAM, forcing a fraction of model weights to be stored in off-chip DRAM. We propose a method to accommodate very wide and very deep hypersparse feed forward networks (FFNs) completely on the FPGA fabric by compressing data structures in addition to quantizing the network parameters. Our method makes it possible to fit large FFNs completely on the FPGA fabric, resulting in inference performance almost 1000x higher than that of the state-of-the-art.},
  keywords      = {Quantization (signal);Memory management;Random access memory;Very large scale integration;Fabrics;Robustness;System-on-chip;Arrays;Sparse matrices;Field programmable gate arrays;Deep Neural Networks;FPGA Neural Network Acceleration;Sparse Networks;High Performance Computing}
}
@inproceedings{11130667,
  title         = {Efficient and Scalable Semantic Data Ingestion for Smart City Digital Twin Platforms},
  author        = {Bellini, Pierfrancesco and Collini, Enrico and Fanfani, Marco and Nesi, Paolo and Panconi, Christian},
  year          = 2025,
  month         = {July},
  booktitle     = {2025 IEEE 11th International Conference on Big Data Computing Service and Machine Learning Applications (BigDataService)},
  pages         = {44--51},
  doi           = {10.1109/BigDataService65758.2025.00012},
  issn          = {2690-828x},
  abstract      = {Smart City Digital Twins are becoming fundamental tools to support decision-makers in facing challenges spanning in multiple domains of the urban environment. By mirroring the real city into a digital counterpart, and thanks to data and visual analytics, digital twins allow operators to perform analysis, predictions, and simulations to better plan the urban development. To achieve such goal, ingest and model semantically enriched Big Data is the first building block required to develop a digital twin and obtain a faithful replica of the city. Ontologies play a fundamental role in this regard; however, graph databases exploiting ontologies to set up knowledge bases are inefficient in handling big data time series and multiple formats. NoSQL solutions excel in storing big data. In this paper, a novel semantic driven process is proposed capable to store, enrich, and forward data messages providing support for semantic data retrieval taking into account relational, temporal, and geographic/spatial queries and real time event driven data. The solution is at the core of the open source Snap4City Digital Twin platform which is currently in use in the context of the Italian National Center for Sustainable Mobility, and for the national center on HPC in Italy.},
  keywords      = {Data ingestion;Smart cities;Visual analytics;Semantics;Knowledge based systems;Computer architecture;Big Data;Ontologies;Real-time systems;Digital twins;Digital Twin;Smart City;Knowledge Base;Ontology;Big Data;NoSQL}
}
@inproceedings{11131739,
  title         = {What We See, What We Do Not See - Have You Ever Thought About the Energy Consumption of ICT?},
  author        = {Jaakkola, H. and Henno, J. and M\"{a}kel\"{a}, J.},
  year          = 2025,
  month         = {June},
  booktitle     = {2025 MIPRO 48th ICT and Electronics Convention},
  pages         = {501--507},
  doi           = {10.1109/mipro65660.2025.11131739},
  issn          = {1847-3938},
  abstract      = {Information and Communication Technology (ICT) has become a critical resource in the current economy and society. Services based on ICT are embedded in our daily lives as an invisible layer, partially replacing traditional practices and providing new opportunities. The transition to the current era of the Information (Intensive) Society has taken place gradually over the decades in all areas of society, including education. We are accustomed to using ICT without considering the various phenomena behind it. One of these phenomena is the energy required and its environmental consequences. Energy consumption related to the use of ICT is growing exponentially. Although users cannot significantly influence this phenomenon, it is important to identify the factors behind it and guide their choices in a direction that promotes sustainable development. This aspect should be considered even in ICT education. This paper examines the energy consumption of ICT from different perspectives. The topic is not widely or systematically studied; existing studies are imprecise and provide conflicting results. This is why it is important to create an overview of the current state of the subject.},
  keywords      = {Energy consumption;Education;Supercomputers;Ecology;Information and communication technology;Sustainable development;Artificial intelligence;Edge computing;ICT;energy;energy consumption;sustainability;Artificial Intelligence;cloud;supercomputer;edge computing;data center;ecology}
}
@inproceedings{11131756,
  title         = {Digital Maturity of Private and Public Organizations in RH},
  author        = {Kr\v{c}eli\'{c}, G. and Lorencin, I. and Tankovi\'{c}, N.},
  year          = 2025,
  month         = {June},
  booktitle     = {2025 MIPRO 48th ICT and Electronics Convention},
  pages         = {1857--1861},
  doi           = {10.1109/mipro65660.2025.11131756},
  issn          = {1847-3938},
  abstract      = {To use the services provided by the members of the EDIH Adira Consortium, organizations need to complete a predefined digital maturity assessment that is unique for all organizations that become users of EDIH services. This research analyzes the results of several dozen digital maturity assessments conducted in public and private sector organizations in 2023 and 2024. The study is based on the results of the European Commission Joint Research Centre (JRC) questionnaire, the Digital Maturity Assessment Tool (DMAT) conducted within the EDIH Adria project prior delivery of EDIH Adria support. The findings indicate that while both SMEs and PSOs demonstrate moderate levels of digital maturity, significant variations exist across different dimensions. The results suggest that organizational size plays a crucial role in Digital Maturity levels, with medium-sized entities often outperforming smaller and larger counterparts in various dimensions. While the findings offer valuable insights, they should be further validated through additional research and larger sample sizes.},
  keywords      = {Statistical analysis;Digital transformation;Europe;Organizations;Market research;Data governance;Artificial intelligence;Investment;Digital Maturity;SME;PSO;public and private sector;EDIH;AI}
}
@inproceedings{11131988,
  title         = {From Innovation to Impact: Case Studies of EDIH Adria TBI Projects},
  author        = {Lorencin, Ivan and Kr\v{c}eli\'{c}, Gordan and Bla\v{s}kovi\'{c}, Luka and \v{Z}u\v{z}i\'{c}, Alesandro and Licardo, Josip Tomo and Babi\'{c}, Snje\v{z}ana and Etinger, Darko and Tankovi\'{c}, Nikola},
  year          = 2025,
  month         = {June},
  booktitle     = {2025 MIPRO 48th ICT and Electronics Convention},
  pages         = {1851--1856},
  doi           = {10.1109/mipro65660.2025.11131988},
  issn          = {1847-3938},
  abstract      = {The European Digital Innovation Hub (EDIH) Adria fosters digital transformation in the Adriatic region by promoting advanced technologies like artificial intelligence, cybersecurity, and high-performance computing. Through its ``Test Before Invest'' (TBI) service, organizations can test tailored solutions for their challenges before making full-scale investments, minimizing risks and encouraging innovation. Key partners, including the University of Rijeka, Juraj Dobrila University of Pula, Ericsson Nikola Tesla, Rijeka Development Agency Porin d.o.o., and STEPRI, support EDIH Adria in bridging research and practical applications. This paper highlights the project's goals and impact through practical TBI case studies. Uniline, a tourism company, implemented a large language model (LLM) to optimize email prioritization and communication workflows. The City of Kastav used an LLM-based system to improve efficiency in evaluating funding applications. \v{S}olta Municipality applied computer vision to detect illegal construction, aiding urban planning. The City of Vodnjan leveraged similar technology to monitor unauthorized construction, vegetation coverage, and illegal waste disposal. By connecting science and industry, EDIH Adria demonstrates how digital innovation solves real-world challenges, enhances competitiveness, and drives sustainable development in the Adriatic region.},
  keywords      = {Technological innovation;Computer vision;Large language models;Digital transformation;Urban planning;OWL;Vegetation;Waste disposal;Sustainable development;Monitoring;Digital transformation;Test Before Invest;EDIH Adria;Artificial Intelligence;Innovation Ecosystem}
}
@inproceedings{11133842,
  title         = {Revisiting the Straggling Problem in GPU-based Distributed Deep Learning Training},
  author        = {Tairin, Suraiya and Zhang, Zeyu and Shen, Haiying},
  year          = 2025,
  month         = {Aug},
  booktitle     = {2025 34th International Conference on Computer Communications and Networks (ICCCN)},
  pages         = {1--9},
  doi           = {10.1109/icccn65249.2025.11133842},
  issn          = {2637-9430},
  abstract      = {The straggler problem has been extensively studied in CPU-based distributed deep learning (DL) training but has not received significant attention in homogeneous GPU-based distributed training, possibly because GPUs do not typically become bottlenecks in this scenario. In this paper, we conduct experiment measurements and find that the straggler problems persist in this scenario, primarily stemming from communication hurdles, compounded by computation delays, and stragglers substantially inflate resource consumption and training time by \sim{}50\%. Existing straggler mitigation methods do not directly address the communication stragglers in this scenario, and they suffer from drawbacks such as prolonged latency in straggler removal, high resource consumption, or compromised training accuracy. To tackle these limitations, based on the insights derived from thorough measurements, we propose a Straggler-aware Time and Resource Efficient distributed DL Training system (STRET). STRET is tailored for both homogeneous and heterogeneous GPU-based distributed training, encompassing both the parameter server (PS) and all-reduce architectures. It creates a hybrid architecture that connects a straggler to a non-straggler possessing high communication bandwidth with it to reduce communication delay. If this method fails to eliminate stragglers, it runs two complementary methods in sequence to remove the stragglers. First, it further reduces communication overhead by withholding reporting gradients when the accuracy increment is marginal. Second, it conducts one-time batch size tuning to reduce iteration time. Real experimental results on TensorFlow show that STRET can reduce up to 56\% and 41\% training time and save up to 94\% and 96\% resources in the heterogeneous and homogeneous scenarios, respectively, compared to state-of-the-art approaches while preserving accuracy.},
  keywords      = {Training;Deep learning;Accuracy;Prevention and mitigation;Computer architecture;Bandwidth;Time measurement;Delays;Servers;Tuning;Deep learning;Distributed training;Straggler}
}
@inproceedings{11135106,
  title         = {Digital Twin Framework for Smart City Development: Systematic Review},
  author        = {Miraoui, Zayneb and Nasser, Abdelkader and Kodad, Mohcine},
  year          = 2025,
  month         = {June},
  booktitle     = {2025 International Conference on Circuit, Systems and Communication (ICCSC)},
  pages         = {1--6},
  doi           = {10.1109/iccsc66714.2025.11135106},
  abstract      = {Cities represent complex ecosystems that grow at a rapid pace each day. Urban management and city services face multiple issues and functional problems. Integrating technology and smart infrastructure has become the chosen solution for modern challenges. The Smart City (SC) concept is a transformative approach being adopted by many cities around the world. This concept relies on the use of smart technologies such as the Internet of Things (IoT), Artificial Intelligence (AI), and high-performance computing for urban management and future project implementation. The goal is to enhance efficiency, improve quality of life, and ensure better harmony between technological progress and environmental sustainability. Moving towards a virtual living city model, the use of Digital Twin (DT) technology for urban growth management and city development is gaining attention among researchers and stakeholders. In this paper, the importance of DT technology for SC management is highlighted through a systematic review methodology. Then, differences between Urban Digital Twin (UDT) and Digital Twin City (DTC) approaches are debated, to synthetize shared properties and outline current limitations and challenges of implementing this technology in real-world settings. Finally, the paper concludes by offering some future research directions and potential paths for further work.},
  keywords      = {Smart cities;High performance computing;Process control;Digital twins;Internet of Things;Stakeholders;Artificial intelligence;Integrated circuit modeling;Standards;Systematic literature review;Smart cities;City modelling;Urban management;Digital twin}
}
@inproceedings{11135388,
  title         = {Spiking Neural Networks for Sustainable and High-Performance Computing},
  author        = {Gangshettiwar, Archit Anand and Correia, Nicole Elaine and Gaharwar, Kashish Singh and Vignesh, S and Sumathi, G and Konguvel, E},
  year          = 2025,
  month         = {July},
  booktitle     = {2025 6th International Conference on Data Intelligence and Cognitive Informatics (ICDICI)},
  pages         = {1030--1035},
  doi           = {10.1109/icdici66477.2025.11135388},
  abstract      = {Neuromorphic computing is defined as a non-von Neumann computation, unlike Von Neuman computation which consists of a separate CPU and memory unit, where data and instructions are stored in a unified memory unit. Neuromorphic computing whose structure is inspired by brains composed of neurons and synapses uses spikes as input, capturing the timing and interval between spikes to encode numerical information. it is ideal for systems that require high parallel operation, neuromorphic systems are highly scalable, and event-driven which allows for efficient computation. These neurological and biological mechanisms are modeled in neuromorphic computing systems through spiking neural networks (SNNs), In SNNs the information is coded with time-dependent spikes, which remarkably reduces the power consumption, our proposed solutions result indicate improved learning capacity and reduced power consumption compared to traditional computing approaches.},
  keywords      = {Power demand;Accuracy;Neuromorphic engineering;Memristors;Spiking neural networks;Timing;Artificial intelligence;Wearable devices;Wearable sensors;Edge computing;Neuromorphic computing;neural spike encoding;Memristor;Spike-Timing-Dependent Plasticity}
}
@inproceedings{11140953,
  title         = {A Comparative Analysis of OpenMP and Cuda in Real-Time Applications},
  author        = {Nahar, Devesh and Phaye, Mangalya D. and Garg, Ridima and George, Anju Susan and K, Chithra},
  year          = 2025,
  month         = {July},
  booktitle     = {2025 8th International Conference on Computing Methodologies and Communication (ICCMC)},
  pages         = {1127--1132},
  doi           = {10.1109/iccmc65190.2025.11140953},
  abstract      = {The need for effective parallel computing in real-time applications has gained momentum with advancements in multi-core processors and GPUs. OpenMP and CUDA are prominent frameworks, with OpenMP streamlining multi-core CPUs and CUDA utilizing GPU parallelism. This comparison measures performance in real-time applications like image processing, scientific computing, and medical diagnostics. The results show that CUDA performs 2.5\texttimes{}–16\texttimes{} speedups for highly parallel applications, and OpenMP is competitive in memory-bound workloads. This can inspire industrialists and research scholars to implement CUDA for sustainable development and economic growth in parallel processing systems. Chief challenges, optimizations, and hybrid implementation possibilities are elucidated.},
  keywords      = {Economics;Scientific computing;Reviews;Graphics processing units;Parallel processing;Streaming media;Real-time systems;Sustainable development;Usability;Optimization;parallel computing;CUDA;OpenMP;GPU acceleration;economic growth;sustainability}
}
@inproceedings{11154216,
  title         = {Application of Lightweight Neural Network Model in Garbage Classification},
  author        = {Zhang, Zhe and Wang, XingYu},
  year          = 2025,
  month         = {Aug},
  booktitle     = {2025 5th International Conference on Computer Science and Blockchain (CCSB)},
  pages         = {116--120},
  doi           = {10.1109/ccsb66722.2025.11154216},
  abstract      = {Waste sorting is crucial for resource recycling, environmental protection, and sustainable development. This paper explores the application of lightweight neural network models in waste classification for a lithium - battery - powered, Raspberry Pi 4B - based real - time system. Although image classification models are widely used, this study compares four lightweight models (TripleNet, EfficientNet - B0, YoloV5 - lite under TinyML framework, MobileNetV2) on edge devices. After comprehensively evaluating training duration, inference time, accuracy rates, and memory consumption, the MobileNetV2 model was chosen as the core architecture due to its easy operation and maintenance. In system implementation, a Raspberry Pi 4B ran neural network models and integrated cameras, conveyor belts, and servo motors for waste recognition and sorting. Experimental results show that MobileNetV2 achieved high accuracy in waste classification with low memory usage and fast inference speeds, suitable for resource - constrained edge devices. The system enables rapid waste sorting in practice, improving efficiency and accuracy in municipal waste management and offering insights for urban waste processing.},
  keywords      = {Training;Accuracy;Image edge detection;Computational modeling;Neural networks;Memory management;Maintenance;Servomotors;Sorting;Image classification;lightweight neural network model;edge device;garbage classification;image classification}
}
@inproceedings{11156520,
  title         = {Hybrid Fog-Cloud Architectures for Enhanced IoT Scalability and Performance},
  author        = {Rajak, Biru and Pradhan, Rahul and Mohapatra, Somanjoli and Aljawarneh, Nader Mohammad and A, Srithar and Balakumar, A.},
  year          = 2025,
  month         = {July},
  booktitle     = {2025 International Conference on Innovations in Intelligent Systems: Advancements in Computing, Communication, and Cybersecurity (ISAC3)},
  pages         = {1--6},
  doi           = {10.1109/isac364032.2025.11156520},
  abstract      = {The amount of IoT devices are growing extremely fast and produce huge amount of data that call for highly efficient and high-performance computing architecture. Analysis shows that traditional cloud based IoT has high latency, limited bandwidth, poor processing efficiency and are unsuitable for real time applications such as smart city, healthcare, etc. Localizing data processing, reducing latency and reducing network traffic, the fog computing is limited in applying complex computation because the fog nodes need powerful architecture and so are expensive. This research proposes Hybrid Fed + Fog-Cloud Orchestration model, which combines the favorable low latency advantages provided by fog computing with the higher storage and analytics capacity provided by cloud computing. AI-driven task scheduling and dynamic resource allocation distribute workloads efficiently across IoT devices, fog nodes, and cloud servers. FL reduces the cloud dependency and helps to achieve security, privacy, and real time decision making without sharing raw data among the subjects. iFogSim, CloudSim, EdgeCloudSim are used to simulate the proposed model and they are evaluated basing their key performance metrics on latency, energy consumption, bandwidth, task completion rate. By demonstrating reduced computational delays, improved scalability, enhanced fault tolerance, it is indeed a good candidate for large scale IoT facilitation. Moreover, intelligent, adaptive hybrid architectures are developed in this research that facilitate efficiency, security, and sustainability in dynamic IoT environments.},
  keywords      = {Cloud computing;Scalability;Computational modeling;Computer architecture;Bandwidth;Telecommunication traffic;Dynamic scheduling;Real-time systems;Internet of Things;Edge computing;IoT scalability;fog-cloud computing;federated learning;resource optimization;real-time processing}
}
@article{11159594,
  title         = {QPUF 2.0: Exploring Quantum Physical Unclonable Functions for Security-by-Design of Energy Cyber–Physical Systems},
  author        = {Bathalapalli, Venkata K. V. V. and Mohanty, Saraju P. and Pan, Chenyun and Kougianos, Elias},
  year          = 2025,
  month         = {Dec},
  journal       = {IEEE Internet of Things Journal},
  volume        = 12,
  number        = 23,
  pages         = {49864--49883},
  doi           = {10.1109/jiot.2025.3606330},
  issn          = {2327-4662},
  abstract      = {Sustainable advancement is being made to improve the efficiency of the generation, transmission, and distribution of renewable energy resources, as well as managing them to ensure the reliable operation of the smart grid. supervisory control and data acquisition (SCADA) enables sustainable management of grid communication flow through its real-time data sensing, processing, and actuation capabilities at various levels in the energy distribution framework. The security vulnerabilities associated with the SCADA-enabled grid infrastructure and management could jeopardize the smart grid operations. This work explores the potential of quantum physical unclonable functions (QPUFs) for the security and reliability of the smart grid's energy transmission and distribution framework. Quantum computing has emerged as a formidable security solution for high-performance computing applications through its probabilistic nature of information processing. This work has a quantum hardware-assisted security mechanism based on intrinsic properties of quantum hardware driven by quantum mechanics to provide tamper-proof security for quantum computing-driven smart grid infrastructure. This work introduces a novel QPUF architecture using quantum logic gates based on quantum decoherence, entanglement, and superposition. This generates a unique bitstream for each quantum device as a fingerprint. The proposed QPUF design is evaluated on IBM and Google quantum systems and simulators. The deployment on IBM quantum (ibmq\_qasm\_simulator) and Google Cirq simulators has achieved 100\% reliability with an average Hamming distance of 50.07\%, 51\% randomness.},
  keywords      = {Smart grids;Quantum computing;Monitoring;Quantum entanglement;Reliability;Power system reliability;Intelligent sensors;Quantum mechanics;Real-time systems;Measurement;cyber–physical systems (CPSs);cybersecurity;physical unclonable functions (PUFs);quantum physical unclonable functions (QPUFs);security-by-design (SbD);smart grid;system security}
}
@inproceedings{11166699,
  title         = {ROA: Energy and Environment Aware Task Scheduling in Cloud Computing},
  author        = {Reddy, Sandi Sridhar and Vishwashanthi, Morigadi and Reddy, Tumukuntla Spoorthi and Reddy Mendu, Lavanya and Manchala, Uma Devi and Kumar Medishetti, Santhosh},
  year          = 2025,
  month         = {Aug},
  booktitle     = {2025 3rd International Conference on Sustainable Computing and Data Communication Systems (ICSCDS)},
  pages         = {1517--1524},
  doi           = {10.1109/icscds65426.2025.11166699},
  abstract      = {Efficient task scheduling is a critical concern in cloud computing to ensure optimal resource utilization and sustainable operation. This paper introduces a novel Revolution Optimization Algorithm (ROA) for task scheduling in cloud environments, designed to minimize energy consumption, temperature variation, and carbon emissions. Inspired by socio-political revolutions, ROA incorporates a dynamic strategy that balances exploration and exploitation during the task-to-resource mapping process. The proposed approach is validated using the CloudSim simulator under realistic workload conditions based on the CEA-Curie workload, which reflects high-performance computing scenarios. Performance comparisons were conducted against traditional algorithms such as GA, PSO, and ACO. Experimental results demonstrate that ROA significantly reduces average energy consumption and thermal fluctuations while lowering the environmental impact measured in terms of carbon emissions. The adaptive learning mechanism within ROA enables rapid convergence to optimal solutions, even under fluctuating workloads and heterogeneous cloud resources. Compared to baseline models, ROA achieves an average improvement of 18.7\% in energy efficiency, 16.3\% reduction in temperature variation, and 20.5\% decrease in carbon emissions. These findings suggest that ROA is a promising, eco-efficient solution for sustainable task scheduling in modern cloud computing infrastructures.},
  keywords      = {Temperature measurement;Cloud computing;Energy consumption;Temperature distribution;Processor scheduling;Heuristic algorithms;Carbon dioxide;Scheduling;Resource management;Optimization;Revolution Optimization Algorithm;Temperature variation;Carbon emissions;CloudSim;CEA-Curie}
}
@inproceedings{11167649,
  title         = {Enhancing Energy Sustainability and Operational Efficiency of Ammonia Production using Machine Learning},
  author        = {Salah, Mohamed and El-Gharbawy, Muhammad and Mohammed, Ammar},
  year          = 2025,
  month         = {July},
  booktitle     = {2025 Intelligent Methods, Systems, and Applications​ (IMSA)},
  pages         = {635--641},
  doi           = {10.1109/imsa65733.2025.11167649},
  abstract      = {Ammonia production is vital to the global chemical industry. Its CO2 removal unit remains an energy-intensive bottleneck, improving sustainability and operational costs. Traditional control strategies struggle with nonlinear dynamics and multivariable interactions, leading to inefficiencies i n CO2 removal processes. This study introduces a machine learning (ML) enabled framework tailored for CO2 removal in ammonia systems using Hot Potassium Carbonate (HPC) solution. Advanced ML models such as Linear Regression, Artificial Neural Networks (ANN),and XGBoost are employed to predict CO2 removal efficiency and energy consumption. E valuated on real operational data from an Egyptian ammonia plant, ANN and XGBoost achieved R2 scores of 0.99 for energy savings and over 0.82 for energy consumption forecasts. The framework reduced steam usage from 12.4 ton/h to 10.1 ton/h, achieving an 18.5\% energy saving, and improved CO2 monitoring efficacy from 88.2\% to 94.7\%, a 6.5\% increase. These results demonstrate the potential of ML to enhance energy sustainability and CO2 removal efficiency, addressing the unique challenges of HPC solution based systems and advancing sustainable industrial practices.},
  keywords      = {Measurement;Ammonia;Energy consumption;Production;Artificial neural networks;Predictive models;Reliability;Sustainable development;Monitoring;Resilience;Machine Learning;Ammonia Production;CO2 Removal;Energy Sustainability;Operational Resilience;Artificial Neural Networks;Industrial Process Optimization}
}
@inproceedings{11169115,
  title         = {Enhancing Grid Capacity and Renewable Integration Through Real-Time Control: A Systematic Literature Review},
  author        = {Ustundag, Muhammed Fevzi and Morren, Johan and Van Den Akker, Wouter and Van Der Molen, Anne and Gargari, Shima Mousavi},
  year          = 2025,
  month         = {July},
  booktitle     = {2025 IEEE International Conference on Environment and Electrical Engineering and 2025 IEEE Industrial and Commercial Power Systems Europe (EEEIC / I\&CPS Europe)},
  pages         = {1--6},
  doi           = {10.1109/EEEIC/ICPSEurope64998.2025.11169115},
  issn          = {2994-9467},
  abstract      = {This paper presents a systematic review of realtime control in power systems, tracing its evolution from early implementations to the current landscape shaped by renewable energy and electrification. Employing the PRISMA methodology, we analyze key enabling technologies, assess the impact on grid operations, and identify research gaps. Challenges and future directions are discussed, focusing on technical barriers, economic considerations, and societal implications. This review provides a comprehensive overview of real-time control, highlighting its critical role in enabling a reliable and sustainable power grid, and laying the groundwork for future research and development in this vital area.},
  keywords      = {Renewable energy sources;Power system stability;Electrification;Real-time systems;Stability analysis;Power system reliability;Reliability;Security;Research and development;Systematic literature review;real-time control;power grids;renewable energy sources;electrification;systematic literature review}
}
@inproceedings{11176672,
  title         = {Bridging the memory-process divide: A Review of Heterogeneous Integration for Energy-Efficient Exascale Systems},
  author        = {Chamala, Yashwanth and Adwaith, A and Jayasree, K R},
  year          = 2025,
  month         = {Aug},
  booktitle     = {2025 8th International Conference on Circuit, Power \& Computing Technologies (ICCPCT)},
  pages         = {1788--1796},
  doi           = {10.1109/iccpct65132.2025.11176672},
  abstract      = {The intense pursuit of exascale computing fueled by accelerating data center traffic, AI applications, and HPC needs has revealed key bottlenecks in traditional architectures, most notably the power-hungry ``memory-processing divide''. Compounded by data movement latency and thermal issues in electrical interconnects, this divide highlights the need for visionary solutions. This article provides a comprehensive review of heterogeneous integration methods that aim to fill this gap, integrating 3D-stacked memory, silicon photonics-based optical interconnects, and processing-in-memory (PIM) architecture. We review state-of-the-art methods including low-temperature System-on-Integrated-Chips (SoIC) bonding, co-packaged optical transceivers, and PIM-enabled high-bandwidth memory (PIM-HBM), which together achieve 70-80\% latency improvements and $4-5 \times$ reductions in energy efficiency per bit. Industry case studies such as Intel's Foveros, NVIDIA's Grace Hopper Superchip, and Ayar Labs' TeraPHY showcase scalability and reliability in applications. Experimental evidence and comparison evaluations further establish the revolutionary promise of these technologies towards energy-efficient exascale platforms despite challenges in thermal issues, standardization, and neu-romorphic-photonic co-design. The review ends with an agenda for future work, solving outstanding questions in interconnect density, manufacturing scalability, and integration of prospective computing paradigms to achieve sustainable exascale computing.},
  keywords      = {Optical interconnections;Reviews;Exascale computing;Computational modeling;Scalability;Multichip modules;Programming;Energy efficiency;Reliability;Bonding;Heterogeneous Integration;3D-Stacked Memory;Silicon Photonics;Processing-in-Memory;Exascale Computing;Co-Packaged Optics;Low-Temperature Bonding}
}
@inproceedings{11178285,
  title         = {Toward a Metal Usage Effectiveness metric in Data Centers: A Study},
  author        = {Reinbigler, Marie and Martin, Rosalie},
  year          = 2025,
  month         = {June},
  booktitle     = {2025 11th International Conference on ICT for Sustainability (ICT4S)},
  pages         = {153--164},
  doi           = {10.1109/ict4s68164.2025.00024},
  abstract      = {Through a detailed breakdown of the metals required to manufacture and interconnect IT components in a High-Performance Computing (HPC) supercomputer, we introduce a novel metric for evaluating its environmental impact: the Metal Usage Effectiveness (MUE). This metric is based on the abiotic depletion potential (ADP), an indicator of the non-renewable material consumption relative to remaining resources. We define this metric as the ADP (expressed in kg antimony equivalents) caused by the extraction of metals required to manufacture and interconnect IT components, divided by the supercomputer computing power (in FLOPS). The MUE, insightful on the supercomputer manufacturing cost relatively to its computing power, complements existing metrics mainly focused on the use phase cost, such as the Power Usage Effectiveness (PUE) or the Water Usage Effectiveness (WUE). It could be a first step toward a more complete Life Cycle Inventory (LCI) of supercomputers and, by extension, data centers. We provide models for estimating copper and gold content in compute hardware components and interconnects of an HPC supercomputer, and apply them to Frontier, the world's first exascale supercomputer.},
  keywords      = {Measurement;Data centers;Gold;Costs;Electric breakdown;Computational modeling;Supercomputers;Hardware;Copper;Sustainable development;HPC;Supercomputer;Data Center;Metal;Sustainability;Metric;LCA;LCI}
}
@inproceedings{11179872,
  title         = {Sustainability Framework for Computing Element Design},
  author        = {Grover, Anuj and Jain, Abhishek and Khan, Najeeb Mohammad and Rao, Thatikonda Gopal and Alam, Farogh and Kumar, Piyush},
  year          = 2025,
  month         = {June},
  booktitle     = {2025 11th International Conference on ICT for Sustainability (ICT4S)},
  pages         = {80--90},
  doi           = {10.1109/ict4s68164.2025.00017},
  abstract      = {The semiconductor industry has revolutionized information and communication technologies by enabling unprecedented advancements in computing, communication, and automation. However, alongside this rapid progress, the escalating power consumption and resource demands of integrated circuits have raised critical sustainability concerns. Traditional evaluation figures of merit, such as Power, Performance, and Area (PPA), no longer appear to be sufficient enough to address the environmental impact of these designs. Hence, there is a need for an evaluation paradigm that can assess a design based on Power, Performance, Area, and Sustainability (PPAS). This research proposes a novel Sustainability Framework to allow designers to assess, benchmark, and choose the most efficient and environment-friendly architecture for their product development at the early design phase (i.e., `schematic' and `layout'). The proposed framework is applied on a wide variety of foundation cells to demonstrate it's wide applicability and agility. Foundation cells have been benchmarked and the impact of design choices on sustainability is presented based on different applications like IoT, Automotive, High-Performance Computing, and Portable Electronics.},
  keywords      = {Performance evaluation;Power demand;Net zero;Standards organizations;Computer architecture;Organizations;Benchmark testing;Very large scale integration;Product development;Sustainable development;Sustainability;Embodied footprint;Operational footprint;Foundation cell;ICT}
}
@inproceedings{11181488,
  title         = {Integrating a new Paradigm: Artificial Intelligence in Data-Intensive Applications},
  author        = {Riedel, Benedikt},
  year          = 2025,
  month         = {Sep.},
  booktitle     = {2025 IEEE International Conference on eScience (eScience)},
  pages         = {379--380},
  doi           = {10.1109/eScience65000.2025.00080},
  issn          = {2325-3703},
  abstract      = {Scientific discovery is undergoing a fundamental transformation, driven by an unprecedented deluge of data from next-generation experimental facilities (such as High-Luminosity Large Hadron Collider), high-fidelity simulations (novel weather prediction), and ubiquitous sensor networks (such as National Ecological Observatory Network). From the petabytes generated by the Large Hadron Collider to the terabytes streamed daily from genomic sequencers and climate models, the scale and complexity of scientific data have outpaced traditional methods of analysis. In response, the scientific community is increasingly turning to Artificial Intelligence (AI), particularly Machine Learning (ML) and Deep Learning (DL), as an indispensable tool for knowledge extraction. AI is not merely accelerating existing processes; it is enabling entirely new modes of inquiry. It allows physicists to identify faint particle signatures in noisy detector data, helps biologists predict protein structures from amino acid sequences, and empowers astronomers to classify celestial objects in vast sky surveys.},
  keywords      = {Surveys;Proteins;Observatories;Large Hadron Collider;Biological system modeling;Weather forecasting;Predictive models;Turning;Data models;Object recognition;workflows;dag}
}
@inproceedings{11181497,
  title         = {Printing Structural Color via AI-Guided Experimentation},
  author        = {Lomas, Johnny Austin and Zhang, Bing and Satheesan, Sandeep Puthanveetil and Berry, Matthew and Diao, Ying},
  year          = 2025,
  month         = {Sep.},
  booktitle     = {2025 IEEE International Conference on eScience (eScience)},
  pages         = {355--356},
  doi           = {10.1109/eScience65000.2025.00068},
  issn          = {2325-3703},
  abstract      = {Structural color, which arises from the interaction of light with micro- and nanostructured materials, has been recognized as an environmentally sustainable alternative to traditional dyes and pigments. In this study, Direct Ink Writing has been utilized as the additive manufacturing technique for fabricating structurally colored materials which here, are bottlebrush block copolymers. The experimental workflow has been integrated with an artificial intelligence-driven optimization process, enabling an efficient exploration of the printing parameter space. Image analysis techniques have been employed to characterize the resultant color profiles, with hue in the HSV color space serving as the primary objective function for optimization. The development of software architecture that facilitates real-time data collection and feedback has been undertaken in collaboration with the National Center for Supercomputing Applications (NCSA). Preliminary results have demonstrated the feasibility of the proposed approach in tuning structural coloration, while ongoing efforts aim to enhance automation capabilities and expand the scope of parameter optimization.},
  keywords      = {Automation;Image color analysis;Software architecture;Writing;Pigments;Three-dimensional printing;Real-time systems;Nanostructured materials;Optimization;Tuning;DIW;printing;structural color;automation;AI;optimization;edge computing;BBCPs}
}
@inproceedings{11181550,
  title         = {Preserving and improving the legacy of eScience: the GLOBO experience},
  author        = {Coppola, Carmine and Davoli, Guido and Fabiano, Federico and De Vita, Ciro Giuseppe and Di Luccio, Diana and Corvino, Pasquale and Pirozzi, Antonella and Alessandri, Andrea and Montella, Raffaele},
  year          = 2025,
  month         = {Sep.},
  booktitle     = {2025 IEEE International Conference on eScience (eScience)},
  pages         = {329--330},
  doi           = {10.1109/eScience65000.2025.00055},
  issn          = {2325-3703},
  abstract      = {Legacy scientific codes are essential to long-standing operational workflows but often cannot fully exploit modern heterogeneous high-performance computing (HPC) architectures. GLOBO, a global atmospheric circulation model developed at CNR-ISAC, is one such model that is still used for research and operational weather forecasting. In this work, we present an ongoing refactoring of GLOBO to improve its scalability and prepare it for GPU acceleration and cloud execution. The modernization focuses on three main areas: dynamic memory allocation, replacement of legacy point-to-point MPI communications with optimized collective operations, and OpenACC-based GPU offloading. We describe the redesign of the communication strategy, which replaces multiple MPI\_Isend/MPI\_Irecv exchanges with collective primitives (MPI\_Bcast, MPI\_Scatterv, MPI\_Sendrecv, MPI\_Reduce) to reduce overhead and improve parallel efficiency. Scalability experiments across multiple spatial resolutions show that a new collective communication strategy consistently matches or exceeds the original implementation, delivering up to 40\% runtime reduction in high-resolution, multi-node configurations. These results lay the groundwork for refactoring GLOBO toward a fully dynamic, GPU-accelerated, cloud-ready execution, preserving its scientific heritage while ensuring sustainable performance on future HPC platforms.},
  keywords      = {Codes;Scalability;Clouds;Atmospheric modeling;Computational modeling;Memory management;Graphics processing units;Weather forecasting;Predictive models;Optimization;Legacy codes;MPI collectives;HPC;Scalability;GPU offloading;Weather modeling}
}
@inproceedings{11182199,
  title         = {Design of an Embedded Image Compression System Using Python and Machine Learning},
  author        = {M, Chethana D and K, Prabhavathi and B, Aruna and G, Manjunatha and B, Naveen K and B, Manojkumar S},
  year          = 2025,
  month         = {Aug},
  booktitle     = {2025 International Conference on Biomedical Engineering and Sustainable Healthcare (ICBMESH)},
  pages         = {1--6},
  doi           = {10.1109/icbmesh66209.2025.11182199},
  abstract      = {The exponential growth of digital imagery necessitates advanced compression techniques that balance storage efficiency, transmission speed, and image quality. This paper presents an embedded image compression system leveraging Python and machine learning, integrating a convolutional neural network (CNN) for feature extraction and a variational autoencoder (VAE) for compression. The system, implemented on a Raspberry Pi 4 Model B, achieves an average compression ratio of 20:1, with a maximum of 25:1, while maintaining high image fidelity, as evidenced by an average PSNR of 32 dB and SSIM of 0.90. The real-time processing capability allows compression at 20 images per second, making it suitable for resource-constrained environments. Comparative analysis with JPEG and JPEG 2000 highlights the system's superior compression efficiency and image quality. Benchmarking on high-performance computing setups further validates its scalability, achieving a compression ratio of 22:1 with a PSNR of 33 dB. These results underscore the transformative role of machine learning in embedded image compression, paving the way for more efficient, real-time applications in digital imaging. This system is especially suitable for sustainable healthcare applications such as X-ray transmission and telemedicine imaging, where efficient bandwidth usage and image fidelity are critical for remote diagnosis and storage scalability.},
  keywords      = {Image quality;Image coding;Scalability;Digital images;Autoencoders;Transform coding;Machine learning;Medical services;Real-time systems;Convolutional neural networks;Embedded Image Compression;Convolutional Neural Network (CNN);Variational Autoencoder (VAE);Machine Learning;Real-Time Processing;Compression Ratio;Image Quality (PSNR;SSIM);Resource-Constrained Environments}
}
@inproceedings{11183292,
  title         = {A Low-Loss Hybrid Power Combiner Designed for Ku-Band 32-Way Power Combining Amplifiers},
  author        = {Zhang, Yiting and Zhu, Nengxu and Meng, Fanyi},
  year          = 2025,
  month         = {June},
  booktitle     = {2025 IEEE International Conference on Electron Devices and Solid-State Circuits (EDSS)},
  pages         = {128--130},
  doi           = {10.1109/edssc64492.2025.11183292},
  abstract      = {This paper introduces a low-loss hybrid power combiner (HPC) designed for 32 -way power combining amplifiers. The HPC integrates four-way transformers, strip-line transformers, and T-line networks, achieving reduced insertion loss within a compact footprint. Across the 9-16 GHz frequency range, the phase difference between $S_{12}$ and $S_{13}$ is tightly controlled, varying only between 182.7\textdegree{} and 183.2\textdegree{}, while the amplitude imbalance between $S_{12}$ and $S_{13}$ remains consistently low for four-way transformers. For the 32-way PA, the experimental results verify a 3dB bandwidth of $10.5-14.5 \text{GHz}, 30.8 \text{dBm}$ saturated output power (Psat), and 19.9 \% peak power-added efficiency (PAE). This design offers a scalable solution for power-combining networks in 5G-Advanced and 6G FR3 power amplifiers.},
  keywords      = {Power combiners;Power amplifiers;Insertion loss;Hybrid power systems;Ku-band;Solid state circuits;Circuit faults;Electron devices;Power generation;Frequency control;5G-Advanced/6G;FR3 band;hybrid power combiner (HPC);PA}
}
@inproceedings{11183572,
  title         = {Design of an Immersion Cooling Data Centers System Based on Deep Hashing Networks},
  author        = {He, Xi and Li, Xun and Gan, Rundong and Zhong, Ye and Tang, Jie},
  year          = 2025,
  month         = {June},
  booktitle     = {2025 5th International Conference on Artificial Intelligence, Big Data and Algorithms (CAIBDA)},
  pages         = {1463--1468},
  doi           = {10.1109/caibda65784.2025.11183572},
  abstract      = {The rapid growth of cloud computing, HPC, and AI has increased data center computing density, making traditional air-cooling inadequate for high-power servers. Immersion cooling, with better thermal conductivity and energy efficiency, is a promising alternative. However, current systems struggle with real-time data management and dynamic heat dissipation control, limiting adaptability to server thermal loads. This study introduces a Dual-Loss Optimized Deep Hashing Network for Immersion Cooling (DHN-IC), which efficiently processes high-dimensional data and optimizes heat dissipation by addressing hash discretization and semantic similarity loss. The DHN module enables real-time coolant flow adjustments, reducing Power Usage Effectiveness (PUE) and enhancing energy efficiency. Experimental results show DHN-IC improves data retrieval accuracy, reduces cooling energy consumption, and stabilizes server temperatures compared to traditional methods. This research provides insights into intelligent liquid cooling optimization, supporting energy-efficient, sustainable data center development.},
  keywords      = {Heating systems;Data centers;Temperature distribution;Immersion cooling;Data retrieval;Thermal management;Energy efficiency;Real-time systems;Servers;Optimization;Immersion Cooling;Deep Hashing Network (DHN);Dynamic Heat Dissipation Optimization;Data Center Energy Efficiency}
}
@article{11184355,
  title         = {Resilience Assessment Methods for Enabling Sustainable Power Systems With High Renewable Energy Penetration: Toward a More Sustainable Energy Future},
  author        = {Wu, Pengfei and Wang, Keren and Chen, Chen and Bie, Zhaohong},
  year          = 2025,
  month         = {Aug},
  journal       = {IEEE Energy Sustainability Magazine},
  volume        = 1,
  number        = 2,
  pages         = {124--138},
  doi           = {10.1109/esm.2025.3583845},
  issn          = {2998-4009},
  abstract      = {With the increasing penetration of renewable energy sources (RESs) in recent years, power system resilience assessment faces greater complexities compared to traditional fossil fuel-based grids due to the inherent uncertainties associated with RESs. The integration of the spatial–temporal evolution for extreme events, along with the uncertainty of RESs and modern operational characteristics, makes it difficult to characterize the system evolution mechanism. For resilience assessment, extreme events with low probability and high impact, combined with RES fluctuations exhibiting high uncertainty, pose significant challenges for scenario generation, operational simulation, and system state analysis during the evaluation. Furthermore, existing model-driven approaches suffer from difficulty in balancing assessment accuracy and efficiency, while lacking the paradigm for interpreting evaluation results. In this context, this article argues that focusing on the impact of RESs on system resilience is critical for enabling sustainable power systems. More specifically, this article explores how advanced model-driven and data-driven approaches can be utilized to facilitate resilience assessment in system operation to achieve a more sustainable energy future. Given the limitations of existing assessment methods, this article further proposes several promising approaches, which include the probabilistic modeling of RESs, high-performance computing techniques, and learning-based evaluation approaches to support a reliable operation and resilience enhancement of sustainable energy systems.},
  keywords      = {Renewable energy sources;Uncertainty;Accuracy;Computational modeling;Systems operation;Power system reliability;Sustainable development;Artificial intelligence;Resilience;Energy management;Probabilistic logic;Power system reliability;High performance computing}
}
@article{11184724,
  title         = {Reinforcement Guided Genetic Algorithm for Application Mapping in Network-on-Chip Architectures: Toward Transparent and Efficient MPSoC Scheduling},
  author        = {Al-Hchaimi, Ahmed Abbas Jasim and Al-Shareeda, Mahmood A. and Azar, Ahmad Taher and El-Shafai, Walid},
  year          = 2025,
  journal       = {IEEE Access},
  volume        = 13,
  pages         = {177520--177536},
  doi           = {10.1109/access.2025.3616179},
  issn          = {2169-3536},
  abstract      = {In this paper, we present a novel hybrid application mapping framework that integrates Genetic Algorithm (GA) with Reinforcement Learning (RL) to optimize task allocation in 2D Network-on-Chip based Multiprocessor System-on-Chip (NoC-based MPSoC) architectures. The goal is to reduce overall communication costs and improve runtime efficiency during the task-to-core mapping process. The RL agent is embedded within the GA loop to dynamically steer selection, crossover, and mutation operations using real-time feedback on mapping quality. Our methodology is evaluated on both real applications (e.g., PIP, MPEG, VOPD) and synthetic TGFF workloads across NoC mesh sizes from  $3\times 3$  to  $12\times 11$ . Experimental results demonstrate that GA+RL consistently outperforms the baseline GA. For instance, in the TGFF-G5 benchmark (80 cores), the GA+RL approach achieved a minimum communication cost of 116.354, compared to 244.645 with original GA, representing over 52\% improvement. Across all trials, GA+RL also showed lower standard deviations and earlier convergence generations. To improve interpretability, we incorporate Explainable AI (XAI) techniques using SHapley Additive exPlanations (SHAP) to analyze feature contributions. Results reveal that average communication hops and total bandwidth are key factors influencing mapping efficiency. The GA+RL model demonstrates greater transparency and consistency, aiding design-time decisions. This work has direct implications for industrial platforms, including Kalray MPPA-256 (autonomous vehicles), Intel SCC (cloud/HPC), Adapteva Epiphany (IoT Edges), and Tilera TILE-Gx (Cybersecurity), where efficient and adaptive application mapping is critical. Aligned with UN SDG 2 (Zero Hunger), the framework also supports real-time scheduling in agriculture IoT systems, enabling energy-efficient deployment of smart technologies to enhance food production and sustainability.},
  keywords      = {Optimization;Runtime;Costs;Convergence;Adaptation models;Genetic algorithms;Real-time systems;Computer architecture;Routing;Network-on-chip;Network-on-chip;application mapping;genetic algorithm;reinforcement learning;MPSoC;convergence-aware optimization;XAI;SHAP}
}
@inproceedings{11186497,
  title         = {Cascade: a Collaborative Algorithm for Scalable and Efficient Neighborhood Allgather},
  author        = {Sharifian, Hamed and Sojoodi, Amirhossein and Afsahi, Ahmad},
  year          = 2025,
  month         = {Sep.},
  booktitle     = {2025 IEEE International Conference on Cluster Computing (CLUSTER)},
  pages         = {1--13},
  doi           = {10.1109/cluster59342.2025.11186497},
  issn          = {2168-9253},
  abstract      = {Neighborhood collectives are a critical feature of MPI, enabling efficient communication in applications with sparse communication patterns. This research proposes Cascade, a new algorithm for neighborhood allgather collective that organizes computing nodes along multiple paths based on their distance to the current node. In this approach, messages are forwarded along these paths and propagated until all outgoing neighbors receive them, reducing the communication time. Three performance models are developed to analyze the efficiency of the Cascade algorithm, the default Open MPI algorithm, and the recently proposed Distance-halving neighborhood algorithm in the literature, offering insight into communication cost, scalability, and expected behavior of the algorithms across different system configurations. Experimental results demonstrate that the Cascade algorithm achieves up to 9.54x and 7.05x speedup over Open MPI for random sparse graphs and Moore neighborhoods, respectively. Additionally, the algorithm improves performance by up to $5.25 x$ for a sparse matrix-matrix multiplication kernel. The Cascade algorithm outperforms the Distance-halving neighborhood algorithm by up to 2.57 x and 4.81 x speedup for random sparse graphs and Moore neighborhoods, respectively. Moreover, Cascade achieves up to 1.61x performance gain over the Distance-halving neighborhood for the sparse matrix-matrix multiplication kernel. The predictions of our performance models closely match the experimental results.},
  keywords      = {Costs;Computational modeling;Scalability;Collaboration;Clustering algorithms;Predictive models;Performance gain;Prediction algorithms;Sparse matrices;Kernel;MPI;Neighborhood Collectives;Allgather;Performance Modeling}
}
@article{11192533,
  title         = {Beyond Backside Power: Backside Signal Routing as Technology Booster for Standard-Cell Scaling},
  author        = {Kedilaya, Anup Ashok and Oruganti, Sirish and Gupta, Nishant and Zhang, Xiuhao and Karpov, Ilya and Anders, Mark A. and Kulkarni, Jaydeep P.},
  year          = 2025,
  journal       = {IEEE Journal on Exploratory Solid-State Computational Devices and Circuits},
  volume        = 11,
  pages         = {107--115},
  doi           = {10.1109/jxcdc.2025.3617784},
  issn          = {2329-9231},
  abstract      = {Advances in process technology enabling backside metals (BSMs) and contacts offer new design–technology co-optimization (DTCO) opportunities to further enhance power, performance, and area gains (PPA) in sub-3-nm nodes. This work exploits backside (BS) contact technology within standard cells to extend both signal and clock routing to BSM layers, enabling standard-cell height reduction options. We design electrically equivalent (EEQ) standard cells with multiple layout variants based on front versus BS pin access, achieving a 2-M0-Track height reduction in 3-nm gate-all-around field-effect transistor (GAAFET) technology. Experimental evaluation across representative industrial benchmarks--including high-performance CPUs, GPUs, and general-purpose systems-on-chip (SoCs) demonstrates significant benefits. Cell height reduction delivers up to 35\% area savings and 10\%–15\% total power reduction for GPU and GP-SoC designs. For high-performance CPUs, maximum performance improves by 15\% at iso-power compared to backside power with buried power rails (BSBPR). Incorporating BS signal routing with cell height reduction also reduces worst case IR drop by 32\% relative to BSBPR. These results show that BS clock (BSCLK) and signal routing represent the next phase of technology innovation beyond BS power delivery, enabling continued standard-cell scaling, improved intracell and intercell routability, and generational PPA gains while maintaining similar core transistor geometries in sub-3-nm technologies.},
  keywords      = {Metals;Routing;Pins;Integrated circuit interconnections;Clocks;Transistors;Benchmark testing;Deep learning;Graphics processing units;High performance computing;Backside (BS) contacts;BS interconnects;BS signal;deep learning accelerators;design–technology co-optimization (DTCO);graphics processing units;high-performance compute}
}
@inproceedings{11196246,
  title         = {ColonyOS: A Meta-OS for Computing Continuums},
  author        = {Kristiansson, Johan and Bodin, Ulf and Borngrund, Carl and Delsing, Jerker and Martinsson, Jesper},
  year          = 2025,
  month         = {Sep.},
  booktitle     = {2025 IEEE International Conference on Cloud Engineering (IC2E)},
  pages         = {236--247},
  doi           = {10.1109/ic2e65552.2025.00041},
  issn          = {2694-0825},
  abstract      = {Increasing demands for low latency, cost efficiency, and digital sovereignty are driving organisations beyond centralised cloud models towards decentralised and hybrid computing environments. The Edge-to-Cloud computing continuum aims to unify edge and cloud infrastructures into a seamless execution environment, but achieving this remains complex in practice.ColonyOS is an open-source, ready-to-use meta-operating system that coordinates distributed workloads across diverse computing environments. ColonyOS separates coordination from execution using declarative, intent-based function specifications and a lightweight, broker-based architecture that provides OS-like abstractions. This paper outlines key properties of a meta-operating system and describes how these are realised in ColonyOS. The paper also presents practical experiences from two industrial deployments: real-time seismic monitoring at RockSigma AB and integration with EuroHPC supercomputers. These use cases demonstrate ColonyOS's capabilities in enabling resilient workload management and hybrid orchestration across HPC and Kubernetes environments. A referenced study on carbon-aware scheduling further illustrates how ColonyOS supports time-shifting of non-urgent workloads to reduce environmental impact. The paper concludes with a discussion of ColonyOS's architecture and future research directions.},
  keywords      = {Job shop scheduling;Data analysis;Processor scheduling;Computer architecture;Real-time systems;Supercomputers;Resource management;Low latency communication;Monitoring;Optimization;computing continuum;meta-operating system;distributed orchestration;edge-cloud integration;platform-agnostic computing}
}
@inproceedings{11196308,
  title         = {System-Level Performance Modeling of Photonic In-Memory Computing},
  author        = {Arockiaraj, Jebacyril and Wijeratne, Sasindu and Sunder, Sugeet and Kaiser, Md Abdullah-Al and Jaiswal, Akhilesh and Jacob, Ajey P. and Prasanna, Viktor},
  year          = 2025,
  month         = {Sep.},
  booktitle     = {2025 IEEE High Performance Extreme Computing Conference (HPEC)},
  pages         = {1--7},
  doi           = {10.1109/hpec67600.2025.11196308},
  issn          = {2643-1971},
  abstract      = {Photonic in-memory computing is a high-speed, low-energy alternative to traditional transistor-based digital computing that utilizes high photonic operating frequencies and bandwidths. In this work, we develop a comprehensive system-level performance model for photonic in-memory computing, capturing the effects of key latency sources such as external memory access and opto-electronic conversion. We perform algorithm-to-hardware mapping across a range of workloads, including the Sod shock tube problem, Matricized Tensor Times Khatri-Rao Product (MTTKRP), and the Vlasov-Maxwell equation, to evaluate how the latencies impact real-world high-performance computing workloads. Our performance model shows that, while accounting for system overheads, a compact 1\texttimes{}256 bit single-wavelength photonic SRAM array, fabricated using the standard silicon photonics process by GlobalFoundries, sustains up to 1.5 TOPS, 0.9 TOPS, and 1.3 TOPS on the Sod shock tube problem, MTTKRP, and the Vlasov-Maxwell equation with an average energy efficiency of 2.5 TOPS/W.},
  keywords      = {Analytical models;Computational modeling;Electric shock;Bandwidth;In-memory computing;Throughput;Mathematical models;Energy efficiency;Maxwell equations;Photonics;Photonic Computing;System-Level Modeling;Sod Shock Tube Problem;MTTKRP;Vlasov–Maxwell Equation}
}
@inproceedings{11196623,
  title         = {Power limits in data centers: what can we expect from improving energy efficiency and refreshing servers?},
  author        = {Leboulanger, Pablo and Orgerie, Anne-C\'{e}cile},
  year          = 2025,
  month         = {Sep.},
  booktitle     = {2025 IEEE International Conference on Cloud Engineering (IC2E)},
  pages         = {114--125},
  doi           = {10.1109/ic2e65552.2025.00027},
  issn          = {2694-0825},
  abstract      = {Ten years after the drafting of the Paris Agreement, the objective to reduce greenhouse gas emissions by half by 2030 seems difficult to reach. The impact of ICT technologies is growing year after year. Data centers have a large impact in this domain. As a lot of research is focused on improving energy efficiency of data centers, one could ask if this improvement would suffice to reduce greenhouse gas emissions. To study the impact of the energy efficiency on the long term, we propose to model a data center that has a limited power capacity and is regularly refreshed with new servers, more energy-efficient than the previous ones, to cope with its workload. Our results explore various growth rates for the load, and the energy efficiency and show that without reduction of usage of data center resources, the improvements in energy efficiency will not be not enough to reach the Paris Agreement's objective.},
  keywords      = {Data centers;Cloud computing;Energy efficiency;Data models;Servers;Greenhouse gases;Sustainable development;Load modeling;Energy efficiency;Cloud computing;Data centers;Sustainability}
}
@inproceedings{11196695,
  title         = {Performance Analysis of Inline Compression in pySDC},
  author        = {Lattanzio, Emily and Ranjan, Sansriti and Underwood, Robert and Saupe, Thomas and Speck, Robert and Calhoun, Jon C.},
  year          = 2025,
  month         = {Sep.},
  booktitle     = {2025 IEEE High Performance Extreme Computing Conference (HPEC)},
  pages         = {1--8},
  doi           = {10.1109/hpec67600.2025.11196695},
  issn          = {2643-1971},
  abstract      = {The volume of data required for High Performance Computing (HPC) jobs is growing faster than the memory storage available to store the required data, leading to performance bottlenecks. Hence the need for inline data compression, which reduces the amount of allocated memory needed by storing all data in its compressed format and decompressing/recompressing single variables as needed. We apply inline compression to the HPC application pySDC, a framework for parallel-in-time integration of partial differential equations. We introduce a new version of pySDC that has a compression manager to add inline compression functionality, along with a software cache that stores the decompressed state of the most frequently used variables. We use the ZFP lossy compressor to test our model with varying software cache sizes. Results show that having no cache has the best compression ratio (CR) at size 5.8, but having a cache size of 16 reduces total execution time by 2.6\texttimes{} while also slightly improving the memory footprint with a CR of 1.5. Our framework overall provides user versatility in the trade-off between execution time and memory savings.},
  keywords      = {Runtime;Partial differential equations;High performance computing;Memory management;Data compression;Turning;Software;Mathematical models;Performance analysis;Complexity theory;in-line compression;software cache}
}
@inproceedings{11196699,
  title         = {Sustainably Modeling a Sustainable Future Climate},
  author        = {Alomairy, Rabab and Abdulah, Sameh and Cao, Qinglei and Genton, Marc G. and Keyes, David E. and Ltaief, Hatem},
  year          = 2025,
  month         = {Sep.},
  booktitle     = {2025 IEEE High Performance Extreme Computing Conference (HPEC)},
  pages         = {1--8},
  doi           = {10.1109/hpec67600.2025.11196699},
  issn          = {2643-1971},
  abstract      = {Voluminous highly resolved climate data requires high-performance statistical modeling frameworks that are both accurate and sustainable on modern supercomputing platforms. Spatio-temporal modeling methods, such as Maximum Likelihood Estimation (MLE), primarily rely on performing a dense Cholesky factorization of large covariance matrices, which becomes a significant bottleneck at scale. We present an enhanced version of ExaGeoStat, a high-performance geostatistical modeling framework, designed to address this challenge through tile-based matrix compression, mixed-precision arithmetic, and architecture-aware scheduling. Building upon our previous work on Fugaku, an Arm A64FX system, we extend our results to three supercomputers featuring diverse hardware architectures: Frontier (AMD MI250X GPUs), Alps (NVIDIA GH200 GPUs), and Shaheen III (AMD EPYC Genoa CPUs). We demonstrate that adaptive algorithms targeting low-rank and low-precision opportunities can deliver up to 4\texttimes{} speedup, 2\texttimes{} memory savings, and over 70\% energy reduction while maintaining application-acceptable accuracy. Our work demonstrates the feasibility of running accurate climate-emulation workloads on next-generation AI hardware in a power-efficient manner, thereby advancing the sustainability of climate data science itself.},
  keywords      = {Maximum likelihood estimation;Accuracy;Computer architecture;Data science;Hardware;Supercomputers;Data models;Covariance matrices;Sustainable development;Next generation networking}
}
@inproceedings{11198219,
  title         = {Blockchain-Enabled Smart Contracts for Transparent and Sustainable Supply Chains},
  author        = {Kumar, Komuravelly Sudheer and Shanvi and Anne, Koteswara Rao and Khan, Sajid and Rakhra, Manik and Bhoyar, Mayur},
  year          = 2025,
  month         = {Feb},
  booktitle     = {2025 International Conference on Technology Enabled Economic Changes (InTech)},
  pages         = {1482--1488},
  doi           = {10.1109/InTech64186.2025.11198219},
  abstract      = {Transparency and sustainability of supply chain have been a big issues of concern in the current society. Most of the supply chain systems used in the traditional models expose the links to risks such as frauds, unethical procurement, and regulatory violations. With the help of blockchain and smart contract mechanism, customers can re-engineer the supply chain solutions as decentralized, transparent and tamper-proof. This paper aims at discussing the possibility of applying smart contracts on the blockchain technology in increasing traceability, eliminating fraud, and encouraging sustainable sourcing. The randomly selected business cases reveal that blockchain enabling supply chain communications increases traceability, reduces overhead fees and delineates better environmental and ethics responsibilities.},
  keywords      = {Economics;Technological innovation;Scalability;Supply chains;Smart contracts;Regulation;Blockchains;Fraud;Security;Sustainable development;Blockchain;Smart Contracts;Supply Chain Transparency;Sustainable Logistics;Decentralized Ledger}
}
@article{11201935,
  title         = {Multi-Objective Low-Carbon Scheduling Method for Data Centers Based on Ensemble Reinforcement Learning},
  author        = {Wang, Yifan and Sun, Wei and Ren, Pengyu and Harrison, Gareth},
  year          = 2026,
  month         = {Jan},
  journal       = {IEEE Transactions on Smart Grid},
  volume        = 17,
  number        = 1,
  pages         = {297--308},
  doi           = {10.1109/tsg.2025.3620106},
  issn          = {1949-3061},
  abstract      = {The explosive growth of GPU data centers is driven by the surging demand for machine learning, artificial intelligence, and high-performance computing applications, with the pressure on the power grid intensifying. Meanwhile, as renewable energy becomes more integrated into the grid, the carbon intensity of grid electricity varies at different times. This variability presents an opportunity for data centers to align their workloads with periods of high renewable energy generation and low carbon intensity, thereby reducing their operational carbon emissions. This paper proposes a multi-objective scheduling strategy to minimize carbon emissions and maximize quality of service (QoS) by identifying the Pareto front. The proposed strategy employs an integrated reinforcement learning model to dynamically integrate action strategies for multiple objectives. Results from a case study based on a real-world, large-scale data center illustrate the method's effectiveness. This effectiveness arises from its dual-objective job scheduling strategy, which simultaneously reduces carbon emissions from electricity consumption and maintains a high quality of service in data centers. The method aims to promote the low-carbon operation of data centers, provide decision support, and facilitate coordination between data centers and power systems in real-world applications.},
  keywords      = {Data centers;Carbon dioxide;Quality of service;Graphics processing units;Electricity;Processor scheduling;Carbon;Data models;Decision making;Energy consumption;Data center;job scheduling;demand side management;deep reinforcement learning;Pareto front}
}
@article{11202221,
  title         = {SOT-MRAM Bitcell Scaling With BEOL Read Selectors: A DTCO Study},
  author        = {Xiang, Y. and Garc\'{\i}a-Redondo, F. and Sharma, A. and Nguyen, V. D. and Fantini, A. and Matagne, P. and Rao, S. and Subhechha, S. and Verschueren, L. and Baig, Md. A. and Garcia Bardon, M. and Hellings, G.},
  year          = 2025,
  month         = {Dec},
  journal       = {IEEE Transactions on Electron Devices},
  volume        = 72,
  number        = 12,
  pages         = {6665--6671},
  doi           = {10.1109/ted.2025.3617043},
  issn          = {1557-9646},
  abstract      = {This work explores the cross-node scaling potential of SOT-MRAM for last-level caches (LLCs) under heterogeneous system scaling paradigm. We perform extensive design-technology co-optimization (DTCO) exercises to evaluate the bitcell footprint for different cell configurations at a representative 7 nm technology and to assess their implications on read and write power-performance. We crucially identify the MTJ routing struggle in conventional two-transistor one-resistor (2T1R) SOT-MRAMs as the primary bitcell area scaling challenge and propose to use BEOL read selectors (BEOL RSs) that enable (10\%–40\%) bitcell area reduction and eventually match sub-N3 SRAM. On writability, we affirm that BEOL RS-based bitcells could meet the required SOT switching current, provided the magnetic free layer properties be engineered in line with LLC-specific, (0.1–100) s retention targets. This is particularly to attribute to their: 1) more available Si fins for write transistor (WRT) and 2) lower bitline resistance at reduced cell width. We nevertheless underscore the read tradeoff associated with BEOL RSs, with the low-drive IGZO-FET selector sacrificing the latency up to (3–5) ns and the imperfectly rectifying diode selectors suffering (2.5–5) $\times $  energy cost relative to 2T1R. This article thus highlights the realistic prospects and hurdles of BEOL RSs toward holistic power-performance-area (PPA) scaling of SOT-MRAM.},
  keywords      = {Magnetic tunneling;Transistors;Routing;Switches;Resistance;Silicon;Logic gates;Hardware;Europe;Schottky diodes;Design-technology co-optimization (DTCO);heterogeneous scaling;last-level cache (LLC);power-performance-area (PPA);read selector (RS);SOT-MRAM}
}
@inproceedings{11207394,
  title         = {Performance Benchmarking of Tamil Nadu's Intra-State Bus Network: Evidence from Data Envelopment Analysis},
  author        = {Perumal, Vamanie and Paramasivan, Kandaswamy},
  year          = 2025,
  month         = {Aug},
  booktitle     = {2025 IEEE International Conference on High Performance Computing and Communications (HPCC)},
  pages         = {920--925},
  doi           = {10.1109/hpcc67675.2025.00136},
  abstract      = {Efficient and accessible public transportation systems are vital catalysts for economic development, facilitating connectivity, enabling trade, and improving the quality of life in both urban and regional areas. In regions like Tamil Nadu, India, intra-state bus routes form a critical backbone of transportation. Given the critical function of these bus networks, a deeper understanding of the factors driving their performance is essential. This study employs Data Envelopment Analysis (DEA), to systematically evaluate the operational efficiency of major intra-state bus routes connecting Chennai to 11 regions within Tamil Nadu from 2018 to 2024. An Input-Oriented DEA model under the assumption of Constant Returns to Scale is utilized, considering routes as Decision Making Units, inputs such as daily trip count, headway, and inter-day service interval, while using occupancy ratio as the output variable. The analysis identifies technically efficient routes that define the best-practice frontier for each year. A large majority of the evaluated DMUs (77.27\%) demonstrate high technical efficiency (scores exceeding 0.8). This comprises 33.12\% DMUs that are fully efficient (score $=1), 17.53 {\%}$ with scores between 0.9 and 0.99, and 26.62\% with scores between 0.8 and 0.89. High technical efficiency is achieved across bus routes serving diverse administrative classifications (Corporations, Municipalities, and Towns), reflecting the operational capability to maintain strong performance throughout the network's varying regional contexts. This can be attributed to the positive impact of strategic investments in transport infrastructure, including road enhancements, modern bus stations, fleet expansion, and technology integration. These results provide valuable insights for bus operators and regional transport authorities aimed at optimizing resource allocation and enhancing service delivery.},
  keywords      = {Economics;Roads;High performance computing;Government;Decision making;Resource management;Sustainable development;Public transportation;Data envelopment analysis;Investment;Public Bus Transport;Tamil Nadu Transport;Performance Efficiency;Data Envelopment Analysis}
}
@inproceedings{11207406,
  title         = {An Efficient Method for Preemptive Scheduling of Resources in Kubernetes},
  author        = {Zhang, Zhaoyang and Zhao, Peiyao and Xiong, Qiang and Jing, Honglei and Li, Jianxin and Chen, Yunliang},
  year          = 2025,
  month         = {Aug},
  booktitle     = {2025 IEEE International Conference on High Performance Computing and Communications (HPCC)},
  pages         = {536--543},
  doi           = {10.1109/hpcc67675.2025.00086},
  abstract      = {Preemptive scheduling reallocates resources to highpriority pods by terminating low-priority pods when idle resources are insufficient in a Kubernetes cluster. The default Kubernetes preemption strategy suffers from poor resource utilization because it neglects scoring metrics, such as network bandwidth and image locality. In this paper, an efficient preemptive resource scheduling method is proposed to address this issue with a well-designed two-layer-based pod prioritization mechanism considering both the pod's restart policy and runtime resource usage, and a node scoring model taking the network bandwidth into consideration. Experimental results show that the proposed method significantly improves resource utilization, reduces scheduling latency, and increases the success rate of highpriority pod deployments compared to the default Kubernetes strategy.},
  keywords      = {Measurement;Runtime;Processor scheduling;High performance computing;Bandwidth;Resource management;Preemptive Scheduling;Kubernetes;Resource Utilization;Node Scoring;Image Locality}
}
@inproceedings{11207451,
  title         = {LLM-THP: A Large Language Model-Powered Terminal Honeypot Dialogue Framework},
  author        = {Wang, Peng and Wang, Laite and Qian, Huan and Gai, Weilin and Zheng, Zhijian and Zhang, Peng and Wang, Ruoxing},
  year          = 2025,
  month         = {Aug},
  booktitle     = {2025 IEEE International Conference on High Performance Computing and Communications (HPCC)},
  pages         = {816--823},
  doi           = {10.1109/hpcc67675.2025.00122},
  abstract      = {With the acceleration of digital globalization, cyber threats are showing a trend of complexity and diversification, posing serious security challenges to critical information infrastructure and sensitive data. In this context, the development of efficient and accurate cyber threat detection technologies has become an urgent need to address potential risks and safeguard the security of the digital ecosystem. Terminal Honeypot is a security tool specifically designed to trap and analyze network attacks against end devices. It attracts attackers by simulating real terminal environments, thus collecting attacker behavioral data and attack methods. Development cycle, high resource consumption, and lack of the ability actively adapt to different attacker behaviors. These problems limit the analysis of the depth of the attack and the subsequent collection of attack information. Therefore, in order to adapt to the unknown attacks against Internet devices in the new situation, it is particularly important to design a terminal honeypot that is free from the predefined conditions and can flexibly respond to various attack scenarios. In this paper, a terminal honeypot design method based on LLM (Large Language Model), LLM-THP, is proposed to solve the problem that the existing honeypots are difficult to cope with unknown network threats. Firstly, we study to construct the initial honeypot environment by presetting prompts and design CoT-DPU, Chain-of-Thought Dynamic Prompt Update, which effectively avoids the token overflow problem in multiple attack interactions. For the challenges of attacker interaction, model invocation, and time asynchrony in practical deployment, the LLM-THP framework designs an efficient workflow. Experimental results show that LLM-THP is better than existing mainstream terminal honeypots in terms of honeypot attractiveness, correct response rate, and simulation.},
  keywords      = {Measurement;Large language models;High performance computing;Emulation;Globalization;Market research;Threat assessment;Internet;Security;Prompt engineering;Large Language Models;Prompt engineering;Honeypots}
}
@inproceedings{11212905,
  title         = {Performance and Scalability Analysis of Single and Hybrid Programming Models Combining CUDA and OpenMP in Multicore and Manycore Architectures},
  author        = {Sharma, Aashi and Sharma, Rashi and Saluja, Saachee and George, Anju Susan and K, Chithra},
  year          = 2025,
  month         = {Aug},
  booktitle     = {2025 11th International Conference on Electrical Energy Systems (ICEES)},
  pages         = {291--295},
  doi           = {10.1109/icees67011.2025.11212905},
  issn          = {2693-3934},
  abstract      = {In this paper, we explore and compare the performance of two popular parallel programming models: OpenMP and CUDA, for the purpose of matrix multiplication. Based on rigorous examination of the literature and some fresh experimental works, we contrast the merits and limitations of each technique in view of execution time, scalability, speedup and utilization of resources. In addition to duplicate benchmarks of available research work, we introduce an emerging hybrid estimation technique through partitioning of matrix by CPU (OpenMP) and GPU (CUDA) which enhances the economic growth. Results bear significant values toward choosing efficient programming models in light of the architecture of the hardware and dimensionality of an application, providing the sustainable development.},
  keywords      = {Analytical models;Parallel programming;Biological system modeling;Scalability;Computational modeling;High performance computing;Graphics processing units;Computational efficiency;Resource management;Sustainable development;Hybrid Computing;Matrix Multiplication;Parallel Programming;High-Performance Computing;Sustainable Development}
}
@article{11218253,
  title         = {Artificial Intelligence in the Middle East and Africa: Needs and Requirements},
  author        = {Routray, Sudhir K. and Mohanty, Sasmita},
  year          = 2025,
  month         = {Sep.},
  journal       = {IT Professional},
  volume        = 27,
  number        = 5,
  pages         = {46--51},
  doi           = {10.1109/mitp.2025.3614987},
  issn          = {1941-045x},
  abstract      = {The Middle East and Africa (MEA) region presents a unique set of needs and opportunities for generative artificial intelligence (AI), driven by economic diversification, digital transformation, and social challenges. Key sectors such as health care, education, finance, and governance require AI-driven solutions tailored to linguistic, cultural, and infrastructural nuances. In the Middle East, AI is central to national visions like Saudi Arabia's Vision 2030 and the United Arab Emirates's (UAE's) AI strategy, strengthening innovation in smart cities and cybersecurity. Africa, with its diverse economies and growing tech hubs, demands AI for localized content creation, agricultural optimization, and financial inclusion. Addressing data scarcity, ethical AI deployment, and skill development remains critical for Africa. A region-specific approach to generative AI can enhance economic growth, societal well-being, and sustainable development in MEA.},
  keywords      = {Economics;Ethics;Generative AI;Education;Finance;Africa;Linguistics;Sustainable development;Artificial intelligence;Market opportunities;Market research;Socioeconomics;Cultural aspects}
}
@article{11219172,
  title         = {Distributed Discrete Morse Sandwich: Efficient Computation of Persistence Diagrams for Massive Scalar Data},
  author        = {Le Guillou, Eve and Fortin, Pierre and Tierny, Julien},
  year          = 2026,
  month         = {Jan},
  journal       = {IEEE Transactions on Parallel and Distributed Systems},
  volume        = 37,
  number        = 1,
  pages         = {137--154},
  doi           = {10.1109/tpds.2025.3626047},
  issn          = {1558-2183},
  abstract      = {The persistence diagram, which describes the topological features of a dataset, is a key descriptor in Topological Data Analysis. The ``Discrete Morse Sandwich'' (DMS) method has been reported to be the most efficient algorithm for computing persistence diagrams of 3D scalar fields on a single node, using shared-memory parallelism. In this work, we extend DMS to distributed-memory parallelism for the efficient and scalable computation of persistence diagrams for massive datasets across multiple compute nodes. On the one hand, we can leverage the embarrassingly parallel procedure of the first and most time-consuming step of DMS (namely the discrete gradient computation). On the other hand, the efficient distributed computations of the subsequent DMS steps are much more challenging. To address this, we have extensively revised the DMS routines by contributing a new self-correcting distributed pairing algorithm, redesigning key data structures and introducing computation tokens to coordinate distributed computations. We have also introduced a dedicated communication thread to overlap communication and computation. Detailed performance analyses show the scalability of our hybrid MPI+thread approach for strong and weak scaling using up to 16 nodes of 32 cores (512 cores total). Our algorithm outperforms DIPHA, a reference method for the distributed computation of persistence diagrams, with an average speedup of $\times 8$\texttimes{}8 on 512 cores. We show the practical capabilities of our approach by computing the persistence diagram of a public 3D scalar field of 6 billion vertices in 174 seconds on 512 cores. Finally, we provide a usage example of our open-source implementation at https://github.com/eve-le-guillou/DDMS-example.},
  keywords      = {Computational efficiency;Filtration;Faces;Distributed databases;Topology;Three-dimensional displays;Parallel processing;Data structures;Hands;Distributed algorithms;Topological data analysis;high-performance computing;distributed-memory algorithms;persistent homology}
}
@inproceedings{11221934,
  title         = {Implementation of the Three-Dimensional SWiPLab-WFM Wind Farm Simulation Model on a Real-Time Simulator Cluster for HIL-Applications},
  author        = {Kipke, Vile and Wehber, Kolja and Sourkounis, Constantinos},
  year          = 2025,
  month         = {Oct},
  booktitle     = {IECON 2025 – 51st Annual Conference of the IEEE Industrial Electronics Society},
  pages         = {1--6},
  doi           = {10.1109/iecon58223.2025.11221934},
  abstract      = {The Smart WindPark Laboratory Wind Flow Model (SWiPLab-WFM) has been developed to simulate three-dimensional wind farm aerodynamics along with wind turbine emulators, i.e. physical test benches, consisting of mechanical drive trains, generators and power electronics in order to consider all relevant cross-couplings of a real wind farm in multiple physical domains. This paper deals with model design and modularization of the SWiPLab-WFM to meet the requirements of a dynamic wind flow simulation. The decentralized real-time simulator cluster architecture, which is capable of computing the model for 15 turbine emulators in total is introduced, along with its hardware specifications and I/O properties. Communication, data exchange and implementation aspects are discussed and results concerning computation efficiency are presented.},
  keywords      = {Solid modeling;Computational modeling;Computer architecture;Wind farms;Wind power generation;Aerodynamics;Real-time systems;Hardware;Power electronics;Wind turbines;Real-Time;Wind Farm Simulation;HIL}
}
@inproceedings{11225043,
  title         = {Carbon Responsibility Allocation in Real-Time Electricity Market based on KernelSHAP},
  author        = {Feng, Yuanhao and Sun, Tao and Feng, Donghan and Liu, Qiyuan and Lin, Danning and Zhou, Yun},
  year          = 2025,
  month         = {July},
  booktitle     = {2025 IEEE Power \& Energy Society General Meeting (PESGM)},
  pages         = {1--5},
  doi           = {10.1109/pesgm52009.2025.11225043},
  issn          = {1944-9933},
  abstract      = {We propose a scalable approach for allocating carbon responsibility among electricity market participants from both generation and consumption sides using KernelSHAP, a sampling-based estimation of Shapley values. The Shapley value provides mathematically proven fair allocation among participants through its uniquely satisfied axioms of efficiency, symmetry, and marginality. However, its exponential computational complexity with respect to the number of participants makes it impractical for any real-world sized electricity market, especially with real-time (5-minute) clearing requirements. Our KernelSHAP-based method significantly reduces computational burden while maintaining allocation accuracy. Through parallel computation using 500 CPU cores on a high-performance computing cluster, we validate our approach on IEEE 14-bus and 118-bus systems, demonstrating that KernelSHAP closely approximates traditional Shapley values while achieving substantial computational speedup.},
  keywords      = {Costs;Accuracy;High performance computing;Estimation;Carbon dioxide;Electricity supply industry;Real-time systems;Resource management;Time factors;Carbon;Carbon emission responsibility;Real-time electricity market;Shapley value;KernelSHAP;High-performance computing}
}
@inproceedings{11225317,
  title         = {Short-Term Load Forecasting for AI-Data Center},
  author        = {Mughees, Mariam and Li, Yuzhuo and Chen, Yize and Li, Yunwei Ryan},
  year          = 2025,
  month         = {July},
  booktitle     = {2025 IEEE Power \& Energy Society General Meeting (PESGM)},
  pages         = {1--5},
  doi           = {10.1109/pesgm52009.2025.11225317},
  issn          = {1944-9933},
  abstract      = {Recent research shows large-scale AI-centric data centers could experience rapid fluctuations in power demand due to varying computation loads such as sudden spikes from inference or interruption of training large language models (LLMs). As a consequence, such huge and fluctuating power demand pose significant challenges to both data center and power utility operation. Accurate short-term power forecasting allows data centers and utilities to dynamically allocate resources and power large computing clusters as required. However, due to the complex data center power system structure and the black-box nature of the underlying AI algorithms running in data centers, explicit modeling of AI-data center is quite challenging. Alternatively, to deal with this emerging load forecasting problem, we propose a data-driven workflow to predict the short-term electricity load in an AI-data center, and such workflow is compatible with learning-based algorithms such as LSTM, GRU, 1D-CNN. We validate our framework, which achieves decent accuracy on data center GPU short-term power consumption. This provides opportunity for improved power management and sustainable data center operation.},
  keywords      = {Training;Data centers;Accuracy;Load forecasting;Heuristic algorithms;Power system management;Power system dynamics;Graphics processing units;Prediction algorithms;Forecasting}
}
@inproceedings{11225556,
  title         = {Sustainable Aviation Fuel Generation from Carbon-Captured CO2: Electricity Impact and Demand-Side Flexibility Modeling},
  author        = {Liu, M. Vivienne and Zhang, Jiazi and Li, Yijin and Liu, Weijia and Sun, Hongfei and Tao, Ling},
  year          = 2025,
  month         = {July},
  booktitle     = {2025 IEEE Power \& Energy Society General Meeting (PESGM)},
  pages         = {1--5},
  doi           = {10.1109/pesgm52009.2025.11225556},
  issn          = {1944-9933},
  abstract      = {As the aviation sector seeks to reduce its environmental impact, sustainable aviation fuel (SAF) has emerged as a promising solution for lowering greenhouse gas (GHG) emissions. Despite SAF's compatibility with existing infrastructure and its potential for significant emissions reductions, large-scale SAF production poses challenges to electricity grid operations and planning. Building on prior work, which analyzed the capacity expansion needs and corresponding costs for different SAF production levels in the U.S. power grid, this study explores the operational impacts of SAF demand within a net-zero GHG electricity grid for the U.S. Specifically, we develop a production cost modeling approach to evaluate the daily grid operation impacts of SAF demand and examine the role of demand-side flexibility as a strategy to mitigate these impacts. By integrating an optimization model that treats SAF production demand as a flexible load, we analyze how this flexibility could impact renewable energy utilization and reduce system costs. Our results show that with lower capacity factor for the SAF production process, demand-side flexibility reduces reliance on non-renewable resources and lowers total system costs by up to 84\% and 86\%, respectively. This result indicates actionable insights for integrating SAF demand in future grid planning and operations.},
  keywords      = {Capacity factor;Renewable energy sources;Electric potential;Costs;Electricity;Production;Power grids;Planning;Fuels;Load modeling;Sustainable Aviation Fuel (SAF);CO2-to-Fuel Technology;Demand-Side Flexibility;Electricity Grid Impact;Prodcution Cost Model (PCM)}
}
@inproceedings{11233586,
  title         = {Trailblazing NanoComm through Advanced Architectures and Efficient System Designs},
  author        = {Khan, Shamim Ahmad and Boddepalli, Eswararao and Mahdi, Haider Sharif and Abdul Wahab Sheet, Sabah and Daham Wassif, Sattar Jabar and Saravanakumar, R},
  year          = 2025,
  month         = {July},
  booktitle     = {2025 3rd World Conference on Communication \& Computing (WCONF)},
  pages         = {1--6},
  doi           = {10.1109/wconf64849.2025.11233586},
  abstract      = {Today nanoscale communication systems are nearly half simple-to-using technology changes, allowing nanodevices to interact freely and effortlessly with one another in numerous applications, such as biomedical sensing, environmental monitoring, or high-performance computing. The present study highlights three main developments: miniaturization of devices, energy efficiency, and scalable network architectures. The ultra-compact and efficient devices are developed by using the latest transistors, like FinFETs and Tunnel FETs, alongside novel nanomaterials, such as graphene and carbon nanotubes. The study integrates bio-inspired energy harvesting mechanisms, including piezoelectric and triboelectric nanogenerators, for the purpose of achieving sustainable and self-powered networks. Including techniques that use adaptive transmission, their new framework, supported by molecular and electromagnetic communication paradigms, reduces energy by 50 percent while increasing throughput by 55 percent. These network architectures can be optimized using hierarchical and hybrid models towards enhanced scalability and adaptability with AI-based SDN. The experimental model suggests advanced cryptographic protocols coupled with quantum encryption to solve security issues along the reliable and secure commutation lines. The performance evaluation indicates that molecular communication achieves very good energy efficiency (<10 pJ/bit), while the newly emerged technologies based on quantum principles improve speed and security for future computation applications. The proposed framework enhances reliability, low latency, and energy efficiency, thus setting the stage for disruptive nanoscale networks. Finally, this paper concludes with the assertion that the integration of innovative devices and a sustainable communication approach that has been presented here are necessary steps toward scalable and energy-efficient nanoscale communication systems that meet the demand of future technologies.},
  keywords      = {Adaptation models;Molecular communication;Network architecture;Throughput;Nanoscale devices;Energy efficiency;Sensors;Security;Reliability;Triboelectricity;Nanoscale Communication (NanoComm);Miniaturization;Energy Efficiency;Network Architectures;Molecular Communication}
}
@inproceedings{11234794,
  title         = {Enhancing Energy Efficiency in Embedded Machine Learning Systems via Neuromorphic Architecture},
  author        = {AL-Attabi, Kassem and Tyagi, Neha},
  year          = 2025,
  month         = {Aug},
  booktitle     = {2025 International Conference on Next Generation of Green Information and Emerging Technologies (GIET)},
  pages         = {1--6},
  doi           = {10.1109/giet65294.2025.11234794},
  abstract      = {As embedded systems are increasingly used in edge computing applications, the demand for machine learning (ML) capabilities has increased. CPUs and GPUs are traditional computing architectures, but their power consumption and memory constraints often limit their performance. Embedded machine learning systems can be made more energy-efficient by using neuromorphic architectures. With neuromorphic computing, low-power, high-performance computation is achieved using spiking neural networks (SNN s). Our approach reduces energy consumption without compromising accuracy by combining approximate computing with neuron sensitivity analysis via backpropagation. Using datasets such as MNIST, Fashion-MNIST, and the ASL Alphabet, neuromorphic systems are validated as being more energy-efficient, latency-free, and scalable than conventional systems. Intel's Loihi and NM500 hardware implementations have demonstrated that neuromorphic models consume over an order of magnitude less energy than GPUs and CPUs. As ML devices become more intelligent and sustainable, neuromorphic architectures have significant potential.},
  keywords      = {Neuromorphics;Sensitivity analysis;Neuromorphic engineering;Approximate computing;Neurons;Computer architecture;Machine learning;Spiking neural networks;Energy efficiency;Hardware;Neuromorphic Computing;Energy Efficiency;Embedded Machine Learning;Spiking Neural Networks (SNNs);Approximate Computing}
}
@inproceedings{11235398,
  title         = {End-To-End Containerized Testbed for Evaluation of Next-Generation Wireless Technology Dataset},
  author        = {Gouda, Punya Satish and Prasad, Varun Kowndinya Shankar and Kumar, Venkataramani},
  year          = 2025,
  month         = {July},
  booktitle     = {NAECON 2025 - IEEE National Aerospace and Electronics Conference},
  pages         = {1--5},
  doi           = {10.1109/naecon65708.2025.11235398},
  issn          = {2379-2027},
  abstract      = {Extensive evaluation of various factors affecting affecting the quality of service (QoS), and signal strength using traditional and advanced tools is pertinent for the efficient implementation of futuristic applications. Most of the existing comprehensive evaluation tools such as virtual machines, python based virtual environments, and cloud-based virtualization suffers from limitations such as higher resource consumption, lack of full process isolation, higher time consumption, and inability to be replicated across diverse environments. To alleviate the above mentioned concerns, in this work, we proposed an end-to-end Docker container based testbed that can support multiple deployments in their isolated containers without comprising the performance, comparatively lesser resource utilization, and reduced latency. Our approach is validated on open-source dataset by using deep learning model as well as statistical tool to identify the parameters affecting the signal strength significantly. Evaluation results included in this work highlights the feasibility of our containerization based testbed for comprehensive evaluation.},
  keywords      = {Wireless communication;Deep learning;Cloud computing;Quality of service;Containers;Aerospace electronics;Aerospace testing;Virtual machines;Resource management;Next generation networking}
}
@inproceedings{11235575,
  title         = {Scaling liquid cooling for Google Data Center AI applications to a 1 GW fleet},
  author        = {Iyengar, Madhusudan and Padilla, Jorge},
  year          = 2025,
  month         = {May},
  booktitle     = {2025 24th IEEE Intersociety Conference on Thermal and Thermomechanical Phenomena in Electronic Systems (ITherm)},
  pages         = {1--10},
  doi           = {10.1109/ITherm55376.2025.11235575},
  issn          = {2694-2135},
  abstract      = {Computer chip power and power densities are predicted to continue to increase for the foreseeable future. Similarly, data center (DC) space constraints are driving the increase of information technology equipment (ITE) deployment densities, i.e. ITE $/ \mathrm{m}^{3}$. Liquid cooled ITE thermal performance is generally superior to air cooling and is achieved with significantly greater energy efficiency and higher power density. Challenging thermal management requirements for $\mathrm{AI} / \mathrm{ML}$ systems, are motivating the DC industry to move beyond air cooling to liquid cooling ITE in order to cool more powerful chips within smaller volumes and with greater energy efficiencies. Liquid cooled ITE is typically a high performance product for DC computing applications such that equipment requires high standards of end-to-end thermal-hydraulic performance, quality, reliability \& supply chain robustness. Liquid cooled equipment includes cold plates (which are typically in direct physical contact with the heat dissipating equipment), pumps, Coolant Distribution Units (CDU) (which typically decouple facility cooling loops from the ITE liquid cooling loop to deliver precisely controlled liquid temperature, pressure, flow and cleanliness to ITE), heat exchangers (e.g. air/liquid \& liquid/liquid), hard and flexible tubing, immersion cooling tanks, liquids (e.g. water, glycol, dielectric), interoperable, multi-source rack and tray level liquid interconnects. For broader adoption of liquid cooled ITE, liquid cooling technologies must be designed and developed to deliver the high engineering performance and reliability required to support the exponential growth of the DC industry. In addition to performance and reliability, to enable scale adoption of liquid cooling ITE, DC owners are recommended to develop more environmentally sustainable DC architectures and supply chain, deployment and operations strategies which are suitable beyond smaller-scale, niche LC deployments. In 2018, Google publicly announced the introduction of liquid cooling in their data centers for machine learning TPUv3. In 2021, the TPUv4 was unveiled as the second generation liquid cooled ML platform. In 2024, Google published information on TPUv5, the third generation liquid cooled ML system. Thermal management of the TPUv3, TPUv4, and TPUv5, and other high power ITE within a small server volume, is enabled by liquid cooling equipment designed to meet the high thermalhydraulic performance standards required for these applications. This paper outlines the technical and strategic model pursued by Google for designing for, and scaling, liquid cooled ITE for data center applications.},
  keywords      = {Data centers;Liquid cooling;Liquids;Heat pumps;Cold plates;Supply chains;Thermal management;Internet;Servers;Standards;thermal management;liquid cooling;data center sustainability;cold plates;supply ecosystem;open standards}
}
@inproceedings{11235634,
  title         = {Liquid Cooling Optimization for Data Centers with Reinforcement Learning},
  author        = {Naug, Avisek and Guillen-Perez, Antonio and Gundecha, Vineet and Guti\'{e}rrez, Ricardo Luna and Faraboschi, Paolo and Bash, Cullen and Sarkar, Soumyendu},
  year          = 2025,
  month         = {May},
  booktitle     = {2025 24th IEEE Intersociety Conference on Thermal and Thermomechanical Phenomena in Electronic Systems (ITherm)},
  pages         = {1--8},
  doi           = {10.1109/ITherm55376.2025.11235634},
  issn          = {2694-2135},
  abstract      = {The growing energy demands of machine learning workloads require more sustainable data centers with reduced energy consumption and lower carbon footprints. Highperformance computing (HPC) and supercomputing data centers, which utilize liquid cooling for improved efficiency over traditional air cooling, stand to benefit significantly from advanced optimization strategies. In this study, we propose a novel Reinforcement Learning (RL) based approach to optimize liquid cooling systems (RL-LC). By applying RL at varying levels of granularity in cooling control, our method achieves over 20\% energy savings, delivering a more efficient and sustainable solution for data center management. Additionally, we introduce a flexible analytical model that supports simulations and digital twin applications, focusing on reducing energy consumption and carbon emissions. This work provides key advancements in liquid cooling technology, offering practical insights to mitigate the environmental impact of HPC operations.},
  keywords      = {Thermal management of electronics;Data centers;Energy consumption;Analytical models;Liquid cooling;Reinforcement learning;Valves;Servers;Level control;Optimization;Reinforcement Learning;Data Centers;Liquid Cooling;Energy Efficiency;Real-Time Systems;Thermal Management;Modelica}
}
@article{11237236,
  title         = {How to Cool Chips with Lasers: Startup Plans to Convert Heat to Light in Data-Center Processors},
  author        = {Balma, Jacob and Rodriguez, Alejandro W.},
  year          = 2025,
  month         = {November},
  journal       = {IEEE Spectrum},
  volume        = 62,
  number        = 11,
  pages         = {40--45},
  doi           = {10.1109/mspec.2025.11237236},
  issn          = {1939-9340},
  abstract      = {Modern high-performance chips are marvels of engineering, containing tens of billions of transistors. The problem is, you can't use them all at once. If you did, you would create hot spots--high temperatures concentrated in tiny areas--with power densities nearing those found at the surface of the sun. This has led to a frustrating paradox known as dark silicon, a term coined by computer architects to describe the growing portion of a chip that must be kept powered down. Up to 80 percent of the transistors on a modern chip must remain ``dark'' at any given moment to keep the chip from sizzling. We are building supercomputers on a sliver of silicon but only using a fraction of their potential. It's like building a skyscraper and being able to use only the first 10 floors.},
  keywords      = {Power system measurements;Density measurement;Lasers;Silicon;Supercomputers;Transistors;High performance computing;Chip scale packaging;Data centers;Performance evaluation;Immersion cooling;Cooling;Heating systems;Cold plates;Laser cooling;Transistors;Liquid cooling;Product design;Product development}
}
@inproceedings{11240260,
  title         = {Stochastic Model Predictive Control with Direct Feedforward Compensation: Harvesting Idle Resources in High-Performance Computing},
  author        = {Halitim, Kouds and Robu, Bogdan and Cerf, Sophie and Bleuse, Rapha\"{e}l and Rutten, Eric},
  year          = 2025,
  month         = {Oct},
  booktitle     = {2025 29th International Conference on System Theory, Control and Computing (ICSTCC)},
  pages         = {246--252},
  doi           = {10.1109/icstcc66753.2025.11240260},
  issn          = {2473-5698},
  abstract      = {In high-performance computing (HPC), many research has been conducted on how to efficiently utilize the idle time of HPC resources (periods when no jobs are submitted to the platform). One promising approach is to exploit this idle time by injecting small, flexible, independent, and interruptible jobs that have no strict time constraints. However, managing the injection of these jobs is challenging due to the stochastic nature of job parameters, such as execution times and resource consumption. Additionally, process noise--resulting from system complexity and the arrival and execution of varying external workloads--can interrupt or terminate these filler jobs. In this paper, we propose and evaluate, using real data, a Stochastic Model Predictive Control (SMPC) approach that addresses system uncertainty and incorporates a feed-forward compensation mechanism for disturbance rejection. The proposed algorithm shows promising results: it ensures a platform usage rate of 98\%, significantly improving overall resource efficiency and reducing the number of early terminated jobs compared to previous work.},
  keywords      = {Uncertainty;High performance computing;Simulation;Stochastic processes;Probabilistic logic;Prediction algorithms;Resource management;Time factors;Feedforward systems;Predictive control;High-Performance Computing;Resource management;Stochastic Model Predictive Control;Energy efficiency}
}
@inproceedings{11241007,
  title         = {Tensor Program Optimization for the RISC-V Vector Extension Using Probabilistic Programs},
  author        = {Peccia, Federico Nicol\'{a}s and Haxel, Frederik and Bringmann, Oliver},
  year          = 2025,
  month         = {Oct},
  booktitle     = {2025 IEEE/ACM International Conference On Computer Aided Design (ICCAD)},
  pages         = {1--9},
  doi           = {10.1109/iccad66269.2025.11241007},
  issn          = {1558-2434},
  abstract      = {RISC-V provides a flexible and scalable platform for applications ranging from embedded devices to high-performance computing clusters. Particularly, its RISC-V Vector Extension (RVV) becomes of interest for the acceleration of AI workloads. But writing software that efficiently utilizes the vector units of RISC-V CPUs without expert knowledge requires the programmer to rely on the autovectorization features of compilers or hand-crafted libraries like muRISCV-NN. Smarter approaches, like autotuning frameworks, have been missing the integration with the RISC-V RVV extension, thus heavily limiting the efficient deployment of complex AI workloads. In this paper, we present a workflow based on the TVM compiler to efficiently map AI workloads onto RISC-V vector units. Instead of relying on hand-crafted libraries, we integrated the RVV extension into TVM's MetaSchedule framework, a probabilistic program framework for tensor operation tuning. We implemented different RISC-V SoCs on an FPGA and tuned a wide range of AI workloads on them. We found that our proposal shows a mean improvement of 46\% in execution latency when compared against the autovectorization feature of GCC, and 29\% against muRISCV-NN. Moreover, the binary resulting from our proposal has a smaller code memory footprint, making it more suitable for embedded devices. Finally, we also evaluated our solution on a commercially available RISC-V SoC implementing the RVV 1.0 Vector Extension and found our solution is able to find mappings that are 35\% faster on average than the ones proposed by LLVM. We open-sourced our proposal for the community to expand it to target other RISC-V extensions.},
  keywords      = {Tensors;Codes;Probabilistic logic;Vectors;Libraries;Proposals;Vector processors;Artificial intelligence;Tuning;Field programmable gate arrays;RISC-V;RVV;TVM;Vector processors}
}
@inproceedings{11242073,
  title         = {Characterizing Adaptive Mesh Refinement on Heterogeneous Platforms with Parthenon-VIBE},
  author        = {Poptani, Akash and Khadem, Alireza and Mahlke, Scott and Miller, Jonah and Dolence, Joshua and Shipman, Galen and Das, Reetuparna},
  year          = 2025,
  month         = {Oct},
  booktitle     = {2025 IEEE International Symposium on Workload Characterization (IISWC)},
  pages         = {439--451},
  doi           = {10.1109/iiswc66894.2025.00043},
  issn          = {2835-2238},
  abstract      = {Hero-class HPC simulations rely on Adaptive Mesh Refinement (AMR) to reduce compute and memory demands while maintaining accuracy. This work analyzes the performance of Parthenon, a block-structured AMR benchmark, on CPU-GPU systems. We show that smaller mesh blocks and deeper AMR levels degrade GPU performance due to increased communication, serial overheads, and inefficient GPU utilization. Through detailed profiling, we identify inefficiencies, low occupancy, and memory access bottlenecks. We further analyze rank scalability and memory constraints, and propose optimizations to improve GPU throughput and reduce memory footprint. Our insights can inform future AMR deployments on Department of Energy's upcoming heterogeneous supercomputers.},
  keywords      = {Adaptation models;Microarchitecture;Computational modeling;Scalability;Memory management;Graphics processing units;Throughput;Adaptive mesh refinement;Software;Optimization;Adaptive Mesh Refinement (AMR);High Performance Computing (HPC);Performance Characterization;Exascale Computing;Microarchitectural Analysis;Parthenon;Kokkos}
}
@inproceedings{11249764,
  title         = {Comparing Performance of Variational Quantum Algorithm Simulations on HPC Systems},
  author        = {de Pascale, Marco and Bauer, Tobias Valentin and Gambo, Yaknan John and Hern\'{a}ndez Vera, Mario and Huber, Stefan and Mete, Burak and Jamadagni, Amit and Bentellis, Amine and Oliv, Marita and Iapichino, Luigi and Lorenz, Jeanette Miriam},
  year          = 2025,
  month         = {Aug},
  booktitle     = {2025 IEEE International Conference on Quantum Computing and Engineering (QCE)},
  volume        = {02},
  pages         = {21--27},
  doi           = {10.1109/qce65121.2025.10287},
  abstract      = {Variational quantum algorithms are of special importance in the research on quantum computing applications because of their applicability to current Noisy Intermediate-Scale Quantum (NISQ) devices. The main building blocks of these algorithms define a relatively large parameter space, making the comparison of results and performance between different approaches and software simulators cumbersome and prone to errors. In this paper, we employ a generic description of the problem, in terms of both Hamiltonian and ansatz, to consistently port a problem definition across different simulators. A use case relevant to current quantum hardware has been run on a set of HPC systems and software simulators to study the dependence of performance on the runtime environment, the scalability of the simulation codes, and the agreement between the physical results, respectively. The results show that our toolchain can successfully translate a problem definition between different simulators. On the other hand, variational algorithms are limited in their scaling by the long runtimes with respect to their memory footprint, so they expose limited parallelism to computation. This shortcoming is partially mitigated by using techniques like job arrays. The potential of the parser tool within the toolchain for exploring HPC performance and comparisons of results of variational algorithm simulations is highlighted.},
  keywords      = {Performance evaluation;Runtime environment;Quantum algorithm;Scalability;Software algorithms;Parallel processing;Software;Hardware;Noise measurement;Optimization;HPC simulations;Performance evaluation;Benchmarking;Variational Quantum Algorithms;Applications: chemistry;optimization}
}
@article{11251094,
  title         = {Steep Subthreshold Slope Transistors for Low-Power Electronics: Evolution, Challenges, and Perspectives},
  author        = {Jia, Rundong and Wu, Chunlei and Liu, Fei and Huang, Qianqian},
  year          = 2025,
  month         = {Sep.},
  journal       = {IEEE Electron Devices Magazine},
  volume        = 3,
  number        = 3,
  pages         = {13--24},
  doi           = {10.1109/med.2025.3599876},
  issn          = {2832-7691},
  abstract      = {In the past few decades, the development of ICs has followed Moore's law, and chip performance has been continuously improved based on device scaling and increased integration. However, as the device size approaches the physical limit, power tends to reach an unacceptable limit and becomes a bottleneck, limiting the clock speed of a single chip. Moreover, in recent years, with the booming development of artificial intelligence (AI) and high-performance computing (HPC) in this big data era, increasingly higher performance is required for chips. Advanced technologies, such as 3D stacking and chiplets, have been used to continuously improve chip performance, while simultaneously the power consumption of AI/HPC systems is continuously growing and has become a first-class design constraint. Various low-power techniques have been explored in the past 20 years. New energy-efficient architectures, such as near-memory computing, computing in memory, and neuromorphic computing, are being widely investigated. Power dissipation at the circuit level can be minimized by power management technologies, such as the use of multivoltage domains, multithreshold voltages, dynamic voltages, and frequency scaling. Beyond upper-level circuit and system strategies, transistor-level design serves as a foundational research method to address power consumption challenges, and reducing the supply voltage (VDD) is one of the most effective and direct ways. From the transistor perspective, VDD is essentially determined by the voltage needed for the transition from the off state to the on state with a satisfactory on/off current ratio. A steep subthreshold slope (SS) transistor is indispensable to make a sharper transition. This article focuses on emerging transistors with a steep SS of below 60 mV/dec at room temperature that can break the fundamental physical limitations of traditional MOSFETs. They include tunneling FETs (TFETs), negative-capacitance FETs (NCFETs), and cold-source FETs (CSFETs). Their theoretical mechanisms and electronic characteristics are reviewed as well as the state of the art and future development trends. These steep-slope transistors can be further integrated with circuit- and architecture-level low-power technologies, contributing to the green and sustainable development of chips.},
  keywords      = {Performance evaluation;Power demand;Three-dimensional displays;Temperature;TFETs;Stacking;Tunneling;Voltage control;Artificial intelligence;Sustainable development}
}
@article{11251100,
  title         = {Advancing Sustainable Semiconductor Innovations Through Simulation, Modeling, and Mentorship: Toward Energy-Efficient and Inclusive Semiconductor Futures},
  author        = {Pahwa, Girish and Pandey, Nilesh},
  year          = 2025,
  month         = {Sep.},
  journal       = {IEEE Electron Devices Magazine},
  volume        = 3,
  number        = 3,
  pages         = {6--12},
  doi           = {10.1109/med.2025.3608793},
  issn          = {2832-7691},
  abstract      = {The rapid growth in high-performance computing and artificial intelligence (AI)-driven applications has intensified concerns about the environmental sustainability of semiconductor technologies. This article explores the critical impact of simulation and device modeling in enabling sustainable semiconductor innovations. It highlights how these tools facilitate design technology co-optimization (DTCO), reduce environmental impact, and drive energy-efficient integrated circuit (IC) design. Beyond technical solutions, the article emphasizes the importance of mentorship, diversity, and global collaboration in creating a sustainable and inclusive semiconductor ecosystem. By aligning with the United Nations Sustainable Development Goals (SDGs), the semiconductor industry can continue to innovate responsibly, balancing technology with planetary and societal well-being.},
  keywords      = {Performance evaluation;Industries;Technological innovation;High performance computing;Collaboration;Transforms;Human factors;Energy efficiency;Sustainable development;Integrated circuit modeling}
}
@inproceedings{11252030,
  title         = {An Improved Quasi-Z-Source Converter Topology With High Boosting Facility},
  author        = {Halder, Tapas},
  year          = 2025,
  month         = {Aug},
  booktitle     = {2025 IEEE 6th India Council International Subsections Conference (INDISCON)},
  pages         = {1--6},
  doi           = {10.1109/indiscon66021.2025.11252030},
  abstract      = {In this paper, immature Quasi-Z-Source Boost converter topology has been matured to construct improved converter topology for high boosting facility in the area of fast charging station and solar energy harvesting. Suitability of the proposed system has been furthermore enriched by sustainable designing and high performance computing of across service matrices for modeling and simulation under spike of the green power processing system with optimized design for substantial performance parameter evaluation at a platform of converter topology fabrication as objective of the paper},
  keywords      = {Fabrication;Costs;High performance computing;Green products;Solar energy;Boosting;Electric vehicles;Topology;Fast charging;Matrix converters;Improved Quasi-Z-Source Boost Converter;High Boost ratio;High Performance computing \& Designing}
}
@inproceedings{11253943,
  title         = {Comprehensive Benchmarking of Parallel Programming Models: A Multi-Dimensional Performance Analysis},
  author        = {Mishra, Anindya and Priya, Aditi and George, Anju Susan and Niranjana, S and Bhuvan, Nikhila T and Sherry, Roshan},
  year          = 2025,
  month         = {Sep.},
  booktitle     = {2025 3rd International Conference on Intelligent Cyber Physical Systems and Internet of Things (ICoICI)},
  pages         = {1904--1910},
  doi           = {10.1109/ICoICI65217.2025.11253943},
  abstract      = {Parallel programming is an important part of High-Performance Computing (HPC). It helps run large scientific simulations, artificial intelligence (AI) tasks, and big data applications efficiently. It makes computing faster and uses less energy, which supports sustainable development. It also speeds up the training of AI models by running many tasks at the same time on multiple processors. In the Internet of Things (IoT), parallel programming is useful for analyzing large data and managing complex systems like smart cities. This paper studies the performance of ten parallel programming models. These are OpenMP, MPI, CUDA, OpenCL, Pthreads, TBB, Charm++, HPX, Kokkos, and SYCL. The study looks at execution time, scalability, memory use, and energy use with benchmark applications. The results show that MPI works best for distributed workloads. CUDA is best for GPU-based tasks. OpenMP and TBB are simple and effective for shared memory systems. The study gives helpful insights for researchers and practitioners to select the right model. It also shows that hybrid models, with asynchronous execution and AI-based workload management, can improve performance, scalability, and energy efficiency in the future.},
  keywords      = {Training;Parallel programming;Biological system modeling;Computational modeling;Scalability;Graphics processing units;Benchmark testing;Internet of Things;Artificial intelligence;Sustainable development;Parallel Programming;High – Performance Computing;Scalability;Sustainable Development;Hybrid Paradigms;Economic Growth}
}
@inproceedings{11257289,
  title         = {An Open and Modular Avionics Enterprise Architecture: Facilitating Integration, Adaptability, and Sustainability with Emerging Technologies},
  author        = {Darwesh, Darbaz Nawzad and Roca, Johannes Kuhnert},
  year          = 2025,
  month         = {Sep.},
  booktitle     = {2025 AIAA DATC/IEEE 44th Digital Avionics Systems Conference (DASC)},
  pages         = {1--9},
  doi           = {10.1109/dasc66011.2025.11257289},
  issn          = {2155-7209},
  abstract      = {This paper proposes an open and modular enterprise architecture concept to fulfill today's technological and economic objectives demanded by customers and enforced by the global ecosystem. Currently, various standards, guidelines, and new technologies are used to develop complex systems. In this era of rapid technological progress, developers have access to powerful tools like artificial intelligence, high-performance computing hardware, and new development platforms. However, the industry has not yet fully adopted these technologies, partly due to interoperability problems and the absence of a standardized development framework guided by a suitable enterprise architecture (EA). Such a framework would prevent vendor lock-in and facilitate faster, more complex scenario management. In this paper, we aim to discuss how to quickly maximize the ability to leverage new technologies. We propose a generic, open, and modular enterprise architecture focused on developing avionics systems. Why ``Open''? `Open' is defined as the commitment to using open standards and global architecture goals throughout the product life cycle. Why ``Modular''? The design of complex systems should be more decentralized and modular to enable incremental upgrades, classification, and configuration. Based on the proposed concept of enterprise architectures, a use case is presented, which can be used as a modern and efficient development process for avionics system development.},
  keywords      = {Industries;Standards organizations;Computer architecture;Aerospace electronics;Regulation;Complex systems;Artificial intelligence;Sustainable development;Certification;Interoperability;Modular Design;Open Standards;Enterprise Architect;Artificial Intelligence;Avionics;Certification (keywords)}
}
@article{11261880,
  title         = {A Planar Transformer Integration Design with 2D Scalability for Vertical Power Delivery to HPC Processors},
  author        = {Wen, Zhaoliang and Xu, Dianguo},
  year          = 2025,
  journal       = {IEEE Transactions on Power Electronics},
  pages         = {1--11},
  doi           = {10.1109/tpel.2025.3635289},
  issn          = {1941-0107},
  abstract      = {Driven by AI training, the power consumption and current required by HPC processors are increasing. This is causing changes in the power supply architecture and current delivery structure of HPC processors. The existing LLC DCX design based on LPD structure has only one-dimensional scalability and has not considered integrating the output terminals into the transformer, which will be detrimental to its application in the future VPD. In this paper, a planar transformer integration design with 2-dimensional scalability for vertical power delivery to HPC processors is proposed. A VPD structure is firstly introduced to explain the necessity of the proposed matrix transformer integration design approach. Then, it is demonstrated how to integrate the output terminals into the transformer and realize the two-dimensional seamless expansion of the transformer, which facilitates its application in the VPD structure and is compatible with the LPD design. A transformer design example and its footprint and loss optimization are also conducted. Finally, an 810W prototype was built and tested, achieving a peak efficiency of 94.4\% and a transformer power density of 1660W/in3, which has a higher power density compared with the existing state-of-art DCX designs.},
  keywords      = {Transformers;Windings;Program processors;Rectifiers;Power supplies;Computer architecture;Power system measurements;Density measurement;Voltage control;Scalability;Vertical power delivery (VPD);planar transformer;integration design;LLC DCX;two-dimensional scalability}
}
@inproceedings{11263030,
  title         = {First Demonstration of MRM on Low-Loss SiN-SOI Platform for High-Density and Low-Power Optical Interconnection},
  author        = {Wang, Xu and Zheng, Wen and Hu, Changran and Xia, Yuan and Tang, Fangyi and Zhou, Lingbo and Xu, Chengwen and Ji, Ruiqiang},
