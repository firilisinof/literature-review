  abstract      = {This study scrutinizes the interplay within the AI, knowledge management, leadership and innovation, emphasizing the collaborative impact on the organizational performance. AI is essential within knowledge management., involving its contributions in improving innovation is important. Leadership involves the contribution in enabling the adaptation of technology and investing the innovation culture. The journals of 2019 to 2024 that have been retrieved from Emarald, Academia and Scopus, the research emphasizes the opportunities, appropriate practices and challenges in adopting AI-driven frameworks of knowledge management. The findings aim to derive the actionable insights by implementing strategies within the organizations for improving organizational learning, driving innovation and optimizing decisions.},
  keywords      = {Technological innovation;Leadership;Technology acceptance model;Catalysts;Decision making;Collaboration;Organizations;Knowledge discovery;Knowledge management;Artificial intelligence;Knowledge Management (KM);Innovation;Artificial Intelligence;Leadership}
}
@inproceedings{11005038,
  title         = {High Performance Computing Models in Electric Vehicles Using Artificial Intelligence},
  author        = {Subrahmanyam, Chitirala and Srilakshmi, P and Divakar, R and L, Balaji and Kaliappan, S and K, Vinoth Kumar},
  year          = 2025,
  month         = {April},
  booktitle     = {2025 International Conference on Inventive Computation Technologies (ICICT)},
  pages         = {1513--1516},
  doi           = {10.1109/icict64420.2025.11005038},
  issn          = {2767-7788},
  abstract      = {As initiatives to save energy and cut down on emissions progress, the consistent electric vehicle charging with solar charging stations for these vehicles have gained greater significance. This research develops an optimization framework for the station's operation by considering the interplay between the electricity and carbon markets through game theory. Within this framework, the higher level signifies the charging station manager, who seeks to enhance the overall electricity and carbon profits while reducing variations in charging. In contrast, the lower level depicts the electric vehicle drivers, who strive to optimize their consumer surplus. Ultimately, a nested mixed integer linear programming genetic algorithm utilized toward resolve the optimization framework and simulation results confirm the effectiveness and advantages of this model.},
  keywords      = {Photovoltaic systems;Computational modeling;Electricity;Simulation;Charging stations;Predictive models;Sampling methods;Carbon;Optimization;Standards;Carbon trading;Electric vehicles;Photovoltaic storage charging station}
}
@inproceedings{11005142,
  title         = {Nature-Inspired Adaptive Evolutionary Swarm Optimization for Energy-Efficient Computational Mathematics in High-Performance Computing Systems},
  author        = {Somanna, Nayakallu and Krishna, V. Rama and Basha, P. Hussain and Shareef, Sk. Khaja and Vasudha, Nannaparaju and Bhavsingh, M},
  year          = 2025,
  month         = {April},
  booktitle     = {2025 International Conference on Inventive Computation Technologies (ICICT)},
  pages         = {442--449},
  doi           = {10.1109/icict64420.2025.11005142},
  issn          = {2767-7788},
  abstract      = {High-Performance Computing (HPC) systems play a critical role in enabling complex simulations, large-scale data analysis, and scientific research. However, the significant energy demands of these systems raise concerns around operational sustainability and long-term cost-efficiency. Existing natureinspired algorithms--such as Genetic Algorithms (GA), Particle Swarm Optimization (PSO), and Ant Colony Optimization (ACO)-have shown promise in task scheduling but often fall short due to issues like high computational overhead, premature convergence, and limited responsiveness to real-time energy dynamics. In response to these limitations, this study presents the Adaptive Evolutionary Swarm Optimization (AESO) algorithm, which integrates adaptive mutation control with swarm-based task clustering to improve energy-aware scheduling in HPC environments. Unlike conventional methods, AESO dynamically adjusts its behavior based on current workload and energy trends, aiming to strike a balance between energy consumption, execution speed, and computational accuracy. Evaluation using the Google Cloud Workload dataset indicates that AESO reduces execution time by 16.9\% (118s vs. 142s in GA) and energy consumption by 31.4\% (1680 J vs. 2450 J in GA), while achieving a scheduling efficiency of 94\% and maintaining a high accuracy of 99.85\%. These outcomes suggest that the pursuit of energy efficiency need not come at the cost of performance. Looking ahead, future work will explore integrating AI-driven predictive models and reinforcement learning to further enhance AESO's adaptability within evolving, cloud-based, and distributed HPC systems.},
  keywords      = {Energy consumption;Processor scheduling;Heuristic algorithms;High performance computing;Dynamic scheduling;Scheduling;Energy efficiency;Computational efficiency;Particle swarm optimization;Genetic algorithms;High-Performance Computing (HPC);EnergyEfficient Scheduling;Adaptive Evolutionary Swarm Optimization (AESO);Task Allocation and Workload Distribution;NatureInspired Algorithms (GA, PSO, ACO);Computational Efficiency and Sustainability}
}
