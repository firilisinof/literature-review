}
@conference{Hofer2024,
  title         = {Systematic Design Of Adaptive Connectors Based On Shape Memory Alloys For Electrical Vehicles},
  author        = {Hofer, Andreas and Pagel, Kenny and Langbein, Sven and Lembke, Dietrich and Lehmann, Dirk and Drossel, Welf-Guntram},
  year          = 2024,
  journal       = {Proceedings of ASME 2024 Conference on Smart Materials, Adaptive Structures and Intelligent Systems, SMASIS2024},
  doi           = {10.1115/smasis2024-140040},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85209178413&doi=10.1115%2FSMASIS2024-140040&partnerID=40&md5=a21a21ae756fc00de68515cd076c6c04},
  note          = {Cited by: 0},
  abstract      = {Fast charging of electric vehicles (EVs) plays a critical role in the adoption of EVs and thereby in the transition from fossil fuels to renewable energy sources in the transportation sector. However, there are significant limitations to the maximum electrical power that can be transferred during the charging process. One of the biggest challenges is the high electrical contact resistance (ECR) between the charging plug and the vehicle inlet, which leads to significant waste heat generation and associated energy loss. These factors not only affect the efficiency of the charging process, but also carry the risk of damage to the connector system and the EV. In response to these challenges, this paper proposes a novel approach for an adaptive connector based on thermal shape memory alloys (SMAs). The proposed adaptive connector is designed to increase contact forces only during the charging process, effectively mitigating ECR while ensuring compatibility with existing charging infrastructure. As a result, this technology promises to unlock higher transmission power capabilities and significantly reduce charging times. An integral aspect of this proposed solution is the inherent ability of SMA-based connectors to self-activate in response to the initial high ECR, generating joule heating that triggers the SMA actuator. This eliminates the need for additional power or active actuator control, allowing for a streamlined and energy efficient charging process. This paper outlines a systematic design framework for the implementation of adaptive connectors, including comprehensive integration of SMA actuators and meticulous optimization strategies tailored to ensure efficient and reliable fast charging of EVs. Evaluation and validation of the system's effectiveness is underway through trials using combined charging systems (CCS) Type 2 connectors tailored for High Power Charging (HPC) applications, which can accommodate charging powers of up to 500kW. Through these concerted efforts, this research aims to drive the evolution of fast charging technology, catalyzing the widespread adoption of electric vehicles and accelerating the transition to sustainable transportation solutions. Copyright \textcopyright{} 2024 by The United States Government.},
  author_keywords = {CCS2; electrical vehicles; power connector; selfsufficient; shape-memory-alloy},
  keywords      = {Associative storage; Charge storage; Lignite; Magnetic levitation vehicles; Oil fields; Oil sands; Petroleum reservoirs; Sailing vessels; Silver alloys; Solar power generation; Waste heat utilization; Charging process; Electrical contact resistance; Electrical vehicles; Fast charging; Memory alloy; Power connectors; Selfsufficient; Shape memory alloy actuators; Shape-memory; Systematic designs; Fast charging (Batteries)},
  type          = {Conference paper},
  publication_stage = {Final},
  source        = {Scopus}
}
