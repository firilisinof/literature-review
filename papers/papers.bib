  title         = {Application of High-Performance Computing for Modeling the Hydrobiological Processes in Shallow Water},
  author        = {Sukhinov, Alexander I. and Chistyakov, Alexander E. and Nikitina, Alla V. and Filina, Alena A. and Belova, Yulia V.},
