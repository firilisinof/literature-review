  author        = {Prasad, D.V.S.S.S.V. and Singh, Akhilesh Kumar and Marxim, Rahula Bharathi. B. and Rao, Yarrapragada K.S.S. and Kamesh, V.V.},
  year          = 2025,
  journal       = {Digital Manufacturing: Processes and Applications},
  pages         = {597--626},
  doi           = {10.1002/9781394365371.ch21},
