@article{He2024331,
  title         = {Multi-dimensional adaptive access contol for high-performance computing environment; [面向高性能计算环境的多维自适应授权访问策略]},
  author        = {He, Rong and Wang, Xiaoning and Xiao, Haili and Lu, Shasha and Zhao, Yining and Chi, Xuebin},
  year          = 2024,
