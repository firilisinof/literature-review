  journal       = {Izvestiya of Saratov University. Mathematics. Mechanics. Informatics},
  volume        = 24,
  number        = 2,
  pages         = {298--315},
  doi           = {10.18500/1816-9791-2024-24-2-298-315},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85195300041&doi=10.18500%2F1816-9791-2024-24-2-298-315&partnerID=40&md5=888f342158d84270b907c38ba742ffc3},
  note          = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access},
  abstract      = {In many countries of the world, there is a deterioration in the geoecological state of water bodies, associated with a significantly increased anthropogenic impact on natural waters. At the same time, the guaranteed quality of water resources and its reliability are ensured by comparing the realized quality and the guaranteed one. This article discusses models for the entry and movement of pollutants contained in the aquatic environment. Based on the currently used approaches and water pollution criteria, a set of parallel programs for high-performance computing systems has been developed, which allows modeling of the processes under consideration, as well as assessing risks and vulnerabilities in relation to anthropogenic impacts, zoning the water area of a shallow water body in accordance with the levels of anthropogenic loads, environmental design from the standpoint of sustainable development. \textcopyright{} \cyrchar\CYRS{}\cyrchar\cyru{}\cyrchar\cyrh{}\cyrchar\cyri{}\cyrchar\cyrn{}\cyrchar\cyro{}\cyrchar\cyrv{} \cyrchar\CYRA{}. \cyrchar\CYRI{}., \cyrchar\CYRCH{}\cyrchar\cyri{}\cyrchar\cyrs{}\cyrchar\cyrt{}\cyrchar\cyrya{}\cyrchar\cyrk{}\cyrchar\cyro{}\cyrchar\cyrv{} \cyrchar\CYRA{}. \cyrchar\CYRE{}., \cyrchar\CYRS{}\cyrchar\cyri{}\cyrchar\cyrd{}\cyrchar\cyro{}\cyrchar\cyrr{}\cyrchar\cyrya{}\cyrchar\cyrk{}\cyrchar\cyri{}\cyrchar\cyrn{}\cyrchar\cyra{} \cyrchar\CYRV{}. \cyrchar\CYRV{}., \cyrchar\CYRK{}\cyrchar\cyru{}\cyrchar\cyrz{}\cyrchar\cyrn{}\cyrchar\cyre{}\cyrchar\cyrc{}\cyrchar\cyro{}\cyrchar\cyrv{}\cyrchar\cyra{} \cyrchar\CYRI{}. \cyrchar\CYRYU{}., \cyrchar\CYRA{}\cyrchar\cyrt{}\cyrchar\cyra{}\cyrchar\cyrya{}\cyrchar\cyrn{} \cyrchar\CYRA{}. \cyrchar\CYRM{}., 2024.},
  author_keywords = {explicit-implicit scheme; hydrodynamics model; parallel algorithms; pollutant transport; suspension-diffusion-convection models},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Sukys2018159,
  title         = {SPUX: Scalable Particle Markov Chain Monte Carlo for Uncertainty Quantification in Stochastic Ecological Models},
  author        = {\v{S}ukys, Jonas and Kattwinkel, Mira},
  year          = 2018,
  journal       = {Advances in Parallel Computing},
  volume        = 32,
  pages         = {159--168},
  doi           = {10.3233/978-1-61499-843-3-159},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85043576869&doi=10.3233%2F978-1-61499-843-3-159&partnerID=40&md5=c86fa29c91dec392ae1286d56f9a929e},
  note          = {Cited by: 5},
  abstract      = {Calibration of individual based models (IBMs), successful in modeling complex ecological dynamical systems, is often performed only ad-hoc. Bayesian inference can be used for both parameter estimation and uncertainty quantification, but its successful application to realistic scenarios has been hindered by the complex stochastic nature of IBMs. Computationally expensive techniques such as Particle Filter (PF) provide marginal likelihood estimates, where multiple model simulations (particles) are required to get a sample from the state distribution conditional on the observed data. Particle ensembles are re-sampled at each data observation time, requiring particle destruction and replication, which lead to an increase in algorithmic complexity. We present SPUX, a Python implementation of parallel Particle Markov Chain Monte Carlo (PMCMC) algorithm, which mitigates high computational costs by distributing particles over multiple computational units. Adaptive load re-balancing techniques are used to mitigate computational work imbalances introduced by re-sampling. Framework performance is investigated and significant speed-ups are observed for a simple predator-prey IBM model. \textcopyright{} 2018 The authors and IOS Press.},
  author_keywords = {Bayesian inference; high performance computing; Individual Based Model; load balancing; Markov Chain Monte Carlo; MPI; Particle Filter; Python},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@book{Sullivan2021439,
  title         = {LINCOLN-lean innovative connected vessels},
  author        = {Sullivan, Brendan P. and Rossi, Monica and Terzi, Sergio},
  year          = 2021,
  journal       = {A Holistic Approach to Ship Design},
  volume        = 2,
  pages         = {439--467},
