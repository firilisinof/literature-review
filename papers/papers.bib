@article{Porto2026,
  title         = {Assuming the best: Towards a reliable protocol for resource usage prediction for high-performance computing based on machine learning},
  author        = {Porto, Alexandre H.L. and Coelho, Micaella and Rocha, Hiago M.G.A. and Osthoff, Carla and Oca\~{n}a, Kary and Cardoso, Douglas O.},
  year          = 2026,
  journal       = {Future Generation Computer Systems},
  volume        = 175,
  doi           = {10.1016/j.future.2025.108070},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105013587334&doi=10.1016%2Fj.future.2025.108070&partnerID=40&md5=2580cc978f396820e19ee936d1e8115e},
  note          = {Cited by: 1; All Open Access; Hybrid Gold Open Access},
  abstract      = {In High-Performance Computing (HPC) systems, multiple processes simultaneously consume resources such as CPU time, memory, and electrical power, among others. Accurately predicting the resource consumption of a process based on its execution parameters enables more efficient resource allocation, ultimately improving the overall performance of the HPC system. While many studies have explored this topic, fewer explicitly examine the underlying assumptions of their approaches. This work contributes to filling that gap by proposing, experimenting with, and discussing a protocol to approach this problem, covering from the collection of processes footprint data to the experimental evaluation of Machine Learning models based on such data. The reported results of the assessment of this protocol in a case study of the RAxML bioinformatics application on a real supercomputer highlight not only its effectiveness (R<sup>2</sup> values greater than 0.9 were achieved in most tests) but also the reasonableness of the assumptions considered. \textcopyright{} 2025 The Author(s)},
  author_keywords = {Bioinformatics; Decision trees; Ensemble methods; High-performance computing; Machine learning; Resource management},
  keywords      = {Computing power; Learning systems; Machine learning; Natural resources management; Resource allocation; Supercomputers; CPU time; Ensemble methods; High performance computing systems; High-performance computing; Machine-learning; Multiple process; On-machines; Performance computing; Resource management; Resource usage prediction; Bioinformatics},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@conference{Poughon1997879,
  title         = {Preliminary study and simulation of the MELiSSA loop including a higher plants compartment},
  author        = {Poughon, L. and Dussap, C.G. and Gros, J.B.},
  year          = 1997,
  journal       = {European Space Agency, (Special Publication) ESA SP},
  number        = {400 Part 2},
  pages         = {879--883},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-5544246330&partnerID=40&md5=88492fc2f5cf91c1090ab2513fa94f17},
  note          = {Cited by: 9},
  abstract      = {MELiSSA (Microbial Ecological Life Support System Alternative) is a micro-organisms based ecosystem conceived as a tool for understanding the behavior of artificial ecosystems and developping the technology for a future Biological Life Support System for long term manned space missions. MELiSSA is composed of four microbial compartments and a last formed by the crew. In order to improve and vary the diet a fifth compartment, a Higher Plants Chamber (HPC), working in parallel with the Spirulina compartment was included as a subset of the MELiSSA loop. This paper reports the mass-balance description of the system and the steady-state simulations of the complete Biological Life Support System, performed in order to satisfy the basic habitability constraints. The recycling efficiencies of the system are determined for various working conditions of the MELiSSA loop and different degrees of link between the MELiSSA loop both with and without a HPC. The MELiSSA loop and the MELiSSA+HPC loop are compared. The second option does not appear better than the first on the basis of total resupply mass. With a HPC, the non-edible part of the plants wasted out of the loop must be compensated by an entry of CO<sub>2</sub>, and the system provides much more oxygen than required. To close the system (reduce the entries) the plants waste must be treated. A physicochemical oxidiser was then added to the MELiSSA+HPC based BLSS. An optimal value of 80\% of the waste to oxidise is found.},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Prakash2021133,
  title         = {Analytical Design of the DIS Architecture: The Hybrid Model},
  author        = {Prakash, B.R. and Hanumanthappa, M. and Dattasmita, H.V. and Kavitha, Vasantha},
  year          = 2021,
  journal       = {Advances in Intelligent Systems and Computing},
  volume        = 1187,
  pages         = {133--143},
  doi           = {10.1007/978-981-15-6014-9_16},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85092647619&doi=10.1007%2F978-981-15-6014-9_16&partnerID=40&md5=8e123d37c50f6fdfdce7649db371888f},
  note          = {Cited by: 0},
  abstract      = {In the last few decades, and due to emergence of internet appliance, there is a strategical increase in the usage of data which had a high impact on the storage and mining technologies. It is also observed that the scientific/research field produces the zig-zag structure of data, viz., structured, semi-structured, and unstructured data. Comparably, processing of such data is relatively increased due to rugged requirements. There are sustainable technologies to address the challenges and to expedite scalable services via effective physical infrastructure (in terms of mining), smart networking solutions, and useful software approaches. Indeed, the cloud computing aims at data-intensive computing, by facilitating scalable processing of huge data. But still, the problem remains unaddressed with reference to huge data, and conversely, the data is growing exponentially faster. At this juncture, the recommendable algorithm is a well-known model, that is, MapReduce, to compress the huge and voluminous data. Conceptualization of any problem with the current model is less fault-tolerant and reliable, which may be surmounted by Hadoop architecture. On the contrary case, Hadoop is fault-tolerant and has the high throughput which is recommendable for applications having huge volume of data sets, thus file system requiring the streaming access. The paper examines and unravels what efficient architectural/design changes are necessary to bring the benefits of the Everest model, HBase algorithm, and the existing MR algorithms. \textcopyright{} 2021, Springer Nature Singapore Pte Ltd.},
  author_keywords = {ADT; Cap3; Cloud computing; Google MapReduce; Hadoop; HBase; HDFS; HPC; HPQL; MapReduce},
  keywords      = {Digital storage; Fault tolerance; Analytical design; Data-intensive computing; Internet appliances; Mining technology; Software approach; Sustainable technology; Unstructured data; Zig-zag structures; Data handling},
  type          = {Conference paper},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Pramanik2019259,
  title         = {Green and sustainable high-performance computing with smartphone crowd computing: Benefits, enablers, and challenges},
  author        = {Pramanik, Pijush Kanti Dutta and Pal, Saurabh and Choudhury, Prasenjit},
  year          = 2019,
  journal       = {Scalable Computing},
  volume        = 20,
  number        = 2,
  pages         = {259--284},
  doi           = {10.12694/scpe.v20i2.1517},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85065468284&doi=10.12694%2Fscpe.v20i2.1517&partnerID=40&md5=1fc60bdce447b93eff00d022c6e75e6c},
  note          = {Cited by: 31; All Open Access; Gold Open Access},
  abstract      = {The introduction of the Internet of Things (IoT) and Big Data applications have garnered a massive amount of digital data. Processing and analysing these data demand vast computing resources, proportionately. The major downside of producing and using computing resources in such volumes is the deterioration of the Earth's environment. The production process of the electronic devices involves hazardous and toxic substances which not only harm human and other living beings health but also contaminate the water and soil. The production and operations of these computers in largescale also results in massive energy consumption and greenhouse gas generation. Moreover, the low use cycle of these devices produces a huge amount of not-easy-todecompose e-waste. In this outlook, instead of buying new devices, it is advisable to use the existing resources to their fullest, which will minimize the environmental penalties of production and e-waste. This paper advocates for using smartphones and smartphone crowd computing (SCC) to ease off the use of PCs/laptops and centralized high-performance computers (HPCs) such as data centres and supercomputers. The paper aims to establish SCC as the most feasible computing system solution for sustainable computing. Detailed comparisons, in terms of environmental effects (e.g., energy consumption, greenhouse gas generation, etc.), between SCC and supercomputers and other green computing initiatives such as Grid and Cloud Computing, are presented. The key enablers of SCC are identified and discussed. One of them is today's computationally powerful smartphones. A comprehensive statistical survey of the various commercial CPUs, GPUs, SoCs for smartphones is presented confirming the capability of the SCC as an alternative to HPC. The challenges involved in realizing SCC are also considered. One of the major challenges is handling the issue of limited battery in smartphones. The reasons for battery drain are recognized with probable measures. An exhaustive survey is presented on the present and optimistic future of the continuous improvement and research on different aspects of smartphone battery and other alternative power sources which will allow users to use their smartphones for SCC without worrying about the battery running out. \textcopyright{} 2019 SCPE.},
  author_keywords = {Alternative power source; Battery research; Cloud computing; Data centre; Energy efficiency; Future battery; Green computing; Grid computing; HPC; Mobile computing; Non-conventional energy; Smartphone battery; Smartphone computing; Sustainable computing; Wireless charging},
  keywords      = {Cloud computing; Data handling; Deterioration; Electronic Waste; Energy efficiency; Energy utilization; Gas generators; Greenhouse gases; Grid computing; Internet of things; Mobile computing; Program processors; Secondary batteries; Smartphones; Supercomputers; Surveys; Sustainable development; Wastes; Alternative power; Data centres; Future battery; Non-conventional energy; Sustainable computing; Wireless charging; Green computing},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
