  author        = {Perry, Rebecca and Elek, Elvira and D'Amico, Elizabeth and Dickerson, Daniel and Komro, Kelli and Walton, Maureen and Razuri, Erin Becker and Yule, Amy M. and Skinner, Juli and Pendergrass, Tyra and Larkin, Kaitlyn and Johnson, Carrie and Bonar, Erin E. and Oudekerk, Barbara A. and Hairgrove, Sara and Liu, Shirley and Graham, Phillip},
  year          = 2023,
  journal       = {Prevention Science},
  volume        = 24,
  pages         = {61--76},
