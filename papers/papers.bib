  author        = {Yang, Hui and Kuang, Xiaofei and Mi, Ying-Hao and Wang, Ming-Ming and Zhao, Yuqing and Lin, Fulin and Lu, Can-Zhong},
  year          = 2024,
  journal       = {New Journal of Chemistry},
  volume        = 48,
  number        = 23,
  pages         = {10646--10652},
  doi           = {10.1039/d4nj01779j},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85194424772&doi=10.1039%2Fd4nj01779j&partnerID=40&md5=16fba89ad316e9b698fb3eb732c3eafc},
  note          = {Cited by: 4},
  abstract      = {Inorganic-organic hybrid semiconductors based on copper(i) halide are intriguing luminescent materials possessing great prospects as rare-earth elements (REEs) free phosphors for use in solid-state lighting (SSL). However, it is still a great challenge to develop such hybrid semiconducting materials with high energy blue light emission and good thermal stability simultaneously. Here, we have synthesized a brand new, one-dimensional (1D) organic-inorganic semiconductor CuI-Pytz (Pytz = 4-(pyrid-2-yl)-1,2,4-triazole) using a solvent diffusion method, for which the structure was determined by single crystal X-ray diffraction (SCXRD) and shows great thermal stability and decomposition temperature up to 220 \textdegree{}C. At room temperature, this indirect band gap hybrid semiconductor shows a blue emission centered at 464 nm which was nearing deep blue light (<460 nm) with a band gap energy of 2.70 eV. In addition, we developed a simple method for large-scale synthesis of the microcrystal, which significantly enhances the possibility of widespread applications for CuI-Pytz. Both density functional theory calculations and experimental studies reveal that the blue light emission originates from the combination of metal-to-ligand charge transfer (MLCT) and halide-to-ligand charge transfer (XLCT). The good thermal stability and high energy blue light emission make this low-cost and easily available copper(i) halide hybrid semiconductor a potential candidate for use as rare-earth free phosphors. \textcopyright{} 2024 The Royal Society of Chemistry.},
  keywords      = {Charge transfer; Copper compounds; Crystal structure; Density functional theory; Energy gap; Ligands; Luminescence; Metal halides; Phosphors; Rare earths; Single crystals; Supercomputers; Transition metals; 1,2,4 triazole derivative; coordination compound; copper iodide 4 (pyrid 2 yl) 1,2,4 triazole; lanthanide; luminescent agent; polymer; solvent; unclassified drug; Blue light emissions; Coordination Polymers; Coordination-polymers; Copper iodide; Element-free; Energy; Inorganic-organic hybrid; Luminescent material; Semiconducting materials; Solid state lighting; absorption spectroscopy; Article; blue light; cost effectiveness analysis; crystal; crystal structure; decomposition; density functional theory; diffusion; electricity; elemental analysis; energy; experimental study; Fourier transform infrared spectroscopy; halide to ligand charge transfer; high temperature; large scale production; metal to ligand charge transfer; photochemistry; photoluminescence; quantum yield; reaction temperature; room temperature; single crystal x ray diffraction; spectrofluorometry; steady state; synthesis; thermogravimetry; thermostability; ultraviolet radiation; ultraviolet visible spectroscopy; X ray diffraction; X ray powder diffraction; Thermodynamic stability},
