@article{Abbou2024120,
  title         = {Enhancing Compressive Strength and Sustainability-High-Performance Concrete with Fly Ash and Brick Waste Powder},
  author        = {Abbou, Somaya Ben and Aalil, Issam and Cherkaoui, Khalid},
