  title         = {Environmental Sustainability and Digital Transformation of Socio-Economic: Quality of Life Perspective},
  author        = {Barykin, Sergey Evgenievich and Sergeev, Sergey Mikhailovich and Kapustina, Irina Vasilievna and Fedotov, Alexander Anatolyevich and Matchinov, Vitaly Anatolievich and Plaza, Elena De La Poza and Mottaeva, Angela Bahauovna and Sharkova, Antonina Vasilievna and Borisova, Anzhelika Yurievna and Karmanova, Anna Evgenievna},
