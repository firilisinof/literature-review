@inproceedings{11272824,
  title         = {Non-Functional Properties in HPC Systems: Design Exploration of Energy, Power, and Reliability},
  author        = {Agosta, G. and Bini, E. and Baroffio, D. and Brandolese, C. and Castrovilli, M. and Cattaneo, D. and Cesarini, D. and Fornaciari, W. and Galimberti, A. and Garfagnini, A. and Gavrikov, Arsenii and Iannone, F. and Lapegna, M. and Lopez, T. A. and Magnani, G. and Mencagli, G. and Metra, C. and Omana, M. E. and Palombi, F. and Reghenzani, F. and Condia, Josie E. Rodriguez and Serafini, A. and Reorda, M. Sonza and Zoni, D and Zummo, G.},
  year          = 2025,
  month         = {Sep.},
  booktitle     = {2025 28th Euromicro Conference on Digital System Design (DSD)},
  pages         = {242--251},
  doi           = {10.1109/dsd67783.2025.00043},
  issn          = {2771-2508},
  abstract      = {Modern HPC systems must be designed considering different parameters, which include cost, performance, and throughput, as well as non-functional properties, such as power/energy consumption and reliability. This paper describes the work performed and the results achieved by the partners of the Italian National Research Center for HPC, Big Data and Quantum Computing in the frame of the sub-project dealing with Future HPC architectures and solutions. The work in this subproject focused on advanced design and monitoring techniques for devising energy- and power-efficient, reliable parallel architectures based on open standards (e.g., RISC-V) and design space exploration techniques and tools. This paper provides a summary of the achieved results and developed products stemming from the activities of the different partners.},
  keywords      = {Quantum computing;Digital systems;High performance computing;Reliability engineering;Throughput;Space exploration;Parallel architectures;System analysis and design;Standards;Monitoring;High-Performance Computing (HPC);Reliability;Power;Energy}
}
@inproceedings{11272831,
  title         = {FLAMA: Architecting Floating-Point Atomic Memory Operations for Heterogeneous HPC Systems},
  author        = {Soria-Pardos, V\'{\i}ctor and Armejach, Adri\`{a} and Su\'{a}rez, Dar\'{\i}o and Martinot, Didier and Grasset, Arnaud and Moret\'{o}, Miquel},
  year          = 2025,
  month         = {Sep.},
  booktitle     = {2025 28th Euromicro Conference on Digital System Design (DSD)},
  pages         = {435--442},
  doi           = {10.1109/dsd67783.2025.00066},
  issn          = {2771-2508},
  abstract      = {Current heterogeneous systems integrate generalpurpose Central Processing Units (CPUs), Graphics Processing Units (GPUs), and Neural Processing Units (NPUs). The efficient use of such systems requires a significant programming effort to distribute computation and synchronize across devices, which usually involves using Atomic Memory Operations (AMOs). Arm recently launched a floating-point Atomic Memory Operations (FAMOs) extension to perform atomic updates on floating-point data types specifically. This work characterizes and models heterogeneous architectures to understand how floating-point AMOs impact graph, Machine Learning (ML), and high-performance computing (HPC) workloads. Our analysis shows that many AMOs are performed on floating-point data, which modern systems execute using inefficient compare-and-swap (CAS) constructs. Therefore, replacing CASbased constructs with FAMOs can improve a wide range of workloads. Moreover, we analyze the trade-offs of executing FAMOs at different memory hierarchy levels, either in private caches (near) or remotely in shared caches (far). We have extended the widely used AMBA CHI protocol to evaluate such FAMO support on a simulated chiplet-based heterogeneous architecture. While near FAMOs achieve an average $1.34 \times$ speed-up, far FAMOs reach an average $1.58 \times$ speed-up. We conclude that FAMOs can bridge the gap between CPU architecture and accelerators and enabling synchronization in key application domains.},
  keywords      = {Performance evaluation;Protocols;High performance computing;Memory management;Graphics processing units;Machine learning;Programming;Central Processing Unit;Synchronization;System analysis and design;atomics;synchronization;hpc;multicores}
}
@inproceedings{11279123,
  title         = {High-Performance Architecture for Next-Generation Storage in Virtual Power Plant Management},
  author        = {Rodrigues, Ricardo and Alves, Manuel and Abbasi, Ali and Cesar, Bruno and Petiz, Maria},
  year          = 2025,
  month         = {July},
  booktitle     = {2025 IEEE 23rd International Conference on Industrial Informatics (INDIN)},
  pages         = {1--7},
  doi           = {10.1109/indin64977.2025.11279123},
  issn          = {2378-363x},
  abstract      = {This paper presents a high-performance architecture for the New Generation Storage (NGS) project, designed to tackle operational and scalability challenges in managing distributed energy resources within Virtual Power Plants (VPPs). The architecture enables real-time data processing and control, facilitating efficient VPP asset management in both on-premise and cloud environments. By incorporating digital twin technologies, it delivers a dynamic model of physical assets for accurate monitoring and control of distributed energy resources. Advanced data analytics and high-performance computing (HPC) support optimization algorithms targeting cost minimization, battery lifespan extension, and enhanced system efficiency. Its scalability accommodates energy network expansions while maintaining performance. The architecture's integration with external services enhances predictive analytics for energy forecasting and resource management. Secure authentication and authorization mechanisms based on Keycloak ensure fine-grained access control, safeguarding sensitive data. This flexible solution is suitable for various VPP applications, from small microgrids to large, distributed energy systems, providing a comprehensive and future-proof framework for modern energy infrastructures, and significantly advancing the management of distributed energy resources.},
  keywords      = {Scalability;High performance computing;Computer architecture;Microgrids;Virtual power plants;Real-time systems;Digital twins;Resource management;Forecasting;Optimization;Virtual Power Plant;New Generation Storage;Digital Twin;High-Performance Computing;Optimization;and Forecasting}
}
@inproceedings{11279166,
  title         = {REACT: A Heterogeneous Reconfigurable Neural Network Accelerator with Software-Configurable NoCs for Training and Inference onWearables},
  author        = {Upadhyay, Mohit and Juneja, Rohan and Wang, Bo and Zhou, Jun and Wong, Weng-Fai and Peh, Li-Shiuan},
  year          = 2022,
  month         = {June},
  booktitle     = {2022 59th ACM/IEEE Design Automation Conference (DAC)},
  pages         = {1291--1296},
  issn          = {0738-100x},
  abstract      = {On-chip training improves model accuracy on personalised user data and preserves privacy. This work proposes REACT, an AI accelerator for wearables that has heterogeneous cores supporting both training and inference. REACT's architecture is NoC-centric, with weights, features and gradients distributed across cores, accessed and computed efficiently through software-configurable NoCs. Unlike conventional dynamic NoCs, REACT's NoCs have no buffer queues, flow control or routing, as they are entirely configured by software for each neural network. REACT's online learning realises upto 75\% accuracy improvement, and is upto $25 \times$ faster and $520 \times$ more energy-efficient than state-of-the-art accelerators with similar memory and computation footprint.ACM Reference Format:Mohit Upadhyay1, Rohan Juneja1, Bo Wang2, Jun Zhou3, Weng-Fai Wong1, and Li-Shiuan Peh1,1 School of Computing, National University of Singapore,2 Singapore University of Technology and Design, Singapore,3 Institute of High Performance Computing, A\textasteriskcenteredSTAR, Singapore,. 2022. REACT: A Heterogeneous Reconfigurable Neural Network Accelerator with Software-Configurable NoCs for Training and Inference on Wearables. In Proceedings of the 59th ACM/IEEE Design Automation Conference (DAC) (DAC `22), July 10-14, 2022, San Francisco, CA, USA. ACM, New York, NY, USA, 6 pages. https://doi.org/10.1145/3489517.3530406},
  keywords      = {Training;Design automation;Accuracy;High performance computing;Neural networks;Routing;Software;Hardware;System-on-chip;Wearable devices;neural networks;accelerators;wearables}
}
@inproceedings{11279293,
  title         = {Computational challenges for the massive production of enriched pre-editions},
  author        = {Gabay, Simon and Kuenzli, Pierre and Rubino, Raphael and Skura, Genis and Biasi, Loris De and Falcone, Jean-Luc and Charpilloz, Christophe and Romanello, Matteo and Cl\'{e}rice, Thibault and Jan\`{e}s, Juliette and Ing, Lucence and Carboni, Nicola},
  year          = 2025,
  month         = {Sep.},
  booktitle     = {2025 IEEE International Conference on Cyber Humanities (IEEE-CH)},
  pages         = {1--6},
  doi           = {10.1109/ieee-ch65308.2025.11279293},
  abstract      = {Computational methods in the humanities require large amounts of rich data that exist only in an analogue format (manuscripts, printed books, etc.). However, converting at scale these analogue documents into rich machine-mineable data poses significant problems in terms of computing capacity – an additional second per page resulting potentially in days of processing and a significantly larger footprint. Therefore, we propose a streamlined pipeline limited to the following tasks: (i) layout analysis, (ii) character optical recognition, (iv) pre-editorialization, (v) linguistic normalization, and (vi) named entity recognition. We assess the impact of each task (including preand post-processing), testing different strategies to maximise both the speed of execution and the quality of result, relying only on open solutions. This pipeline is used to transform automatically a massive corpus of French theatrical plays (<1,300,000 pages) into enriched pre-editions (< 10,000 books).},
  keywords      = {Humanities;High performance computing;Pipelines;Layout;Transforms;Production;Named entity recognition;Linguistics;Character recognition;Testing;Computational humanities;sustainable high-performance computing;modern philology}
}
@inproceedings{11279692,
  title         = {CUDA-Accelerated Simulated Annealing for Optimal Scheduling of Virtual Power Plants},
  author        = {Abbasi, Ali and Sobral, Joao L. and Rodrigues, Ricardo},
  year          = 2025,
  month         = {July},
  booktitle     = {2025 IEEE 23rd International Conference on Industrial Informatics (INDIN)},
  pages         = {1--6},
  doi           = {10.1109/indin64977.2025.11279692},
  issn          = {2378-363x},
  abstract      = {Efficient scheduling of Virtual Power Plants (VPPs) is critical for integrating distributed energy resources into modern power systems. This paper introduces a CUDA-accelerated simulated annealing algorithm designed to optimize VPP scheduling by leveraging GPUs' massive parallel processing capabilities. The proposed method reformulates the traditional simulated annealing process to exploit GPU parallelism, significantly reducing computational runtime and enhancing scalability even as the system dimensionality increases. Experimental results indicate that the GPU-based implementation maintains a consistent solution time irrespective of the number of prosumers, demonstrating robust performance in large-scale, real-world energy optimization scenarios. The findings suggest that CUDA-accelerated simulated annealing can serve as a highly effective tool for optimal VPP scheduling, offering substantial improvements in both efficiency and scalability.},
  keywords      = {Job shop scheduling;Processor scheduling;Scalability;Graphics processing units;Simulated annealing;Optimal scheduling;Virtual power plants;Parallel processing;Batteries;Smart grids;Virtual power plants;simulated annealing;CUDA;GPU acceleration;parallel optimization;energy management}
}
@article{11279991,
  title         = {VizGenie: Toward Self-Refining, Domain-Aware Workflows for Next-Generation Scientific Visualization},
  author        = {Biswas, Ayan and Turton, Terece L. and Ranasinghe, Nishath Rajiv and Jones, Shawn and Love, Bradley and Jones, William and Hagberg, Aric and Shen, Han-Wei and DeBardeleben, Nathan and Lawrence, Earl},
  year          = 2026,
  month         = {Jan},
  journal       = {IEEE Transactions on Visualization and Computer Graphics},
  volume        = 32,
  number        = 1,
  pages         = {1021--1031},
  doi           = {10.1109/tvcg.2025.3634655},
  issn          = {1941-0506},
  abstract      = {We present VizGenie, a self-improving, agentic framework that advances scientific visualization through large language model (LLM) by orchestrating of a collection of domain-specific and dynamically generated modules. Users initially access core functionalities--such as threshold-based filtering, slice extraction, and statistical analysis--through pre-existing tools. For tasks beyond this baseline, VizGenie autonomously employs LLMs to generate new visualization scripts (e.g., VTK Python code), expanding its capabilities on-demand. Each generated script undergoes automated backend validation and is seamlessly integrated upon successful testing, continuously enhancing the system's adaptability and robustness. A distinctive feature of VizGenie is its intuitive natural language interface, allowing users to issue high-level feature-based queries (e.g., ``visualize the skull'' or ``highlight tissue boundaries''). The system leverages image-based analysis and visual question answering (VQA) via fine-tuned vision models to interpret these queries precisely, bridging domain expertise and technical implementation. Additionally, users can interactively query generated visualizations through VQA, facilitating deeper exploration. Reliability and reproducibility are further strengthened by Retrieval-Augmented Generation (RAG), providing context-driven responses while maintaining comprehensive provenance records. Evaluations on complex volumetric datasets demonstrate significant reductions in cognitive overhead for iterative visualization tasks. By integrating curated domain-specific tools with LLM-driven flexibility, VizGenie not only accelerates insight generation but also establishes a sustainable, continuously evolving visualization practice. The resulting platform dynamically learns from user interactions, consistently enhancing support for feature-centric exploration and reproducible research in scientific visualization.},
  keywords      = {Data visualization;Natural languages;Iterative methods;Reproducibility of results;Codes;Question answering (information retrieval);Large language models;Visual analytics;Three-dimensional displays;Robustness;Scientific data;Large language models;Agentic workflows;Natural language;Feature-based visualization}
}
@inproceedings{11283201,
  title         = {A Synergistic Deep Learning Optimization Framework for Energy-Efficient HPC Clusters},
  author        = {Dong, Yuet and Li, Donovan and Sun, Peter},
  year          = 2025,
  month         = {Sep.},
  booktitle     = {2025 5th International Conference on Electronic Information Engineering and Computer Science (EIECS)},
  pages         = {1334--1338},
  doi           = {10.1109/eiecs67708.2025.11283201},
  abstract      = {The escalating energy consumption of HighPerformance Computing (HPC) facilities, driven by dataintensive applications like Large Language Models, poses a significant sustainability challenge. This paper addresses the critical need to align computational throughput with environmental responsibility. We propose a novel framework that uses a neural network autoencoder for task clustering, followed by a multi-objective optimization model to intelligently allocate tasks across a heterogeneous network of 92 HPC centers. While a single-minded focus on speed reduces makespan by $58.5 \%$ compared to a FIFO scheduler, it offers no energy savings. In contrast, our multi-objective approach reveals a Pareto front of optimal solutions, demonstrating that a minor $10 \%$ concession in makespan can yield a significant $25 \%$ reduction in energy consumption, which directly translates to a reduction in carbon emissions based on the regional energy mix. This provides a practical framework for operators to select a scheduling policy that aligns with both performance targets and sustainability goals.},
  keywords      = {Energy consumption;Translation;Processor scheduling;Optimization models;Neural networks;Autoencoders;Green computing;Dynamic scheduling;Sustainable development;Optimization;High-Performance Computing;Deep-learning based Scheduling;Multi-Objective Optimization;Green Computing}
}
@inproceedings{11284056,
  title         = {Data-Driven Carbon Footprint Estimation in Software Systems Using AI and Deep Learning},
  author        = {Khan, Iffat and Dharmadhikari, Pranjali and Benji, Mikhiel and Edne, Rushikesh and Jakhete, S. A.},
  year          = 2025,
  month         = {Aug},
  booktitle     = {2025 9th International Conference on Computing, Communication, Control and Automation (ICCCBEA)},
  pages         = {1--6},
  doi           = {10.1109/iccubea65967.2025.11284056},
  issn          = {2771-1358},
  abstract      = {The software industry contributes significantly to global carbon emissions, driven by the energy-intensive operations of cloud computing, data centers, and AI-driven workloads. This study systematically examines the environmental footprint of software throughout its life cycle, from hardware manufacturing to operational energy consumption. We analyze carbon emissions resulting from software execution, with a particular focus on computationally intensive tasks such as deep learning and large-scale data processing. In addition, we review existing methodologies for measuring and mitigating software-induced carbon emissions, including energy-efficient coding practices, workload optimization strategies, and integration of renewable energy sources. To advance this effort, we introduce an open source tool that quantifies $\text{CO}_{2}$ emissions in real time, specifically targeting deep learning models with high computational demands. Using frameworks such as Green Algorithms, our approach provides a standardized method for assessing and reducing carbon footprints in software operations. This paper aims to bridge the gap between sustainable computing practices and industry adoption, offering insights into future pathways for reducing the environmental impact of software technologies while aligning with global sustainability goals.},
  keywords      = {Deep learning;Life cycle assessment;Industries;Software algorithms;Carbon dioxide;Software;Artificial intelligence;Sustainable development;Carbon footprint;Optimization;Carbon Footprint;Green Computing;High Performance Computing (HPC);Software Sustainability;Life Cycle Assessment (LCA);Energy-Efficient Computing;Green Algorithms;Sustainable Software Engineering;Carbon-Aware Computing;Eco-Friendly AI}
}
@inproceedings{11284497,
  title         = {A Hybrid Firefly and Opposition-Based Learning Approach for Optimizing Task Scheduling in Cloud Environments},
  author        = {Ciptaningtyas, Henning Titi and Rosyadi, Fuad Dary and Ghozali, Khakim and Firdausi, Hafara and Indrawanti, Annisaa Sri and Faizah, Nida'ul},
  year          = 2025,
  month         = {Oct},
  booktitle     = {2025 International Conference on Smart-Green Technology in Electrical and Information Systems (ICSGTEIS)},
  pages         = {165--170},
  doi           = {10.1109/icsgteis68532.2025.11284497},
  issn          = {2831-400x},
  abstract      = {With the increasing complexity of cloud computing environments, efficient task scheduling has become a critical factor in maximizing resource utilization and minimizing energy consumption. This study proposes a hybrid optimization approach that combines the Firefly Algorithm (FA) with Opposition-Based Learning (OBL) to enhance task scheduling performance in cloud environments. The Firefly Algorithm, inspired by the social flashing behaviour of fireflies, is known for its effectiveness in solving complex optimization problems. However, it suffers from limitations such as premature convergence. To address this, OBL is integrated to improve population diversity and exploration capabilities by evaluating both candidate solutions and their opposites. The proposed method is implemented and evaluated using CloudSim, a simulation framework for cloud computing environments. Performance is compared against the Genetic Algorithm (GA) across three datasets: Simple Random, Stratified Random, and the San Diego Supercomputer Centre (SDSC) Blue Horizon log. Evaluation metrics include Makespan, Average Execution Time, Total Wait Time, Throughput, Resource Utilization, and Total Energy Consumption. Experimental results show that the hybrid FAOBL approach significantly reduces energy consumption and improves workload balance compared to GA, especially in scenarios using synthetic datasets. Although FA-OBL does not consistently outperform GA in all scheduling parameters, it demonstrates a notable advantage in energy efficiency and imbalance reduction. These findings highlight the potential of hybrid metaheuristic algorithms to address key challenges in cloud task scheduling and contribute to more sustainable and efficient cloud computing operations.},
  keywords      = {Cloud computing;Energy consumption;Processor scheduling;Metaheuristics;Throughput;Scheduling;Supercomputers;Resource management;Genetic algorithms;Synthetic data;Cloud Computing;Task Scheduling;Firefly Algorithm;Opposition-Based Learning;CloudSim;Optimization}
}
@inproceedings{11286127,
  title         = {Energy Consumption in Computing over the Decades: Trends, Efficiency, and Measurement Challenges},
  author        = {Nazar\'{e}, Thalita and Nepomuceno, Erivelton},
  year          = 2025,
  month         = {Sep.},
  booktitle     = {2025 IEEE History of Electrotechnology Conference (HISTELCON)},
  pages         = {1--6},
  doi           = {10.1109/histelcon64051.2025.11286127},
  issn          = {2770-8357},
  abstract      = {This study presents a historical and technical analysis of energy consumption in computing systems, tracing its evolution from the mid-20th century to the present. It examines the trajectory from the energy-intensive operation of early mainframes to the contemporary emphasis on energy-efficient data centres and software engineering practices. The emergence of energy metrics such as Power Usage Effectiveness (PUE), the adoption of virtualisation, and advances in cooling and workload management are discussed as critical responses to environmental pressures and operational demands. In parallel, the evolution of software, from low-level optimisation to modern green software engineering, has played a significant role in shaping the energy footprint of computational systems. The study also explores the positive feedback loop formed between hardware efficiency, sustainable software development, and the growing use of computing in climate science, highlighting how these interrelated domains contribute to broader sustainability goals. Current challenges in energy measurement, lifecycle assessment, and distributed computing environments are outlined, and future research directions are proposed. The findings underscore the importance of integrated strategies in addressing the complex relationship between computing and energy, with implications for both technological development and environmental stewardship.},
  keywords      = {Energy consumption;Energy measurement;Energy efficiency;Hardware;Software;Trajectory;Sustainable development;Optimization;Software engineering;Software development management}
}
@inproceedings{11288892,
  title         = {Flexible Wrapper for Ensemble Machine Learning Trees Targeting High-Performance HBM-FPGAs},
  author        = {Moreira, Icaro G. S. and Silva, Olavo and Bragan\c{c}a, Lucas and Pac\'{\i}fico, Racyus D. G. and Ferreira, Ricardo and Nacif, Jos\'{e} Augusto M.},
  year          = 2025,
  month         = {Nov},
  booktitle     = {2025 XV Symposium on Computing Systems Engineering (SBESC)},
  pages         = {1--6},
  doi           = {10.1109/sbesc68008.2025.11288892},
  issn          = {2324-7894},
  abstract      = {Machine learning (ML) increases the demand for real-time inference and efficient hardware-based acceleration. This paper evaluates decision tree ensemble implementations on FPGA platforms coupled with High Bandwidth Memory (HBM). While traditional implementations often deploy hundreds of trees ("jungles") to maximize accuracy, our work demonstrates that carefully designed compact ensembles ("copses") can achieve comparable accuracy while better aligning with the architectural constraints of modern FPGA-HBM systems. We present a flexible wrapper for the automatic implementation of ML models, particularly tree-based models, on hardware. In addition, we developed a custom tree-based architecture with a variable pipeline aimed at maximizing throughput. By distributing smaller tree ensembles across parallel processing modules with direct HBM access, we eliminate the performance bottlenecks associated with large monolithic implementations that necessitate complex interconnection networks. We implemented the accelerator on the Xilinx Alveo FPGA platform, using 32 HBM channels, and performed the experiments in a realistic high-performance HPC cluster. Our results demonstrate that the accelerator processes 17 billion samples and low logic resource utilization while leveraging the high memory bandwidth of HBM.},
  keywords      = {Accuracy;Trees (botanical);Biological system modeling;Neural networks;Bandwidth;Throughput;Time measurement;Decision trees;Field programmable gate arrays;Random forests;Machine Learning;Neural Networks;Decision Trees;Hardware Accelerator;FPGAs;HBMs;Random Forest}
}
@inproceedings{11290127,
  title         = {Energy-Aware Computing: Cutting CPU Cycles through Intelligent Thread Management and Code Smell Optimization},
  author        = {Jolly, Sonali and Yadav, Asmita and Singh, Sandeep Kumar},
  year          = 2025,
  month         = {Aug},
  booktitle     = {2025 Seventeenth International Conference on Contemporary Computing (IC3)},
  pages         = {1--7},
  doi           = {10.1109/ic366947.2025.11290127},
  abstract      = {In the field of high-performance computing, increasing resource efficiency and enhancing code quality is essential for minimizing CPU cycles, reducing execution duration, and reducing energy usage. This study introduces an approach for Thread management and Code smell optimization aimed at boosting software performance and reducing the workload on the CPU. The framework achieves significant reductions in overall computational time by employing intelligent thread allocation techniques with respect to memory thereby reducing CPU cycles and speeding up the processing. This paper also incorporates experiments on code smell detection by using Abstract Syntax Tree (AST) traversal and recommendation along with optimization to boost efficiency and quality code. By identifying and addressing code smell indicators of subpar coding practices that negatively affect readability, maintainability has achieved results in reduced CPU cycles and Execution Time. The resulting code demonstrates enhanced modularity and improved performance, minimizing energy usage without sacrificing results. Findings reveal that the optimization decreases in processing duration by 33.34\% over non-optimized programs, CPU utilization, and energy consumption across a set of few programs and highlighting the efficacy of thread management. These Experiments contribute to the advancement of energy-efficient software methodologies suitable for modern resource-intensive applications.},
  keywords      = {Codes;Instruction sets;Trees (botanical);High performance computing;Software performance;Syntactics;Energy efficiency;Resource management;Sustainable development;Optimization;Code smell Optimization;Energy Efficiency;Thread Management;CPU Cycles;Software Sustainability;Energy Aware Computing;Green Computing}
}
@inproceedings{11290266,
  title         = {Three-River-Source Ecological Information Knowledge Q\&A Based on Zero-Shot Learning and Retrieval-Enhanced Generation},
  author        = {Hu, Naihao and XiaodanZhang and Zhao, Shuailing and Tang, Yuyang and Zhang, Qiyuan and Huo, Wei},
  year          = 2025,
  month         = {Sep.},
  booktitle     = {2025 5th International Conference on Artificial Intelligence, Automation and High Performance Computing (AIAHPC)},
  pages         = {378--382},
  doi           = {10.1109/aiahpc66801.2025.11290266},
  abstract      = {The Three-River-Source region generates massive heterogeneous ecological data that are difficult to process with traditional retrieval and rule-based systems. To address the challenges of semantic complexity, limited computational resources, and the need for reliable ecological decision support, we propose ZRQA-RAG, a zero-shot retrieval-augmented generation framework with multi-turn contextual interaction. Unlike existing RAG-based approaches, ZRQA-RAG is specifically designed for ecological knowledge Q\&A, integrating a semantic retriever with a lightweight generator to support local deployment. We construct an ecological Q\&A dataset covering climate, hydrology, and biodiversity data from the Three-River-Source and evaluate the system under closed-book and open-book settings. Experimental results show that ZRQA-RAG achieves 69.1\% exact match and 83.5\% accuracy, which is outperforming RAG-Seq (57.4\% EM, 68.3\% Acc) and Atlas-XL+CIT (65.6\% EM, 77.4\% Acc). Furthermore, the multi-turn interaction mechanism significantly improves reasoning-intensive queries (Set 3), with accuracy gains of nearly +5\% over single-turn RAG. These results demonstrate that ZRQA-RAG provides an effective, scalable, and domain-adapted solution for ecological knowledge Q\&A, offering practical support for conservation planning and policy-making in the Three-River-Source region.},
  keywords      = {Hydrology;Accuracy;High performance computing;Semantics;Zero shot learning;Retrieval augmented generation;Generators;Planning;Complexity theory;Reliability;RAG;Three-River-Source ecological knowledge;LLMs;zero-shot learning;multi-turn interaction}
}
@inproceedings{11290272,
  title         = {Research on Real-time Cloth Simulation Based on Local Embedded FEM and Multigrid Method},
  author        = {Wang, Ruxin and Shu, Hou and Hu, Weixiao and Yang, Baokun and Song, Wei},
  year          = 2025,
  month         = {Sep.},
  booktitle     = {2025 5th International Conference on Artificial Intelligence, Automation and High Performance Computing (AIAHPC)},
  pages         = {970--973},
  doi           = {10.1109/aiahpc66801.2025.11290272},
  abstract      = {Position-based dynamics (PBD) algorithms are widely used in computer graphics and image processing. In the field of cloth simulation, PBD algorithms significantly improve computational efficiency by directly setting physical constraints on object positions, making them widely used in scenes requiring real-time cloth simulation. However, with the advancement of information technology, cloth materials in scenes have become increasingly sophisticated and complex, significantly reducing the simulation efficiency of existing PBD algorithms in complex scenes. To address these issues, this paper investigates the PBD algorithm and proposes a cloth simulation method based on the local embedded finite element method (FEM) combined with multigrid technology. This method constructs a hierarchical cloth mesh using mesh simplification to improve computational efficiency. The finite element method is then applied to this local hierarchical mesh to ensure cloth mesh accuracy. The simulation performance and computer resource consumption are verified. Experimental analysis shows that this method reduces the computer resource consumption required to complete an equivalent workload while maintaining simulation performance, thereby improving the frame rate (FPS) of real-time cloth simulation.},
  keywords      = {Accuracy;Heuristic algorithms;Multigrid methods;Image processing;High performance computing;Real-time systems;Finite element analysis;Computational efficiency;Iterative methods;Information technology;PBD;FEM;multigrid method;cloth simulation}
}
@article{11293239,
  title         = {Exploring High-Performance Processor Architecture Beyond The Exascale},
  author        = {Xie, Xiang-Hui and Jia, Xun},
  year          = 2018,
  month         = {October},
  journal       = {Frontiers of Information Technology \& Electronic Engineering},
  volume        = 19,
  number        = 10,
  pages         = {1224--1229},
  doi           = {10.1631/fitee.1800424},
  issn          = {2095-9230},
  abstract      = {The ever-increasing need for high performance in scientific computation and engineering applications will push high-performance computing beyond the exascale. As an integral part of a supercomputing system, high-performance processors and their architecture designs are crucial in improving system performance. In this paper, three architecture design goals for high-performance processors beyond the exascale are introduced, including effective performance scaling, efficient resource utilization, and adaptation to diverse applications. Then a high-performance many-core processor architecture with scalar processing and application-specific acceleration (Massa) is proposed, which aims to achieve the above three goals by employing the techniques of distributed computational resources and application-customized hardware. Finally, some future research directions regarding the Massa architecture are discussed.},
  keywords      = {Program processors;High performance computing;Architecture;System performance;Prototypes;Mechanism design;Computer architecture;Hardware;Resource management;Coprocessors;High-performance computing;Beyond the exascale;Processor architecture;Application-customized hardware;Distributed computational resources}
}
@inproceedings{11298776,
  title         = {Out of Core and Adaptive Image Blending Approach for Large Scale Image Mosaics},
  author        = {Quincy, Marcus and Petruzza, Steve},
  year          = 2025,
  month         = {Nov},
  booktitle     = {2025 IEEE 15th Symposium on Large Data Analysis and Visualization (LDAV)},
  pages         = {65--71},
  doi           = {10.1109/ldav68558.2025.00011},
  issn          = {2832-6512},
  abstract      = {Color blending is a widely used technique in mosaic or panorama image processing, particularly for seamlessly combining images with varying lighting or weather conditions. One key application is in aerial image mosaics, where seams often arise between images captured by aircraft. Blending large-scale mosaics, however, typically requires access to global image information, resulting in high memory demands. Prior work has addressed this challenge either through interactive local blending or by leveraging high-performance computing (HPC) systems with distributed memory.In this work, we present an out-of-core blending approach that processes large mosaics tile by tile using an iterative Poisson solver. Our method leverages a downsampled global mosaic to guide local blending, eliminating the need to load the full-resolution dataset into memory. We further introduce two adaptive execution strategies that vary the number of solver iterations per tile, improving both efficiency and quality. We demonstrate our approach using large orthomosaic datasets from the National Ecological Observatory Network (NEON), and implement the pipeline using the SYCL programming model for cross-platform portability.},
  keywords      = {Visualization;Neon;Observatories;Pipelines;Memory management;Lighting;Programming;Hardware;Remote sensing;Load modeling;Index Terms: Image blending;out of core;mosaic}
}
@inproceedings{11299273,
  title         = {Supervised Learning of Wireless Signal Waveforms in the Era of Radar-Communications Convergence},
  author        = {Shatov, Victor and Vagollari, Adela and Su, Yanpeng and Gerstacker, Wolfgang and L\"{u}bke, Maximilian and Franchi, Norman},
  year          = 2025,
  month         = {Nov},
  booktitle     = {2025 16th IFIP Wireless and Mobile Networking Conference (WMNC)},
  pages         = {127--133},
  doi           = {10..23919/wmnc67099.2025.11299273},
  issn          = {2473-3644},
  abstract      = {Widely recognized as a candidate technology for 6G, joint communication and sensing (JCAS) is expected to enable a range of emerging applications in wireless networks. However, incorporating radio sensing capabilities introduces new design challenges and demands novel approaches across various research and engineering disciplines. This paper studies the waveform classification task not only for dedicated communication and radar but also for fully integrated JCAS waveforms. To this end, we generate wireless waveforms that belong to eight classes, including four pure communications standard signal waveforms, two classical radar waveforms, and two fully integrated JCAS candidate waveforms. We examine the dataset's statistical properties and evaluate several machine learning and deep learning classifiers based on expert feature extraction and raw data. Numerical simulations show that expert feature-based classifiers exhibit limited accuracy for the considered task, even for a very high signal-to-noise ratio (SNR). The classifier that learns from raw data yields high accuracy, but requires either a high-performance computing platform or further architectural optimization to meet real-time requirements. Additionally, we investigate the complexity, inference time, and memory footprint of the designed classifiers in the context of their practical implementation in wireless communication systems.},
  keywords      = {Wireless communication;Wireless sensor networks;Supervised learning;Radar;Numerical simulation;Real-time systems;Sensors;Standards;Long short term memory;Signal to noise ratio;Deep neural network (DNN);joint communication and sensing (JCAS);intelligent spectrum sensing;long short-term memory (LSTM);radar;supervised learning;waveform classification}
}
@inproceedings{11299618,
  title         = {Welcoming Remarks},
  author        = {Naomab, Erold},
  year          = 2025,
  month         = {Aug},
  booktitle     = {2025 International Conference on Emerging Trends in Networks and Computer Communications (ETNCC)},
  pages         = {iii-v},
  doi           = {10.1109/etncc66224.2025.11299618},
  abstract      = {I am honoured to welcome everyone to the Namibia University of Science and Technology (NUST) for the 5th International Conference on Emerging Trends in Networks and Computer Communications (ETNCC). This hybrid event is scheduled to take place from August 5 to 7, 2025, and is organised by the UNESCO Chair on Secure High-Performance Computing for Higher Education and Research within NUST's Faculty of Computing and Informatics, under the leadership of Prof. Dharm Singh Jat. The conference is technically co-sponsored by the IEEE South Africa Section and is supported by IEEE Region 8. This platform provides a truly unique and invaluable opportunity for us to come together-bringing diverse perspectives, expertise, and passion to collaboratively shape the future of sustainable development. By fostering innovation, dialogue, and shared commitment, we can drive meaningful progress toward creating a more equitable, resilient, and environmentally responsible world for generations to come.}
}
@inproceedings{11305848,
  title         = {The Hidden Variables in the Future of Quantum Computing in 6G},
  author        = {Bassoli, Riccardo},
  year          = 2025,
  month         = {Sep.},
  booktitle     = {2025 International Conference on Electromagnetics in Advanced Applications (ICEAA)},
  pages         = {1303--1306},
  doi           = {10.1109/iceaa65662.2025.11305848},
  issn          = {2766-2284},
  abstract      = {5G has been commercialised and 6G standardisation has just started. The vision of these networks are going to pose unprecedented computing challenges on the infrastructure. To ensure the computing infrastructure is capable to assure the necessary promises, integration between `classical' and quantum computing has started being researched by the industrial and scientific communities in cloud computing scenarios. In the years, various technologies for quantum computing have been developed with different performances and characteristics. Superconducting and trapped-ions have been attracting a lot of attention and investments. That mainly due to the best fidelities, gate times, for the number of computational qubits offered. These quantum computing technologies work at very low temperatures (below some Kelvins) and require cryogenics. Nevertheless, in the history, the success of ICT technologies has also passed through their flexibility, sustainability (e.g., energy usage, cost, scalability). Current cryogenic methods for quantum computing face significant sustainability challenges due to their extreme energy demands and reliance on finite resources. The cooling infrastructure represents one of the most significant sustainability challenge in quantum computing. That is why other solutions like photonic and NV-centre diamond-based quantum computing could offer a suitable alternative to match the requirements of future generation networks.},
  keywords      = {6G mobile communication;Quantum computing;Temperature;Cooling;Scalability;Qubit;Cryogenics;Sustainable development;Photonics;Resilience;Quantum computing;6G;photonic computing;trustworthiness;sustainability}
}
@inproceedings{11307333,
  title         = {Carbon-Aware Computing: Redesigning Algorithms for a Greener Future},
  author        = {Mungle, Soham and Rewatkar, Rajendra and Motewar, Atharva},
  year          = 2025,
  month         = {Oct},
  booktitle     = {2025 2nd International Conference on Electronic Circuits and Signaling Technologies (ICECST)},
  pages         = {365--371},
  doi           = {10.1109/icecst66106.2025.11307333},
  abstract      = {The rise in computational pressure in the data centers, cloud, and edge has resulted in rising energy and carbon footprint. Although much focus has been on hardware efficiency and the use of renewable energy, algorithmic redesign is a close and highly effective way of looking at sustainability. In this paper, carbon-conscious computing gets reviewed with special reference to the alcoholic approaches to workload scheduling, offloading tasks, resource provisioning, and carbon footprint estimation. The most notable case studies are Google carbon-intelligent workload management, GreenScale edge-cloud scheduling, CASPER distributed web-service provisioning, market-driven edge AI optimization and the Green Algorithms footprint analysis tool. These approaches prove to have the ability to reduce emissions by up to 70 percent without affecting performance, latency, and cost. Other challenges that have been pointed out in the study include challenges in intermittency of renewable energy, computational overhead, and lack of standardized carbon measures. The future of the AI-based scheduling is predictive, further combination with the carbon markets, and cross-layer optimization of devices, edge, and data center. Carbon aware redesigning of algorithms is depicted as an important move towards making computing systems greener and more sustainable.},
  keywords      = {Performance evaluation;Data centers;Processor scheduling;Green products;Prediction algorithms;Scheduling;Internet;Sustainable development;Optimization;Carbon footprint;Carbon-conscious computing;green computing;sustainable algorithms;datacenter optimization;edge-cloud scheduling;workload management;quantification of carbon footprint}
}
@inproceedings{11308445,
  title         = {AIML-based Pest Detection using Hyperspectral Imaging and Edge Inference in 6G Farms},
  author        = {Santhoshi, G and T.Swapna and Priyanka, Lingala and Yadav, Om Prakash and V.Vivekanandhan and Babu, Pottapinjara},
  year          = 2025,
  month         = {Oct},
  booktitle     = {2025 International Conference on Sustainable Communication Networks and Application (ICSCN)},
  pages         = {556--561},
  doi           = {10.1109/icscn67106.2025.11308445},
  abstract      = {The rapid development of intelligent agriculture is associated with the necessity of sophisticated, scalable, and real-time pest detection solutions to guarantee the health of crops and food security. In this work, the authors suggest a framework of Artificial Intelligence and Machine Learning (AIML)-based technology, using hyperspectral imaging and edge inference to be used in the new 6G farm ecosystem. Hyperspectral imaging has fine-grained spectral characteristics, which allow early and accurate discrimination of normal and pest crops. These multidimensional datasets are fed on to optimized AIML models, such as deep neural networks optimized on spectral-spatial feature extraction. In order to circumvent latency and bandwidth issues that are common with transmitting hyperspectral data to centralized servers, inference is executed at the edge based on low-power, high-performance computing nodes deployed in 6G-enabled farm infrastructures. The combination of edge computing and 6G ultra-reliable low-latency communication (URLLC) will provide real-time detection, and distributed learning methods will guarantee the flexibility of the models to operate in the variety of agricultural conditions. The results of experimental validation in simulated 6G farm testbeds reveal that there is a substantial enhancement in detection accuracy, response time and scalability in comparison with traditional pest monitoring systems. The presented strategy reflects on the revolutionary impact of hyperspectral-AIML-edge integration in the next-generation, precision agriculture, which is going to provide the path to sustainable, resilient, and intelligent farming.},
  keywords      = {6G mobile communication;Precision agriculture;Accuracy;Three-dimensional displays;Image edge detection;Biological system modeling;Crops;Ultra reliable low latency communication;Real-time systems;Hyperspectral imaging;Crops;Multispectral Image Fusion;Precision Agriculture;Machine Learning and Spectral-Spatial Analysis}
}
@inproceedings{11310985,
  title         = {Towards Affordable, Adaptive and Automatic GNN Training on CPU-GPU Heterogeneous Platforms},
  author        = {Qiao, Tong and Zhou, Ao and Qi, Yingjie and Wang, Yiou and Wan, Han and Yang, Jianlei and Hu, Chunming},
  year          = 2025,
  month         = {Nov},
  booktitle     = {2025 IEEE 43rd International Conference on Computer Design (ICCD)},
  pages         = {87--94},
  doi           = {10.1109/iccd65941.2025.00019},
  issn          = {2576-6996},
  abstract      = {Graph Neural Networks (GNNs) have been widely adopted due to their strong performance. However, GNN training often relies on expensive, high-performance computing platforms, limiting accessibility for many tasks. Profiling of representative GNN workloads indicates that substantial efficiency gains are possible on resource-constrained devices by fully exploiting available resources. This paper introduces $\mathrm{A}^{3} \text{GNN}$, a framework for Affordable, Adaptive, and Automatic GNN training on heterogeneous CPU-GPU platforms. It improves resource usage through locality-aware sampling and fine-grained parallelism scheduling. Moreover, it leverages reinforcement learning to explore the design space and achieve pareto-optimal trade-offs among throughput, memory footprint, and accuracy. Experiments show that $\mathrm{A}^{3}$ GNN can bridge the performance gap, allowing seven Nvidia 2080Ti GPUs to outperform two A100 GPUs by up to $1.8 \times$ in throughput with minimal accuracy loss.},
  keywords      = {Training;Performance evaluation;Accuracy;Memory management;Parallel processing;Throughput;Graph neural networks;Space exploration;Optimization;Tuning;Multi-GPUs;graph neural networks;training optimization;parallelism optimization}
}
@inproceedings{11311340,
  title         = {Coordinating Artificial Intelligence and Bitcoin Mining Workloads: A Risk-Aware Distributional Multi-Agent Reinforcement Learning Approach},
  author        = {Thomaidis, Ioannis T. and Giannopoulos, Panagiotis G. and Dasaklis, Thomas K.},
  year          = 2025,
  month         = {July},
  booktitle     = {2025 16th International Conference on Information, Intelligence, Systems \& Applications (IISA)},
  pages         = {1--8},
  doi           = {10.1109/iisa66859.2025.11311340},
  abstract      = {The rapid expansion of Artificial Intelligence (AI) workloads has created substantial energy requirements for contemporary data centers, which generate worries about infrastructure expansion and operational expenses and environmental sustainability. The worldwide shift toward renewable energy creates uncertainties in power supply that lead to grid instability and energy curtailment problems. This paper explores the synergistic convergence of AI compute infrastructure and Bitcoin (BTC) mining as a novel, energy-aware co-optimization framework. We propose a Distributional Multi-Agent Reinforcement Learning (MARL) system that dynamically allocates surplus energy between latency-sensitive AI jobs and highly flexible BTC mining operations. The proposed solution includes essential participants like renewable energy producers, energy management agents, AI clusters and BTC miners operating within a centralized training and decentralized execution paradigm. The simulation demonstrates that our MARL-driven methodology reduces the reduction in renewable energy by up to 65 \% while maintaining high BTC mining profitability and stable grid demand and ensuring AI service level compliance. These findings suggest a path toward sustainable, intelligent energy computation ecosystems where AI and blockchain technologies operate not as competitors, but as complementary agents within a unified infrastructure.},
  keywords      = {Training;Uncertainty;Smart cities;Profitability;Power supplies;Ecosystems;Bitcoin;Reinforcement learning;Real-time systems;Artificial intelligence;Bitcoin mining;Grid;Balance;Agents;Energy}
}
@article{11314845,
  title         = {Exploring Time Predictability for High-Bandwidth Memory Technology},
  author        = {Cilardo, Alessandro and Maddaluno, Manuel},
  year          = 2026,
  month         = {Jan},
  journal       = {IEEE Transactions on Emerging Topics in Computing},
  volume        = 14,
  number        = 1,
  pages         = {105--117},
  doi           = {10.1109/tetc.2025.3645133},
  issn          = {2168-6750},
  abstract      = {High Bandwidth Memory (HBM) is a 3D-stacked DRAM interface standard that provides higher bandwidth, lower power consumption, and a smaller footprint than DDR4 and GDDR5. It is increasingly adopted in supercomputers, datacenters, and high-end embedded platforms, such as autonomous driving systems, where it meets the performance demands of artificial intelligence and other data-intensive workloads. Beyond raw performance, many of these applications require deterministic or bounded response times, either for hard real-time safety-critical systems or to provide Quality-of-Service (QoS) guarantees in multi-tenant HPC, datacenter, and cloud environments. While performance predictability has been extensively studied for DDR memory controllers, it remains largely unexplored for HBM. Although HBM shares some characteristics with DDR, such as command reordering to reduce data bus reversals, it introduces additional challenges, including stricter timing constraints that increase command latency within bank groups. In this work, we propose an implementable architectural model of a deterministic HBM controller that addresses these challenges, together with a quantitative closed-form analysis to fully characterize its response times. We present a complete physical implementation derived from the model and describe practical simulation and synthesis toolflows enabling extensive experimental evaluation with real-world memory-intensive workloads, also including aspects such as the impact of address-to-bank/row/column mapping on HBM command performance. The proposed controller achieves a peak throughput of 13.5 GB/s per pseudo-channel and an aggregate peak throughput of 432 GB/s while providing time predictability guarantees.},
  keywords      = {Random access memory;Delays;Standards;Time factors;Throughput;Quality of service;Bandwidth;Real-time systems;Logic;IP networks;High-Bandwidth Memory (HBM);predictable DRAM controllers;accelerator memory}
}
@article{11315147,
  title         = {Retrospective on the Lax Report: Then and Now},
  author        = {Deelman, Ewa and Dongarra, Jack and Hendrickson, Bruce and Randles, Amanda and Reed, Daniel and Seidel, Edward and Yelick, Katherine},
  year          = 2025,
  journal       = {Computing in Science \& Engineering},
  pages         = {1--9},
  doi           = {10.1109/mcse.2025.3647733},
  issn          = {1558-366x},
  abstract      = {More than four decades after its release, the 1982 Lax Report remains a landmark blueprint for U.S. high-performance computing (HPC) policy. This retrospective revisits the report's four principal recommendations, evaluating each on its current fulfillment. While the HPC ecosystem has matured through network advances, broader access, and the integration of AI and distributed computing, gaps in workforce development, scientific software sustainability, and architectural innovation tailored to science needs remain. This article traces HPC's evolution from centralized supercomputers to today's cloud-augmented, AI-converged landscape and highlights how market-driven hardware design increasingly diverges from the needs of rigorous scientific computing. The paper also calls for sustained public investment in hardware-software co-design, workforce pipelines, and open, science-centered infrastructure.},
  keywords      = {Investment;Software;Scientific computing;Artificial intelligence;Hardware;Cloud computing;Vectors;Supercomputers;Software algorithms;Ecosystems}
}
@article{11320933,
  title         = {Optimizing Management of Persistent Data Structures in High-Performance Analytics},
  author        = {Youssef, Karim and Iwabuchi, Keita and Gokhale, Maya and Feng, Wu-chun and Pearce, Roger},
  year          = 2026,
  month         = {Feb},
  journal       = {IEEE Transactions on Parallel and Distributed Systems},
  volume        = 37,
  number        = 2,
  pages         = {562--574},
  doi           = {10.1109/tpds.2025.3646133},
  issn          = {1558-2183},
  abstract      = {Large-scale data analytics workflows ingest massive input data into various data structures, including graphs and key-value datastores. These data structures undergo multiple transformations and computations and are typically reused in incremental and iterative analytics workflows. Persisting in-memory views of these data structures enables reusing them beyond the scope of a single program run while avoiding repetitive raw data ingestion overheads. Memory-mapped I/O enables persisting in-memory data structures without data serialization and deserialization overheads. However, memory-mapped I/O lacks the key feature of persisting consistent snapshots of these data structures for incremental ingestion and processing. The obstacles to efficient virtual memory snapshots using memory-mapped I/O include background writebacks outside the application's control, and the significantly high storage footprint of such snapshots. To address these limitations, we present Privateer, a memory and storage management tool that enables storage-efficient virtual memory snapshotting while also optimizing snapshot I/O performance. We integrated Privateer into Metall, a state-of-the-art persistent memory allocator for C++, and the Lightning Memory-Mapped Database (LMDB), a widely-used key-value datastore in data analytics and machine learning. Privateer optimized application performance by 1.22\texttimes{} when storing data structure snapshots to node-local storage, and up to 16.7\texttimes{} when storing snapshots to a parallel file system. Privateer also optimizes storage efficiency of incremental data structure snapshots by up to 11\texttimes{} using data deduplication and compression.},
  keywords      = {Data structures;Memory management;Data analysis;Optimization;Storage management;Semantics;Tuning;Programming;File systems;Distributed databases;High-performance computing;large-scale data analytics;memory-mapped i/o;snapshots;storage systems;tool;user-level paging}
}
@inproceedings{11321406,
  title         = {Bridging the Gap between Academic Curricula and Industry Requirements through Faculty Industry Internships},
  author        = {Thomas, Bindu A. and Banu, Mujeeda and M G, Divya and Thakkar, Rushali and Marimuthu, Ramalatha},
  year          = 2025,
  month         = {July},
  booktitle     = {2025 11th International Conference on Control, Decision and Information Technologies (CoDIT)},
  volume        = 1,
  pages         = {1542--1546},
  doi           = {10.1109/CoDIT66093.2025.11321406},
  issn          = {2576-3555},
  abstract      = {The persistent disconnect between academic curricula and industry requirements remains a critical challenge in higher education, particularly in fast-evolving fields such as artificial intelligence (AI), semiconductor technology, and cyber security. This paper proposes faculty industry internships as a transformative mechanism to align academic training with industry needs. By immersing faculty in industry environments, these programs empower educators to acquire practical skills, integrate real-world insights into teaching, and mentor students effectively. Case studies from Indian institutions like IISc Bengaluru and C-DAC demonstrate the success of Faculty Development Programs (FDPs) in fostering industry-relevant competencies, while empirical data from a mixed-methods study involving 150 faculty members and 30 industry experts highlight improved curriculum alignment and student employability. Challenges such as faculty resistance and funding constraints are addressed through hybrid models and policy reforms like the National Education Policy (NEP) 2020. The paper concludes with actionable strategies for institutions and policymakers to prioritize faculty-industry collaboration, ensuring the sustainability and relevance of technical education in India.},
  keywords      = {Industries;Training;Resistance;Collaboration;Curriculum development;Sustainable development;Artificial intelligence;Information technology;Computer crime;Faculty internships;industry-academia collaboration;curriculum design;technology integration;mentorship;sustainability;Indian higher education}
}
@inproceedings{11322340,
  title         = {The Challenges of Setting up Sustainable Research Data Infrastructure},
  author        = {Ganzenm\"{u}ller, Andreas and Rodrigues, Preston and Kushnarenko, Volodymyr and Puskaric, Miroslav and B\"{o}nisch, Thomas},
  year          = 2025,
  month         = {Sep.},
  booktitle     = {2025 IEEE 13th International Conference on Intelligent Data Acquisition and Advanced Computing Systems: Technology and Applications (IDAACS)},
  pages         = {1--5},
  doi           = {10.1109/idaacs68557.2025.11322340},
  issn          = {2770-4254},
  abstract      = {Research project setups in academia usually do not outlive the end of the project. This is even more prominent for academic projects that deal with research data infrastructure. To address this the High-Performance Computing Center Stuttgart (HLRS) is looking at a sustainable approach to operate research data infrastructure. At its core this approach consists of building up a dedicated platform. The overall goal is to benefit from synergy effects by having services of multiple projects sharing the same hardware platform thereby reducing project costs, as well as to accumulate experience from different projects regarding research data management and research data infrastructure within one comprehensive team.},
  keywords      = {Costs;High performance computing;Data acquisition;Buildings;Hardware;Maintenance;Sustainable development;Infrastructure;Research Data;Data Management;Sustainability;Virtualisation}
