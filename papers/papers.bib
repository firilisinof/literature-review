  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84900304907&doi=10.1557%2Fopl.2013.809&partnerID=40&md5=315ea1667f4272c76dde7bf6e2ea7b39},
  note          = {Cited by: 1},
  abstract      = {High Performance Computing (HPC) Wales was launched in 2010 as a five year joint venture between Wales' six Universities, working in partnership with a variety of academic and industrial stakeholders and funded by the EU, UK and Welsh Governments. The aim of HPC Wales is to deliver a pan-Wales HPC infrastructure: primarily to assist with economic regeneration in the Principality of Wales (which has a population of approximately 3.6 million) through the up-skilling of individuals and by promoting uptake of HPC in Welsh businesses, but also open to collaborations from outside Wales. It is the first national service of its kind in Europe. In order to encourage the uptake of HPC into small and medium sized enterprises (of up to 250 staff) in Wales, and for HPC Wales itself to become a sustainable business, the development of a strong skills base is vital. Successful delivery will be marked by the successful upskilling of individuals via accredited training programmes, and through outreach and engagement activities. Recognising that a significant amount of upskilling is required, further work is being undertaken by HPC Wales to develop workflows which can help to simplify the HPC job submission process for the end user. This will make it possible for businesses to achieve results without their needing to acquire a high level of specialist HPC skills in the short term. At a mid-point in this ambitious venture, this paper examines the strategies being developed by HPC Wales which will help to ensure propagation throughout the educational chain so that the requisite skills and workflows are in place which will benefit the next-generation workforce. Through this, HPC Wales hopes to assist in the overall advancement of scientific discovery which will, in turn, help Welsh businesses to become more competitive in the global marketplace. \textcopyright{} 2013 Materials Research Society.},
  keywords      = {Materials science; Global marketplaces; High performance computing (HPC); Job submission; Joint ventures; Scientific discovery; Small and medium sized enterprise; Sustainable business; Training programmes; Education},
  type          = {Conference paper},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Redies2022,
  title         = {Fast All-Electron Hybrid Functionals and Their Application to Rare-Earth Iron Garnets},
  author        = {Redies, Matthias and Michalicek, Gregor and Bouaziz, Juba and Terboven, Christian and M\"{u}ller, Matthias S. and Bl\"{u}gel, Stefan and Wortmann, Daniel},
  year          = 2022,
  journal       = {Frontiers in Materials},
  volume        = 9,
  doi           = {10.3389/fmats.2022.851458},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85127943979&doi=10.3389%2Ffmats.2022.851458&partnerID=40&md5=4656c4d8352787b74dcc02e1475abe22},
  note          = {Cited by: 4; All Open Access; Gold Open Access; Green Open Access},
  abstract      = {Virtual materials design requires not only the simulation of a huge number of systems, but also of systems with ever larger sizes and through increasingly accurate models of the electronic structure. These can be provided by density functional theory (DFT) using not only simple local approximations to the unknown exchange and correlation functional, but also more complex approaches such as hybrid functionals, which include some part of Hartree–Fock exact exchange. While hybrid functionals allow many properties such as lattice constants, bond lengths, magnetic moments and band gaps, to be calculated with improved accuracy, they require the calculation of a nonlocal potential, resulting in high computational costs, that scale rapidly with the system size. This limits their wide application. Here, we present a new highly-scalable implementation of the nonlocal Hartree-Fock-type potential into FLEUR--an all-electron electronic structure code that implements the full-potential linearized augmented plane-wave (FLAPW) method. This implementation enables the use of hybrid functionals for systems with several hundred atoms. By porting this algorithm to GPU accelerators, we can leverage future exascale supercomputers which we demonstrate by reporting scaling results for up to 64 GPUs and up to 12,000 CPU cores for a single k-point. As proof of principle, we apply the algorithm to large and complex iron garnet materials (YIG, GdIG, TmIG) that are used in several spintronic applications. Copyright \textcopyright{} 2022 Redies, Michalicek, Bouaziz, Terboven, M\"{u}ller, Bl\"{u}gel and Wortmann.},
  author_keywords = {Density Functional Theory (DFT); GdIG; High-Performance Computing (HPC); Hybrid Functionals; PBE0; Rare-Earth Iron Garnets; TmIG; YIG},
  keywords      = {Computation theory; Design for testability; Electronic structure; Energy gap; Iron; Lattice constants; Lattice theory; Magnetic moments; Program processors; Rare earths; Supercomputers; Density functional theory; Density-functional-theory; Electronic.structure; GdIG; High-performance computing; Hybrid functionals; PBE0; Performance computing; Rare-earth iron garnet; TmIG; Density functional theory},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
