@inproceedings{10445076,
  title         = {Short-Term Hours Ahead Forecast of Expected Available Solar Power Using Linear Regression Machine Learning Scheme},
  author        = {Yusuff, Adedayo Ademola and Mosetlhe, Thapelo Cornelius},
  year          = 2024,
