 author_keywords = {Green-Aware Scheduling; High Performance Computing; Job Scheduling; Multi-objective Reinforcement Learning; Reinforcement Learning},
 doi = {10.1007/978-981-95-4960-3_33},
 journal = {Lecture Notes in Computer Science},
 keywords = {Computational cost; Cost reduction; Deep learning; Deep reinforcement learning; Green computing; Job shop scheduling; Multitasking; Scheduling algorithms; Green-aware scheduling; High performance computing; Jobs scheduling; Multi objective; Multi-objective reinforcement learning; Performance computing; Price signals; Reinforcement learnings; Renewables; Reinforcement learning},
