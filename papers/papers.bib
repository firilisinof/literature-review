  year          = 2009,
  journal       = {Waste Management},
  volume        = 29,
  number        = 4,
  pages         = {1409--1415},
  doi           = {10.1016/j.wasman.2008.10.009},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-59849114883&doi=10.1016%2Fj.wasman.2008.10.009&partnerID=40&md5=4a8d61a7ecd916d631af69b2ef7e7040},
  note          = {Cited by: 96},
  abstract      = {The present study describes the production and characterization of a feather hydrolyzing enzyme by Serratia sp. HPC 1383 isolated from tannery sludge, which was identified by the ability to form clear zones around colonies on milk agar plates. The proteolytic activity was expressed in terms of the micromoles of tyrosine released from substrate casein per ml per min (U/mL min). Induction of the inoculum with protein was essential to stimulate higher activity of the enzyme, with 0.03\% feathermeal in the inoculum resulting in increased enzyme activity (45 U/mL) that further increased to 90 U/mL when 3 d old inoculum was used. The highest enzyme activity, 130 U/mL, was observed in the presence of 0.2\% yeast extract. The optimum assay temperature and pH for the enzyme were found to be 60 \textdegree{}C and 10.0, respectively. The enzyme had a half-life of 10 min at 60 \textdegree{}C, which improved slightly to 18 min in presence of 1 mM Ca<sup>2+</sup>. Inhibition of the enzyme by phenylmethyl sulfonyl fluoride (PMSF) indicated that the enzyme was a serine protease. The enzyme was also partially inhibited (39\%) by the reducing agent \ensuremath{\beta}-mercaptoethanol and by divalent metal ions such as Zn<sup>2+</sup> (41\% inhibition). However, Ca<sup>2+</sup> and Fe<sup>2+</sup> resulted in increases in enzyme activity of 15\% and 26\%, respectively. The kinetic constants of the keratinase were found to be 3.84 \ensuremath{\mu}M (K<sub>m</sub>) and 108.7 \ensuremath{\mu}M/mL min (V<sub>max</sub>). These results suggest that this extracellular keratinase may be a useful alternative and eco-friendly route for handling the abundant amount of waste feathers or for applications in other industrial processes. \textcopyright{} 2008 Elsevier Ltd. All rights reserved.},
  keywords      = {Animals; Chickens; Culture Media; Feathers; Hydrogen-Ion Concentration; Industrial Waste; Keratins; Kinetics; Metals; Peptide Hydrolases; Serratia; Tanning; Temperature; Serratia sp. HPC1383; Amino acids; Calcium; Enzyme activity; Enzymes; Metal ions; Polysaccharides; Zinc; bacterial enzyme; benzylsulfonyl fluoride; calcium ion; dimethyl sulfoxide; edetic acid; ferrous ion; keratin; keratinase; mercaptoethanol; protein hydrolysate; serine proteinase; zinc ion; Agar plates; Divalent metal ions; Eco-friendly; Extracellular keratinase; Industrial process; Keratinase; Kinetic constants; Mercaptoethanol; Poultry feathers; Proteolytic activities; Serine protease; Serratia; Tannery sludges; Yeast extracts; amino acid; cation; environmental impact; enzyme activity; feather; hydrolysis; phenolic compound; poultry; sludge; waste treatment; article; bacterium isolate; concentration response; controlled study; enzyme activity; enzyme inhibition; feather; half life time; nonhuman; nucleotide sequence; pH; poultry; priority journal; protein degradation; protein hydrolysis; Serratia; solid waste management; temperature dependence; Enzyme inhibition},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
