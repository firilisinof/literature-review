  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105027574775&doi=10.1007%2F978-3-032-11515-7_19&partnerID=40&md5=92cac36f133ad700e1c812f3888b9762},
  note          = {Cited by: 0; All Open Access; Green Open Access},
  abstract      = {Time series forecasting faces challenges from non-stationarity, complex dependencies, and computational demands. Temporal Kolmogorov-Arnold Networks (TKANs) have emerged as a promising alternative to traditional deep learning models, leveraging learnable univariate functions for improved parameter efficiency and interpretability. However, a systematic comparison of TKAN variants is lacking. This paper presents the first comprehensive evaluation of state-of-the-art TKAN models, including TimeKAN, RMoK, and MT-KAN, across large-scale benchmark datasets. We identify a shared limitation in modeling inter-variable dependencies for multivariate forecasting and introduce HiPPO-KAN-GNN, a novel extension incorporating Graph Neural Networks to address this issue. Experiments on a high-performance computing cluster demonstrate consistent accuracy improvements with our model. Additionally, we conduct a sustainability analysis, measuring energy consumption and carbon footprint, offering critical insights for green AI deployment. This study provides a holistic view of TKANs' performance, scalability, and environmental impact, advancing both their practical application and sustainable machine learning research. \textcopyright{} The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
  author_keywords = {Graph Neural Networks; Kolmogorov-Arnold Networks; Time Series Forecasting},
  keywords      = {Benchmarking; Deep learning; Environmental impact; Forecasting; Green computing; Large datasets; Learning systems; Neural networks; Sustainable development; Time series; Computational demands; Graph neural networks; Kolmogorov; Kolmogorov-arnold network; Learning models; Multivariate time series; Network-based; Non-stationarities; Time series forecasting; Univariate functions; Energy utilization},
  type          = {Conference paper},
