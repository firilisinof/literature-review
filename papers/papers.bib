@article{Lu202316778,
  title         = {Hierarchical Porous Carbon/Co Nanocomposites Derived from Biomass for High-Performance Microwave Absorption},
  author        = {Lu, Chengxu and Geng, Haoran and Ma, Jinming and Zhao, Jianqiao and Wang, Rongwen and An, Zhaojun and Tu, Guoli},
  year          = 2023,
  journal       = {ACS Applied Nano Materials},
  volume        = 6,
  number        = 18,
  pages         = {16778--16789},
  doi           = {10.1021/acsanm.3c02981},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85173186275&doi=10.1021%2Facsanm.3c02981&partnerID=40&md5=79443893d806fdbfa2b5682bafc465fc},
  note          = {Cited by: 18},
  abstract      = {Biomass-derived carbon materials have attracted considerable attention in electromagnetic wave (EMW) absorption applications due to their advantages of low cost, light weight, and sustainability. Herein, loofah sponge-derived hierarchical porous carbon nanocomposites (HPC/Co-T) were successfully synthesized by a facile dipping and subsequent carbonization method. The combination of hierarchical porous carbon with magnetic Co nanoparticles takes advantage of the synergistic effect of dielectric loss and magnetic loss, which is a compelling route to improve impedance matching and EMW attenuation capacity. The specific surface area, carbon defects, and electromagnetic parameters of the HPC/Co-T nanocomposites are effectively regulated through carbonization temperature. The HPC/Co-700 nanocomposite annealed at 700 \textdegree{}C with a filler content of 15 wt \% exhibits an RL<sub>min</sub> value of -66.8 dB at a thickness of 2.4 mm. Meanwhile, a broad effective absorption bandwidth of 5.5 GHz ranging from 11.7 to 17.2 GHz can be achieved at a thickness of 2.1 mm. This work provides a strategy for the fabrication of low-cost, sustainable, lightweight, and high-performance EMW-absorbing materials from nature biomass. \textcopyright{} 2023 American Chemical Society.},
  author_keywords = {biomass; electromagnetic wave absorption; hierarchical porous structure; impedance matching; lightweight},
  keywords      = {Biomass; Carbon; Carbonization; Circular waveguides; Costs; Dielectric losses; Impedance matching (electric); Nanocomposites; Porous materials; Carbon material; Carbon nanocomposite; Derived carbons; Hierarchical porous carbons; Hierarchical porous structures; Impedance matchings; Lightweight; Low-costs; Microwave absorption; Performance; Electromagnetic wave absorption},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
