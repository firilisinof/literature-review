@article{Khan2024,
  title         = {Machine learning-based surrogate modelling of a robust, sustainable development goal (SDG)-compliant land-use future for Australia at high spatial resolution},
  author        = {Khan, Md Shakil and Moallemi, Enayat A. and Thiruvady, Dhananjay and Nazari, Asef and Bryan, Brett A.},
  year          = 2024,
  journal       = {Journal of Environmental Management},
  volume        = 363,
  doi           = {10.1016/j.jenvman.2024.121296},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85195030127&doi=10.1016%2Fj.jenvman.2024.121296&partnerID=40&md5=3517c274193d6c2678328d9fc034c4e9},
  note          = {Cited by: 7},
  abstract      = {We developed a high-resolution machine learning based surrogate model to identify a robust land-use future for Australia which meets multiple UN Sustainable Development Goals. We compared machine learning models with different architectures to pick the best performing model considering the data type, accuracy metrics, ability to handle uncertainty and computational overhead requirement. The surrogate model, called ML-LUTO Spatial, was trained on the Land-Use Trade-Offs (version 1.0) model of Australian agricultural land system sustainability. Using the surrogate model, we generated projections of land-use futures at 1.1 km resolution with 95\% classification accuracy, and which far surpassed the computational benchmarks of the original model. This efficiency enabled the generation of numerous SDG-compliant (SDGs 2, 6, 7, 13, 15) future land-use maps on a standard laptop, a task previously dependent upon high-performance computing clusters. Combining these projections, we derived a single, robust land-use future and quantified the uncertainty. Our findings indicate that while agricultural land-use remains dominant in all Australian regions, extensive carbon plantings were identified in Queensland and environmental plantings played a role across the study area, reflecting a growing urgency for offsetting greenhouse gas emissions and the restoration of ecosystems to support biodiversity across Australia to meet the 2050 Sustainable Development Goals. \textcopyright{} 2024 Elsevier Ltd},
  author_keywords = {Land-use futures; Machine learning; Robustness; Surrogate modelling; Sustainable development goals},
  keywords      = {Agriculture; Australia; Biodiversity; Conservation of Natural Resources; Ecosystem; Machine Learning; Models, Theoretical; Sustainable Development; Agriculture; Biodiversity; Economic and social effects; Gas emissions; Greenhouse gases; Machine learning; Sustainable development; carbon; Australia; High resolution; High spatial resolution; Land-use future; Machine-learning; Plantings; Robustness; Surrogate modeling; Sustainable development goal; Uncertainty; agricultural land; biodiversity; future prospect; greenhouse gas; land use change; machine learning; spatial resolution; Sustainable Development Goal; accuracy; agricultural land; architecture; Article; artificial neural network; Australia; Australian; benchmarking; biodiversity; computer model; controlled study; convolutional neural network; ecosystem restoration; environmental management; environmental sustainability; feed forward neural network; gated recurrent unit network; greenhouse gas emission; land development; land use; land use planning; land use trade off model; machine learning; multilayer perceptron; Queensland; spatial soil variability; sustainable development goal; uncertainty; agriculture; ecosystem; environmental protection; sustainable development; theoretical model; Land use},
