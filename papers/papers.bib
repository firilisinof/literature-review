  title         = {Fundamental Research and Space Economy: the Italian strategy in the new "High-Performance Computing, Big Data e Quantum Computing Research Centre"},
  author        = {Bonacorsi, Daniele and Boccali, Tommaso and Malvezzi, Sandra},
  year          = 2024,
