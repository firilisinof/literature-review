@inproceedings{10687383,
  title         = {Leveraging Green Supply Chain Practices to Enhance Resource Management and Load Balancing through High-Performance Computing for Sustainability},
  author        = {Shah, Janmejai Kumar and Sharma, Rajat and Kaushal, Deepak and Sharma, Manu and Joshi, Sudhanshu},
  year          = 2024,
  month         = {June},
  booktitle     = {2024 OPJU International Technology Conference (OTCON) on Smart Computing for Innovation and Advancement in Industry 4.0},
  pages         = {1--6},
  doi           = {10.1109/otcon60325.2024.10687383},
  abstract      = {This paper investigates the leveraging of integration of green supply chain strategies and high-performance computing to sustainable resource management and load balancing. It addresses environmental and socioeconomic issues through interdisciplinary collaboration. The paper examines circular economy methods, dynamic capacity theory, and green human resource management, emphasizing the significance of circular economy-based solid waste management solutions through bibliometric, epistemological and substantive analysis. The study focuses on identification of 8 criteria's 26 sub criteria's through which three major areas for enhancing resource management and load balancing were found: GIS-enhanced supply chain dynamics, ICT infrastructure life cycle assessment tools, and circular economy-based solid waste management solutions, with an emphasis on technology and sustainability. By focusing on these study areas, companies can promote environmental stewardship and economic resilience in modern supply networks, paving the path for a more sustainable future.},
  keywords      = {Waste materials;Technological innovation;High performance computing;Green products;Supply chains;Load management;Dynamic scheduling;Green Supply chain;load balancing;resource management;high performance computing;Sustainability and Carbon footprint}
}
@inproceedings{10692243,
  title         = {Low Power 3-Bit Decoder Design using Memristor},
  author        = {Ganesh, Karrothu and Venkata Sai Rakesh, Karri Surya and Magthelin Therase, L. and Joany, R. M. and Anna Devi, E.},
  year          = 2024,
  month         = {July},
  booktitle     = {2024 2nd World Conference on Communication \& Computing (WCONF)},
  pages         = {1--6},
  doi           = {10.1109/wconf61366.2024.10692243},
  abstract      = {In the pursuit of energy-efficient and innovative VLSI designs, the integration of memristor technology has emerged as a promising avenue. This project endeavours to explore the design and implementation of a low-power 3-bit decoder utilizing memristor devices. The memristor's unique properties, such as non-volatility and low energy consumption, offer an unprecedented opportunity for advancing VLSI circuits. The proposed 3-bit decoder leverages memristors to decode a 3-bit binary input into a unique 3-bit output representation, enabling a compact and efficient decoding solution. Throughout the project, various low-power design methodologies and memristor-based optimization techniques are investigated to minimize power consumption while ensuring reliable performance. This project not only delves into the theoretical underpinnings of memristor technology but also embraces practical challenges in designing memristor-based VLSI circuits. Extensive simulations and verification processes are conducted to validate the decoder's correctness and robustness. The potential applications of memristor-based decoders extend beyond this specific project, contributing to the broader exploration of memristor technologies and their integration into modern VLSI designs. The outcomes of this study will not only enrich the realm of VLSI but also pave the way for more energy-efficient and technologically advanced integrated circuits, propelling the semiconductor industry towards a sustainable and innovative future.},
  keywords      = {Power demand;Memristors;Very large scale integration;Reliability theory;Propulsion;Reliability engineering;Energy efficiency;Robustness;Decoding;Logic;Decoder;Memristor;CMOS technology;Transient;Ltspice}
}
@inproceedings{10705403,
  title         = {Towards Green HPC Job Outsourcing: Energy Models for Molecular Dynamics Simulations on Three Clusters},
  author        = {Horn, Ruben and Neumann, Philipp},
  year          = 2024,
  month         = {July},
  booktitle     = {2024 23rd International Symposium on Parallel and Distributed Computing (ISPDC)},
  pages         = {1--8},
  doi           = {10.1109/ispdc62236.2024.10705403},
  issn          = {2996-1483},
  abstract      = {In order to facilitate outsourcing of HPC jobs to remote computing resources powered directly by renewable energy, we aim to model the energy requirement of MD simulations on a single node. First, three different clusters are compared using an example simulation scenario with varying volume using a simple linear model. Then we investigate the impact of the density and simulated substance (number of LJ sites) and confirm their linear effect on the energy consumption of the simulation. Combining these insights with direct energy measurements could allow the prediction of the total energy required for a given job. Other simulation parameters, such as the temperature, and hardware parameters like FLOPS and cache size, should be added to such a model in the future to improve its generalizability.},
  keywords      = {Temperature measurement;Solid modeling;Energy consumption;Renewable energy sources;Computational modeling;Green products;Energy measurement;Hardware;Outsourcing;Distributed computing;energy consumption modelling;green computing;high performance computing;molecular dynamics}
}
@inproceedings{10709417,
  title         = {A novel Design for Improving Heat Dissipation Capacity of Single-Phase Immersion Cooling System with the Perturbation Mechamism},
  author        = {Hsu, Po-Chien and Wu, Jiahong and Kuo, Chia-Lung and Chen, Carrie and Zhang, Jun and Lo, Ying-Shan and Haung, Po-Tsang},
  year          = 2024,
  month         = {May},
  booktitle     = {2024 23rd IEEE Intersociety Conference on Thermal and Thermomechanical Phenomena in Electronic Systems (ITherm)},
  pages         = {1--5},
  doi           = {10.1109/ITherm55375.2024.10709417},
  issn          = {2694-2135},
  abstract      = {With the explosive demands for high performance computing, especially the emerging artificial intelligence generated content (AIGC) with large language model (LLM) on stage, higher performance CPUs and GPUs are constantly being innovated to meet the demand of higher computability. Higher performance also means more heat is generated from CPUs and GPUs. The recent trend in the industry that the thermal design power (TDP) of data center microprocessors is projected to increase from 350 watts to 1200 watts, or above in the coming 3 years.The study in this paper has increased the overall heat transfer capability by improving the upward speed of dielectric coolant with a novel perturbation design. The experimental method is to use Intel 4th Gen Xeon Scalable Processors along with Intel Open IP immersion cooling system for actual measurement, the CPU Tjunction temperature with the novel perturbation design is achieved at least 13.27\% lower than that without perturbation design. This paper also details such novel perturbation design mechanism and engineering results to conclude single phase immersion cooling solution is capable of addressing the challenge of data center cooling for up to 1500W TDP or above high heat flux processors.},
  keywords      = {Temperature measurement;Data centers;Program processors;Perturbation methods;Immersion cooling;Thermal management;Heat sinks;Sustainable development;Heat transfer;Space heating;immersion cooling;single-phase immersion;perturbation}
}
@inproceedings{10709473,
  title         = {Analysis on Long Term Reliability of Single-phase Immersion Solution based on Data Center Deployment},
  author        = {Wang, Yulong and Gui, Chenglong and Shen, Chen and Cheng, Pengfei and Wang, Chen and Wang, Ruidong and Wang, Shifeng and Jing, Tangbo and Lin, Bin and Tian, Wenbin and Xu, Jialiang and Li, Zhiming and Zhang, Zhichao and Zhang, Xu and Zhang, Zhijie and Wu, Lihui and Wang, Kai and Ahuja, Sandeep and Ahuja, Nishi},
  year          = 2024,
  month         = {May},
  booktitle     = {2024 23rd IEEE Intersociety Conference on Thermal and Thermomechanical Phenomena in Electronic Systems (ITherm)},
  pages         = {1--8},
  doi           = {10.1109/ITherm55375.2024.10709473},
  issn          = {2694-2135},
  abstract      = {Data centers (DCs) are mission critical infrastructures composed of thousands of Information Technology Equipment (ITE) including servers, network switches, Uninterruptible Power Supply (UPS), cooling system etc. In the past decade, skyrocketing demand from Cloud and artificial intelligence (AI) has led to explosive growth in number of DCs worldwide, which introduces tremendous needs for electricity as well as significant amounts of heat dissipation. Both ITE and cooling systems are huge-power consuming. In order to conserve energy while maintaining electronic devices under reasonable operation temperature, advanced and efficient cooling technology has become crucial and has attracted more attention from DC's operators in pursue of optimal performance, reliability, sustainability as well as Power Usage Effectiveness (PUE).Among the novel cooling technologies, single-phase immersion cooling (1-PIC) solution has been deeply investigated by Cloud Service Provides (CSPs). Some pioneer CSPs have even adopted 1- PIC volume deployment in DC. However, existing research and literatures mostly focused on thermal design optimization. Industry is lack of long-term operation data in terms of thermal performance degradation, periodic analysis on immersion fluid content and impact on electric performance. Most DCs still hesitate to adopt this novel cooling technology for deployment.Volcano Engine, public CSP under ByteDance.COM, has investigated technical feasibility of 1-PIC with fluorochemical fluid for DC's application for years. Based on the architecture previously published in ITherm 2023, hundreds of servers under immersion environment have been operating as pilot deployment for six months already out of planned twelve-month research. Massive amounts of first-hand operation and reliability data are being collected to support long-term reliability research, including analysis on variation of CPU Digital Temperature Sensor (DTS) temperature, fluid content, material compatibility, impact on Signal Integrity (SI) etc. This paper presents the data collected with analysis from long-term reliability tests covering multiple perspectives. The collected results and analysis should be able to support long-term stability and maturity of 1-PIC solution, which will support the following volume adoption and deployment of this novel technology in DC for achieving better PUE.},
  keywords      = {Temperature sensors;Data centers;Cloud computing;Fluids;Thermomechanical processes;Materials reliability;Servers;Artificial intelligence;Uninterruptible power systems;Thermal stability;Data Center;Single-Phase Immersion Cooling;Fluorochemical Fluid;Cloud Computing;PUE;Material Compatibility and Long-Term Reliability}
}
@inproceedings{10709499,
  title         = {Long-Term Reliability Test on An Air Assisted Liquid Cooling System},
  author        = {Hang, Yin and Zhang, Wenying and Piette, Grace and Pichumani, Pradip Sairam and Tseng, Joseph and Mariam, Feroz Ahamed Iqbal and Yaroch, K eegan and Chen, Ellie and Lokhande, Mahendra and Fernandes, John and Li, Yueming and Xu, Jiu and Chen, Cheng and Mithani, Noman},
  year          = 2024,
  month         = {May},
  booktitle     = {2024 23rd IEEE Intersociety Conference on Thermal and Thermomechanical Phenomena in Electronic Systems (ITherm)},
  pages         = {1--6},
  doi           = {10.1109/ITherm55375.2024.10709499},
  issn          = {2694-2135},
  abstract      = {The power density of advanced-node semiconductors used in HPC applications has been increasing. Simultaneously, the adoption of advanced packaging techniques such as 2.5D, 3D, and heterogeneous integration has posed significant challenges for cooling these HPC applications. It has become evident that traditional air-cooling methods are insufficient for cooling HPC systems, necessitating the use of liquid cooling. However, liquid cooling technologies come with their own set of challenges which are currently being identified and understood by the industry. Air-assisted Liquid Cooling (AALC) system is one of the solutions that can be adopted into the data center without the need of the infrastructure-wise upgrade. To gain confidence in this technology, ensuring the reliability and sustainability of this system is of utmost importance. To achieve this, we have conducted an extensive long-term reliability test over one year duration, continuously monitoring the system's operation and performance in an accelerated environment. In this paper, we will discuss the setup of the long-term reliability test, examine the degradation of system performance over time, and explore our methods for monitoring the test while it is in operation.In addition, one notable challenge is the reliability of materials that come into direct contact with the coolant, as it can lead to potential corrosion and material incompatibility issues. This can result in cooling efficiency degradation in the event of microchannel blockages by corrosion byproducts and more critically can lead to catastrophic failure in the affected CPUs, racks, and possibly the whole facility. In this study, we will also show how we identify and address the root causes of issues encountered during this collaborative effort and lesson learned.},
  keywords      = {Degradation;Liquid cooling;Power demand;Costs;System performance;Corrosion;Materials reliability;Life estimation;Performance analysis;Monitoring;Liquid Cooling;Air Assisted Liquid Cooling;Reliability;Cold Plate;Material Compatibility}
}
@inproceedings{10709588,
  title         = {Thermal Performance Characteristic of Single-phase Immersion Cooling on Servers with Optimized Heatsink Design},
  author        = {Wang, Jin and Xu, Shoubiao and Fan, Linghao and Gao, Maoju and Zhang, Wenda and He, Yuwei and Wang, Xinbing and Huang, Qian and Li, Jie and Zeng, Qinchu and Liu, Chao and Zhao, Yan and Zhou, Lizhi and Tian, Wenbin and Zhou, Chao and Liang, Xiaoguo and Zhang, Zhichao and Liu, Yang and Zhu, Kunye and Wu, Lihui and Ahuja, Nishi},
  year          = 2024,
  month         = {May},
  booktitle     = {2024 23rd IEEE Intersociety Conference on Thermal and Thermomechanical Phenomena in Electronic Systems (ITherm)},
  pages         = {1--7},
  doi           = {10.1109/ITherm55375.2024.10709588},
  issn          = {2694-2135},
  abstract      = {The rapid development of artificial intelligence (AI), high performance computing (HPC), communication technology and cloud service has been requesting high performance of servers powered by CPU and GPU in data centers (DCs). In order to meet the commercial and industrial demand, the thermal design power (TDP) of both CPU and GPU has been rising from generation to generation due to constant increase on the core count, cache size and heat flux density. Intel XEON processor has reached 350W and Nvidia's H100 GPU even up to 700W on TDP. This exposes huge challenges on system thermal design with traditional air-cooling solution under current boundary condition of heatsink keep out zone (KOZ), air flow and off-the-shelf heatsink technologies. Therefore, liquid cooling has more attention to address the thermal management challenges from increasing TDP of chips and rack power density in DCs. Among these novel liquid cooling solutions, the singlephase immersion cooling(1-PIC) has emerged due to the special advantages over air-cooling solution in terms of enhanced cooling capability, improved components operation reliability and optimal Power usage effectiveness (PUE).Tencent Cloud (Tencent) has huge amount deployment of servers in DCs globally to respond the demand of all walks of life and consumes huge electricity energy each year. In order to reduce carbon footprint and accomplish green and sustainable DC, one 1-PIC solution prototype with fluorochemical fluid is built to investigate the cooling performance and optimization for application in future. This paper presents both computational fluid dynamics (CFD) analysis and experimental investigation to study the thermal performance characteristic of 1-PIC on servers developed by Tencent on Intel Eagle Stream (EGS) platform. Thermal performance is characterized based on system level to represent the real operation scenarios. Meanwhile, this paper also describes the design of prototype tank, rework on servers for immersion, thermal interface material (TIM) selection and impact on thermal cooling performance from different heatsink design, fluid flowrate and fluid inlet temperature. It is demonstrated that 1-PIC solution could deliver better cooling capability and support higher TDP of CPU than traditional aircooling solution, which could be a promising cooling methodology for high-power server's adoption in DCs.},
  keywords      = {Heating systems;Fluids;Liquid cooling;Computational fluid dynamics;Thermomechanical processes;Graphics processing units;Prototypes;Thermal management;Servers;Artificial intelligence;AI;HPC;TDP;thermal performance characteristic;Single-Phase Immersion Cooling;Data Center;Cloud Service and PUE}
}
