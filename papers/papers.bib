  author        = {Rong, Huigui and Zhang, Haomin and Xiao, Sheng and Li, Canbing and Hu, Chunhua},
  year          = 2016,
  journal       = {Renewable and Sustainable Energy Reviews},
  volume        = 58,
  pages         = {674--691},
