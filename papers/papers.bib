  author        = {Trisunaryanti, Wega and Wijaya, Karna and Triyono, Triyono and Adriani, Anggita Rahma and Larasati, Savitri},
  year          = 2021,
  journal       = {Results in Engineering},
  volume        = 11,
  doi           = {10.1016/j.rineng.2021.100258},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85111277853&doi=10.1016%2Fj.rineng.2021.100258&partnerID=40&md5=b90c9edbf9c9e14b7f4bc30860ae1374},
  note          = {Cited by: 32; All Open Access; Gold Open Access; Green Open Access},
  abstract      = {In this work, hydrotreating Callophyllum inophyllum oil (CIO) was performed using hierarchical porous carbon (HPC) supported catalyst prepared from a massively produced waste, coconut lumber sawdust (Cocos nucifera L.), using only K<sub>2</sub>CO<sub>3</sub> as activating agent for a green process. Coconut lumber sawdust was carbonized at 700 \textdegree{}C for 2 h to obtain coke as starting material. The produced coke was then activated at various furnace temperature and K<sub>2</sub>CO<sub>3</sub>/Coke weight ratio to generate six different types of HPC supports: HPC2-600, HPC2-700, HPC3-600, HPC3-700, HPC4-600, and HPC4-700. Iodine value has shown that HPC prepared at 700 \textdegree{}C h using K<sub>2</sub>CO<sub>3</sub>/Coke weight ratio of 3 (HPC3-700) exhibited the best adsorptive capacity, thus, depicting the most promising potential as a hydrotreating catalyst. In the hydrotreatment of CIO at 550 \textdegree{}C for 2 h using 1:300 (catalyst:feed) weight ratio, with a small addition of Ni to the pore (2.76 wt\%), Ni/HPC3-700 catalyst, possessing 400.6 m<sup>2</sup> g<sup>-1</sup> BET surface area and 1.076 mmol g<sup>-1</sup> acidity value, was able to produce a satisfying result by yielding over 74 wt\% liquid product with 65 wt\% hydrocarbon compounds. According to reusability study, although a gradual decrease of deoxygenation effectivity can be reflected through a declining hydrocarbon production, the level of liquid product generated by the catalyst remained consistent after its 3rd use in the hydrotreatment. The use of a low-cost high performing catalyst for hydrotreating a highly available non-edible oil in this study has offered a more sustainable and economical biofuel production with an environmental benefit. \textcopyright{} 2021 The Authors},
  author_keywords = {Biofuel; Callophyllum inophyllum oil; Catalyst; Hierarchical porous carbon; Hydrotreatment},
  keywords      = {Carbon; Coke; Costs; Green Synthesis; Hydrocarbons; Lumber; Porous materials; Potash; Reusability; Adsorptive capacity; Biofuel production; Environmental benefits; Furnace temperatures; Hierarchical porous carbons; Hydrocarbon compounds; Hydrocarbon production; Hydrotreating catalysts; Catalyst supports},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@conference{Truong2013,
  title         = {Cryogenic single-phase heat transfer in a microscale pin fin heat sink},
  author        = {Truong, Eric D and Rasouli, Erfan and Narayanan, Vinod},
  year          = 2013,
  journal       = {ASME 2013 Heat Transfer Summer Conf. Collocated with the ASME 2013 7th Int. Conf. on Energy Sustainability and the ASME 2013 11th Int. Conf. on Fuel Cell Science, Engineering and Technology, HT 2013},
  volume        = 3,
  doi           = {10.1115/ht2013-17660},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84892950913&doi=10.1115%2FHT2013-17660&partnerID=40&md5=afb90ba60fc6eefe8b1e5abc6703cadc},
  note          = {Cited by: 1},
  abstract      = {A combined experimental and computational fluid dynamics study of single-phase liquid nitrogen flow through a microscale pin-fin heat sink is presented. Such cryogenic heat sinks find use in applications such as high performance computing and spacecraft thermal management. A circular pin fin heat sink in diameter 5 cm and 250 micrometers in depth was studied herein. Unique features of the heat sink included its variable cross sectional area in the flow direction, variable pin diameters, as well as a circumferential distribution of fluid into the pin fin region. The stainless steel heat sink was fabricated using chemical etching and diffusion bonding. Experimental results indicate that the heat transfer coefficients were relatively unchanged around 2600 W/m <sup>2</sup>-K for flow rates ranging from 2 - 4 g/s while the pressure drop increased monotonically with the flow rate. None of the existing correlations in literature on cross flow over a tube bank or micro pin fin heat sinks were able to predict the experimental pressure drop and heat transfer characteristics. However, three dimensional simulations performed using ANSYS Fluent showed reasonable (\sim{}7 percent difference) agreement in the average heat transfer coefficients between experiments and CFD simulations. Copyright \textcopyright{} 2013 by ASME.},
  keywords      = {Computational fluid dynamics; Cryogenics; Flow rate; Fuel cells; Heat transfer coefficients; Pressure drop; Sustainable development; Average heat transfers; Heat transfer characteristics; High performance computing; Micro pin fin heat sinks; Single-phase liquids; Spacecraft thermal management; Three dimensional simulations; Variable cross-sectional areas; Heat sinks},
  type          = {Conference paper},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Tsamandas2006817,
  title         = {Potential role of hepatic progenitor cells expression in cases of chronic hepatitis C and their relation to response to therapy: A clinicopathologic study},
  author        = {Tsamandas, Athanassios C. and Syrokosta, Ioulia and Thomopoulos, Konstantinos and Zolota, Vassiliki and Dimitropoulou, Dimitra and Liava, Anna and Coupoulou, Anna Antona and Siagris, Dimitrios and Petsas, Theodore and Karatza, Chrisoula and Gogos, Charalambos A.},
  year          = 2006,
  journal       = {Liver International},
  volume        = 26,
  number        = 7,
  pages         = {817--826},
  doi           = {10.1111/j.1478-3231.2006.01306.x},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-33746762849&doi=10.1111%2Fj.1478-3231.2006.01306.x&partnerID=40&md5=6ea1510e2b258877e41838f5cebcd482},
  note          = {Cited by: 28},
  abstract      = {Background: This study investigates the correlation of hepatic progenitor cells (HPC) expression with treatment response in patients with chronic hepatitis C. Design: The study comprised 77 liver biopsies with chronic hepatitis C (HCV). All patients were PCR-HCV (+) and received antiviral therapy with interferon or pegylated interferon \ensuremath{\alpha}-2b and ribavirin. Twenty-nine patients were assigned as responders (group A), 29 as nonresponders (group B) and 19 as relapsers (group C). Ten normal liver biopsies were used as controls. Liver paraffin sections were subjected (a) to immunohistochemistry using antibodies for cytokeratins 19 (CK19) and 7 (CK7), \ensuremath{\alpha}-fetoprotein (AFP), leukocyte common antigen (LCA) and CD34 antigen (b) to in situ hybridization for AFP mRNA and (c) to immunohistochemistry+in situ hybridization. Results were expressed as \% of positive cells following morphometric analysis. Results: HPC expression was present in all 87 specimens. In the control biopsies, rare HPC were detected. In the CH cases and according to AFP mRNA expression, the grade for \% HPC expression was: group B: 53.2 \pm{} 2.6> group C: 48.37 \pm{} 1.8> group A: 31.4 \pm{} 1.6 (group A vs B P < 0.01, group A vs C P < 0.01, group B vs C P > 0.05. Double stain revealed that HPC coexpressed CK19/AFP mRNA, CK7/ AFP mRNa and AFP protein/AFP mRNA. HPC-percentages were directly correlated with total HAI score (P < 0.01), fibrosis stage (P < 0.01), and transaminase values (P < 0.05). Conclusions: This study demonstrates that in cases of chronic hepatitis C, the significant association of HPC expression with the severity of disease and more specifically with the response to treatment implies that HPC development and proliferation may provide additional prognostic information and predict prognosis in such cases. \textcopyright{} 2006 Blackwell Munksgaard.},
  author_keywords = {Chronic hepatitis C; Fibrosis; Hepatic progenitor cells; Therapy},
  keywords      = {Adult; alpha-Fetoproteins; Antiviral Agents; Biological Markers; Biopsy; Cell Differentiation; Cell Proliferation; Drug Therapy, Combination; Female; Hepacivirus; Hepatitis C, Chronic; Humans; Interferon Alfa-2a; Interferon Alfa-2b; Keratin-19; Keratin-7; Liver; Male; Middle Aged; Polyethylene Glycols; Ribavirin; Stem Cells; alpha fetoprotein; aminotransferase; antivirus agent; CD34 antigen; CD45 antigen; cytokeratin 19; cytokeratin 7; interferon; messenger RNA; paraffin; peginterferon alpha2b; protein antibody; ribavirin; adult; article; cell maturation; cell proliferation; controlled study; correlational study; disease association; disease severity; drug response; female; hepatitis C; Hepatitis C virus; human; human cell; human tissue; immunohistochemistry; in situ hybridization; liver biopsy; liver cell; liver fibrosis; major clinical study; male; morphometrics; nonhuman; pathology; polymerase chain reaction; prediction; prognosis; protein expression; relapse; scoring system; statistical significance; stem cell},
