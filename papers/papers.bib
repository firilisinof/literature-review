  author        = {Toker, M. and \c{C}olak, E. and Sunar, F.},
  year          = 2021,
  journal       = {International Archives of the Photogrammetry, Remote Sensing and Spatial Information Sciences - ISPRS Archives},
  volume        = 43,
  number        = {B3-2021},
  pages         = {735--740},
  doi           = {10.5194/isprs-archives-XLIII-B3-2021-735-2021},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85115873866&doi=10.5194%2Fisprs-archives-XLIII-B3-2021-735-2021&partnerID=40&md5=55746517c75ce98afb781749d538e1f2},
  note          = {Cited by: 1; All Open Access; Gold Open Access; Green Open Access},
  abstract      = {Protected areas are important with land or water body ecosystems that have biodiversity, flora and fauna species. In Turkey, National Parks are one of the protected areas managed according to the National Parks Law No. 2873. Among them, the \"{A}\textdegree{}ǧneada Floodplain Forests National Park, located in Igneada town in the province of Klrklareli, Turkey has been declared as a national park in 2007, and has an importance being a rare ecosystem, which consists of wetland, swamp, lakes and coastal sand dunes. Planning of Protected Areas can be done in a variety of ways, taking into account the balance of protection/use and should follow policies and guidelines. Today, for the sustainability and effective management of forest ecosystems, remote sensing technology provides an effective tool for assessing and monitoring ecosystem health at different temporal and spatial scales. In this study, potential temporal changes in the National Park were analyzed with Landsat satellite time series images using two different methods. First method, the Landtrendr algorithm (Landsat-based Detection of Trends in Disturbance and Recovery) developed for multitemporal satellite data, uses pixel values as input data and analysis them by using regression models to capture, label and map the changes. In this context, Landsat satellite time series images were taken quinquennial between 1987 and 2007 and biennially until 2017 for Landtrendr analysis (i.e. before and after its declaration as a National Park, respectively). As a second approach, the Google Earth Engine (GEE) cloud-based platform, which facilitates access to high-performance computing resources to process large long-term data sets, was used to analyze the impact of land cover changes. The results showed that the area was subjected to various pressures (i.e. due to illegal felling, pollution, etc.) until it was declared as a National park. Although there was general improvement and recovery after the region declared as a Park, it was seen that the sensitive dynamics of the region require continuous monitoring and protection using geo-information technologies. \textcopyright{} 2021 International Archives of the Photogrammetry, Remote Sensing and Spatial Information Sciences - ISPRS Archives. All rights reserved.},
  author_keywords = {Google Earth Engine; Landsat TM time series; Landtrendr analysis; Protected Areas; Spatiotemporal Changes},
  keywords      = {Banks (bodies of water); Biodiversity; Conservation; Ecosystems; Engines; Environmental protection; Floods; Forestry; Image analysis; Regression analysis; Remote sensing; Satellites; Time series analysis; Wetlands; Floodplain forest; Google earth engine; Google earths; LANDSAT; Landsat TM time series; Landtrendr analyse; National parks; Protected areas; Spatio-temporal changes; Times series; Time series},
  type          = {Conference paper},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Tomasevic2020,
  title         = {Evaluation of criteria for the implementation of high-performance computing (HPC) in danube region countries using fuzzy piprecia method},
  author        = {Toma\v{s}evic, Milovan and Lapuh, Lucija and Stevic, \v{Z}eljko and Stanujkic, Dragi\v{s}a and Karaba\v{s}evic, Darjan},
  year          = 2020,
  journal       = {Sustainability (Switzerland)},
  volume        = 12,
  number        = 7,
  doi           = {10.3390/su12073017},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85083548497&doi=10.3390%2Fsu12073017&partnerID=40&md5=8c94eee92f3cfb9589cd9661ee173151},
  note          = {Cited by: 24; All Open Access; Gold Open Access; Green Open Access},
  abstract      = {The use of computers with outstanding performance has become a real necessity in order to achieve greater efficiency and sustainability for the accomplishment of various tasks. Therefore, with the development of information technology and increasing dynamism in the business environment, it is expected that these computers will be more intensively deployed. In this paper, research was conducted in Danube region countries: Austria, Bosnia and Herzegovina, Bulgaria, Croatia, Czech Republic, Germany, Hungary, Moldova, Montenegro, Romania, Serbia, Slovakia, Slovenia, and Ukraine. The aim of the research was to determine what criteria are most significant for the introduction of high-performance computing and the real situation in each of the countries. In addition, the aim was to establish the infrastructure needed to implement such a system. In order to determine the partial significance of each criterion and thus the possibility of implementing high-performance computing, a multi-criteria model in a fuzzy environment was applied. The weights of criteria and their rankings were performed using the Fuzzy PIvot Pairwise RElative Criteria Importance Assessment-fuzzy PIPRECIA method. The results indicate diffierent values depend on decision-makers (DMs) in the countries. Spearman's and Pearson's correlation coefficients were calculated to verify the results obtained. \textcopyright{} 2020 by the authors.},
  author_keywords = {Danube region countries; Fuzzy PIPRECIA; High-performance computing (HPC); Supercomputers},
  keywords      = {Austria; Bosnia and Herzegovina; Bulgaria; Croatia; Czech Republic; Germany; Hungary; Moldova; Montenegro; Romania; Serbia; Slovakia; Slovenia; Ukraine; computer simulation; fuzzy mathematics; information technology; multicriteria analysis; performance assessment; research work; sustainability; technical efficiency; technological development},
