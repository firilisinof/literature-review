@article{Laiblova2019,
  title         = {Environmental impact of textile reinforced concrete facades compared to conventional solutions-lca case study},
  author        = {Laiblov\'{a}, Lenka and Pe\v{s}ta, J. Jan and Kumar, Anuj and H\'{a}jek, Petr and Fiala, Ctislav and Vlach, Tom\'{a}\v{s} and Koc\'{\i}, Vladim\'{\i}r},
  year          = 2019,
  journal       = {Materials},
  volume        = 12,
  number        = 19,
  doi           = {10.3390/ma12193194},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85073721550&doi=10.3390%2Fma12193194&partnerID=40&md5=b35392aea3c94f62033f07a80482b32b},
  note          = {Cited by: 58; All Open Access; Gold Open Access; Green Open Access},
  abstract      = {Pitch-faced concrete is becoming a very popular element of modern architecture in the 21st century. In particular, the demand for concrete facades is increasing globally. On the other hand, climate change, environmental degradation, and limited resources are motivations for sustainable building materials. The construction industry is one the highest emitters of CO2 and other greenhouse gases, in which concrete plays a major role. Thus, reduction in the volume of concrete consumption is essential to control greenhouse gases. One approach to this problem is to use textile reinforced concrete (TRC). The main aim of the present study was to compare the subtle TRC facade made of three different types of technical textile rovings (glass, carbon, and basalt) with ordinary facades reinforced by steel reinforcement (ORC). The goal was to compare the basic environmental impact potential according to product category rules (PCR) for concrete structures. The functional unit was defined as an experimental facade with an area of 60 m2 and a 100-year lifespan. Inventory data were elaborated for concrete, steel, and textile fiber production; the building site; service life; demolition; and final disposal. The main life cycle assessment (LCA) parameters were global warming potential (GWP), ozone depletion (ODP), acidification (AP), eutrophication (EP), abiotic depletion (ADP), and photochemical oxidant creation (POCP). All the data used in the work were related to Czech Republic. Textile reinforced concrete facades appeared to be more environmentally friendly in four of six impact categories by an average of 30\%. The results of the present study revealed that, in comparison to ORC, TRC has a lower environmental impact for the given conditions and thus good potential for use in sustainable construction. \textcopyright{} 2019 by the authors.},
  author_keywords = {AR-glass fibers; Basalt fibers; Carbon fibers; Environmental impact; High performance concrete (HPC); Life cycle assessment (LCA); Textile reinforced concrete (TRC)},
  keywords      = {Basalt; Carbon fibers; Construction industry; Environmental impact; Eutrophication; Facades; Global warming; Greenhouse gases; High performance concrete; Intelligent buildings; Life cycle; Ozone layer; Reinforced plastics; Steel fibers; Sustainable development; Textiles; Ar glass fibers; Basalt fiber; Global warming potential; Life Cycle Assessment (LCA); Photochemical oxidants; Sustainable building materials; Sustainable construction; Textile reinforced concretes; Reinforced concrete},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Laihang2026,
  title         = {High-performance hybrid asymmetric supercapacitors based on sustainable RuₓP/N or P-doped porous carbon from vegetable root waste},
  author        = {Laihang, Sudarat and Lin, Jeng-Yu and Limthongkul, Pimpa and Hasin, Panitat},
  year          = 2026,
  journal       = {Journal of Energy Storage},
  volume        = 154,
  doi           = {10.1016/j.est.2026.121102},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105033860885&doi=10.1016%2Fj.est.2026.121102&partnerID=40&md5=3d6a9b810eed35372d80817c5e1e1d9c},
  note          = {Cited by: 0},
  abstract      = {The specific capacitance and energy density of porous carbons can be enhanced by the fabrication of hierarchical porous carbons using vegetable roots as well as the introduction of N/P heteroatoms and Ru<sub>x</sub>P nanoparticles. The Ru<sub>x</sub>P\@P-doped hierarchical porous carbon derived from celery roots (Ru<sub>x</sub>P\@P-HPC-CR) exhibits good electrochemical performance and a specific capacitance of 3303~F~g-1 at 1 A g-1 in 2~M KOH, which is almost 19 times greater than that of HPC-CR. The high specific capacitance depends on the unique three-dimensional interconnected honeycomb-like carbon frameworks, which are abundant in N/O functional groups and possess a large specific surface area. Since P atoms can effectively regulate the electronic structure of carbon and ruthenium atoms, Ru<sub>x</sub>P\@P-HPC-CR also displays the robust electrocatalytic activity. Moreover, when employed as a positive electrode in asymmetric supercapacitor, the Ru<sub>x</sub>P\@P-HPC-CR electrode delivers 109~Wh~kg-1 and 719~W~kg-1 at 1 A g-1 in a 2~M KOH electrolyte. To significantly suppress the side reactions, deep eutectic solvent (DES) system comprising LiClO<sub>4</sub>, DMSO, and water was prepared. This results in a wide electrochemical stability window of 2.4~V, an energy density of 128~Wh~kg-1 at 1784~W~kg-1, maintaining 90\% capacitance retention after 20000~cycles. These results successfully show that this approach to fabricate electrodes developed from an inexpensive green source demonstrates an environmentally friendly, economically feasible, and effective way for the conversion process of agricultural waste into valuable carbon materials, opening a new avenue for the design of future high-performance bioengineered energy storage systems. \textcopyright{} 2026 Elsevier Ltd. All rights are reserved, including those for text and data mining, AI training, and similar technologies.},
  author_keywords = {Asymmetric supercapacitor; Heteroatom; Porous carbon; RuₓP; Vegetable root waste},
  keywords      = {Agricultural wastes; Carbon Economy; Carbon electrodes; Chlorine compounds; Chromium compounds; Digital storage; Electrochemical electrodes; Electrolytes; Electrolytic capacitors; Honeycomb structures; Lithium compounds; Phosphorus compounds; Porous carbon; Porous materials; Potassium hydroxide; Ruthenium compounds; Tungsten compounds; Vegetables; Asymmetric supercapacitor; Energy density; Heteroatoms; Hierarchical porous carbons; Performance; Porous carbons; RuₓP; Specific capacitance; Specific energy; Vegetable root waste; Supercapacitor},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@book{Lakhan2025315,
  title         = {Sustainable AI-assisted energy-efficient edge cloud system for industrial Internet of Things applications},
  author        = {Lakhan, Abdullah and Groenli, Tor Morten},
  year          = 2025,
  journal       = {Intelligent Urban Mobility: Decision Support Systems for Sustainable Transportation},
  pages         = {315--326},
  doi           = {10.1016/b978-0-443-34160-1.00005-5},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105019737187&doi=10.1016%2FB978-0-443-34160-1.00005-5&partnerID=40&md5=533c9a1bb60fe9611e66e0f25e5b3799},
  note          = {Cited by: 1},
  abstract      = {Sustainable artificial intelligence (AI) development aims to create AI solutions on edge cloud nodes that are responsible for energy-efficient computational processes for industrial Internet of Things (IIoT) applications. Processing IIoT data of applications nearer to edge computing reduces the volume of data as compared to a centralized cloud. The IIoT applications, such as smart homes, digital healthcare, and smart transportation, require substantial resources that have huge energy consumption due to the vast amounts of real-time data produced across multiple nodes. The huge energy demand for these applications significantly impacts the environment due to the huge energy consumption within smart cities. This proposal introduces intelligent edge computing as a cutting-edge solution designed to decrease the energy consumption of AI task processing. In contrast, the proposal designs a green AI computing environment for IIoT applications. We are implementing an advanced edge computing framework with diverse nodes to offload most AI tasks to edge nodes instead of a centralized cloud. In addition, we present an innovative strategy that optimizes the scheduling of various AI tasks, improving the energy efficiency of individual computing resources. The proposed solution has an optimal outcome with effective simulation capabilities for IIoT applications, which conserves energy and reduces overall latency in distributed edge cloud networks. \textcopyright{} 2025 Elsevier Inc. All rights are reserved, including those for text and data mining, AI training, and similar technologies.},
