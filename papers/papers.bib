@article{Vogginger2015,
  title         = {Reducing the computational footprint for real-time BCPNN learning},
  author        = {Vogginger, Bernhard and Sch\"{u}ffny, Ren\'{e} and Lansner, Anders and Cederstr\"{o}m, Love and Partzsch, Johannes and H\"{o}ppner, Sebastian},
  year          = 2015,
  journal       = {Frontiers in Neuroscience},
  volume        = 9,
  number        = {Jan},
  doi           = {10.3389/fnins.2015.00002},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84921746938&doi=10.3389%2Ffnins.2015.00002&partnerID=40&md5=761ee6ad78dc980661b1e1057a9e2c0a},
  note          = {Cited by: 14; All Open Access; Gold Open Access; Green Open Access},
  abstract      = {The implementation of synaptic plasticity in neural simulation or neuromorphic hardware is usually very resource-intensive, often requiring a compromise between efficiency and flexibility. A versatile, but computationally-expensive plasticity mechanism is provided by the Bayesian Confidence Propagation Neural Network (BCPNN) paradigm. Building upon Bayesian statistics, and having clear links to biological plasticity processes, the BCPNN learning rule has been applied in many fields, ranging from data classification, associative memory, reward-based learning, probabilistic inference to cortical attractor memory networks. In the spike-based version of this learning rule the pre-, postsynaptic and coincident activity is traced in three low-pass-filtering stages, requiring a total of eight state variables, whose dynamics are typically simulated with the fixed step size Euler method. We derive analytic solutions allowing an efficient event-driven implementation of this learning rule. Further speedup is achieved by first rewriting the model which reduces the number of basic arithmetic operations per update to one half, and second by using look-up tables for the frequently calculated exponential decay. Ultimately, in a typical use case, the simulation using our approach is more than one order of magnitude faster than with the fixed step size Euler method. Aiming for a small memory footprint per BCPNN synapse, we also evaluate the use of fixed-point numbers for the state variables, and assess the number of bits required to achieve same or better accuracy than with the conventional explicit Euler method. All of this will allow a real-time simulation of a reduced cortex model based on BCPNN in high performance computing. More important, with the analytic solution at hand and due to the reduced memory bandwidth, the learning rule can be efficiently implemented in dedicated or existing digital neuromorphic hardware. \textcopyright{} 2015 Vogginger, Sch\"{u}ffny, Lansner, Cederstr\"{o}m, Partzsch and H\"{o}ppner.},
  author_keywords = {Bayesian confidence propagation neural network (BCPNN); Digital neuromorphic hardware; Event-driven simulation; Fixed-point accuracy; Hebbian learning; Look-up tables; Spiking neural networks; Synaptic plasticity},
  keywords      = {accuracy; arithmetic; Article; artificial neural network; Bayesian learning; calculation; computer simulation; memory; nerve cell plasticity; network learning; synapse; time},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Volz2016,
  title         = {Review of organic light-emitting diodes with thermally activated delayed fluorescence emitters for energy-efficient sustainable light sources and displays},
  author        = {Volz, Daniel},
  year          = 2016,
  journal       = {Journal of Photonics for Energy},
  volume        = 6,
  number        = 2,
  doi           = {10.1117/1.jpe.6.020901},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84967157604&doi=10.1117%2F1.JPE.6.020901&partnerID=40&md5=9fb55e544e3de968710588daf5f61c20},
  note          = {Cited by: 76; All Open Access; Hybrid Gold Open Access},
  abstract      = {Thermally activated delayed fluorescence (TADF) is an emerging hot topic. Even though this photophysical mechanism itself has been described more than 50 years ago and optoelectronic devices with organic matter have been studied, improved, and even commercialized for decades now, the realization of the potential of TADF organic light-emitting diodes (OLEDs) happened only recently. TADF has been proven to be an attractive and very efficient alternative for phosphorescent materials, such as dopants in OLEDs, light-emitting electrochemical cells as well as potent emitters for chemiluminescence. In this review, the TADF concept is introduced in terms that are also understandable for nonchemists. The basic concepts behind this mechanism as well as state-of-the-art examples are discussed. In addition, the future economic impact, especially for the lighting and display market, is addressed here. We conclude that TADF materials are especially helpful to realize efficient, durable deep blue and white displays. \textcopyright{} 2016 Society of Photo-Optical Instrumentation Engineers (SPIE).},
  author_keywords = {display; organic light-emitting diode; singlet harvesting; solid state lighting; thermally activated delayed fluorescence},
  keywords      = {Display devices; Electrochemical cells; Electronic equipment; Energy efficiency; Fluorescence; Light emitting diodes; Light sources; Lighting; Optoelectronic devices; Phosphorescence; Supercomputers; Economic impacts; Energy efficient; Light-emitting electrochemical cell; Organic light emitting diodes(OLEDs); Phosphorescent material; Solid state lighting; State of the art; Thermally activated delayed fluorescences; Organic light emitting diodes (OLED)},
  type          = {Review},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{vonderChristine2022351,
  title         = {Thin Sandwich Elements Prestressed with CFRP Tendons},
  author        = {von der Christine, Ann-Heid and Bosbach, Sven and Stark, Alexander and Schulze-Ardey, Jan Philip and Hegger, Josef},
  year          = 2022,
  journal       = {Lecture Notes in Civil Engineering},
  volume        = {198 Lnce},
  pages         = {351--362},
  doi           = {10.1007/978-3-030-88166-5_30},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85121931340&doi=10.1007%2F978-3-030-88166-5_30&partnerID=40&md5=428b61e4646f5e80385ac81654c1f0be},
  note          = {Cited by: 0},
  abstract      = {Sandwich panels exhibit an attractive choice for modern building envelopes. Innovative high performance materials such as non-corrosive carbon reinforcement make it possible to produce elements with thin layers, which fulfil the requirements of sustainable and durable building envelopes. The application of two thin facings made of high performance concrete (HPC) and a core of polymeric rigid foam (PU) can highly enhance the load-bearing capacity of sandwich panels providing a low weight at the same time. In order to enable large fa\c{c}ade elements or wide-span roof elements, an additional prestressing with CFRP (carbon fibre reinforced polymer) tendons is advantageous. These prestressed slender sandwich elements have a high potential for economic savings in terms of material and transport as well as reduced time efforts during mounting. The paper reports on experimental investigations during the development of planar elements made of carbon reinforced HPC and pretensioned CFRP tendons. The determination of the transfer length of CFRP tendons in HPC is described and the results of bond tests on small-scale sandwich elements under tensile and shear loads are shown. Furthermore, the influence of textile connecting devices on the load-bearing capacity was determined. With the conducted experimental investigations, the high potential and performance of sandwich elements prestressed with CFRP and a PU core can be shown. \textcopyright{} 2022, The Author(s), under exclusive license to Springer Nature Switzerland AG.},
  author_keywords = {CFRP tendons; Prestressed concrete; Sandwich constructions; Textile connecting devices; Textile reinforced concrete},
  keywords      = {Bearing capacity; Carbon fiber reinforced plastics; Carbon fibers; Concrete slabs; High performance concrete; Honeycomb structures; Loads (forces); Prestressed concrete; Reinforced concrete; Textiles; Carbon fiber reinforced polymer tendon; Carbon fibre reinforced polymer; Fiber-reinforced polymer tendons; High-performance concrete; Pre-stressed; Sandwich construction; Sandwich element; Sandwich panel; Textile connecting device; Textile reinforced concretes; Sandwich structures},
  type          = {Conference paper},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Vowles2014151,
  title         = {The importance of behaviour in predicting the impact of a novel small-scale hydropower device on the survival of downstream moving fish},
  author        = {Vowles, Andrew S. and Karlsson, Simon P. and Uzunova, Eliza P. and Kemp, Paul S.},
  year          = 2014,
  journal       = {Ecological Engineering},
  volume        = 69,
  pages         = {151--159},
  doi           = {10.1016/j.ecoleng.2014.03.089},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84899857177&doi=10.1016%2Fj.ecoleng.2014.03.089&partnerID=40&md5=816c88cc7001f52cfda90e215067999f},
  note          = {Cited by: 28},
  abstract      = {Further exploitation of hydroelectric power is one strategy that may help European Union member states meet targets to increase the proportion of electricity produced by renewable means. Government subsidies and novel technologies are aiding the development of previously uneconomic, very low-head (<2.5. m) hydropower sites. Legislation requires that environmental impacts of hydropower development must be assessed and mitigated for. This study incorporated numerical blade strike models (BSMs), open channel flume experiments, and field observations to determine the importance of behaviour when assessing impacts of a novel hydropower device (the Hydrostatic Pressure Converter [HPC]) on downstream moving fish. A Stochastic BSM predicted a lower probability of strike for small fish that travelled downstream faster, and when blades rotated slowly. When empirical data were incorporated into a BSM, predicted probability of strike was in agreement with that observed during a validation test in which freshly euthanised hatchery reared brown trout (Salmo trutta) were recorded passively drifting through a prototype HPC under an experimental setting. Forty-four percent of trout were struck by a blade, of these, 64\% sustained obvious visible physical damage. Behavioural observations of rainbow trout (Oncorhynchus mykiss) and European eel (Anguilla anguilla) suggest that fish will pass through an unscreened HPC. When behavioural parameters (fish velocity, orientation/degree of body contortion) were incorporated into the BSM, probability of strike increased and decreased for trout and eel, respectively, compared with an assumption of passive drift with the flow. Field observations supported the suggestion that salmonid behaviour may increase risk of mortality during passage through small-scale hydropower devices. This study highlights the importance of considering interspecific variation in behaviour when developing BSMs and conducting Environmental Impact Assessments of hydropower development. \textcopyright{} 2014 Elsevier B.V.},
  author_keywords = {Blade strike model; Fish injury; Flume; Low-head hydropower; Turbine},
  keywords      = {Environmental impact; Fish; Hydrostatic pressure; Laws and legislation; Probability; Turbines; Turbomachine blades; Fish injury; Flume; Government subsidies; Hydro-power development; Interspecific variations; Low-head hydropower; Lower probabilities; Rainbow trouts (Oncorhynchus mykiss); Hydroelectric power},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Vysocky2020159,
  title         = {Overview of Application Instrumentation for Performance Analysis and Tuning},
  author        = {Vysocky, Ondrej and Riha, Lubomir and Bartolini, Andrea},
  year          = 2020,
  journal       = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
  volume        = {12044 Lncs},
  pages         = {159--168},
  doi           = {10.1007/978-3-030-43222-5_14},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85083961299&doi=10.1007%2F978-3-030-43222-5_14&partnerID=40&md5=ebb9d3052c70bf18ef330d2c2ecc0643},
  note          = {Cited by: 2; All Open Access; Green Open Access},
  abstract      = {Profiling and tuning of parallel applications is an essential part of HPC. Analysis and improvement of the hot spots of an application can be done using one of many available tools, that provides measurement of resources consumption for each instrumented part of the code. Since complex applications show different behavior in each part of the code, it is desired to insert instrumentation to separate these parts. Besides manual instrumentation, some profiling libraries provide different ways of instrumentation. Out of these, the binary patching is the most universal mechanism, that highly improves user-friendliness and robustness of the tool. We provide an overview of the most often used binary patching tools and show a workflow of how to use them to implement a~binary instrumentation tool for any profiler or autotuner. We have also evaluated the minimum overhead of the manual and binary instrumentation. \textcopyright{} 2020, Springer Nature Switzerland AG.},
  author_keywords = {Binary instrumentation; Code optimization; High performance computing; Performance analysis},
  keywords      = {Computer science; Computers; Binary instrumentations; Complex applications; Manual instrumentations; Parallel application; Performance analysis; Resources consumption; Universal mechanisms; User friendliness; Artificial intelligence},
  type          = {Conference paper},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Vysocky2021,
  title         = {Application instrumentation for performance analysis and tuning with focus on energy efficiency},
  author        = {Vysock\'{y}, Ond\v{r}ej and \v{R}\'{\i}ha, Lubom\'{\i}r and Bartolini, Andrea},
  year          = 2021,
  journal       = {Concurrency and Computation: Practice and Experience},
  volume        = 33,
  number        = 11,
  doi           = {10.1002/cpe.5966},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85089468748&doi=10.1002%2Fcpe.5966&partnerID=40&md5=145dd3f580d72b5852e61fe9dfaf7c20},
  note          = {Cited by: 2},
  abstract      = {Profiling and tuning of parallel applications is an essential part of HPC. Analysis and elimination of application hot spots can be performed using many available tools, which also provides resource consumption measurements for instrumented parts of the code. Since complex applications show different behavior in each part of the code, it is essential to be able to insert instrumentation to analyse these parts. Because each performance analysis or autotuning tool can bring different insights into an application behavior, it is valuable to analyze and optimize an application using a variety of them. We present our on request inserted shared C/C++ API for the most common open-source HPC performance analysis tools, which simplify the process of the manual instrumentation. Besides manual instrumentation, profiling libraries provide different methods for instrumentation. Of these, the binary patching is the most universal mechanism, and highly improves the user-friendliness and robustness of the tool. We provide an overview of the most commonly used binary patching tools, and describe a workflow for how to use them to implement a~binary instrumentation tool for any profiler or autotuner. We have also evaluated the minimum overhead of the manual and binary instrumentation. \textcopyright{} 2020 John Wiley \& Sons Ltd},
  author_keywords = {binary patching; code optimization; energy efficient computing; high-performance computing; performance analysis; READEX},
  keywords      = {Application programming interfaces (API); C++ (programming language); Codes (symbols); Binary instrumentations; Binary patching; Code optimization; Energy-efficient computing; High-performance computing; Manual instrumentations; Performance computing; Performance tuning; Performances analysis; READEX; Energy efficiency},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Wadenstein2025,
  title         = {Life cycle analysis for emissions of scientific computing centres},
  author        = {Wadenstein, Mattias and Vanderbauwhede, Wim},
  year          = 2025,
  journal       = {European Physical Journal C},
  volume        = 85,
