  title         = {Comparison of different types of glass reinforcement for HPC fa\c{c}ade elements from mechanical and economical aspects},
  author        = {Laiblov\'{a}, Lenka and Vlach, Tom\'{a}\v{s} and \v{Z}en\'{\i}\v{s}ek, Michal and Kumar, Anuj and H\'{a}jek, Petr},
