}
@book{Lamb2019533,
  title         = {Internal solitary waves and mixing},
  author        = {Lamb, Kevin G. and Lien, Ren-Chieh and Diamessis, Peter J.},
  year          = 2019,
  journal       = {Encyclopedia of Ocean Sciences},
  pages         = {533--541},
  doi           = {10.1016/b978-0-12-409548-9.10951-0},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85079081980&doi=10.1016%2FB978-0-12-409548-9.10951-0&partnerID=40&md5=6630e1095baeeade2a42b222ea586fb5},
  note          = {Cited by: 5},
  abstract      = {Internal solitary waves (ISWs) are isolated nonlinear-dispersive waves that propagate horizontally, guided by the sea-surface and sea-floor, in the stratified ocean interior. These waves maintain a characteristic highly coherent and slowly evolving waveform. Typical waves have amplitudes (vertical displacement) of O(10) m, widths of O(100) m and energy densities of O(1) MJ m<sup>-1</sup> per unit length, with even larger and more energetic waves observed in select locations. Generated primarily through tide-topography interactions, ISWs can propagate very long distances, transporting energy far from their generation site. As they propagate, ISWs dissipate their energy through turbulence that results from instabilities that occur locally in the interior of the waves or in their bottom footprint. In the water column interior, this turbulence enhances vertical mixing of heat and nutrients and influences large-scale circulation and productivity. At the sea-floor, potentially intensified turbulence under ISWs mixes near-bed gradients of chemicals and nutrients and drives particle resuspension impacting benthic ecology and water quality. The large-scale separation between ISWs and any localized turbulence within them and the broad range of scales within turbulence events themselves poses nontrivial challenges to computational modeling of ISW-driven mixing, in terms of numerical method development and the implementation on high-performance computing platforms. Theory and computational modeling play an important complementary role to field observations, in terms of fleshing out the physics of the life-cycle of ISWs. Further work is needed in all three areas to develop parameterizations of mixing due to ISWs for use in regional or global scale circulation. \textcopyright{} 2019 Elsevier Ltd All rights reserved.},
  author_keywords = {Bottom boundary layer turbulence; Computational fluid dynamics; Convective breaking; High-performance computing; Internal waves; Mass and nutrient transport; Multiscale physics; Nonlinear dispersive waves; Sediment resuspension; Shear instability; Shoaling waves; Solitary waves; Trapped cores; Turbulent mixing and diffusivity},
  type          = {Book chapter},
  publication_stage = {Final},
  source        = {Scopus}
}
@conference{Lambros20032123,
  title         = {High performance concrete and sustainable development},
  author        = {Lambros, V. and Androus, A. and Hossain, K.M.A. and Sennah, K. and Lachemi, M.},
  year          = 2003,
  journal       = {Proceedings, Annual Conference - Canadian Society for Civil Engineering},
  volume        = 2003,
  pages         = {2123--2132},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-4544262939&partnerID=40&md5=4fdf8163b5c3f9ace379d36148e0e26c},
  note          = {Cited by: 2},
  abstract      = {Over the last decades there has been a tremendous growth of built environment to meet higher standards of living with growing industrialization and urbanization. There are however, growing concerns with the inefficient practices adopted in the infrastructure development and its socio-economic and environmental impacts. The replacement and rehabilitation of aging and deteriorating existing infrastructures as well as the tremendous demand for the construction of new infrastructures are the challenges of the 21<sup>st</sup> century. Concrete is the most widely used of all building materials and is the largest consumer of natural resources. The cement industry is one of the major contributors to the damaging emissions of large quantities of CO<sub>2</sub> into the atmosphere. In the 21<sup>st</sup> century, there will be a tremendous growth in concrete construction as developing countries become developed and emission of CO<sub>2</sub> will be multifold. The 1997 World Earth summit in Kyoto, Japan made it clear that the unchecked increase in the emissions of greenhouse gases to the atmosphere is environmentally and socially no longer acceptable for sustainable development. Development of new environmentally friendly building materials and high performance concrete (HPC) can be a solution. The development of HPC is a diverse technology that can lead to lower greenhouse gas emissions, consumption of wastes, durable construction, and sustainability in concrete construction industry. This paper will discuss various aspects associated with HPC and sustainable development including environmental and economical issues as well as durability, life cycle and holistic approach.},
  keywords      = {Aging of materials; Concrete construction; Durability; Economic and social effects; Environmental impact; Greenhouse effect; Life cycle; Sustainable development; Urban planning; High performance concrete (HPC); Industrialization; Infrastructures; Urbanization; Concretes},
  type          = {Conference paper},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Lammel201698,
  title         = {SONAR: Automated communication characterization for HPC applications},
  author        = {Lammel, Steffen and Zahn, Felix and Fr\"{o}ning, Holger},
  year          = 2016,
  journal       = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
  volume        = {9945 Lncs},
  pages         = {98--114},
  doi           = {10.1007/978-3-319-46079-6_8},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84992571517&doi=10.1007%2F978-3-319-46079-6_8&partnerID=40&md5=c8a690596ba7b2342f2612e17fbe6c12},
  note          = {Cited by: 6},
  abstract      = {Future computing systems will need to operate within hard power and energy constraints, this is particularly true for Exascale-class systems. These constraints are hard for technical, economical and ecological reasons, thus, such systems have to operate within given power and energy budgets. Therefore, we anticipate the need for modeling tools that help to predict power and energy consumption. In particular, such modeling tools would allow for detailed explorations of various alternatives when designing systems. While processing and memory already receives a large amount of interest from the research community, power modeling of scalable interconnection networks is rather neglected. However, analyses show that the network contributes about 20\% to the overall power consumption of HPC systems. Considering the increasing energy efficiency of other components, this fraction is likely to increase. While models for processing and memory typically rely on performance counters to model power and energy, we observe that the distributed nature of networks leads to significantly more complex metrics. Selecting the right set of abstract metrics, which will be used as input for such a prediction, is crucial for prediction performance. In this work we introduce our tool called Simple Offline Network Analyzer (SONAR) to derive complex metrics from communication traces of HPC applications. We explain the motivation behind choosing this concept, the implementation, and the ability of the tool to easily support the integration of new metrics. We also show exemplary explorations using an initial set of metrics for a representative range of HPC applications, including contemporary as well as emerging Exascale workloads. In particular, we use SONAR to characterize the communication of applications in terms of verbosity and network utilization, as we believe both to be important metrics for power prediction. \textcopyright{} Springer International Publishing AG 2016.},
  author_keywords = {Automated tooling; Characterization; Communication; Exascale; HPC; MPI},
  keywords      = {Budget control; Characterization; Communication; Complex networks; Computer systems programming; Data storage equipment; Digital storage; Embedded systems; Energy efficiency; Energy utilization; Forecasting; Interconnection networks (circuit switching); Sonar; Automated tooling; Communication traces; Exascale; Net work utilization; Performance counters; Power and energy consumption; Prediction performance; Research communities; Distributed computer systems},
  type          = {Conference paper},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Lammlein2021,
  title         = {Prestressing low clinker structural concrete elements by ultra-high modulus carbon fibre reinforced polymer tendons},
  author        = {L\"{a}mmlein, Tobias Dominik and Justs, Janis and Terrasi, Giovanni Pietro and Lura, Pietro},
  year          = 2021,
  journal       = {Materials and Structures/Materiaux et Constructions},
  volume        = 54,
  number        = 1,
  doi           = {10.1617/s11527-021-01634-9},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85100919299&doi=10.1617%2Fs11527-021-01634-9&partnerID=40&md5=4012e4d1c0a093419b9cae45f456020e},
  note          = {Cited by: 8; All Open Access; Green Open Access; Hybrid Gold Open Access},
  abstract      = {The combination of low clinker high-performance concrete (LCHPC) and ultra-high modulus (UHM) carbon fibre reinforced polymer (CFRP) tendons was recently proposed for prestressed structural elements. The 70\% reduction in cement content resulting in limited creep and shrinkage of the LCHPC in comparison to a conventional high-performance concrete (HPC) and the very high UHM-CFRP tendon stiffness (> 509~GPa) were expected to impact the mechanical behaviour of such structures. This study focuses on the behaviour of 3~m-long beam specimens during prestressing, concrete hardening and in 4 point-bending experiments. Fibre optic sensors were implemented inside the CFRP tendons to measure strain during those stages and a digital image correlation system was employed to monitor the 4-point-bending tests. After 28~days, the LCHPC recipe, despite a 70\% cement reduction and much smaller environmental footprint, did not show measurable differences in the prestress loss behaviour in comparison to a conventional HPC. The UHM-CFRP prestressing tendons, because of their stiffness, showed both higher prestress losses of around 40\% and on average a nearly doubled prestress transfer length. However, they increased the beam`s maximum load-bearing capacity by 21\% and showed 47\% less deflection at failure in comparison to beams prestressed with the standard modulus (UTS)-CFRP tendons. \textcopyright{} 2021, The Author(s).},
  author_keywords = {Bending behavior; Carbon fiber; Low-clinker-high-performance-concrete (LCHPC); Optical fiber bragg grating; Prestress transfer; Prestress-losses; Prestressed concrete},
  keywords      = {Carbon fiber reinforced plastics; Cements; Graphite fibers; High performance concrete; Prestressing; Shrinkage; Stiffness; Carbon fibre reinforced polymer; Creep and shrinkages; Digital image correlations; Environmental footprints; Mechanical behaviour; Prestress transfers; Structural concretes; Structural elements; Wire},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Lamothe2021,
  title         = {Lightweight and slender timber-concrete composite floors made of CLT-HPC and CLT-UHPC with ductile notch connectors},
  author        = {Lamothe, Serge and Sorelli, Luca and Blanchet, Pierre and Galimard, Philippe},
  year          = 2021,
  journal       = {Engineering Structures},
  volume        = 243,
  doi           = {10.1016/j.engstruct.2021.112409},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85111055521&doi=10.1016%2Fj.engstruct.2021.112409&partnerID=40&md5=5bf28ebd2b87d3e32f47201d5550dc91},
  note          = {Cited by: 28; All Open Access; Green Open Access},
  abstract      = {Cross-Laminated Timber (CLT) structures have been emerging worldwide for residential floors in multi-storey buildings thanks to their lightness, fast construction and low ecological footprint. This work aims at fostering this application, which is often limited by vibrational and deflection limits, by investigating composite slab floors made of CLT and High-Performance Concrete (HPC) slab as well as CLT and Ultra High-Performance Fiber Reinforced Concrete (UHPFRC). Firstly, the composite floors CLT-HPC and CLT-UHPFRC with a span of 8 m were designed by considering a multicriteria analysis. To assure a certain structural ductility, previously developed ductile notch connectors were employed. As an economic choice, no shear reinforcement in the concrete slab was employed. Then, full-scale composite beams were fabricated in order to verify the predicted flexural behaviour and natural frequency. A numerical analysis was carried out to verify the connectors could effectively yield before the timber collapse. The comparison between the numerical simulation and the slip measurements confirmed that about 50\% of the notch connections fully yielded and underwent inelastic deformation which favors the structural ductility. In the case of the CLT-HPC floor, a reduction of the notch contact surface due to the use of plastic sheet waterproofing as well as shear cracks developing in the concrete close to the notch corner both reduced the expected structural stiffness. Finally, the CLT-UHPFRC floor is endowed with outstanding values of slenderness ratio (\sim{}35) and lightness (\sim{}2 kPa), while eliminating the use of shear reinforcement and sheet waterproofing. \textcopyright{} 2021 Elsevier Ltd},
  author_keywords = {Cross Laminated Timber (CLT); Ductile Notch Connections; High Performance Concrete (HPC); Timber-concrete composite structures; Ultra-High Fiber Performance Concrete (UHPFRC)},
  keywords      = {Concrete slabs; Ductility; Floors; Laminated composites; Laminating; Reinforced concrete; Timber; Waterproofing; Composite floors; Cross laminated; Cross laminated timber; Ductile notch connection; High performance concrete; High-performance concrete; Laminated timber; Timber-concrete composite structures; Ultra-high; Ultra-high fiber performance concrete; comparative study; composite; ductility; floor; numerical method; reinforced concrete; timber; High performance concrete},
