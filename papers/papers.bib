  source        = {Scopus}
}
@book{Wang2025141,
  title         = {Green AI: Balancing Innovation With Environmental Sustainability},
  author        = {Wang, Ziyi},
  year          = 2025,
  journal       = {Navigating the Intersection of AI Policy, Technology, and Governance},
  pages         = {141--170},
  doi           = {10.4018/979-8-3373-1210-1.ch006},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105013920268&doi=10.4018%2F979-8-3373-1210-1.ch006&partnerID=40&md5=2bfd9260a6a99e6eff49ac2ce0af9eec},
  note          = {Cited by: 0},
  abstract      = {This chapter examines the environmental impact of artificial intelligence (AI) and explores strategies to align AI development with sustainability goals. As AI-driven technologies expand, their energy consumption and carbon footprint present significant challenges, particularly in the operation of data centers and high-performance computing infrastructure. This chapter analyzes AI's dual role as both a contributor to environmental challenges and a tool for sustainability. It discusses AI's carbon footprint and AI's potential to drive climate action. Policy interventions, such as financial incentives, regulations for data centers, and carbon offset initiatives, are also examined. By integrating sustainability into AI development, this chapter provides a framework for fostering Green AI that minimizes ecological impact while leveraging AI's capabilities for global sustainability efforts. \textcopyright{} 2025 by IGI Global Scientific Publishing. All rights reserved.},
