@conference{Long2023,
  title         = {Large-Scale Ensemble Learning for Robust Wind Power Forecasting with Supercomputing},
  author        = {Long, Yujiang and Wei, Wei and Zhong, Ye},
  year          = 2023,
  journal       = {Proceedings of SPIE - The International Society for Optical Engineering},
  volume        = 12645,
  doi           = {10.1117/12.2681713},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85163332603&doi=10.1117%2F12.2681713&partnerID=40&md5=2fca0b98c821965b85afdf49b8f5c22a},
  note          = {Cited by: 0},
  abstract      = {Wind power is renewable energy, and plays a critical role in the carbon emission peak and carbon neutrality plan. As wind speed and direction is unstable, the generated electricity power fluctuates, and therefore cannot directly accepted by the power grid. A common solution is to forecast the wind power generation, and adjust the power generation and dispatching strategy to improve the stability and acceptance when provided to the power grid based on the forecasting results. The accurate forecasting of wind power is the key to this scheme. Common forecasting methods include physical approach and statistical approach. For physical approach, the Numerical Weather Prediction (NWP) model forecasts the wind speed and direction, so that the power is directly calculated. For statistical approach, the wind power is forecasted according to historical time series and predicted weather. The forecasting model including statistical autoregressive models, support vector machines, and neural networks, etc. However, the single model prediction lacks robustness, so we propose to ensemble multiple models to achieve robust short-term wind power forecasting. Based on supercomputing, we propose a large-scale parallel forecasting of various methods and models and a statistical method to assign reasonable weights to various models, achieving the large-scale ensemble of various models. In order to adapt to real-time data distribution changes, we update the models and corresponding weights online. The experiments are conducted on a dataset of wind power generation and meteorology from a province in China. The experimental results show that compared with the single model, the proposed large-scale ensemble model achieves better forecast accuracy and robustness. \textcopyright{} 2023 SPIE.},
  author_keywords = {Ensemble Learning; Online Learning; Supercomputing; Wind Power Forecasting},
  keywords      = {Carbon; E-learning; Electric load dispatching; Power generation; Support vector machines; Weather forecasting; Wind speed; Ensemble learning; Large-scales; Online learning; Physical approaches; Power; Power grids; Supercomputing; Wind power forecasting; Wind power generation; Wind speed and directions; Wind power},
  type          = {Conference paper},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Long2023_2,
  title         = {Improvement of temperature uniformity by using novel guide vanes in solar external receiver tubes},
  author        = {Long, Yun and Tu, Zecan and Piccioni Koch, Daniela and Frank, Martin and Zhu, Rongsheng},
  year          = 2023,
  journal       = {Applied Thermal Engineering},
  volume        = 233,
  doi           = {10.1016/j.applthermaleng.2023.121182},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85165239119&doi=10.1016%2Fj.applthermaleng.2023.121182&partnerID=40&md5=6bedf5e81b3e9e3a77fc36d7a77defa8},
  note          = {Cited by: 3},
  abstract      = {The heat flux sustainability in solar external receiver tubes is limited by the non-uniformity of the temperature distribution and the maximum achievable temperature of the molten salt flow. In this paper, the external receiver tubes were equipped with novel guide vanes to enhance the heat transfer inside the tube and improve the uniformity of the temperature distribution on the tube surface. The geometric structures of guide vanes were optimized under non-uniform heat flux distributions. Firstly, the numerical models of tubes with different guide vanes (different wrap angles at trailing angle and different number of blades) were developed. Secondly, the numerical calculation of each case was carried out by using the fine meshing method, and was carried out by means of the commercial software ANSYS Fluent 19.2 on the High-Performance Computing. The SST k-\ensuremath{\omega} turbulence model was used to predict the flow field inner the tube. The temperature, pressure loss, velocity and Nusselt number of these models predicted by CFD were analyzed and compared. Finally, the effect of different geometric parameters on the heat transfer enhancement and for improving the uniformity of temperature distribution were studied. It was observed that the guide vane is very effective to enhance the heat transfer inside the tube and improve the uniformity of temperature distribution on the tube surface. By optimizing the design of two parameters (wrap angles and number of blades), better heat transfer performance and improved uniformity can be obtained. For enhancing the heat transfer, and for improving the temperature uniformity and the flow resistance in the tube, a value of \texttheta{}<sub>TE</sub> = 82\textdegree{} is should be chosen. With the increase of the blade number, the flow separation will be better controlled, and the swirling strength will increase gradually. To increase the number of blades helps to enhance the heat transfer and improve the temperature uniformity. A higher blade number will increase the system resistance and affect the thermal hydraulic performance, and increase the design head and power of the pump. The most convenient blade number is N = 6. In addition, it was observed, that by adding the guide vanes, the flow resistance increases and this affects the thermo-hydraulic performance of the receiver tube. This study will provide theoretical basis and technical support for the efficient and reliable operation of solar collector heat exchanger tubes. \textcopyright{} 2023 Elsevier Ltd},
  author_keywords = {Concentrated solar power; External receiver tube optimization; Guide vane; Heat transfer; Molten salt; Temperature uniformity},
  keywords      = {Computational fluid dynamics; Concentrated solar power; Flow separation; Fused salts; Heat exchangers; Heat flux; Heat resistance; Heat transfer; Numerical methods; Oceanography; Solar energy; Temperature distribution; Tubes (components); Blade numbers; Concentrated solar power; External receiver tube optimization; Flow resistance; Geometric structure; Guide-vane; Molten salt; Nonuniformity; Optimisations; Temperature uniformity; Turbulence models},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@conference{Long2023510,
  title         = {Modeling of radiative free cooling for data centers},
  author        = {Long, Wenjun and Aili, Ablimit},
  year          = 2023,
  journal       = {Proceedings of the International Congress on Modelling and Simulation, MODSIM},
  pages         = {510--516},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85185223505&partnerID=40&md5=d6c8b426f8a4bea21220f756289ac7cc},
  note          = {Cited by: 0},
  abstract      = {Demand for data centers with high-performance computing is growing rapidly. However, large energy consumption in data centers (DC) is increasingly becoming a major challenge. As cooling systems are a key part of data centers accounting for a substantial fraction of energy consumption, improving their energy efficiency remains an important goal. Here, we demonstrate cooling energy saving in a data center with a radiative free cooling system that operates as part of the DC chiller system. Using physics-based models of the radiative free cooling and chiller systems, we simulate chiller energy consumption with and without free cooling. We specifically study the effects of DC outlet air temperature, free cooling system size, cooling tower water flow rate, free cooling system flow rate, relative humidity and ambient temperature on the system performance such as coefficient of performance, power consumption, and energy and water savings. Through a series of sensitivity analyses, we identify operation parameters of the integrated cooling system that must be optimized to achieve the best energy-saving state. Energy and water savings are positively corelated with cooling power and size of the free cooling system, cooling tower flow rate and relative humidity. We show that 7.5\% cooling energy and 7.6\% water consumption can be saved for the annual average weather conditions of Singapore. \textcopyright{} 2023 Proceedings of the International Congress on Modelling and Simulation, MODSIM. All rights reserved.},
  author_keywords = {Data center; energy saving; free cooling; water saving},
  keywords      = {Cooling; Cooling systems; Cooling towers; Cooling water; Energy efficiency; Flow of water; Green computing; Operations research; Sensitivity analysis; Thermoelectric equipment; Water conservation; Chiller system; Cooling energy; Datacenter; Energy  savings; Energy-consumption; Energy-savings; Free cooling; Free-cooling systems; Performance computing; Water-saving; Energy utilization},
  type          = {Conference paper},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Lopez-Ubeda2026661,
  title         = {Environmental and economic costs behind LLMs},
  author        = {L\'{o}pez-\'{U}beda, Pilar and Mart\'{\i}n-Noguerol, Teodoro and Luna, Antonio},
  year          = 2026,
  journal       = {International Journal of Computer Assisted Radiology and Surgery},
  volume        = 21,
  number        = 3,
  pages         = {661--663},
  doi           = {10.1007/s11548-026-03568-5},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105027383411&doi=10.1007%2Fs11548-026-03568-5&partnerID=40&md5=bb1be5959bfffd86130f8969634f47da},
  note          = {Cited by: 0; All Open Access; Bronze Open Access},
  abstract      = {Purpose: To discuss the economic and environmental implications of implementing large language models (LLMs) in radiology, highlighting both their transformative potential and the challenges they pose for equitable and sustainable adoption. Methods: Current trends in AI investment, infrastructure requirements, operational costs, and environmental impact associated with LLMs are analyzed, highlighting the specific challenges of integrating LLMs into radiological workflows, including data privacy, regulatory compliance, and cost barriers for healthcare institutions. The analysis also considers the costs of model validation, maintenance, and updates, as well as investments in system integration, staff training, and cybersecurity for clinical implementation. Results: LLMs have revolutionized natural language processing and offer promising applications in radiology, such as improved diagnostic support and workflow optimization. However, their deployment involves substantial financial and environmental costs. Training and operating these models require high-performance computing infrastructure, significant energy consumption, and large volumes of annotated data. Water usage and CO₂ emissions from data centers further raise sustainability concerns, while ongoing operational costs add to the financial burden. Subscription fees and per-query pricing may restrict access for smaller institutions, widening existing inequalities. Conclusion: While LLMs offer significant benefits for radiology, their high economic and environmental costs present challenges to widespread and equitable adoption. Responsible use, sustainable practices, and policy frameworks are essential to ensure that AI-driven innovations do not exacerbate existing disparities in healthcare access and quality. \textcopyright{} CARS 2026.},
  type          = {Editorial},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Lou2026,
  title         = {Stable perovskite fluoride glass enabling 1550~nm NIR-II pulsed upconversion via energy-transfer dynamics for optical wireless charging of drones},
  author        = {Lou, Zimeng and Zhang, Xiaosong and Wang, Xinru and Gong, Xiaokai and Kong, Lina and Xu, Jianping and Li, Lan},
  year          = 2026,
  journal       = {Ceramics International},
  doi           = {10.1016/j.ceramint.2026.03.425},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105034701369&doi=10.1016%2Fj.ceramint.2026.03.425&partnerID=40&md5=f5c9a2e9e400ce94555ad8342b8b372c},
  note          = {Cited by: 0},
  abstract      = {AbstractUpconversion (UC) materials doped with rare-earth ions have attracted wide interest, but their application remains limited by matrix instability, thermal sensitivity, and the narrow excitation band centered at 980~nm. In addition, the transient luminescence dynamics under NIR-II excitation are still not well understood. Here, CsPb<sub>1-x</sub>(Er/Yb)<sub>x</sub>Br<sub>3</sub>-ZBLAY perovskite fluoride glass was prepared by melt-quenching. Time-resolved measurements show that the decay behavior is governed by sensitizer-activator energy transfer and sensitizer-sensitizer migration. Adjusting the excitation pulse width allows control over the balance of these processes, enabling tunable UC lifetimes and red-to-green emission ratios. A laser charging system built on this glass provided an efficient and covert remote power supply for drones and showed potential to lower radar detectability. This work demonstrates a route to regulate UC kinetics in rare-earth-doped perovskites and highlights their promise for wireless energy applications such as drone charging. \textcopyright{} 2026 Published by Elsevier Ltd.},
  author_keywords = {1550~nm pulsed pump; Dynamic control; Fluoride glass; Rare earth ions; Upconversion},
  keywords      = {Bromine compounds; Dynamics; Energy transfer; Fluorine compounds; Glass; Inductive power transmission; Lead compounds; Luminescence; Metal ions; Optical pumping; Perovskite; Supercomputers; Wireless charging; 1550 nm; 1550 nm pulsed pump; Dynamic controls; Energy transfer dynamics; Fluoride glass; Optical wireless; Rare earth ions; Sensitiser; Up-conversion; Wireless charging; Drones},
  type          = {Article},
  publication_stage = {Article in press},
  source        = {Scopus}
}
@article{Lozoya202538,
  title         = {Educational Democratization in Latin America: Sustainability, Public Administration, and High-Performance Computing; [Democratizaci\'{o}n educativa en Latinoam\'{e}rica: Sostenibilidad, gesti\'{o}n p\'{u}blica y c\'{o}mputo avanzado]},
  author        = {Lozoya, Arandia Jorge and Mora P\'{e}rez, C\'{e}sar Omar and Valdez Zepeda, Andr\'{e}s and Ort\'{\i}z Palafox, Karla Hayde\'{e}},
