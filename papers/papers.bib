  keywords      = {Algae; Bioinformatics; Eutrophication; Game theory; Green computing; Nutrients; Planning; Supercomputers; Sustainable development; Blue green algae; Cultivated strains; Dynamic problem; Hierarchical management; High performance computing systems; Hybrid computing; Numerical implementation; Supercomputer technologies; Hierarchical systems},
