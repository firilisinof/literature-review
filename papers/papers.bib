  abstract      = {New emerging technologies have brought significant transformation to the healthcare industry. 3D printing, lab-on-chip (organoids), robotics, wearables integrated with the internet of things (IoT), artificial intelligence (AI), machine learning, quantum technology, blockchain technologies, etc., have revolutionized the healthcare system. Amazingly, owing to the rapid use of smart wearable sensors, IoT- and AI-enabled technology are shifting healthcare from a conventional hub-based system to a more personalized healthcare management system. Also, telemedicine and remote patient monitoring have improved patient care by minimizing the need for physical visits, thus reducing environmental impacts associated with transportation and logistics. Recent advancements in healthcare systems have given many patients access to advanced personalized healthcare. IoT-assisted wearable sensor devices, with their fast communication and automated collection of basic health-related data, have reduced the strain placed on doctors for continuous profiling of health examination data. Smart Data and Data Analytics, along with cognitive computing, are the promising technologies with great value added for the domain of healthcare. In addition, blockchain technology guarantees the security and interoperability of patient data, mitigating the risks of breaches and unauthorized access. Currently, we are lacking an efficient and predictive universal digital healthcare ecosystem. This system will be capable of providing early warning, assisting in risk reduction, and guiding management of national and global health risks to minimize mortality. Finally, we will discuss the present challenges and prospects of sustainable healthcare. \textcopyright{} 2026 Elsevier Inc. All rights reserved.},
  author_keywords = {Big Data; Blockchain; Health care ecosystem; High-performance computing; Human machine interface; Internet of things; Machine learning; Wearables},
  keywords      = {Big data; Diagnosis; Health care; Health risks; Hospital data processing; Human computer interaction; Internet of things; Learning systems; Machine learning; Medical computing; Remote patient monitoring; Risk management; Wearable computers; Wearable sensors; Block-chain; Emerging technologies; Health care ecosystem; Healthcare systems; High-performance computing; Human Machine Interface; Machine-learning; Performance computing; Personalized healthcare; Wearable; Blockchain},
  type          = {Book chapter},
  publication_stage = {Final},
  source        = {Scopus}
}
@conference{Rejitha20131388,
  title         = {Energy consumption analysis and energy optimization techniques of HPC applications},
  author        = {Rejitha, R.S. and Bright, C. Bency and Benedict, Shajulin},
  year          = 2013,
  journal       = {2013 International Conference on Energy Efficient Technologies for Sustainability, ICEETS 2013},
  pages         = {1388--1394},
  doi           = {10.1109/iceets.2013.6533590},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84881068568&doi=10.1109%2FICEETS.2013.6533590&partnerID=40&md5=0462b781fa56339cb8b9cb69b6eb128d},
  note          = {Cited by: 1},
  abstract      = {High Performance Computing (HPC) is used for running advanced application programs efficiently, reliably, and quickly. HPC makes use of both parallel as well as distributed computing technologies. In earlier decades, performance analysis of HPC applications was evaluated based on speed, scalability of threads, memory hierarchy. Now, it is essential to consider the energy or the power consumed by the system while executing an application. There exist performance analysis tools, such as, Periscope, Scalasca, Vampir, TAU, and Paradyn, which consider hardware based performance bottlenecks and memory hierarchy issues including EnergyAnalyzer which is a dedicated tool for energy analysis purpose. Recently, these tools have focused on doing an automatic tuning of HPC applications which require a wide study of HPC applications in terms of power consumption. This paper aims at experimenting the most commonly used HPC applications and express the HPC application developers or tool developers that power consumption will be higher in certain conditions. We have done the experiments in HPCCLoud Research Laboratory, India. The experimental results were impressive when tested for the energy consumption of HPC applications. \textcopyright{} 2013 IEEE.},
