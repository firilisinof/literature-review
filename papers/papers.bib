  publication_stage = {Final},
  source        = {Scopus}
}
@article{Salas20211,
  title         = {Rotation invariant networks for image classification for HPC and embedded systems},
  author        = {Salas, Rosemberg Rodriguez and Dokladal, Petr and Dokladalova, Eva},
  year          = 2021,
  journal       = {Electronics (Switzerland)},
  volume        = 10,
  number        = 2,
  pages         = {1--14},
  doi           = {10.3390/electronics10020139},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85099392527&doi=10.3390%2Felectronics10020139&partnerID=40&md5=17299f3bf40a0b3612181745e90afca2},
  note          = {Cited by: 3; All Open Access; Gold Open Access; Green Open Access},
  abstract      = {Convolutional Neural Network (CNNs) models' size reduction has recently gained interest due to several advantages: energy cost reduction, embedded devices, and multi-core interfaces. One possible way to achieve model reduction is the usage of Rotation-invariant Convolutional Neural Networks because of the possibility of avoiding data augmentation techniques. In this work, we present the next step to obtain a general solution to endowing CNN architectures with the capability of classifying rotated objects and predicting the rotation angle without data-augmentation techniques. The principle consists of the concatenation of a representation mapping transforming rotation to translation and a shared weights predictor. This solution has the advantage of admitting different combinations of various basic, existing blocks. We present results obtained using a Gabor-filter bank and a ResNet feature backbone compared to previous other solutions. We also present the possibility to select between parallelizing the network in several threads for energy-aware High Performance Computing (HPC) applications or reducing the memory footprint for embedded systems. We obtain a competitive error rate on classifying rotated MNIST and outperform existing state-of-the-art results on CIFAR-10 when trained on up-right examples and validated on random orientations. \textcopyright{} 2021 by the authors. Licensee MDPI, Basel, Switzerland.},
  author_keywords = {Angular prediction; Classification; CNN; Model reduction; Rotation invariance},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Salem2025,
  title         = {Tailoring of hydroxypropyl cellulose for high performance biodegradable liquid crystal and mechanical films},
  author        = {Salem, Aya M. and Basta, Altaf H. and Lotfy, Vivian F. and Micky, Jehane A.},
  year          = 2025,
  journal       = {Journal of Molecular Liquids},
  volume        = 437,
  doi           = {10.1016/j.molliq.2025.128589},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105016872807&doi=10.1016%2Fj.molliq.2025.128589&partnerID=40&md5=85d6eafa4ba4ad053cec36841a3391bf},
  note          = {Cited by: 0},
  abstract      = {Biodegradable polymers with functional properties are vital for reducing environmental impact. This study explores the upcycling of Giant Reed waste to enhance the optical and mechanical performance of hydroxypropyl cellulose (HPC) films. Modified cellulose nanoparticles were incorporated into the HPC matrix and compared with carbon-based nanoparticles. The liquid crystalline behavior was examined in both lyotropic suspensions--through rheological and optical analysis and in solid nanocomposite films using X-ray diffraction (XRD), Fourier Transform Infrared Spectroscopy (FTIR), thermogravimetric analysis (TGA), water contact angle measurements, mechanical testing, scanning electron microscopy (SEM), and optical microscopy. The results revealed that the addition of esterified nanoparticles, especially esterified nanocellulose, significantly reduced the critical concentration for anisotropic phase formation in HPC lyotropic solutions from 38 wt\% to 32 wt\%. The smallest reduction was observed with cellulose nanoparticles alone. In solid films, the incorporation of esterified nanoparticles, particularly esterified graphite oxide in combination with cellulose acetate, notably enhanced hydrophobicity (contact angle increased from 55.2\textdegree{} to 74\textdegree{}), mechanical strength, thermal stability, and crystallinity. Morphological analysis confirmed the presence of well-defined fingerprint textures, especially in films containing esterified cellulose nanoparticles and graphite oxide. These findings demonstrate the potential of esterified biobased nanomaterials to advance the development of functional, sustainable liquid crystal nanocomposites. The developed HPC-based nanocomposites show strong potential for use in biodegradable optical films, sustainable packaging, and smart environmental sensors, owing to their enhanced optical anisotropy, mechanical strength, hydrophobicity, and thermal stability. \textcopyright{} 2025 Elsevier B.V.},
  author_keywords = {Functional biodegradable polymer; High performance hydroxypropyl cellulose esterified cellulose /carbon- nanostructures; Lyotropic/mechanical behaviors films; Rheology},
  keywords      = {Cellulose Plastics; Contact Angle; Graphite; Hydroxypropyl Cellulose; Performance; Carbon films; Cellulose; Cellulose films; Cellulosic resins; Contact angle; Environmental impact; Graphite; Mechanical testing; Nanocomposite films; Nanocomposites; Nanoparticles; Optical films; Thermodynamic stability; Carbon nano-structures; Cellulose nanoparticles; Functionals; High performance hydroxypropyl cellulose esterified cellulose /carbon- nanostructure; Hydroxypropyl cellulose; Lyotropic/mechanical behavior film; Lyotropics; Mechanical; Mechanical behavior; Performance; Scanning electron microscopy},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Salih2025,
  title         = {Design optimization of high-performance, cost-efficient concrete enhanced with nano-CNTs: A hybrid approach using machine learning and NSGA-II},
  author        = {Salih, Ahmed Fathi Mohamed},
  year          = 2025,
  journal       = {Materials Today Communications},
  volume        = 45,
  doi           = {10.1016/j.mtcomm.2025.112251},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105000623881&doi=10.1016%2Fj.mtcomm.2025.112251&partnerID=40&md5=8b2d00b035712e639e17fc139acfda1a},
  note          = {Cited by: 9},
  abstract      = {High-performance concrete (HPC) has become a cornerstone material for next-generation infrastructure that offers exceptional mechanical strength, durability, and resilience under extreme environmental conditions. The incorporation of carbon nanotubes (CNTs) has attracted significant attention for its potential to enhance HPC's structural and microstructural properties, enabling denser matrices, reduced porosity, and improved hydration. CNTs, with their unparalleled mechanical, thermal, and electrical characteristics, serve as nanoscale reinforcements that bridge micro-voids and cracks, elevating the overall performance of HPC. Despite its promise, the practical adoption of CNT-enhanced HPC faces considerable challenges, including high costs, complexities in achieving uniform CNT dispersion, and the difficulty of balancing material performance with economic feasibility. This study addresses these limitations through a hybrid optimization framework that integrates advanced machine learning analytics with the Non-dominated Sorting Genetic Algorithm II (NSGA-II). By systematically optimizing mix designs, this approach identifies cost-effective formulations that maintain high mechanical performance while minimizing environmental impact. Rigorous parametric analyses and iterative adjustments of material proportions provide critical insights into the physicochemical interactions governing HPC behavior at the nanoscale. Achieving uniform CNT dispersion in cement remains challenging due to strong van der Waals interactions, leading to agglomeration and reduced reinforcement efficiency. Advanced techniques such as surfactant-assisted dispersion, ultrasonic agitation, and chemical functionalization have shown promise in computational models, but experimental validation is needed. Future research will focus on laboratory testing to assess mechanical performance and durability, refining dispersion methods and optimizing CNT-enhanced concrete for practical construction applications. The proposed framework offers a pathway for scalable, sustainable HPC production and facilitates the practical integration of CNT-enhanced HPC into critical infrastructure projects. This research establishes a model for employing intelligent, data-driven methodologies to optimize advanced cementitious composites, paving the way for resilient, environmentally responsible, and economically viable solutions in modern construction. \textcopyright{} 2025 Elsevier Ltd},
  author_keywords = {Concrete; Cost-efficient construction materials; Machine learning; Nano-carbon nanotubes; NSGA-II optimization},
  keywords      = {Dynamic programming; Linear programming; Natural gems; Sols; Structural optimization; Synthetic gems; Ultra-high performance concrete; Ultrasonic testing; Cost-efficient; Cost-efficient construction material; Efficient construction; High-performance concrete; Machine-learning; Nano-carbon nanotube; Nanocarbons; Non dominated sorting genetic algorithm ii (NSGA II); Non-dominated sorting genetic algorithm II optimization; Optimisations; Ultrasonic dispersion},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Saloni2020365,
  title         = {Investigation of bioplastics for additive manufacturing},
  author        = {Saloni, Daniel and Mervine, Nicole},
  year          = 2020,
  journal       = {Advances in Intelligent Systems and Computing},
  volume        = 975,
  pages         = {365--376},
  doi           = {10.1007/978-3-030-20216-3_34},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85067413793&doi=10.1007%2F978-3-030-20216-3_34&partnerID=40&md5=e97b36ae2abab72ae224af118d29f59b},
  note          = {Cited by: 5},
  abstract      = {Additive manufacturing (AM) has been growing in interest due to its non-traditional approach to producing objects by which components are fabricated directly from computer models by selectively depositing and consolidating or curing raw materials in successive layers. Currently, most polymer AM processes are limited by a narrow field of available and compatible materials. Typical thermoplastics common to the injection molding industry are created from petroleum, a limited and nonrenewable resource and have been widely adopted for use in AM. Recently plastics that are more sustainable, such as polylactic acid (PLA), have started to gain traction as a competitor to these traditional plastics. For this study, cellulose acetate butyrate (CAB), cellulose acetate propionate (CAP), hydroxypropyl cellulose (HPC), nylon 11, and polycaprolactone (PCL) were formulated and tested for AM. In addition, ABS and PLA were tested as control materials. Results showed the technical feasibility of some bioplastics for AM. \textcopyright{} Springer Nature Switzerland AG 2020.},
