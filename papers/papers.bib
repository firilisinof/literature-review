  title         = {Extracting, assimilating, and sharing the results of image analysis on the fsa/owi photography collection},
  author        = {Rodriguez, Paul and Satheesan, Sandeep Puthanveetil and Will, Jeffrey and Wuerffel, Elizabeth and Craig, Alan},
  year          = 2017,
  journal       = {ACM International Conference Proceeding Series},
