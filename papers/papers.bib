@conference{Simon2023_2,
  title         = {Energy Analysis Of Rear Door Heat Exchangers In Data Centers With Spatial Workload Distribution},
  author        = {Simon, Vibin Shalom and Karajgikar, Saket and Mulay, Veerendra and Pundla, Sai Abhideep and Sivaraju, Krishna Bhavana and Gupta, Gautam and Bansode, Pratik and Agonafer, Dereje},
  year          = 2023,
  journal       = {Proceedings of ASME 2023 International Technical Conference and Exhibition on Packaging and Integration of Electronic and Photonic Microsystems, InterPACK 2023},
  doi           = {10.1115/ipack2023-112078},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85179625105&doi=10.1115%2FIPACK2023-112078&partnerID=40&md5=9c5ea5145c5feb84201c216954e87960},
  note          = {Cited by: 0},
  abstract      = {Data centers have complex environments that undergo constant changes due to fluctuations in IT load, commissioning and decommissioning of IT equipment, heterogeneous rack architectures and varying environmental conditions. These dynamic factors often pose challenges in effectively provisioning cooling systems, resulting in higher energy consumption. To address this issue, it is crucial to consider data center thermal heterogeneity when allocating workloads and controlling cooling, as it can impact operational efficiency. Computational Fluid Dynamics (CFD) models are used to simulate data center heterogeneity and analyze the impact of two different cooling mechanisms on operational efficiency. This research focuses on comparing the cooling based on facility water for Rear Door Heat Exchanger (RDHx) and conventional Computer Room Air Conditioning (CRAH) systems in two different data center configurations. Efficiency is measured in terms of ∆T across facility water. Higher ∆T will result in efficient operation of chillers. The actual chiller efficiency is not calculated as it would depend on local ambient conditions in which the chiller is operated. The first data center model represents a typical enterprise-level configuration where all servers and racks have homogeneous IT power. The second model represents a colocation facility where server/rack power configurations are randomly distributed. These models predict temperature variations at different locations based on IT workload and cooling parameters. Traditionally, CRAH configurations are selected based on total IT power consumption, rack power density, and required cooling capacity for the entire data center space. On the other hand, RDHx can be scaled based on individual rack power density, offering localized cooling advantages. Multiple workload distribution scenarios were simulated for both CRAH and RDHx-based data center models. The results showed that RDHx provides a uniform thermal profile across the data center, irrespective of server/rack power density or workload distribution. This characteristic reduces the risk of over- or under-provisioning racks when using RDHx. Operational efficiency is compared in terms of difference in supply and return temperature of facility water for CRAH and RDHx units based on spatial heat dissipation and workload distribution. RDHx demonstrated excellent cooling capabilities while maintaining a higher \ensuremath{\Delta}T, resulting in reduced cooling energy consumption, operational carbon footprint (?), and water usage. Copyright \textcopyright{} 2023 by ASME.},
  author_keywords = {Air cooling; high density racks; high performance computing; hybrid cooling; Rear Door Heat Exchanger},
  keywords      = {Air conditioning; Carbon footprint; Computational efficiency; Computational fluid dynamics; Cooling; Cooling systems; Energy utilization; Green computing; Air cooling; Datacenter; High density rack; High performance computing; Hybrid cooling; IT Power; Operational efficiencies; Performance computing; Rear door heat exchanger; Work-load distribution; Heat exchangers},
  type          = {Conference paper},
  publication_stage = {Final},
  source        = {Scopus}
}
@conference{Simonov2018,
  title         = {Application of machine learning technologies for rapid 3D modelling of inflow to the well in the development system},
  author        = {Simonov, Maksim and Akhmetov, Alexey and Temirchev, Pavel and Koroteev, Dmitry and Kostoev, Ruslan and Burnaev, Evgeny and Oseledets, Ivan},
  year          = 2018,
  journal       = {Society of Petroleum Engineers - SPE Russian Petroleum Technology Conference 2018, RPTC 2018},
  doi           = {10.2118/191593-18rptc-ms},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85088764172&doi=10.2118%2F191593-18rptc-ms&partnerID=40&md5=4b165304ee78b0631d5425cf94a3fc09},
  note          = {Cited by: 13},
  abstract      = {The most convenient and physically justified tool for optimization of oil field development system is 3D hydrodynamical modeling. The high resource consumption of the method, however, does not allow carrying out fast multivariate calculations. In this paper, we propose an approach to 3D modeling in a development unit, based on the machine learning algorithms. According to available data of the reservoir properties and using high-performance computing systems, we've created a training set and a metamodel of the development unit. Forecasting in the latent variables space makes it possible to perform the necessary calculations many times faster than for the classical approach. We also offer a method for improving the quality of calculations on coarsened grids, that allows to greatly increase the size of training set and to reduce the complexity of setting up a metamodel. Copyright 2018, Society of Petroleum Engineers.},
  keywords      = {3D modeling; Gasoline; Learning algorithms; Machine learning; Oil field equipment; Three dimensional computer graphics; Classical approach; Development systems; Field development; High performance computing systems; Hydrodynamical model; Machine learning technology; Reservoir property; Resource consumption; Oil field development},
  type          = {Conference paper},
