@conference{Guritz2000335,
  title         = {Automated DEM Production Using ESA Tandem Mission Data for the Caribou-Poker Creek LTER Watershed, Alaska},
  author        = {Guritz, R. and Ayers, M. and Logan, T. and Li, S. and Lawlor, O.},
  year          = 2000,
  journal       = {European Space Agency, (Special Publication) ESA SP},
  number        = 478,
  pages         = {335--340},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-0347682096&partnerID=40&md5=14da6886d15413e413600252a14f4ce4},
  note          = {Cited by: 0},
  abstract      = {The Alaska SAR Facility has developed an automated procedure for production of a digital elevation model (DEM) from ESA tandem mission data. This software processes from ASF Computer Compatible Signal Data (CCSD) or Level Zero (raw) products to a map-projected, ground-range 30m DEM. Several advanced techniques have been integrated into the procedures to improve accuracy and to allow full automation. This spring, a test site at the Caribou-Poker Long Term Ecological Research (LTER) watershed was analyzed in collaboration with Larry Hinzman (Principal Investigator) and the Arctic Region Supercomputing Center. An accuracy assessment of the results for four ESA tandem pairs showed average differences ranging from approximately 4 to 8 meters in elevation when compared with field measurements using differential GPS. The final mosaic had an average difference of 4.68 meters in elevation. Point target analysis of existing 3\texttimes{}6 and 2\texttimes{}3 arc-second USGS digital elevation data showed an average difference of 19.97 and 10.04 meters in elevation, respectively. These advances in accuracy are due to use of precision timing and orbital data in an interferometric SAR processor using an average Doppler, precise baseline refinement, and direct ground rectification. The Alaska SAR Facility continues to refine its interferometric SAR processor in support of NASA-approved users.},
  keywords      = {Algorithms; Computer software; Data reduction; Glaciers; Global positioning system; Graphical user interfaces; Image analysis; Interferometry; Satellites; Servers; Subsidence; Watersheds; Computer compatible signal data (CCSD); Digital elevation models (DEM); Synthetic aperture radar},
