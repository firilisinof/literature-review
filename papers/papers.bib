@article{Awile2022,
  title         = {Modernizing the NEURON Simulator for Sustainability, Portability, and Performance},
  author        = {Awile, Omar and Kumbhar, Pramod and Cornu, Nicolas and Dura-Bernal, Salvador and King, James Gonzalo and Lupton, Olli and Magkanaris, Ioannis and McDougal, Robert A. and Newton, Adam J. H. and Pereira, Fernando and S\u{a}vulescu, Alexandru and Carnevale, Nicholas T. and Lytton, William W. and Hines, Michael L. and Sch\"{u}rmann, Felix},
  year          = 2022,
  journal       = {Frontiers in Neuroinformatics},
  volume        = 16,
  doi           = {10.3389/fninf.2022.884046},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85133897530&doi=10.3389%2Ffninf.2022.884046&partnerID=40&md5=68a60cf4317660c44be88b468e7f985b},
  note          = {Cited by: 29; All Open Access; Gold Open Access; Green Open Access},
  abstract      = {The need for reproducible, credible, multiscale biological modeling has led to the development of standardized simulation platforms, such as the widely-used NEURON environment for computational neuroscience. Developing and maintaining NEURON over several decades has required attention to the competing needs of backwards compatibility, evolving computer architectures, the addition of new scales and physical processes, accessibility to new users, and efficiency and flexibility for specialists. In order to meet these challenges, we have now substantially modernized NEURON, providing continuous integration, an improved build system and release workflow, and better documentation. With the help of a new source-to-source compiler of the NMODL domain-specific language we have enhanced NEURON's ability to run efficiently, via the CoreNEURON simulation engine, on a variety of hardware platforms, including GPUs. Through the implementation of an optimized in-memory transfer mechanism this performance optimized backend is made easily accessible to users, providing training and model-development paths from laptop to workstation to supercomputer and cloud platform. Similarly, we have been able to accelerate NEURON's reaction-diffusion simulation performance through the use of just-in-time compilation. We show that these efforts have led to a growing developer base, a simpler and more robust software distribution, a wider range of supported computer architectures, a better integration of NEURON with other scientific workflows, and substantially improved performance for the simulation of biophysical and biochemical models. Copyright \textcopyright{} 2022 Awile, Kumbhar, Cornu, Dura-Bernal, King, Lupton, Magkanaris, McDougal, Newton, Pereira, S\u{a}vulescu, Carnevale, Lytton, Hines and Sch\"{u}rmann.},
  author_keywords = {computational neuroscience; multiscale computer modeling; NEURON; neuronal networks; simulation; systems biology},
  keywords      = {Article; automation; biochemical analysis; biophysics; brain cortex; computer model; computer simulation; continuous integration; controlled study; data analysis; documentation; extracellular matrix; hippocampal CA1 region; hippocampus; human; integration; language; memory; nerve cell; nerve cell network; nervous system; neuron performance; neuron portability; neuron sustainability; nonhuman; olfactory network; quality assessment tool; rat; sensory system; software; systems biology; workflow},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@book{Aydn2014293,
  title         = {Exergetic performance of a low bypass turbofan engine at takeoff condition},
  author        = {Ayd\i{}n, Hakan and Turan, Onder and Midilli, Adnan and Karakoc, T. Hikmet},
  year          = 2014,
  journal       = {Progress in Exergy, Energy, and the Environment},
  pages         = {293--304},
  doi           = {10.1007/978-3-319-04681-5_25},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84949599843&doi=10.1007%2F978-3-319-04681-5_25&partnerID=40&md5=b2cced3ad59896a9643700bb4e26e705},
  note          = {Cited by: 2},
  abstract      = {In this article, exergetic methodology is applied for a low bypass turbofan engine at maximum power setting. The engine is a low-bypass (0.96–1) turbofan engine and its variants fitted to the 737-100/200 all comprise six low-pressure compressor (LPC) stages, seven high-pressure compressor (HPC) stages, a single HP turbine (HPT), and finally three LPT stages. At the end of the analysis, the most irreversible units in the system are found to be the combustor and the fan/LPC, with exergy loss rates of 18.7 and 2.486 MW, respectively. The exergy efficiencies of the fan/LPC, the HPC, and combustor are 0.856, 0.845, and 0.744, respectively. For the HPT and LPT, the exergy efficiencies are calculated to be 0.98 and 0.963, respectively. \textcopyright{} Springer International Publishing Switzerland 2014.},
  author_keywords = {Aircraft; Aviation; Energy; Exergy; Sustainability; Turbofan},
  keywords      = {Aircraft; Aviation; Combustors; Exergy; Sustainable development; Takeoff; Energy; Exergetic performance; Exergy efficiencies; Exergy loss; High-pressure compressors; Low pressure compressor; Maximum power; Turbofan; Engines},
  type          = {Book chapter},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Aygun2024,
  title         = {Thermodynamics, Environmental and Sustainability Impacts of a Turbofan Engine Under Different Design Conditions Considering Variable Needs in the Aviation Industry},
  author        = {Aygun, Hakan and Sheikhi, Mohammad Rauf and Caliskan, Hakan},
  year          = 2024,
  journal       = {Global Challenges},
  volume        = 8,
  number        = 2,
  doi           = {10.1002/gch2.202300205},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85182430256&doi=10.1002%2Fgch2.202300205&partnerID=40&md5=77c356fcf02a55261a7211140a5e0803},
  note          = {Cited by: 13; All Open Access; Gold Open Access; Green Open Access},
  abstract      = {In this study, thermodynamic analysis is implemented~to the kerosene-fuelled high by-pass turbofan (HBP-TF) engine to assess entropy, exergy, environmental, and sustainability metrics for different design variables such as pressure ratio of high-pressure compressor (HPC-PR) ranging from 7.5 to 8.5 and turbine inlet temperature (TIT) varying from 1400 to 1525~K considering variable needs in the aviation industry. As a novelty, entropic improvement potential (EIP) index for turbomachinery components and specific irreversibility production for the whole engine are calculated. Sustainability-based parameters for different cases are compared with the baseline values of the HBP-TF engine. The combustor has the highest entropy production of 44.4425~kW~K<sup>-1</sup> at the baseline. The higher TIT increases the entropy production of the combustor by 16.56\%, whereas the higher HPC-PR decreases it by 5.83\%. The higher TIT and HPC-PR favorably affect the sustainable efficiency factor of the engine, which is observed as 1.5482 at baseline and increases by 4.5\% and 0.058\% with the increment of TIT and HPC-PR, respectively. The higher TIT and higher HPC-PR results in lowering sustainability of the engine. The specific irreversibility production of the engine decreases by 3.78\% and 0.1171\% respectively, as TIT and HPC-PR reach the highest point considered in the study. \textcopyright{} 2024 The Authors. Global Challenges published by Wiley-VCH GmbH.},
  author_keywords = {entropy; environmental effect; exergy; sustainability; turbofan},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@book{Azeez2025404,
  title         = {The rojava revolution and alternative models of policing},
  author        = {Azeez, Hawzhin},
  year          = 2025,
  journal       = {Routledge International Handbook of Critical Policing Studies},
  pages         = {404--417},
  doi           = {10.4324/9781003401162-36},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105010661169&doi=10.4324%2F9781003401162-36&partnerID=40&md5=7cdf342b69974a0dba016ea18346fa32},
  note          = {Cited by: 3},
  abstract      = {The carceral capitalist system entrenched in hierarchical power and violence raises questions about envisioning a world devoid of oppressive structures. Rojava emerges as a powerful case study, showcasing an alternative social model involving democratic confederalism, gender equality, and social ecology. The Kurdish example challenges traditional policing by fostering community-driven security and protection values. Rojava's emphasis on citizen participation and the duty of collective protection rejects reliance on a singular institution. The Social Defence Forces (HPC), the Asay\^{\i}s units, the women's house, and the existence of perwardas that teach in the Kurdish language exemplify innovative conflict resolution, which replaces punitive measures with education and democratic reform. Unlike the Global North's trend of criminalising dissent, Rojava actively opposes replicating state violence, vengeance, and land dispossession. Rojava's exploration into non-Western alternatives provides a unique perspective on police abolition that emphasises the need for transformative, life-affirming institutions in place of punitive structures. Rojava's experience challenges the conventional narrative and offers valuable insights into constructing a just, egalitarian, and ecological society. \textcopyright{} 2025 Nicole L. Asquith, Jess Rodgers, James Clover, Gary Cordner, Angela Dwyer and Rishweena Ahmed. All rights reserved.},
  keywords      = {Case-studies; Citizen's participations; Collective protection; Conflict Resolution; Defense force; Gender equality; Power; Security and protection; Social ecologies; Social models; Ecology},
  type          = {Book chapter},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Aziza20252381,
  title         = {Mitigating autogenic shrinkage in high-performance concrete using wollastonite: A structural enhancement approach},
  author        = {Aziza, Kuldasheva and Li, Beixing and Huang, Bin and Kholjigit, Kuldashev and Yu, Yang},
  year          = 2025,
  journal       = {Structural Concrete},
  volume        = 26,
  number        = 3,
  pages         = {2381--2396},
  doi           = {10.1002/suco.202400007},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85208060672&doi=10.1002%2Fsuco.202400007&partnerID=40&md5=97629d4fce42fd6e4474a7794fec88a8},
  note          = {Cited by: 5; All Open Access; Bronze Open Access},
  abstract      = {This study investigates the influence of wollastonite fiber as a reinforcement in high-performance concrete (HPC), focusing on its potential to mitigate autogenic shrinkage and enhance overall structural properties. HPC known for its superior strength and low permeability, often suffers from intensified autogenic shrinkage, leading to micro-cracking and compromising durability. To address this challenge, wollastonite was incorporated at different substitutions (0\%, 5\%, 10\%, and 15\%) for both cement and aggregate. The experimental program involved a systematic evaluation of compressive strength, flexural strength, porosity, water absorption, and corrosion resistance with tests conducted at different curing periods. We found that the addition of 10\% wollastonite significantly enhances compressive strength (up to 20\% after 90 days) and flexural strength (maximum improvement of 21\%). The water permeability was decreased by 29\% and improved resistance to steel reinforcement corrosion, demonstrating enhanced durability compared to conventional HPC. However, diminishing returns were observed at higher wollastonite replacement levels (15\%), indicating a threshold beyond which mechanical and durability benefits were reduced due to potential issues with fiber dispersion and workability. Our findings suggest that wollastonite is a promising, cost-effective additive for improving HPC. The study contributes new understandings into optimizing HPC mixtures for greater durability and sustainability, while also reducing the environmental footprint through partial cement replacement. Future research is needed to explore the long-term performance of wollastonite-reinforced HPC under different environmental conditions and its combination with other supplementary cementitious materials for further enhancement. \textcopyright{} 2024 fib. International Federation for Structural Concrete.},
  author_keywords = {concrete; durability; high-performance concrete; reinforcing; wollastonite},
  keywords      = {Bending strength; Cement additives; Compressive strength; Concrete aggregates; Corrosion resistance; Fiber reinforced concrete; Fracture mechanics; Hydroelasticity; Shrinkage; Experimental program; High-performance concrete; Low permeability; Micro-cracking; Property; Reinforcing; Structural enhancements; Systematic evaluation; Wollastonite; Wollastonite fiber; High performance concrete},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Azmee2019,
  title         = {Investigating the impacts of ultra-fine calcium carbonate in high-volume fly ash concrete for structural rehabilitation for sustainable development},
  author        = {Azmee, Norzaireen M. and Shafiq, Nasir},
  year          = 2019,
  journal       = {Sustainability (Switzerland)},
  volume        = 11,
  number        = 17,
  doi           = {10.3390/su11174671},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85071983454&doi=10.3390%2Fsu11174671&partnerID=40&md5=51dc70c234d907a3d9be50fc69c73521},
  note          = {Cited by: 12; All Open Access; Gold Open Access; Green Open Access},
  abstract      = {An estimate shows that approximately 50\% of global annual construction activities account for the repair and retrofitting of structures and constructed facilities. Therefore, structural rehabilitation and repair are becoming hot topics among researchers, in order to find innovative and comprehensive solutions. Ultra-high-performance concrete (UHPC) is designed to achieve high strength and long-term durability. Such types of concrete offer a solution for complicated repair and retrofitting jobs. Although many benefits of using UHPC have been derived, many concerns have also been identified with the use of UHPC-sustainability is considered a critical concern due to the requirement of large proportions of cement, which results in an increase in cost and environmental impacts. This paper presents a recipe for UHPC that contains a small ratio of cement and a large proportion of fly ash, i.e., up to 50\%, as a cement replacement material (CRM). In order to achieve long-term durability and increase bonding with old concrete or brickwork for repair and retrofitting purposes, ultra-fine calcium carbonate (UFCC) is also added. In selecting an appropriate material for structural repair, it is essential to acquire an understanding of the material behavior. Therefore, this research was focused on providing a comprehensive guide to the behavior and strength performance of UHPC. The experimental results have shown that the highest strength of UHPC with low cement content can be achieved using a binary combination of high-volume fly ash (HVFA) and ultra-fine CaCO<sub>3</sub> (UFCC) as a substitution for cement by up to a ratio of 50\% in the recipe. The UHPC with low cement content displayed excellent repair and retrofitting potential for structural strengthening in regions of high stress by developing a strong bond with the existing concrete substrate. \textcopyright{} 2019 by the authors.},
  author_keywords = {High-performance concrete (HPC); High-volume fly ash (HVFA); Structural repair and retrofitting; Sustainable design of structures; Ultra-fine CaCO<sub>3</sub> (UFCC)},
  keywords      = {architectural design; calcium carbonate; concrete; durability; fly ash; long-term change; performance assessment; strength; sustainability; sustainable development},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Azzaz-Rahmani2025473,
  title         = {Recycling and multi-recycling high performance concretes as coarse aggregates for making new high-performance concretes},
  author        = {Azzaz-Rahmani, Abdessamed and Ladjel, Mohamed and Chemrouk, Mohamed and Ammar-Boudjelal, Amina},
  year          = 2025,
  journal       = {Revista de la Construccion},
  volume        = 24,
  number        = 2,
  pages         = {473--490},
  doi           = {10.7764/rdlc.24.2.473},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105016243486&doi=10.7764%2FRDLC.24.2.473&partnerID=40&md5=d4edb0020a23c4d365d61b46c67d8809},
  note          = {Cited by: 0; All Open Access; Gold Open Access},
  abstract      = {This research work aims at assessing the physic-mechanical properties of recycled and multi-recycled high performances concrete as aggregates for making new high performances concrete (HPC). Different concretes have been made with aggregates substitutions of 50\%, 75\% and 100\% of recycled and multi-recycled high performances concrete as coarse aggregates. A natural aggregate high performances concrete of around 75 MPa was first fabricated and then crushed to produce recycled concrete aggregates for making a first cycle HPC recycled aggregates concrete of 73 MPa. After assessing its properties, this concrete was in turn crushed to produce a second cycle recycled HPC aggregates for making a two-cycle recycled aggregates HPC of 71 MPa. The results show that, after two cycles of recycling, HPC keeps almost the same physico-mechanical properties as the parent concrete, even when 100\% of recycled concrete aggregates were used. The hardened recycled cement paste was as strong as the natural aggregates used or even more since traces of crushed aggregates were observed. This has resulted in recycled HPC properties similar to those of the original high performances concrete. Recycling high performances concrete into coarse aggregates for making new high qualities concrete appears to be a valuable aggregates supply resource, which fully fulfills the challenge of a sustainable concrete construction that responds to the quest for a sustainable development. Copyright (c) 2025. Azzaz-Rahmani, A., Ladjel, M., Chemrouk, M., and Ammar-Boudjelal, A. This work is licensed under a Creative Commons Attribution-Noncommercial-No Derivatives 4.0 International License.},
  author_keywords = {HPC; mechanical properties; multi-recycled concrete; recycled coarse aggregates; rheological parameters},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@conference{Baca19908.1,
  title         = {Fluids modeling for waste management},
  author        = {Baca, R.G. and Walton, J.C. and Sisson, J.B.},
  year          = 1990,
  pages         = {8.1},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-0025549970&partnerID=40&md5=a7ab2b294da65ccc83708f331f64f035},
  note          = {Cited by: 0},
  abstract      = {Computer models are playing a key role in studies of contaminant migration from waste disposal sites. At INEL, computer models have been applied to the problem of organic vapor migration for the Radioactive Waste Management Complex (RWMC). Chlorinated solvents, primarily carbon tetrachloride, disposed at the RWMC in the mid-1960's have produced a large subsurface vapor plume that extends to the groundwater. A three-diminsional computer model has been used to: (1) study processes that lead to the formation of the plume and (2) develop and evaluate remedial actions for site clean-up. Computer simulations studies indicate that vapor vacuum extraction may be a very effective and inexpensive method for site clean-up. The computer simulation study has been greatly aided by the availability of the INEL Cray supercomputer. Specialized graphics software on the Cray supercomputer has been used to process the computer output and produce a three-dimensional 'visualization' of the organic vapor plume. The visualization is summarized in a color video that shows the growth and movement of the plume in the subsurface. These visualization techniques have proven to be very valuable in understanding the geologic factors influencing contaminant migration and in designing vapor vacuum extraction systems. The purpose of this paper if to highlight the modeling approach, present selected results of the organic vapor simulations, and to discuss the planned field demonstration of vapor vacuum extraction. A short color video presentation will be shown to illustrate the recent applications to the organic vapor problem at the RWMC.},
  keywords      = {Carbon Tetrachloride; Environmental Impact - Modeling; Water Resources - Underground; Radioactive Waste Management Complex; Subsurface Vapor Plume; Vapor Vacuum Extraction; Water Pollution},
  type          = {Conference paper},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Bachtis2024,
  title         = {Inverse renormalization group of spin glasses},
  author        = {Bachtis, Dimitrios},
  year          = 2024,
  journal       = {Physical Review B},
  volume        = 110,
  number        = 14,
  doi           = {10.1103/PhysRevB.110.L140202},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85208274558&doi=10.1103%2FPhysRevB.110.L140202&partnerID=40&md5=d1d3c00f3489ff6d2f7d691c58d3e79a},
  note          = {Cited by: 2},
  abstract      = {We propose inverse renormalization group transformations to construct approximate configurations for lattice volumes that have not yet been accessed by supercomputers or large-scale simulations in the study of spin glasses. Specifically, starting from lattices of volume V=83 in the case of the three-dimensional Edwards-Anderson model we employ machine learning algorithms to construct rescaled lattices up to V\ensuremath{'}=1283, which we utilize to extract two critical exponents. We conclude by discussing how to incorporate numerical exactness within inverse renormalization group methods of disordered systems, thus opening up the opportunity to explore a sustainable and energy-efficient generation of exact configurations for increasing lattice volumes without the use of dedicated supercomputers.  \textcopyright{} 2024 American Physical Society.},
  keywords      = {Crystal lattices; Inverse problems; Inverse transforms; Supercomputers; Critical exponent; Disordered system; Edwards-Anderson models; Energy efficient; Large scale simulations; Machine learning algorithms; Renormalization group; Renormalization group methods; Renormalization-group transformation; Spin-glass; Spin glass},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@conference{Bagnasco2024,
  title         = {Computing Challenges for the Einstein Telescope project},
  author        = {Bagnasco, Stefano and Bozzi, Antonella and Fragos, Tassos and Gonzalvez, Alba and Hahn, Steffen and Hemming, Gary and Lavezzi, Lia and Laycock, Paul and Merino, Gonzalo and Pardi, Silvio and Schramm, Steven and Stahl, Achim and Tanasijczuk, Andres and Tonello, Nadia and Vallero, Sara and Veitch, John and Verdier, Patrice},
  year          = 2024,
  journal       = {EPJ Web of Conferences},
  volume        = 295,
  doi           = {10.1051/epjconf/202429504015},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85200442217&doi=10.1051%2Fepjconf%2F202429504015&partnerID=40&md5=f166684d3ff2a9428fa43ffcda050949},
  note          = {Cited by: 4; All Open Access; Gold Open Access; Green Open Access},
  abstract      = {The discovery of gravitational waves, first observed in September 2015 following the merger of a binary black hole system, has already revolutionised our understanding of the Universe. This was further enhanced in August 2017, when the coalescence of a binary neutron star system was observed both with gravitational waves and a variety of electromagnetic counterparts; this joint observation marked the beginning of gravitational multimessenger astronomy. The Einstein Telescope, a proposed next-generation ground-based gravitational-wave observatory, will dramatically increase the sensitivity to sources: the number of observations of gravitational waves is expected to increase from roughly 100 per year to roughly 100'000 per year, and signals may be visible for hours at a time, given the low frequency cutoff of the planned instrument. This increase in the number of observed events, and the duration with which they are observed, is hugely beneficial to the scientific goals of the community but poses a number of significant computing challenges. Moreover, the currently used computing algorithms do not scale to this new environment, both in terms of the amount of resources required and the speed with which each signal must be characterised. This contribution will discuss the Einstein Telescope's computing challenges, and the activities that are underway to prepare for them. Available computing resources and technologies will greatly evolve in the years ahead, and those working to develop the Einstein Telescope data analysis algorithms will need to take this into account. It will also be important to factor into the initial development of the experiment's computing model the availability of huge parallel HPC systems and ubiquitous Cloud computing; the design of the model will also, for the first time, include the environmental impact as one of the optimisation metrics. \textcopyright{} The Authors, published by EDP Sciences.},
  type          = {Conference paper},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Bagus2021181,
  title         = {Computation of Vibrational Excitations in XPS Spectroscopy},
  author        = {Bagus, Paul S. and Nelin, Connie J.},
  year          = 2021,
  journal       = {ACS Symposium Series},
  volume        = 1388,
  pages         = {181--206},
  doi           = {10.1021/bk-2021-1388.ch009},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85119489425&doi=10.1021%2Fbk-2021-1388.ch009&partnerID=40&md5=88ae0108cac0be786e6f485851e83674},
  note          = {Cited by: 7},
  abstract      = {Advances and Challenges in Nuclear and Radiochemistry. Rare earth elements (REEs) and actinides are critical to electronics, communication, military applications, and green energy systems. They also play a large role in nuclear waste challenges with critical national importance. Actinides are still among some of the least studied elements in the periodic table, due to their short half-lives and radioactivity, which demand expert facilities for research. Computational modeling greatly aids in understanding REEs and actinides; however, electronic structure modeling of these elements presents limitations. High Performance Computing (HPC) has had a direct impact not only on technical advances and access to information on a global scale but also on investigations of REEs and actinides. This work discusses recent advances in molecular and data driven modeling that are essential to the study of REEs and actinides, effects of computational science in nuclear and radiochemical applications, and advances and challenges in the exascale era of supercomputing. \textcopyright{} 2021 American Chemical Society.},
  keywords      = {Electronic structure; Energy efficiency; Military applications; Rare earth elements; Rare earths; Computational modelling; Electronic communications; Electronic.structure; Energy systems; Green energy; Half lives; Periodic table; Structure models; Vibrational excitation; XPS spectroscopy; Actinides},
  type          = {Book chapter},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Bahmani2023,
  title         = {A comparative study of calcium hydroxide, calcium oxide, calcined dolomite, and metasilicate as activators for slag-based HPC},
  author        = {Bahmani, Hadi and Mostafaei, Hasan and Ghiassi, Bahman and Mostofinejad, Davood and Wu, Chengqing},
  year          = 2023,
  journal       = {Structures},
  volume        = 58,
  doi           = {10.1016/j.istruc.2023.105653},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85179001793&doi=10.1016%2Fj.istruc.2023.105653&partnerID=40&md5=ea43f968cf7f781230a05529659803fc},
  note          = {Cited by: 38},
  abstract      = {In this study, the mechanical characteristics and microstructure of high-performance concrete (HPC) were thoroughly investigated and the influences of alkaline earth and metasilicate activators on material properties were comprehensively analyzed. Moreover, the carbon footprint of each mix design was evaluated and the strength to the carbon footprint was quantified. To evaluate the mechanical properties, the samples underwent tests for compressive, tensile, and flexural strengths at 28 days. Microstructure characteristics were analyzed using Scanning Electron Microscopy (SEM) and Thermogravimetric Analysis/Differential Thermal Analysis (TGA/DTA). Additionally, electrical resistance and water absorption tests were conducted. The findings revealed that employing 10\% CaO as an HPC activator resulted in the highest compressive strength (80 MPa), flexural strength (6.4 MPa), splitting tensile strength (5.5 MPa), and electrical resistance (445 \ensuremath{\Omega}m). Moreover, these samples exhibited the lowest water absorption percentage (2\%). TGA/DTA analysis indicated the highest content of Calcium Silicate Hydrate (C-S-H) in the geopolymer matrix of samples activated with 10\% CaO. SEM analysis confirmed the densest microstructure formation in these samples. Moreover, the study demonstrated that using 10\% CaO as an HPC activator can yield superior strength to the embodied carbon footprint. \textcopyright{} 2023 Institution of Structural Engineers},
  author_keywords = {Alkaline earth metal ions; Carbon footprint analysis; HPC; Mechanical properties; Metasilicate; Microstructural properties; Sustainability},
  keywords      = {Bending strength; Calcium silicate; Compressive strength; Durability; High performance concrete; Lime; Metal ions; Microstructure; Scanning electron microscopy; Silicate minerals; Slags; Tensile strength; Thermogravimetric analysis; Water absorption; Alkaline-earth metal ions; Calcined dolomite; Carbon footprint analyse; Comparatives studies; Differential-thermal analysis; Electrical resistances; Footprint analysis; High-performance concrete; Mechanical characteristics; Micro-structural properties; Carbon footprint},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Bahmani2024,
  title         = {Comparative analysis of environmental, social, and mechanical aspects of high-performance concrete with calcium oxide-activated slag reinforced with basalt, and recycled PET fibers},
  author        = {Bahmani, Hadi and Mostofinejad, Davood},
  year          = 2024,
  journal       = {Case Studies in Construction Materials},
  volume        = 20,
  doi           = {10.1016/j.cscm.2024.e02895},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85183460287&doi=10.1016%2Fj.cscm.2024.e02895&partnerID=40&md5=d22f55fcc69540be3e4f888d7ea7d138},
  note          = {Cited by: 27; All Open Access; Gold Open Access; Green Open Access},
  abstract      = {This paper studied the effects of steel, basalt, and recycled PET fibers on the environmental, social, and mechanical properties of high-performance concrete (HPC) with calcium oxide-activated slag (HPC-CAS). The energy consumption, greenhouse gas emissions, and human health impacts of concrete production were determined using resources, climate change, and human health indexes. The compressive strength, tensile and flexural strengths, modulus of elasticity, electrical resistance, and durability of HPC-CAS with different fiber types and contents were also measured and determined. Furthermore, the microstructure of HPC-CAS was examined by scanning electron microscope (SEM). The results revealed that 3 \% recycled PET or basalt fibers increased the HPC-CAS tensile strength by 89 \% and 55 \%, respectively, and the flexural strength by 28 \% \% and 1.2 times, respectively, compared to specimens without fibers. The specimens with fibers also showed higher ductility and lower electrical resistance than those without fibers. The SEM analysis showed that basalt fibers had a better bond with the geopolymer matrix than recycled PET fibers. Basalt fibers had the lowest environmental impact and recycled PET fibers had the lowest social impact among the three types of fibers. However, recycled PET fibers also had lower mechanical performance and durability than basalt fibers. It was concluded, therefore, that the choice of fiber type for HPC-CAS depends on the balance between social, environmental, and technical criteria. \textcopyright{} 2024 The Authors},
  author_keywords = {Basalt; Calcium oxide; Durability; Environmental aspects; Geopolymer; HPC-CAS; Mechanical characteristics; Recycled PET; Steel fiber},
  keywords      = {Basalt; Bending strength; Climate change; Compressive strength; Energy utilization; Gas emissions; Geopolymers; Greenhouse gases; High performance concrete; Inorganic polymers; Lime; Recycling; Reinforced plastics; Scanning electron microscopy; Slags; Steel fibers; Tensile strength; Basalt fiber; Electrical resistances; Environmental aspects; Fiber types; Geopolymer; High-performance concrete; High-performance concrete-CAS; Mechanical characteristics; Pet fibres; Recycled PET; Durability},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Bahmani2025,
  title         = {Impact of Fibers on the Mechanical and Environmental Properties of High-Performance Concrete Incorporating Zeolite},
  author        = {Bahmani, Hadi and Mostafaei, Hasan},
  year          = 2025,
  journal       = {Journal of Composites Science},
  volume        = 9,
  number        = 5,
  doi           = {10.3390/jcs9050222},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105006640001&doi=10.3390%2Fjcs9050222&partnerID=40&md5=1c57125ba70829d08a645d7a08c4ea48},
  note          = {Cited by: 16; All Open Access; Gold Open Access},
  abstract      = {This study investigates, for the first time, the effects of polypropylene, steel, glass, and synthetic fibers on the mechanical and environmental properties of high-performance concrete (HPC) incorporating zeolite as a substitute for aggregates and cement. A series of tests, including compressive strength (load-displacement), slump, specific gravity, and water absorption percentage, were conducted to evaluate the performance of the composite materials. Additionally, the IMPACT2002+ method was employed to assess the environmental impacts of the different fiber types. Furthermore, a life cycle costing (LCC) analysis was performed to evaluate the economic feasibility of using these fibers in sustainable HPC applications. The findings reveal that the incorporation of steel fibers results in a notable improvement in compressive strength, achieving 92 MPa compared to 85 MPa for fiber-free samples. Additionally, modified synthetic macro fibers exhibited the second-highest compressive strength, at 83 MPa, while also demonstrating the lowest environmental impact among the tested fibers, characterized by the lowest cost index and minimal carbon dioxide emissions. \textcopyright{} 2025 by the authors.},
  author_keywords = {carbon footprint; high-performance concrete; life cycle costing; mechanical characteristics; zeolite},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Bahmani2025_2,
  title         = {Sustainable high-performance concrete with sugar factory lime waste -activated slag and fiber reinforcement: Mechanical properties and environmental impact},
  author        = {Bahmani, Hadi and Mostofinejad, Davood},
  year          = 2025,
  journal       = {Construction and Building Materials},
  volume        = 464,
  doi           = {10.1016/j.conbuildmat.2025.140202},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85216246534&doi=10.1016%2Fj.conbuildmat.2025.140202&partnerID=40&md5=0fe1de93aff7f4ff86cbddf24a01d64d},
  note          = {Cited by: 16},
  abstract      = {This research presents a pioneering investigation into developing high-performance concrete (HPC) using lime-activated slag (HPC-LAS) derived from sugar factory waste. To enhance the ductility of the concrete, a novel approach was employed, utilizing four types of fibers - steel, glass, barchip, and polypropylene - at 1.5 \% and 2 \% dosages. The study rigorously evaluates the mechanical properties, including compressive, flexural, and tensile strengths and durability characteristics such as water absorption. Additionally, it analyzes the environmental impact of the concrete production process, focusing on energy consumption, greenhouse gas emissions, and related health implications, using indices related to resource use, climate change, and human health. Key findings indicate that the type and amount of fibers significantly influence the HPC-LAS's specific weight and mechanical strength. Steel fibers achieved a maximum compressive strength of 79 MPa, representing an 8 \% increase over fiber-free specimens, but also led to a substantial 75 \% rise in carbon footprint. In contrast, polypropylene fibers resulted in a lower compressive strength of 61 MPa, a 16 \% decrease compared to fiber-free specimens. However, they produced the lightest mix and demonstrated the highest toughness index, presenting a more sustainable option with only an 8 \% increase in carbon footprint relative to fiber-free specimens. This research underscores the importance of balancing mechanical performance and environmental sustainability in developing fiber-reinforced HPC. The findings pave the way for eco-friendly construction practices and advancements in sustainable concrete technology. Research Purposes. Methods Effect of different types of fibers Compressive, flexural, and tensile strengths. Optimization of the mix design Water absorption. Determining environmental challenges Resource, climate change, and human health \textcopyright{} 2025 Elsevier Ltd},
  author_keywords = {Environmental impact; HPC-LAS; Lime-activated slag; Mechanical performance; Polypropylene fibers; Steel fiber},
  keywords      = {Carbon capture and utilization; Carbon footprint; Compressive strength; Fiber reinforced concrete; Slags; Tensile strength; Zero-carbon; Concrete production process; Fiber reinforcement (e); High-performance concrete; High-performance concrete-LAS; Human health; Lime-activated slag; Mechanical; Mechanical performance; Polypropylene fiber; Property; Sugar factories},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Bahmani2025_3,
  title         = {Review of Energy Dissipation Mechanisms in Concrete: Role of Advanced Materials, Mix Design, and Curing Conditions},
  author        = {Bahmani, Hadi and Mostafaei, Hasan and Mostofinejad, Davood},
  year          = 2025,
  journal       = {Sustainability (Switzerland)},
  volume        = 17,
  number        = 15,
  doi           = {10.3390/su17156723},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105013102425&doi=10.3390%2Fsu17156723&partnerID=40&md5=410c5b17b6d173337bfa8b18e602dba0},
  note          = {Cited by: 15; All Open Access; Gold Open Access},
  abstract      = {Concrete structures increasingly face dynamic loading conditions, such as seismic events, vehicular traffic, and environmental vibrations, necessitating enhanced energy dissipation capabilities. The damping ratio, a critical parameter quantifying a material's ability to dissipate vibrational energy, is typically low in conventional concrete, prompting extensive research into strategies for improvement. This review comprehensively explores the impact of advanced concrete types--such as Engineered Cementitious Composites (ECCs), Ultra-High-Performance Concrete (UHPC), High-Performance Concrete (HPC), and polymer concrete--on enhancing the damping behavior. Additionally, key mix design innovations, including fiber reinforcement, rubber powder incorporation, and aggregate modification, are evaluated for their roles in increasing energy dissipation. External factors, particularly curing conditions, are also discussed for their influence on the damping performance. The findings consolidate experimental and theoretical insights into how material composition, mix design, and external treatments interact to optimize dynamic resilience. To guide future research, this paper identifies critical gaps including the need for multi-scale numerical simulation frameworks, standardized damping test protocols, and long-term performance evaluation under realistic service conditions. Advancing work in material innovation, optimized mix design, and controlled curing environments will be essential for developing next-generation concretes with superior vibration control, durability, and sustainability. These insights provide a strategic foundation for applications in seismic-prone and vibration-sensitive infrastructure. \textcopyright{} 2025 by the authors.},
  author_keywords = {aggregate effects; concrete damping; curing conditions; energy dissipation; engineered cementitious composites (ECCs); fiber-reinforced concrete; rubberized concrete; ultra-high-performance concrete (UHPC)},
  keywords      = {aggregate; concrete; energy dissipation; polymer; rubber; simulation; vibration},
  type          = {Review},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Bahmani2025_4,
  title         = {Sustainable construction solutions: The role of sugar factory lime waste-activated slag in high-performance concrete},
  author        = {Bahmani, Hadi and Mostofinejad, Davood},
  year          = 2025,
  journal       = {Ain Shams Engineering Journal},
  volume        = 16,
  number        = 3,
  doi           = {10.1016/j.asej.2025.103315},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85217912708&doi=10.1016%2Fj.asej.2025.103315&partnerID=40&md5=943fea411894736d16a7349530a02f67},
  note          = {Cited by: 8; All Open Access; Gold Open Access; Green Open Access},
  abstract      = {This pioneering research aims to develop high-performance concrete (HPC) using waste lime from sugar factories to activate slag. The study explores the transformative effects of high-temperature treatment on sugar factory lime waste and its potential to enhance slag activation, representing a novel approach in sustainable construction materials. The newly formulated HPC was rigorously compared with traditional counterparts made from calcium oxide-activated slag and calcined dolomite. A comprehensive series of tests were conducted at 28 days, assessing critical performance metrics, including compressive strength, four-point bending strength, tensile strength, and water absorption. Microstructural analysis was performed using Scanning Electron Microscopy (SEM), Energy Dispersive X-ray Spectroscopy (EDAX), and Fourier Transform Infrared Spectroscopy (FTIR). The results revealed that samples activated with 10 \% sugar factory lime waste achieved a compressive strength of approximately 80 MPa, rivaling samples activated with 10 \% calcium oxide. These lime-activated samples also demonstrated outstanding tensile and bending strengths of 5.6 MPa and 6.6 MPa, respectively--the highest recorded in this study. The microstructural analysis indicated a dense microstructure with an elevated Si/Al ratio and significant geopolymerization. The low water absorption rate of 2.1 \% highlighted the reduced porosity of this innovative geopolymeric matrix. This research is the first to investigate the high-temperature treatment of sugar factory lime waste for slag activation in HPC. The findings suggest that incorporating 10 \% waste lime significantly lowers the climate change impact index to 397.6 kg CO<sub>2</sub> eq--12 \% less than samples with 30 \% calcium oxide and 7 \% lower than those with 30 \% dolomite. Using sugar factory waste lime enhances mechanical properties and promotes environmental sustainability, presenting a compelling alternative that excels in both performance and ecological benefits. \textcopyright{} 2025 The Author(s)},
  author_keywords = {Calcium oxide; Environmental assessments; HPC; Mechanical characteristics; Microstructure; Sugar factory lime waste},
  keywords      = {Bending strength; Climate change; Fourier transform infrared spectroscopy; Geopolymer concrete; High temperature applications; Slags; Sustainable development; Calcined dolomite; Construction solutions; Environmental assessment; High temperature treatments; High-performance concrete; Mechanical characteristics; Microstructural analysis; Performance metrices; Sugar factory lime waste; Sustainable construction; Compressive strength},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Bahmani2026,
  title         = {Sustainable high-performance concrete: harnessing recycled rubber and slag for strength and eco-friendliness},
  author        = {Bahmani, Hadi and Mostafaei, Hasan},
  year          = 2026,
  journal       = {Scientific Reports},
  volume        = 16,
  number        = 1,
  doi           = {10.1038/s41598-026-35362-3},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105030585942&doi=10.1038%2Fs41598-026-35362-3&partnerID=40&md5=5f48c961a84ab216a1999caee9c2b077},
  note          = {Cited by: 3; All Open Access; Gold Open Access; Green Open Access},
  abstract      = {This study proposes a sustainable high-performance concrete (HPC) incorporating industrial by-products and recycled materials, specifically granulated blast furnace slag and recycled rubber powder, as partial replacements for cement. A series of experimental tests were conducted to evaluate the mechanical performance of the modified concrete, including compressive, flexural, and Brazilian tensile strengths, along with workability characteristics. Results indicate that replacing cement with up to 30\% slag resulted in less than 5–10\% reduction in mechanical strength, while significantly improving workability. The inclusion of 10\% recycled rubber powder enhanced ductility and fracture energy albeit with an associated reduction in compressive strength from 89 to 73~MPa. From an environmental perspective, carbon footprint analysis revealed that cement replacement led to substantial CO₂ emission reductions, with a 42\% reduction at 30\% slag and up to 37\% reduction at 30\% rubber content compared to conventional HPC. Life cycle cost analysis further demonstrated that the mix containing 30\% slag achieved the highest strength-to-cost efficiency (0.22~MPa/\$), highlighting its economic viability. Overall, the findings demonstrate that combining slag and recycled rubber offers an effective pathway toward environmentally friendly and cost-efficient HPC, suitable for sustainable construction applications where reduced carbon emissions, enhanced energy absorption, and adequate structural performance are required. \textcopyright{} The Author(s) 2026.},
  author_keywords = {Cement; High-performance concrete; Mechanical characteristics; Rubber powder; Slag; Sustainability evaluation},
  keywords      = {cement; concrete; rubber; article; carbon emission; carbon footprint; compressive strength; controlled study; cost benefit analysis; energy absorption; furnace; life cycle; major clinical study; pharmaceutics; powder; slag; tensile strength},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Bahmani2026_2,
  title         = {Development of High-Performance Eco-Friendly Concrete Incorporating Recycled Fine Aggregates: Mechanical, Microstructural and Carbon Footprint Assessment},
  author        = {Bahmani, Hadi and Mostafaei, Hasan and Shabani, Khosro and Santos, Paulo},
