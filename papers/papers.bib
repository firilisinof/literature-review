@article{Magudeaswaran20151649,
  title         = {Use of industrial waste materials in sustainable green high-performance reinforced concrete short columns},
  author        = {Magudeaswaran, P. and Eswaramoorthi, P.},
  year          = 2015,
  journal       = {International Journal of Earth Sciences and Engineering},
  volume        = 8,
