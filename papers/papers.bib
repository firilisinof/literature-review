@article{Ravichandran201878,
  title         = {Performance study on strength characteristics of high performance concrete using rice husk ash},
  author        = {Ravichandran, P.T. and Arul Raj, K. and Divya Krishnan, K. and Kannan Rajkumar, P.R.},
  year          = 2018,
  journal       = {Journal of Mines, Metals and Fuels},
  volume        = 2018,
  number        = {Special Issue},
  pages         = {78--80},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85054015610&partnerID=40&md5=adbd62b11cf8d20fdc2dcef69dfa9129},
  note          = {Cited by: 1},
  abstract      = {Advancements of civil engineering have recently resulted in new methods and greater consumption of concrete for construction activities. Thus production of a sustainable concrete has become necessary requirement for stimulation in making valuation of local materials for using such materials to prepare the concrete in an effective way. The introduction of different pozzolanic materials in concrete for the replacement of cement can reduce the environment issues due to bulk usage of cement and concrete. In this paper, the mechanical properties of a high strength concrete with rice husk ash (RHA) as a partial replacement for portland cement are reported at different concentrations of admixture at increasing curing periods. Concrete mixes were designed with RHA content of 0, 5, 10, 15 and 20\% with cement for M60 grade concrete. The strength characteristics such as compressive strength, tensile strength and flexural strength were investigated at 7 days, 14 days and 28 days of curing to find the optimum replacement of rice husk ash. From the experimental study, the results revealed that, the concrete with rice husk ash at 10\% replacement of total cement content have achieved 13.9\% more than the 28 days target strength and other strength parameters such as split tensile and flexural strength also marginally increased. Hence, the use of agro waste material, RHA in concrete as additive results in reduction in environmental issues, cost, energy etc and it improved the high strength concrete performances. \textcopyright{} 2018, Books and Journals Private Ltd. All rights reserved.},
  author_keywords = {Compressive strength; Flexural strength; HPC; Rice husk ash},
  keywords      = {Bending strength; Compressive strength; Construction industry; Curing; Mechanical properties; Portland cement; Tensile strength; Cement and concretes; Construction activities; Environmental issues; High strength concretes; Pozzolanic materials; Rice husk ash; Strength characteristics; Sustainable concretes; High performance concrete},
  type          = {Article},
