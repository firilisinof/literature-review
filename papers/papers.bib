@article{Yassin2024,
  title         = {The Flexural Behavior and Mechanical Properties of Super High-Performance Concrete (SHPC) Reinforced Using the Hybridization of Micro Polypropylene and Macro Steel Fibers},
  author        = {Yassin, Ahmed M. and Mohie Eldin, Mohammad and Hafez, Mohamed Ahmed and Elnaggar, Mohamed A.},
  year          = 2024,
  journal       = {Buildings},
  volume        = 14,
  number        = 7,
  doi           = {10.3390/buildings14071887},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85195816134&doi=10.3390%2Fbuildings14071887&partnerID=40&md5=4b1ce6dbeaf81d5f08380ced4c0ce1f9},
  note          = {Cited by: 9; All Open Access; Gold Open Access; Green Open Access},
  abstract      = {There is a need to investigate the flexural behavior and mechanical properties of super high-performance concrete (SHPC) for a better understanding of its response to compression, tension, and bending. Super-high-performance concrete (SHPC) lies between high-performance concrete (HPC) and ultra-high-performance concrete (UHPC) in strength, durability, and workability and is suitable for sustainable buildings. This paper presents an extensive experimental and analytical study to investigate the effect of the hybridization of micro-polypropylene and macro-steel fibers on the flexural behavior and mechanical properties of super-high-performance concrete (SHPC). The hybridization of both micro-PP fibers and macro-hooked-end ST fibers gathers the benefits of their advantages and offsets their disadvantages. Three types of fibers (micro polypropylene fibers (PP), macro hooked-end steel fiber (ST), and hybrid fiber (PP + ST)) with different fiber content up to 2\% were tested to study their effect on the following: (a) the workability of fresh concrete, (b) concrete compressive strength, (c) splitting tensile strength, (d) flexural behavior, including flexural tensile strength and toughness, and (e) the optimum percentage of each of the two fibers, PP and ST, in the hybrid to get the maximum structural and economic benefits of hybridization. Based upon the experimental results and using a statistical program, formulae to calculate both the tensile splitting strength ((Formula presented.)) and the flexural tensile strength in the form of the modulus of rupture ((Formula presented.)) were obtained. These formulae were able to predict accurately both the splitting tensile strength and modulus of rupture for SHPC with each of the three types of fibers used in this research. Also, they were in very good agreement with the values corresponding to different experimental results of other research, which means the ability to use these equations more generally. In addition, the prediction of the additional ultimate moment provided for all fibers was investigated. This research confirms the structural and the economical efficiency of hybridization in the behavior of SHPC. It was found that the optimum percentage of the fiber volume content for the hybrid of ST and PP is 1\%; 0.5\% for each of the two kinds. \textcopyright{} 2024 by the authors.},
  author_keywords = {end-hooked steel fiber; hybrid fiber; polypropylene fiber; residual flexural strength; super high-performance concrete (SHPC)},
  keywords      = {Compressive strength; High performance concrete; Intelligent buildings; Polypropylenes; Reinforced plastics; Steel fibers; Tensile strength; Toughness; End-hooked steel fiber; Flexural behavior; High-performance concrete; Hooked steel fibers; Hybrid fiber; Hybridisation; Polypropylene fiber; Residual flexural strength; Splitting-tensile strengths; Super high-performance concrete; Bending strength},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Ye2022,
  title         = {Recovery of microbiological quality of long-term stagnant tap water in university buildings during the COVID-19 pandemic},
  author        = {Ye, Chengsong and Xian, Xuanxuan and Bao, Ruihan and Zhang, Yiting and Feng, Mingbao and Lin, Wenfang and Yu, Xin},
  year          = 2022,
  journal       = {Science of the Total Environment},
  volume        = 806,
  doi           = {10.1016/j.scitotenv.2021.150616},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85115959780&doi=10.1016%2Fj.scitotenv.2021.150616&partnerID=40&md5=7f2ad14d6faa1ef3eda3414c4572d396},
  note          = {Cited by: 35; All Open Access; Green Open Access},
  abstract      = {Stagnant water can cause water quality deterioration and, in particular, microbiological contaminations, posing potential health risks to occupants. University buildings were unoccupied with little water usage during the COVID-19 pandemic. It's an opportunity to study microbiological quality of long-term stagnant water (LTSW) in university buildings. The tap water samples were collected for three months from four types of campus buildings to monitor water quality and microbial risks after long-term stagnation. Specifically, the residual chlorine, turbidity, and iron/zinc were disqualified, and the heterotrophic plate counts (HPC) exceeded the Chinese national standard above 100 times. It took 4-54 days for these parameters to recover to the routine levels. Six species of pathogens were detected with high frequency and levels (10<sup>1</sup>-10<sup>5</sup> copies/100 mL). Remarkably, L. pneumophilia occurred in 91\% of samples with turbidity > 1 NTU. The absence of the culturable cells for these bacteria possibly implied their occurrence in a viable but non-culturable (VBNC) status. The bacterial community of the stagnant tap water differed significantly and reached a steady state in more than 50 days. Furthermore, a high concentration of endotoxin (>10 EU/mL) was found in LTSW, which was in accordance with the high proportion of dead bacteria. The results suggested that the increased microbiological risks require more attention and the countermeasures before the building reopens should be taken. \textcopyright{} 2021 Elsevier B.V.},
  author_keywords = {Endotoxin; Long-term stagnation water; Pathogens; University buildings; Viable but non-culturable state},
  keywords      = {COVID-19; Humans; Pandemics; SARS-CoV-2; Universities; Water Microbiology; Water Quality; Water Supply; Bacteria (microorganisms); Varanidae; Bacteria; College buildings; Health risks; Turbidity; Water quality; chlorine; endotoxin; iron; tap water; zinc; Endotoxin; Long-term stagnation water; Microbiological contaminations; Microbiological quality; Potential health risks; Stagnant water; Tap water; Viable but non-culturable; Viable but non-culturable state; Water quality deterioration; building; COVID-19; microbial activity; pathogenicity; university sector; water quality; Article; bacterial growth; bacterium; bacterium detection; colony forming unit; concentration (parameter); coronavirus disease 2019; environmental monitoring; Escherichia coli; high throughput sequencing; Legionella pneumophila; microbial community; nonhuman; pandemic; physical chemistry; plate count; polymerase chain reaction; Pseudomonas aeruginosa; Salmonella; Shigella; turbidity; university; water quality; water retention; water sampling; water supply; human; microbiology; pandemic; university; water quality; water supply; Deterioration},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Ye20232667,
  title         = {An information encrypted heterogeneous hydrogel with programmable mechanical properties enabled by 3D patterning},
  author        = {Ye, Yuhang and Yu, Zhengyang and Zhang, Yifan and Jiang, Feng},
  year          = 2023,
  journal       = {Materials Horizons},
  volume        = 10,
  number        = 7,
  pages         = {2667--2676},
  doi           = {10.1039/d3mh00234a},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85158027619&doi=10.1039%2Fd3mh00234a&partnerID=40&md5=7c5eea28fb73add27d624713aebd32d2},
  note          = {Cited by: 23},
  abstract      = {Heterogeneous architectures with defined patterns found in nature have stimulated the burgeoning development of biomimetic materials. However, the construction of soft matter like hydrogels that mimic biological materials with a combination of strong mechanical performance and unique functionality remains difficult. In this work, we developed a simple and adaptable strategy of a 3D printing complex structure within hydrogels utilising all-cellulosic materials (hydroxypropyl cellulose/cellulose nanofibril, HPC/CNF) as ink. The structural integrity of the patterned hydrogel hybrid is ascertained by the interfacial interaction between cellulosic ink and the surrounding hydrogels. Through designing the geometry of the 3D printed pattern, programmable mechanical properties of hydrogels are achieved. In addition, the thermally induced phase separation properties of HPC confer thermally responsive behaviour on patterned hydrogels, providing them potential to be assembled into double information encryption devices and shape-morphing materials. We anticipate that this all-cellulose ink-enabled 3D patterning technique within hydrogels can serve as a promising and sustainable alternative for designing biomimetic hydrogels with desired mechanical properties and functions for a variety of applications. \textcopyright{} 2023 The Royal Society of Chemistry.},
  keywords      = {Cellulose; Construction; Geometry; Ink; Materials; Mechanical Properties; Patterns; Shape; 3D printing; Biomimetics; Cellulose; Cryptography; Hydrogels; Phase separation; 3-D printing; 3D patterning; 3D-printing; Adaptable strategies; Cellulosic material; Complexes structure; Heterogeneous architectures; Mechanical performance; Simple++; Soft matter; Biological materials},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
