@article{Alamoudi2024,
  title         = {On the Energy Behaviors of the Bellman–Ford and Dijkstra Algorithms: A Detailed Empirical Study},
  author        = {Alamoudi, Othman and Al-Hashimi, Muhammad},
  year          = 2024,
  journal       = {Journal of Sensor and Actuator Networks},
  volume        = 13,
  number        = 5,
  doi           = {10.3390/jsan13050067},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85207726792&doi=10.3390%2Fjsan13050067&partnerID=40&md5=3621b4dada4d0bb5ef7e61e379833095},
  note          = {Cited by: 5; All Open Access; Gold Open Access; Green Open Access},
  abstract      = {The Single-Source Shortest Paths (SSSP) graph problem is a fundamental computation. This study attempted to characterize concretely the energy behaviors of the two primary methods to solve it, the Bellman–Ford and Dijkstra algorithms. The very different interactions of the algorithms with the hardware may have significant implications for energy. The study was motivated by the multidisciplinary nature of the problem. Gaining better insights should help vital applications in many domains. The work used reliable embedded sensors in an HPC-class CPU to collect empirical data for a wide range of sizes for two graph cases: complete as an upper-bound case and moderately dense. The findings confirmed that Dijkstra's algorithm is drastically more energy efficient, as expected from its decisive time complexity advantage. In terms of power draw, however, Bellman–Ford had an advantage for sizes that fit in the upper parts of the memory hierarchy (up to 2.36 W on average), with a region of near parity in both power draw and total energy budgets. This result correlated with the interaction of lighter logic and graph footprint in memory with the Level 2 cache. It should be significant for applications that rely on solving a lot of small instances since Bellman–Ford is more general and is easier to implement. It also suggests implications for the design and parallelization of the algorithms when efficiency in power draw is in mind. \textcopyright{} 2024 by the authors.},
  author_keywords = {Bellman–Ford; Dijkstra's algorithm; empirical methods; power efficiency; power-efficient algorithms; single-source shortest paths (SSSP)},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Alanazi2026,
  title         = {CacheAware: Data Locality-Aware Scheduling for Distributed Memory Systems},
  author        = {Alanazi, Haifa A. and Alanazi, Abdulaziz G. and Albalawi, Nasser S.},
  year          = 2026,
  journal       = {Computers},
  volume        = 15,
  number        = 3,
  doi           = {10.3390/computers15030181},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105034168560&doi=10.3390%2Fcomputers15030181&partnerID=40&md5=8842f2bd9e69a99643f35808f4d37dbc},
  note          = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access},
  abstract      = {The widening performance gap between processor speed and memory access latency has made data locality a critical bottleneck in high-performance computing. In Non-Uniform Memory Access (NUMA) and distributed memory systems, remote accesses incur penalties far greater than local operations, degrading the efficiency of scientific and data-intensive workloads. This paper introduces CacheAware, a compiler–runtime framework for data locality-aware scheduling. CacheAware leverages compiler analysis to annotate tasks with memory access footprints and combines this static information with runtime monitoring of cache miss patterns to guide scheduling and dynamic task migration. Unlike existing NUMA balancing or runtime tasking systems, CacheAware integrates both proactive and reactive strategies to minimize cache thrashing and remote memory fetches. Experimental evaluation on scientific benchmarks demonstrates reductions of up to 30\% in cache misses and over 20\% improvements in execution time compared to Linux AutoNUMA, NUMA-aware schedulers, and task-based runtimes. These results confirm that CacheAware provides a practical and scalable approach for enhancing data locality and accelerating workloads on modern distributed memory systems. \textcopyright{} 2026 by the authors.},
  author_keywords = {cache-aware scheduling; compiler–runtime systems; data locality; distributed memory; NUMA},
  keywords      = {Benchmarking; Cache memory; Computer operating systems; Distributed computer systems; Memory architecture; Cache Miss; Cache-aware scheduling; Compiler–runtime system; Data locality; Distributed Memory; Distributed memory systems; Locality aware; Nonuniform memory access; Run- time systems; Runtimes; Program compilers},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Albadrani2026,
  title         = {Mechanistic insights into eco-efficient high-performance concrete with basalt powder: Microstructural refinement, durability modeling, and finite element validation},
  author        = {Albadrani, Mohammed A.},
  year          = 2026,
  journal       = {Results in Engineering},
  volume        = 29,
  doi           = {10.1016/j.rineng.2026.109135},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105027634500&doi=10.1016%2Fj.rineng.2026.109135&partnerID=40&md5=77c2daf155feaec9649312d23362da87},
  note          = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access},
  abstract      = {This study investigates the eco-efficient potential of basalt powder (BP), a quarry by-product, as a partial replacement for natural sand in high-performance concrete (HPC). A multi-scale framework was employed, combining experimental testing, service-life prediction, and finite element analysis (FEA). BP enhanced compressive, tensile, and flexural strengths by \sim{}12\% compared to the control, while durability indicators confirmed nearly double the corrosion initiation time and reduced carbonation depth. Microstructural analyses (SEM, XRD, ITZ quantification) validated pore refinement and secondary C–S–H formation all analytical tools used to emphasize multi-scale validation. At 20 \% replacement, basalt powder enhanced compressive, tensile, and flexural strengths by \approx{} 12 \%, 13 \%, and 12 \%, respectively. Service-life modeling projected an extension from \sim{}22 years (control) to \sim{}55–60 years for the BP20 mix. Beyond technical improvements, incorporating BP conserves \sim{}130 kg of natural sand per m\ensuremath{^3} and valorizes quarry waste, providing dual sustainability benefits. The findings highlight BP as a practical and eco-efficient solution for durable HPC, with direct implications for sustainable construction practices in line with international and Saudi building codes. \textcopyright{} 2026 The Author(s).},
  author_keywords = {Basalt powder; Eco-efficient construction; High-performance concrete; Microstructural refinement; Service-life modeling},
  keywords      = {Corrosion; Durability; High performance concrete; Intelligent buildings; Service life; Sustainable development; Tensile strength; Basalt powders; Eco-efficient constructions; Finite Element validation; High-performance concrete; Mechanistics; Microstructural refinement; Multiscale framework; Natural sand; Partial replacement; Service life modelling; Basalt; Bending strength},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Albayrak2026,
  title         = {Valorization of aluminothermite welding slag in sustainable high-performance heavyweight concrete: mechanical and radiation-shielding performance},
  author        = {Albayrak, Enes Burak and Y\"{u}zer, Nabi and Din\c{c}-\c{S}eng\"{o}n\"{u}l, Burcu},
  year          = 2026,
  journal       = {Sustainable Chemistry and Pharmacy},
  volume        = 50,
  doi           = {10.1016/j.scp.2026.102341},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105034571940&doi=10.1016%2Fj.scp.2026.102341&partnerID=40&md5=df4a0e8e8045180cbe2798cf4e89d5c7},
  note          = {Cited by: 0},
  abstract      = {The growing demand for radiation-shielding materials in nuclear, medical, and protective infrastructures has intensified interest in sustainable alternatives to conventional heavyweight aggregates. This study investigates the valorization of aluminothermite welding slag (AWS), a dense oxide-rich industrial by-product generated at 2200–3000~\textdegree{}C, as a heavyweight aggregate in high-performance concrete (HPC). Six concrete mixtures incorporating 0–100~\% AWS were produced at a constant water-to-binder ratio of 0.18, including both fiber-free and steel-fiber-reinforced (0.6~vol \%) series. Mechanical performance, fracture behavior, microstructure, capillary water absorption, and gamma and neutron radiation-shielding performance were systematically evaluated. The full-replacement mixture (ALM100) achieved an oven-dry density of 2624~kg/m3 and a 28-day compressive strength of 117~MPa, representing a 12.5~\% increase compared to the fiber-reinforced reference. Flexural strength and fracture energy increased to 16~MPa and 1205~N/m, respectively, indicating enhanced post-cracking ductility. Gamma-ray shielding tests using a 0.662~MeV Cs-137 source showed that the linear attenuation coefficient increased from 0.139~cm-1 (REF) to 0.167~cm-1 (ALM100), accompanied by reduced half- and tenth-value layers. Neutron attenuation also improved with increasing AWS content. SEM–EDS analyses confirmed matrix densification and the formation of Fe–Al–Mn oxide-rich clusters responsible for both mechanical enhancement and radiation attenuation. A cradle-to-gate CO<sub>2</sub> assessment revealed that AWS-based heavyweight concrete exhibits approximately 21–29~\% lower embodied carbon than conventional barite-, magnetite-, and hematite-based concretes. Furthermore, an Eco-Strength Efficiency (ESE) analysis demonstrated that the AWS-HPC achieved the highest mechanical performance per unit of embodied carbon among the investigated mixtures. Overall, the results confirm that AWS is a technically viable and environmentally efficient aggregate for producing multifunctional heavyweight concretes for structural and radiation-shielding applications. \textcopyright{} 2026 Elsevier B.V. All rights are reserved, including those for text and data mining, AI training, and similar technologies.},
  author_keywords = {Aluminothermite welding slag (AWS); Heavyweight concrete; High-performance concrete (HPC); Nuclear safety; Radiation shielding; Sustainability},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@conference{Aldarwish2025,
  title         = {Optimizing Heterogeneous High-Performance Computing Resource Allocation for Optimal Performance in Advanced Seismic Imaging Algorithms},
  author        = {Aldarwish, Aljawharah and Abulleif, Sami},
  year          = 2025,
  journal       = {SPE Middle East Oil and Gas Show and Conference, MEOS, Proceedings},
  doi           = {10.2118/226868-ms},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105020390486&doi=10.2118%2F226868-MS&partnerID=40&md5=3bb445d6dba1868ad23b4ce53504eb78},
  note          = {Cited by: 0},
  abstract      = {Optimizing resource allocation for seismic imaging workloads in High-Performance Computing (HPC) environments, particularly in heterogeneous infrastructures with diverse architectures, is crucial for achieving optimal computational efficiency in the oil and gas industry. As seismic imaging algorithms continue to grow in sophistication, they exhibit diverse resource requirements, making it essential to understand and accommodate these varying demands to ensure optimal resource utilization. This paper presents a data-driven resource allocation strategy that leverages application-level behavior metrics to optimize workload placement and resource utilization in heterogeneous HPC environments. The methodology is centered around defining two key metrics: Application CPU Ratio (ACPR) and Size CPU Ratio (SCR), which enable accurate identification of the applications' resource consumption patterns to guide decisions on optimal resource allocations. By identifying the optimal number of cores required for each application, this approach maximizes system throughput and eliminates idle resources. The proposed optimization method has been successfully applied to production HPC environment, without requiring any modifications to the underlying infrastructure, resulting in significant improvements in system efficiency, with a substantial 100X decrease in queue wait times, enhancing overall resource utilization. The methodology's effectiveness underscores its potential to transform resource management in various scientific and engineering domains. Copyright 2025, Society of Petroleum Engineers.},
  keywords      = {Computer architecture; Gasoline; Optimization; Petroleum engineering; Resource allocation; Seismic prospecting; Seismology; Computing environments; Heterogeneous high performance computing; High-performance computing resources; Imaging algorithm; Oil and Gas Industry; Optimal performance; Performance computing; Resources allocation; Resources utilizations; Seismic imaging; Computational efficiency},
  type          = {Conference paper},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Alevizos2025,
  title         = {Sustainable Swarm Intelligence: Assessing Carbon-Aware Optimization in High-Performance AI Systems},
  author        = {Alevizos, Vasileios and Gerolimos, Nikitas and Leligkou, Eleni Aikaterini and Hompis, Giorgos and Priniotakis, Georgios and Papakostas, George A.},
  year          = 2025,
  journal       = {Technologies},
  volume        = 13,
  number        = 10,
  doi           = {10.3390/technologies13100477},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105020167688&doi=10.3390%2Ftechnologies13100477&partnerID=40&md5=5133e5f10340778e2bf42a6aa3e37212},
  note          = {Cited by: 6; All Open Access; Gold Open Access; Green Open Access},
  abstract      = {Carbon-aware AI demands clear links between algorithmic choices and verified emission outcomes. This study measures and steers the carbon footprint of swarm-based optimization in HPC by coupling a job-level Emission Impact Metric with sub-minute power and grid-intensity telemetry. Across 480 runs covering 41 algorithms, we report grams CO<sub>2</sub> per successful optimisation and an efficiency index (Formula presented.) (objective gain per kg CO<sub>2</sub>). Results show faster swarms achieve lower integral energy: Particle Swarm emits 24.9 g CO<sub>2</sub> per optimum versus 61.3 g for GridSearch on identical hardware; Whale and Cuckoo approach the best (Formula presented.) frontier, while L-SHADE exhibits front-loaded power spikes. Conservative scale factor schedules and moderate populations reduce emissions without degrading fitness; idle-node suppression further cuts leakage. Agreement between CodeCarbon, MLCO2, and vendor telemetry is within 1.8\%, supporting reproducibility. The framework offers auditable, runtime controls (throttle/hold/release) that embed carbon objectives without violating solution quality budgets. \textcopyright{} 2025 by the authors.},
  author_keywords = {biomimicry; energy efficiency; green AI; swarm},
  keywords      = {Biomimetics; Budget control; Carbon dioxide; Carbon footprint; Optimization; Swarm intelligence; Telemetering; Telemetering equipment; Zero-carbon; AI systems; Algorithmics; Biomimicry; Emissions' impacts; Energy; Green AI; Impact metric; Optimisations; Performance; Swarm; Energy efficiency},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Alexander2025,
  title         = {Unprecedented rainfall events increase the magnitude of design storms},
  author        = {Alexander, Ashlin Ann and Rasool, Tabasum and Kumar, Chandan and Sahoo, Saswata and Bhowmik, Rajarshi Das and Kumar, D Nagesh},
  year          = 2025,
  journal       = {Environmental Research Letters},
  volume        = 20,
  number        = 6,
  doi           = {10.1088/1748-9326/add175},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105005659112&doi=10.1088%2F1748-9326%2Fadd175&partnerID=40&md5=ca50b1dd7f6481fb8b0ded5d47e47c67},
  note          = {Cited by: 1; All Open Access; Gold Open Access; Green Open Access},
  abstract      = {Climate change, driven by human activities and increasing greenhouse gas emissions, is pushing Earth's climate toward a warmer state, as evidenced by long-term observations. The frequency and intensity of unprecedented rainfall events have increased in recent years, underscoring the urgent need to revise design storms and depth-duration frequency (DDF) curves to better adapt to and mitigate the impacts of climate change. This study used a serial type of stochastic rainfall generator (SRG) that is capable of simulating daily rainfall series by embedding unprecedented events to study extreme precipitation scenarios under the changing climate. By perturbing values of power law tuning parameters in the SRG model, we developed thirty-six precipitation scenarios, some of which directly correlate with the current climate change scenario, while others represent very extreme conditions. High-performance computing is employed to run the computationally intensive SRG for simulating thirty-six scenarios across the entire Indian region. These simulated scenarios were analyzed to prepare rainfall return level maps and DDF curves. The findings reveal substantial increases in rainfall return levels across all frequencies when unprecedented events are considered, with pronounced impacts in coastal, northeastern, and Himalayan regions. The spatial pattern of simulated extreme precipitation was consistent across all generated scenarios from SRG irrespective of the return periods. Minimal spatial uncertainty in return level estimates across climate zones is observed which confirms the robustness of the SRG model and spatial clusters of extreme rainfall are identified irrespective of SRG being a point model. The analysis in this study based on SRG simulated climate change scenarios offers crucial insights for revising design storms and for devising climate resilience and flood management strategies. \textcopyright{} 2025 The Author(s). Published by IOP Publishing Ltd.},
  author_keywords = {DDF curves; design storm; stochastic rainfall generator; unprecedented},
  keywords      = {Greenhouse gas emissions; Resource allocation; Climate change scenarios; Depth duration frequency curves; Design storms; Extreme precipitation; Generator modelling; Rainfall event; Return level; Stochastic rainfall generator; Stochastic rainfalls; Unprecedented; climate change; extreme event; human activity; precipitation (climatology); rainfall; storm; Global warming},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Alfano2021,
  title         = {Photoelectrochemical water splitting by hybrid organic-inorganic systems: setting the path from 2\% to 20\% solar-to-hydrogen conversion efficiency},
  author        = {Alfano, Antonio and Mezzetti, Alessandro and Fumagalli, Francesco and Tao, Chen and Rovera, Eugenio and Petrozza, Annamaria and Di Fonzo, Fabio},
  year          = 2021,
  journal       = {iScience},
  volume        = 24,
  number        = 5,
  doi           = {10.1016/j.isci.2021.102463},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85105256295&doi=10.1016%2Fj.isci.2021.102463&partnerID=40&md5=8c86aa898216f6e70011e50310c24f64},
  note          = {Cited by: 22; All Open Access; Gold Open Access; Green Open Access},
  abstract      = {Promoting solar fuels as a viable alternative to hydrocarbons calls for technologies that couple efficiency, durability, and low cost. In this work we elucidate how hybrid organic-inorganic systems employing hybrid photocathodes (HPC) and perovskite solar cells (PSC) could eventually match these needs, enabling sustainable and clean hydrogen production. First, we demonstrate a system comprising an HPC, a PSC, and a Ru-based oxygen evolution catalyst reaching a solar-to-hydrogen (STH) efficiency above 2\%. Moving from this experimental result, we elaborate a perspective for this technology by adapting the existing models to the specific case of an HPC-PSC tandem. We found two very promising scenarios: one with a 10\% STH efficiency, achievable using the currently available semiconducting polymers and the widely used methylammonium lead iodide (MAPI) PSC, and the other one with a 20\% STH efficiency, requiring dedicated development for water-splitting applications of recently reported high-performing organic semiconductors and narrow band-gap perovskites. \textcopyright{} 2021},
  author_keywords = {Catalysis; Chemical engineering; Chemistry; Electrochemistry},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Alfieri2010,
  title         = {3D integrated water cooling of a composite multilayer stack of chips},
  author        = {Alfieri, Fabio and Tiwari, Manish K. and Zinovik, Igor and Poulikakos, Dimos and Brunschwiler, Thomas and Michel, Bruno},
  year          = 2010,
  journal       = {Journal of Heat Transfer},
  volume        = 132,
  number        = 12,
  doi           = {10.1115/1.4002287},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-79952129852&doi=10.1115%2F1.4002287&partnerID=40&md5=9199142b93c91a4e0e456cbf62af9469},
  note          = {Cited by: 63},
  abstract      = {New generation supercomputers with three dimensional stacked chip architectures pose a major challenge with respect to the removal of dissipated heat, which can reach currently as high as 250 W/ cm<sup>2</sup> in multilayer chip stacks of less than 0.3 cm<sup>3</sup> volume. Interlayer integrated water cooling is a very promising approach for such high heat flux removal due to much larger thermal capacity and conductivity of water compared with air, the traditional cooling fluid. In the current work, a multiscale conjugate heat transfer model is developed for integrated water cooling of chip layers and validated with experimental measurements on an especially designed thermal test vehicle that simulates a four tier chip stack with a footprint of 1 cm <sup>2</sup>. The cooling heat transfer structure, which consists of microchannels with cylindrical pin-fins, is conceived in such a way that it can be directly integrated with the device layout in multilayer chips. Every composite layer is cooled by water flow in microchannels (height of 100 \ensuremath{\mu}m), which are arranged in two port water inlet-outlet configuration. The total power removed in the stack is 390 W at a temperature gradient budget of 60 K from liquid inlet to maximal junction temperature, corresponding to about 1.3 kW/ cm<sup>3</sup> volumetric heat flow. The computational cost and complexity of detailed computational fluid dynamics (CFD) modeling of heat transfer in stacked chips with integrated cooling can be prohibitive. Therefore, the heat transfer structure is modeled using a porous medium approach, where the model parameters of heat transfer and hydrodynamic resistance are derived from averaging the results of the detailed 3D-CFD simulations of a single streamwise row of fins. The modeling results indicate that an isotropic porous medium model does not accurately predict the measured temperature fields. The variation of material properties due to temperature gradients is found to be large; therefore, variable properties are used in the model. It is also shown that the modeling of the heat transfer in the cooling sublayers requires the implementation of a porous medium approach with a local thermal nonequilibrium, as well as orthotropic heat conduction and hydrodynamic resistance. The improved model reproduces the temperatures measured in the stack within 10\%. The model is used to predict the behavior of multilayer stacks mimicking the change of heat fluxes resulting from variations in the computational load of the chips during their operation. \textcopyright{} 2010 American Society of Mechanical Engineers.},
  author_keywords = {3D chip stack; conjugate heat transfer modeling; integrated water cooling; micropin-fin; nonthermal equilibrium; thin porous medium; variable properties},
  keywords      = {Air; Computational fluid dynamics; Cooling; Fins (heat exchange); Fluid dynamics; Forced convection; Heat flux; Heat resistance; Hydrodynamics; Inlet flow; Microchannels; Multilayers; Porous materials; Supercomputers; Thermal gradients; Water cooling systems; 3D chip stack; Conjugate heat transfer; integrated water cooling; Micropins; nonthermal equilibrium; Porous medium; variable properties; Three dimensional},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
