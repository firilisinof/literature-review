  title         = {Feasibility analysis of embedded MRAM solutions at advanced process nodes},
  author        = {Komalan, Manu Perumkunnil and Gupta, Mohit and Rao, Siddharth and Kim, Woojin and Yasin, Farrukh and Couet, Sebastien and Furnemont, Arnaud and Kar, Gouri Sankar},
