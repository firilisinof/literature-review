@article{Ma2025,
  title         = {A Tree Crown Segmentation Approach for Unmanned Aerial Vehicle Remote Sensing Images on Field Programmable Gate Array (FPGA) Neural Network Accelerator},
  author        = {Ma, Jiayi and Yan, Lingxiao and Chen, Baozhe and Zhang, Li},
  year          = 2025,
  journal       = {Sensors},
  volume        = 25,
  number        = 9,
  doi           = {10.3390/s25092729},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105004852797&doi=10.3390%2Fs25092729&partnerID=40&md5=e910c0814dd4d4794ef69fd2b11b87b0},
  note          = {Cited by: 3; All Open Access; Gold Open Access; Green Open Access},
  abstract      = {Tree crown detection of high-resolution UAV forest remote sensing images using computer technology has been widely performed in the last ten years. In forest resource inventory management based on remote sensing data, crown detection is the most important and essential part. Deep learning technology has achieved good results in tree crown segmentation and species classification, but relying on high-performance computing platforms, edge calculation, and real-time processing cannot be realized. In this thesis, the UAV images of coniferous Pinus tabuliformis and broad-leaved Salix matsudana collected by Jingyue Ecological Forest Farm in Changping District, Beijing, are used as datasets, and a lightweight neural network U-Net-Light based on U-Net and VGG16 is designed and trained. At the same time, the IP core and SoC architecture of the neural network accelerator are designed and implemented on the Xilinx ZYNQ 7100 SoC platform. The results show that U-Net-light only uses 1.56 MB parameters to classify and segment the crown images of double tree species, and the accuracy rate reaches 85\%. The designed SoC architecture and accelerator IP core achieved 31 times the speedup of the ZYNQ hard core, and 1.3 times the speedup compared with the high-end CPU (Intel CoreTM i9-10900K). The hardware resource overhead is less than 20\% of the total deployment platform, and the total on-chip power consumption is 2.127 W. Shorter prediction time and higher energy consumption ratio prove the effectiveness and rationality of architecture design and IP development. This work departs from conventional canopy segmentation methods that rely heavily on ground-based high-performance computing. Instead, it proposes a lightweight neural network model deployed on FPGA for real-time inference on unmanned aerial vehicles (UAVs), thereby significantly lowering both latency and system resource consumption. The proposed approach demonstrates a certain degree of innovation and provides meaningful references for the automation and intelligent development of forest resource monitoring and precision agriculture. \textcopyright{} 2025 by the authors.},
  author_keywords = {neural network accelerator; SoC design; tree crown segmentation},
  keywords      = {Computer aided logic design; Deforestation; Drones; Image segmentation; Integrated circuit layout; Logging (forestry); Photointerpretation; Reforestation; Resource allocation; Target drones; Aerial vehicle; Field programmables; Neural network accelerator; Neural-networks; Performance computing; Programmable gate array; Remote sensing images; SoC design; Tree crown segmentation; Tree crowns; article; artificial neural network; automation; canopy; China; deep learning; energy consumption; forest; nerve cell network; pine; precision agriculture; prediction; remote sensing; tree; tree crown; unmanned aerial vehicle; willow; Intellectual property core},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Ma2025_2,
  title         = {Edge computing-enabled energy efficiency prediction of immersion cooling system for supercomputing centers},
  author        = {Ma, Shuaiyin and Cao, Yichun and Liu, Yang},
  year          = 2025,
  journal       = {Cleaner Engineering and Technology},
  volume        = 27,
  doi           = {10.1016/j.clet.2025.101014},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105007555058&doi=10.1016%2Fj.clet.2025.101014&partnerID=40&md5=900d5717f67641e9ecffdf9e9b9e4122},
  note          = {Cited by: 2; All Open Access; Gold Open Access; Green Open Access},
  abstract      = {Within the context of cleaner production, enhancing energy efficiency and sustainability has emerged as a central focus in supercomputing center development. To address the challenges in predicting energy consumption, this study proposes an architecture of edge computing-enabled energy efficiency prediction of immersion cooling system for supercomputing centers. This architecture combines time-series generative adversarial network (TimeGAN) for data augmentation with the neural basis expansion analysis for time series (N-BEATS) for prediction, providing a robust solution for accurate energy consumption prediction. TimeGAN enhances the training dataset by generating high-quality synthetic time-series data, effectively mitigating issues of data sparsity and imbalance. N-BEATS, with its modular architecture and strong adaptability to temporal data, ensures precise predictions by capturing both global trends and local variations in energy usage. Experimental results demonstrate the effectiveness of the proposed architecture, exhibiting superior performance across key metrics when compared to traditional models. Specifically, the RMSE of TimeGAN-N-BEATS reduced by more than 8 \%, the MSE decreased by over 18 \%, and the R<sup>2</sup> reached 97.31 \%, outperforming baseline models such as long short-term memory and gated recurrent unit, and their attention-enhanced variants. This study highlights the potential of integrating generative and predictive models to optimize energy efficiency in liquid cooling systems, offering valuable insights for sustainable supercomputing operations. \textcopyright{} 2025 The Authors},
  author_keywords = {Edge computing; Liquid cooling system; N-BEATS; Supercomputing centers; TimeGAN},
  type          = {Article},
  publication_stage = {Final},
  source        = {Scopus}
}
@conference{Ma20251316,
  title         = {Research on the Application of Prefabricated High-Performance Concrete in Prefabricated Substation},
  author        = {Ma, Yanqing and Ge, Song and Gao, Xiangyu},
  year          = 2025,
  journal       = {Conference Proceedings of the 13th International Symposium on Project Management, ISPM 2025},
  volume        = 3,
  pages         = {1316--1323},
  doi           = {10.52202/081497-0170},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105015948785&doi=10.52202%2F081497-0170&partnerID=40&md5=7a083b3ce00bc66b895810eaea55b44c},
  note          = {Cited by: 0},
  abstract      = {The civil engineering of power transmission and transformation is the core part of energy infrastructure construction. As an innovative construction method, prefabricated concrete is gradually receiving attention. This construction method not only meets the needs of power grid construction under the new power system, ensures the quality and reliability of power supply, but also reflects the concept of green development and conforms to the low-carbon green direction of economic and social development. In order to explore the application of high performance concrete (HPC) mixed with fly ash in the construction of prefabricated substation, the effects of different fly ash content and water-binder ratio on the performance of concrete were studied. The test results revealed its potential advantages: (1) Moderate fly ash content (20\%) and lower water-binder ratio (0.35) significantly improve the compressive strength and impermeability of concrete. This ratio not only optimizes the microstructure of concrete, reduces the porosity, but also enhances its durability; (2) When the curing time is 28d, due to the increase of fly ash content, the change trend of compressive strength of concrete is not synchronized with the impermeability. Only when the curing time is 90d, the compressive strength and impermeability of concrete have the same trend when the concrete is given sufficient reaction time. (3) Bao significantly reduced the carbon emissions of concrete by reducing the amount of cement and increasing the use of fly ash. This is of great significance for promoting the green development of the construction industry and meeting the environmental sustainability goals. \textcopyright{} 2025 by Aussino Academic Publishing House. All Rights Reserved.},
  author_keywords = {Carbon Emissions; High Performance Concrete of Fly Ash; Power Transmission and Transformation Civil Engineering; Water-Binder Ratio},
  keywords      = {Binders; Carbon; Compressive strength; Construction industry; Curing; Durability; Electric power system economics; Electric power transmission; Energy conservation; Green development; High performance concrete; Power transmission; Sustainable development; Carbon emissions; Construction method; Core part; Curing time; Fly ash content; High performance concrete of fly ash; High-performance concrete; Power transmission and transformation civil engineering; Power-transmission; Water-binder ratios; Fly ash},
  type          = {Conference paper},
