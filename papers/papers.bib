}
@article{Fung1988varpagings,
  title         = {Development And Implementation Of Lertad: A Modelling System For Lagrangian Estimates Of Regional Transport And Acidic Deposition.},
  author        = {Fung, C.S. and Huget, R.G. and Rooney, D.R. and Alp, E. and Portelli, R.V.},
  year          = 1988,
  journal       = {Research and Development Report - Canadian Electrical Association},
  number        = {pt 6},
  pages         = {varpagings},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-0023980482&partnerID=40&md5=1d625c8b4c31aee383ceaf27a59af858},
  note          = {Cited by: 1},
  abstract      = {This study consists of the implementation, enhancement, sensitivity testing and validation of a state-of-the-art Lagrangian model of regional transport and acidic deposition. The model was selected through an exhaustive and critical evaluation of available Lagrangian models of atmospheric transport in the meso to regional scale, which was undertaken and reported on in a previous phase of this project. The selected model, MESOPUFF II, was implemented on a Cyber 205 supercomputer and the code vectorized/optimized to realize a saving of more than 75\% for a small scale run without sacrificing any attributes. The savings for larger scale applications are expected to be even more substantial. Some coding deficiencies and errors were detected during the testing of the model and were rectified accordingly. The model, together with the preprocessor and postprocessor developed for data management and validation, form a modelling system called LERTAD for Lagrangian Estimates of Regional Transport and Acidic Deposition.},
  keywords      = {CODES, SYMBOLIC - Applications; COMPUTERS, DIGITAL - Applications; ENVIRONMENTAL IMPACT; ACIDIC DEPOSITION; LAGRANGIAN ESTIMATES; LERTAD MODELING SYSTEM; MODEL PERFORMANCE EVALUATION; REGIONAL TRANSPORT; AIR POLLUTION},
  type          = {Article},
