}
@conference{Fiala2015475,
  title         = {Experimental verification of elements of light concrete frame for energy efficient buildings},
  author        = {Fiala, Ctislav and Novotna, Magdalena and Bilek, Ylastimil and Hejl, Jaroslav and Ruzicka, Jan and Hajek, Petr},
  year          = 2015,
  journal       = {Concrete - Innovation and Design: fib Symposium Proceedings},
  pages         = {475--476},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85015387814&partnerID=40&md5=2f1237ae9b02dcef86ca046658aeffe9},
  note          = {Cited by: 1},
  abstract      = {Paper presents some results of long-term research of a new optimized subtle precast construction system based on high performance silicate composites. The system is particularly aimed for construction of buildings in passive or zero-energy standard. Subtle structural elements from high performance concrete (HPC) can be integrated into building envelope of energy efficient buildings with substantial reduction of envelope structure and avoiding risk of thermal bridges. Significant advantages of subtle elements are material and energy savings during production, transport, manipulation and construction on building site. Paper presents results of experimental verification of noor panels and connections between columns and beams ensured by Peikko's PCs corbels. Moreover, production of two prototypes of columns from high performance fibre reinforced concrete is presented. Prototypes were casted in ZPSV a.s. plant, Litice nad Orlici in June 2014. Production of pre-stressed concrete elements (girders and panels) is expected in December 2014. A complex LCA analysis of three various reinforced concrete columns was performed. The analysis covers construction life phase. Results show that it is possible to reduce some environmental impacts in the range from 16 up to 65\% in comparison with common solution of reinforced concrete columns. This was achieved by the utilization of excellent mechanical properties of high performance concrete that enables the design of subtle structural elements.},
  author_keywords = {Experimental verification; High perfonnance concrete; LCA; Noor panel; Production technology; Subtle column},
  keywords      = {Buildings; Concrete construction; Concretes; Construction; Energy conservation; Energy efficiency; Environmental impact; Fiber reinforced materials; Life cycle; Reinforced concrete; Silicates; Construction of buildings; Energy efficient building; Experimental verification; High-performance fibres; Noor panel; Production technology; Reinforced concrete column; Substantial reduction; High performance concrete},
