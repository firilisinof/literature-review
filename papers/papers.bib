  type          = {Conference paper},
  publication_stage = {Final},
  source        = {Scopus}
}
@book{Xu2025296,
  title         = {Digital technologies for climate-adaptive smart urban transportation systems},
  author        = {Xu, Jinying and MacAskill, Kristen and Tzachor, Asaf and Richards, Catherine},
  year          = 2025,
  journal       = {Routledge Handbook of Smart Built Environment},
  pages         = {296--313},
  doi           = {10.1201/9781003383840-19},
  url           = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85217985626&doi=10.1201%2F9781003383840-19&partnerID=40&md5=da50c9ebb14015a327cb4a762bfe50f4},
  note          = {Cited by: 2},
  abstract      = {An urban transportation system (UTS) is a complex system of interdependent systems. Being one of the most critical infrastructures to support daily human activities, today's UTS is confronting intractable challenges in the face of hazards and disasters whose probability and impacts are exacerbated by climate change. To evade the dilemma, there have been urgent appeals that cities and their UTSs should take immediate climate mitigation (greenhouse gas emission reduction) and adaptation (adapting to a changing climate) actions. While many cities are taking climate mitigation measures, few have adopted climate adaptation actions in their transportation sector. To plan and manage a complex UTS to enhance its adaptability to the uncertainty of climate change stressors requires gigantic data, sophisticated models, and supercomputing. The scope and application of technology is becoming increasingly complex, this chapter sets out to map technology development efforts and how they could be deployed to support the development of a climate-adaptive, smart UTS. By integrating new methodologies of data collection and analysis, information management, decision-making, and system control, digital technologies can play a crucial role in climate adaptability toward resilience, reliability, and low-carbon/zero-carbon in UTSs. This chapter contributes by mapping the value of different digital technologies, including internet of things, digital twinning, big data, and artificial intelligence for against climate-adaptive, smart UTS requirements. It proposes a conceptual deployment framework for the planning and management of a climate-adaptative UTS from local through to national scale with principles and a plan about how such digital technologies might be deployed in a step-by-step review. It also identifies the barriers to be addressed in the future. \textcopyright{} 2025 Jinying XuORCID Icon, Kristen MacAskillORCID Icon, Asaf TzachorORCID Icon, Catherine Richards. All rights reserved.},
  type          = {Book chapter},
  publication_stage = {Final},
  source        = {Scopus}
}
@article{Xu2026,
